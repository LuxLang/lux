(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]
    [[0] format]]
   [error
    [[0] try]]
   [data
    [collection
     [dictionary (.only Dictionary)]
     [[0] list]]]
   [type
    [[0] poly]]
   [time
    [[0] instant]
    [[0] duration]
    [[0] date]
    [[0] day]
    [[0] month]]]]
 [\\library
  [[0] /]])

(the .public format
     (poly.macro
      (` (format.Format /.JSON))
      [poly.:case (poly.flat [poly.:on_each (` /.tag)
                              poly.:on_both (` /.or)
                              poly.:on_whole (` /.variant)])
       poly.:pair (poly.flat [poly.:on_each (` /.slot)
                              poly.:on_both (` /.and)
                              poly.:on_whole (` /.record)])
       poly.:function poly.not_applicable
       poly.:reification {.:None}
       poly.:recursive (function (_ code ['*self body])
                                 (monad.let try.monad
                                            ['body (code body)]
                                            (pure (` (/.recursive
                                                      (.function ((,* '*self) (,* '*self))
                                                                 (, 'body)))))))
       poly.:recursion {.:None}
       poly.:any {.:Some (` /.any)}
       poly.:polymorphic {.:None}
       poly.:parameter {.:None}
       poly.:specializations (list [Bit (` /.bit)]
                                   [Natural (` /.natural)]
                                   [Integer (` /.integer)]
                                   [Revolution (` /.revolution)]
                                   [Real (` /.real)]
                                   [Text (` /.text)]
                                   [duration.Duration (` /.duration)]
                                   [instant.Instant (` /.instant)]
                                   [date.Date (` /.date)]
                                   [day.Day (` /.day)]
                                   [month.Month (` /.month)]

                                   [(type (Dictionary Text)) (` /.dictionary)]
                                   [List (` /.list)]
                                   )]))
