(.using
 [library
  [lux (.except)
   [["$"] documentation]
   [data
    [collection
     [[0] list]]]]]
 [\\library
  [[0] /]]
 [[0] /
  [[1 0] contravariant]])

(the .public documentation
     (List $.Documentation)
     (list.partial ($.module /._
                             "")

                   ($.definition (/.Functor !))
                   ($.definition (/.Or left right))
                   ($.definition (/.And left right))
                   ($.definition (/.Then outer inner))

                   ($.definition /.case
                                 "Case composition for functors.")

                   ($.definition /.pair
                                 "Pair composition for functors.")

                   ($.definition /.composite
                                 "Functor composition.")

                   /contravariant.documentation))
