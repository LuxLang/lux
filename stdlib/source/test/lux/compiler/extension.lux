(.using
 [library
  [lux (.except)
   [test
    [["_"] property]]]]
 [\\library
  [[0] /]]
 [["!"] \\theorem]
 [[0] /
  [[1 0] lux]
  [[1 0] jvm]
  [[1 0] js]
  [[1 0] lua]
  [[1 0] python]
  [[1 0] ruby]])

(the .public test
     _.Test
     (<| (_.covering /._)
         (_.for [/.Name])
         (all _.and
              (_.by_proof [/.suffix]
                          [!.name])
              (_.by_proof [/.name]
                          [!.name])
              
              (_.by_proof [/.suffix_of_analysis]
                          [!.analysis])
              (_.by_proof [/.analysis]
                          [!.analysis])
              
              (_.by_proof [/.suffix_of_synthesis]
                          [!.synthesis])
              (_.by_proof [/.synthesis]
                          [!.synthesis])

              /lux.test
              /jvm.test
              /js.test
              /lua.test
              /python.test
              /ruby.test
              )))
