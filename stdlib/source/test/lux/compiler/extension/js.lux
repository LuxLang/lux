(.using
 [library
  [lux (.except)
   [macro
    [[0] template]]
   [test
    [["_"] property]]]]
 [\\library
  [[0] /]]
 [["!"] \\theorem])

(<| (the .public test
         _.Test)
    (_.covering /._)
    (`` (all _.and
             (,, (template.with [,name]
                                [(`` (_.by_proof [,name]
                                                 [(,, (template.name [!._] [,name]))]))]
                                
                                [[/.object_new]
                                 [/.object_get]
                                 [/.object_do]
                                 [/.object_null]
                                 [/.object_null?]
                                 [/.object_undefined]
                                 [/.object_undefined?]

                                 [/.constant]
                                 [/.of]
                                 [/.function]
                                 [/.import]
                                 [/.type_of]
                                 ]))
             )))
