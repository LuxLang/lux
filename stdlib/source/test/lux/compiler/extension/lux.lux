(.using
 [library
  [lux (.except)
   [macro
    [[0] template]]
   [test
    [["_"] property]]]]
 [\\library
  [[0] /]]
 [["!"] \\theorem])

(<| (the .public test
         _.Test)
    (_.covering /._)
    (`` (all _.and
             (,, (template.with [,name]
                                [(`` (_.by_proof [,name]
                                                 [(,, (template.name [!._] [,name]))]))]
                                
                                [[/.is?]
                                 [/.try]
                                 [/.when_char]
                                 [/.local]
                                 [/.global]
                                 [/.universe]
                                 [/.exec]
                                 [/.let]
                                 [/.if]
                                 [/.case]
                                 [/.if_case]
                                 [/.pair]
                                 [/.let_pair]
                                 [/.when]
                                 [/.function]

                                 [/.log!]
                                 [/.error]

                                 [/.i64_and]
                                 [/.i64_or]
                                 [/.i64_xor]
                                 [/.i64_left]
                                 [/.i64_right]

                                 [/.i64_=]
                                 [/.i64_+]
                                 [/.i64_-]

                                 [/.int_<]
                                 [/.int_x]
                                 [/.int_/]
                                 [/.int_%]
                                 
                                 [/.int_f64]
                                 [/.int_char]

                                 [/.f64_=]
                                 [/.f64_<]
                                 [/.f64_+]
                                 [/.f64_-]
                                 [/.f64_x]
                                 [/.f64_/]
                                 [/.f64_%]
                                 [/.f64_int]

                                 [/.text_=]
                                 [/.text_<]
                                 [/.text_composite]
                                 [/.text_index]
                                 [/.text_size]
                                 [/.text_char]
                                 [/.text_clip]

                                 [/.list]
                                 [/.list_size]
                                 [/.list_item]
                                 [/.list_composite]
                                 [/.if_list]

                                 [/.type_name]
                                 [/.type]

                                 [/.array]
                                 [/.array_size]
                                 [/.array_its]
                                 [/.array_has]
                                 [/.array_lacks]
                                 [/.array_lacks?]

                                 [/.constant_literal]

                                 [/.iteration]
                                 [/.loop]

                                 [/.reification]

                                 [/.constant]
                                 ]))
             )))
