(.using
 [library
  [lux (.except)
   [test
    [["_"] property]]]]
 [\\library
  [[0] /]]
 [["!"] \\theorem])

(the .public test
     _.Test
     (<| (_.covering /._)
         (all _.and
              (_.by_proof [/.delimiter_for_module]
                          [!.delimiter_for_module])
              (_.by_proof [/.delimiter_for_name]
                          [!.delimiter_for_name])
              )))
