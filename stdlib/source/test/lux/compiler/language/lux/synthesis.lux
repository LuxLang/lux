(.using
 [library
  [lux (.except)
   [abstract
    [["<>"] projection]
    [[0] monad]
    [[0] equality
     [[1 "T"] \\test]]
    [[0] hash
     [[1 "T"] \\test]]]
   [error
    [[0] try]
    [[0] exception]]
   [data
    [[0] maybe (.open functor)]
    [[0] pair]
    [[0] text]
    [collection
     [[0] list (.open functor)
      [["?" 1] \\projection]]
     [[0] dictionary]]]
   [logic
    [[0] bit]]
   [math
    [[0] random (.only Random)]
    [number
     [[0] /64 (.only)
      [["n"] natural]
      [[0] real]]]]
   [macro
    [["^"] pattern]
    [[0] template]
    [[0] expansion]]
   [meta
    [[0] static]
    [[0] name (.only)
     [[1 "T"] \\test]]
    [[0] provenance (.only)
     [[1 "T"] \\test]]]
   [compiler
    [["@" 0] type (.only Environment Variable)]
    [language
     [lux
      [[0] phase (.only)
       [[0] extension]]]]]
   [test
    [["_"] property (.only Test)]]
   [type
    [[0] check]]
   [aspect
    [[0] view]]]]
 [\\library
  [[0] / (.only)
   [[0] path]
   [[0] access (.only)
    [[0] side]
    [[0] member]]]]
 [[0] \\projection]
 [[0] /
  [[1 0] simple]
  [[1 0] access]
  [[1 0] path]])

(the random_constant
     (Random Name)
     (random.and (random.lower_cased 1)
                 (random.upper_cased 1)))

(the random_variable
     (Random Variable)
     (random.or random.natural
                random.natural))

(the random_environment
     (Random (Environment /.Term))
     (monad.let [! random.monad]
                [size (by ! each (n.% 5) random.natural)]
                (|> ..random_variable
                    (by ! each (|>> {/.:Variable provenance.dummy}))
                    (random.list size))))

(the \\projection
     Test
     (<| (_.covering \\projection._)
         (_.for [\\projection.Projection])
         (`` (all _.and
                  (,, (template.with [<query> <check> <random> <synthesis> <equality>]
                                     [(monad.let [! random.monad]
                                                 [expected <random>
                                                  dummy (|> <random> (random.only (|>> (by <equality> = expected) not)))]
                                                 (all _.and
                                                      (_.coverage [<query>]
                                                                  (|> <query>
                                                                      (?list.value (list (<synthesis> provenance.dummy expected)))
                                                                      (match? (^.multi {try.:Success actual}
                                                                                       (by <equality> = expected actual)))))
                                                      (_.coverage [<check>]
                                                                  (and (|> (<check> expected)
                                                                           (?list.value (list (<synthesis> provenance.dummy expected)))
                                                                           (match? {try.:Success _}))
                                                                       (|> (<check> expected)
                                                                           (?list.value (list (<synthesis> provenance.dummy dummy)))
                                                                           (match? {try.:Failure error}))))
                                                      ))]

                                     [[\\projection.i64 \\projection.this_i64 random.i64 /.i64 /64.equality]
                                      [\\projection.f64 \\projection.this_f64 random.unit_real /.f64 real.equality]
                                      [\\projection.text \\projection.this_text (random.unicode 1) /.text text.equality]
                                      [\\projection.local \\projection.this_local random.natural /.local n.equality]
                                      [\\projection.foreign \\projection.this_foreign random.natural /.foreign n.equality]]))

                  (monad.let [! random.monad]
                             [[expected_module expected_proper] ..random_constant
                              [dummy_module dummy_proper] (|> ..random_constant
                                                              (random.only (|>> (by name.equality = [expected_module expected_proper])
                                                                                not)))]
                             (all _.and
                                  (_.coverage [\\projection.constant]
                                              (|> \\projection.constant
                                                  (?list.value (list (/.constant provenance.dummy expected_module expected_proper)))
                                                  (match? (^.multi {try.:Success actual}
                                                                   (by name.equality = [expected_module expected_proper] actual)))))
                                  (_.coverage [\\projection.this_constant]
                                              (and (|> (\\projection.this_constant [expected_module expected_proper])
                                                       (?list.value (list (/.constant provenance.dummy expected_module expected_proper)))
                                                       (match? {try.:Success _}))
                                                   (|> (\\projection.this_constant [expected_module expected_proper])
                                                       (?list.value (list (/.constant provenance.dummy dummy_module dummy_proper)))
                                                       (match? {try.:Failure error}))))
                                  ))
                  (monad.let [! random.monad]
                             [arity random.natural
                              expected_environment ..random_environment
                              expected_body (random.unicode 1)]
                             (_.coverage [\\projection.function]
                                         (and (|> (\\projection.function arity \\projection.text)
                                                  (?list.value (list (/.abstraction provenance.dummy
                                                                                    [/.:environment expected_environment
                                                                                     /.:arity arity
                                                                                     /.:body (/.text provenance.dummy expected_body)])))
                                                  (match? (^.multi {try.:Success [actual_environment actual_body]}
                                                                   (and (by (list.equality /.equality) =
                                                                            expected_environment
                                                                            actual_environment)
                                                                        (by text.equality = expected_body actual_body)))))
                                              (|> (\\projection.function arity \\projection.text)
                                                  (?list.value (list (/.text provenance.dummy expected_body)))
                                                  (match? {try.:Failure error})))))
                  ))))

(the simple
     Test
     (<| (monad.let [! random.monad]
                    [expected_provenance provenanceT.random
                     
                     expected_bit random.bit
                     expected_i64 random.i64
                     expected_f64 random.safe_real
                     expected_text (random.lower_cased 1)])
         (_.for [/.:Simple])
         (`` (all _.and
                  (,, (template.with [,tag ,expected]
                                     [(_.coverage [,tag]
                                                  (when (,tag expected_provenance ,expected)
                                                        (,tag actual_provenance actual)
                                                        (and (identical? expected_provenance actual_provenance)
                                                             (identical? ,expected actual))

                                                        else
                                                        false))]

                                     [[/.i64 expected_i64]
                                      [/.f64 expected_f64]
                                      [/.text expected_text]]
                                     ))))))

(the reference
     Test
     (<| (monad.let [! random.monad]
                    [expected_provenance provenanceT.random
                     
                     expected_register random.natural
                     [expected_module expected_proper] (nameT.random 1 2)])
         (`` (all _.and
                  (,, (template.with [,tag ,expected]
                                     [(_.coverage [,tag]
                                                  (when (,tag expected_provenance ,expected)
                                                        (,tag actual_provenance actual)
                                                        (and (identical? expected_provenance actual_provenance)
                                                             (identical? ,expected actual))

                                                        else
                                                        false))]

                                     [[/.local expected_register]
                                      [/.foreign expected_register]]))
                  (_.coverage [/.constant]
                              (when (/.constant expected_provenance expected_module expected_proper)
                                    (/.constant actual_provenance actual_module actual_proper)
                                    (and (identical? expected_provenance actual_provenance)
                                         (identical? expected_module actual_module)
                                         (identical? expected_proper actual_proper))

                                    else
                                    false))))))

(the test_of_state
     Test
     (<| (monad.let [! random.monad]
                    [expected_locals random.natural
                     expected_currying? random.bit])
         (_.for [/.State
                 /.:locals /.:currying?])
         (all _.and
              (_.coverage [/.init]
                          (and (n.= 0 (its /.:locals /.init))
                               (bit.= false (its /.:currying? /.init))))
              (_.coverage [/.with_currying? /.currying?]
                          (with (try.equality bit.equality)
                                (|> (/.with_currying? expected_currying?
                                                      /.currying?)
                                    (phase.value /.init)
                                    (= {try.:Success expected_currying?}))))
              (_.coverage [/.with_locals /.locals]
                          (with (try.equality n.equality)
                                (|> (/.with_locals expected_locals
                                                   /.locals)
                                    (phase.value /.init)
                                    (= {try.:Success expected_locals}))))
              (_.coverage [/.with_new_local]
                          (with (try.equality n.equality)
                                (|> (/.with_locals expected_locals
                                                   (/.with_new_local
                                                    /.locals))
                                    (phase.value /.init)
                                    (= {try.:Success (++ expected_locals)}))))
              )))

(the .public test
     Test
     (<| (_.covering /._)
         (monad.let [! random.monad]
                    [left /.random
                     right /.random])
         (_.for [/.Term
                 /.random])
         (`` (all _.and
                  ..\\projection

                  (_.for [/.equality /.=]
                         (static.when (identical? /.equality /.=)
                                      (equalityT.spec /.equality /.random)))
                  (_.for [/.hash]
                         (hashT.spec /.hash /.random))

                  (_.coverage [/.as_text]
                              (bit.= (text.= (/.as_text left) (/.as_text right))
                                     (by /.equality = left right)))
                  
                  ..simple
                  ..reference
                  
                  ..test_of_state
                  
                  (,, (template.with [,synthesis ,phase]
                                     [(_.coverage [,synthesis]
                                                  (check.< ,synthesis ,phase))]

                                     [[/.Operation phase.Operation]
                                      [/.Phase phase.Phase]]))
                  (<| (_.for [/.:Extension])
                      (all _.and
                           (,, (template.with [,synthesis ,phase]
                                              [(_.coverage [,synthesis]
                                                           (check.< ,synthesis ,phase))]

                                              [[/.Handler extension.Handler]
                                               [/.Bundle extension.Bundle]
                                               [/.Extender extension.Extender]]))
                           ))
                  (_.coverage [/.unit]
                              (identical? text.empty /.unit))
                  (<| (_.for [/.Resolver])
                      (_.coverage [/.fresh_resolver]
                                  (dictionary.empty? /.fresh_resolver)))

                  /simple.test
                  /access.test
                  /path.test
                  ))))
