(.using
 [library
  [lux (.except)
   [test
    ["_" property]]
   [compiler
    ["@[0]" type]]]]
 [\\library
  ["[0]" /]]
 ["!" \\theorem])

(the .public test
     _.Test
     (<| (_.covering /._)
         (_.for [@type.Register])
         (all _.and
              (_.by_proof [/.abstraction]
                          [!.abstraction])
              (_.by_proof [/.argument]
                          [!.argument])
              )))
