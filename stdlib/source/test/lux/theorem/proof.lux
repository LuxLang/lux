(.using
 [library
  [lux (.except)
   [test
    [["_"] property]]]]
 [\\library
  [[0] /]]
 [[0] /
  [[1 0] contradiction]
  [[1 0] induction]
  [[1 0] inference]])

(the .public test
     _.Test
     (<| (_.covering /._)
         (all _.and
              (_.coverage [/.=]
                          false)

              /contradiction.test
              /induction.test
              /inference.test
              )))
