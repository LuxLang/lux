(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]]
   [math
    [[0] random]]
   [test
    [["_"] property]]]]
 [["/"] \\library])

(the .public test
     _.Test
     (<| (_.covering /._)
         (monad.let [! random.monad]
                    [])
         (all _.and
              (_.coverage [/.Environment]
                          false)
              )))
