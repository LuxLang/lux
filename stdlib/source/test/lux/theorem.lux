(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]]
   [math
    [[0] random]]
   [test
    [["_"] property (.only Test)]]
   [error
    [[0] try]]]]
 [\\library
  [[0] / (.only)
   [["?"] proposition]]]
 [[0] /
  [[1 0] proposition]
  [[1 0] substitution]
  [[1 0] rule]
  [[1 0] proof]
  [[1 0] axiom]
  [[1 0] hypothesis]
  [[1 0] term]
  [[1 0] context]
  [[1 0] state]])

(the .public test
     Test
     (<| (_.covering /._)
         (monad.let [! random.monad]
                    [])
         (all _.and
              (_.coverage [/.the]
                          false)

              /proposition.test
              /substitution.test
              /rule.test
              /proof.test
              /axiom.test
              /hypothesis.test
              /term.test
              /context.test
              /state.test
              )))
