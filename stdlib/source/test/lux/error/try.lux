(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad (.only)
     [[1 "T"] \\test]]
    [[0] functor
     [[1 "T"] \\test (.only Injection Comparison)]]
    [[0] equality
     [[1 "T"] \\test]]]
   [control
    [["|"] pipe]
    [[0] io]]
   [math
    [[0] random (.only Random)]
    [number
     [/64
      [["n"] natural]
      [["i"] integer]]]]
   [meta
    [[0] static]]
   [test
    [["_"] property (.only Test)]]]]
 [\\library
  [[0] /]]
 [["!"] \\theorem])

(the injection
     (Injection /.Try)
     (|>> {/.:Success}))

(the comparison
     (Comparison /.Try)
     (function (_ ==)
               (by (/.equality ==) =)))

(the .public (attempt element)
     (for_any (_ a)
              (-> (Random a)
                  (Random (/.Try a))))
     (all random.or
          (random.unicode 1)
          element))

(the .public test
     Test
     (<| (_.covering /._)
         (_.for [/.Try
                 /.:Failure /.:Success])
         (monad.let [! random.monad]
                    [expected random.natural
                     alternative (|> random.natural (random.only (|>> (n.= expected) not)))
                     error (random.unicode 1)])
         (with ["io:" 0] io.monad)
         (all _.and
              (_.for [/.equality]
                     (equalityT.spec (/.equality n.equality) (..attempt random.natural)))
              (_.for [/.monad]
                     (monadT.spec ..injection ..comparison /.monad))

              (_.by_proof [/.functor]
                          [!.functor])

              (_.coverage [/.trusted]
                          (n.= expected
                               (/.trusted {/.:Success expected})))
              (_.by_proof [/.as_maybe]
                          [!.as_maybe|:Failure
                           !.as_maybe|:Success])
              (_.by_proof [/.of_maybe]
                          [!.of_maybe|:None
                           !.of_maybe|:Some])
              (_.by_proof [/.else]
                          [!.else|:Failure
                           !.else|:Success])
              (_.by_proof [/.whether]
                          [!.whether|false
                           !.whether|true])
              (_.coverage [/.With /.with /.lifted]
                          (let [lifted (/.lifted io.monad)]
                               (|> (monad.let (/.with io.monad)
                                              [a (lifted (io:pure expected))
                                               b (pure alternative)]
                                              (pure (n.+ a b)))
                                   io.value
                                   (|.when
                                    {/.:Success it}
                                    (n.= (n.+ expected alternative)
                                         it)

                                    _
                                    false))))
              (_.by_proof [/.and/or]
                          [!.and/or|:Failure
                           !.and/or|:Success])
              (_.by_proof [/.as]
                          [!.idempotency_of_as
                           !.as|:Failure
                           !.as|:Success])
              (_.coverage [/.is?]
                          (let [wrong_error (by n.base_10 as (static.random_natural))
                                expected_error (by i.base_10 as (static.random_integer))]
                               (and (|> {/.:Failure wrong_error}
                                        (/.as expected_error)
                                        (/.is? expected_error))
                                    (|> {/.:Failure wrong_error}
                                        (/.is? expected_error)
                                        not))))
              (_.by_proof [/.as_either]
                          [!.as_either|:Failure
                           !.as_either|:Success])
              (_.by_proof [/.of_either]
                          [!.of_either|:Left
                           !.of_either|:Right])
              (_.by_proof [/.if]
                          [!.if|:Failure
                           !.if|:Success])
              )))
