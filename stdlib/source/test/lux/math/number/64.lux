(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]
    [[0] equality
     [[1 "T"] \\test]]
    [[0] hash
     [[1 "T"] \\test]]
    [[0] monoid
     [[1 "T"] \\test]]]
   [error
    [[0] try]]
   [logic
    [[0] bit]]
   [math
    [[0] random (.only Random)]]
   [meta
    [[0] static]]
   [macro
    [[0] template]]
   [test
    [["_"] property]]]]
 [["/"] \\library (.only)
  [["number"] // (.only)
   [/64
    [["n"] natural]
    [["i"] integer]]]]
 [["!"] \\theorem]
 [[0] /
  [[1 0] natural]
  [[1 0] integer]
  [[1 0] revolution]
  [[1 0] real]
  [[1 0] fraction]
  [[1 0] complex]
  [[1 0] rational]])

(the bit
     _.Test
     (<| (monad.let [! random.monad]
                    [pattern random.natural
                     idx (by ! each (n.% /.width) random.natural)])
         (_.for [/.Address])
         (all _.and
              (_.coverage [/.one? /.one]
                          (if (/.one? idx pattern)
                              (/.= pattern (/.one idx pattern))
                              (not (/.= pattern (/.one idx pattern)))))
              (_.coverage [/.zero? /.zero]
                          (if (/.zero? idx pattern)
                              (/.= pattern (/.zero idx pattern))
                              (not (/.= pattern (/.zero idx pattern)))))
              (_.coverage [/.flipped]
                          (/.= (/.flipped idx pattern)
                               (if (/.one? idx pattern)
                                   (/.zero idx pattern)
                                   (/.one idx pattern))))
              (_.coverage [/.bit]
                          (bit.= (/.zero? idx pattern)
                                 (/.= /.false (/.and (/.bit idx) pattern))))
              )))

(the shift
     _.Test
     (<| (monad.let [! random.monad]
                    [pattern random.natural])
         (_.for [/.Shift])
         (all _.and
              (_.coverage [/.shift /.opposite]
                          (n.= /.width
                               (n.+ (/.shift pattern)
                                    (/.opposite pattern))))
              (monad.let !
                         [idx (by ! each (|>> (n.% (-- /.width)) ++) random.natural)]
                         (_.coverage [/.<< /.>>]
                                     (let [nullity!
                                           (and (/.= pattern (/.<< 0 pattern))
                                                (/.= pattern (/.>> 0 pattern)))

                                           idempotency!
                                           (and (/.= pattern (/.<< /.width pattern))
                                                (/.= pattern (/.>> /.width pattern)))

                                           movement!
                                           (let [shift (n.- idx /.width)]
                                                (/.= (/.and (/.mask idx) pattern)
                                                     (|> pattern
                                                         (/.<< shift)
                                                         (/.>> shift))))]
                                          (and nullity!
                                               idempotency!
                                               movement!))))
              )))

(the mask
     _.Test
     (<| (_.for [/.Mask])
         (monad.let [! random.monad]
                    [pattern random.natural
                     idx (by ! each (n.% /.width) random.natural)
                     signed random.integer]
                    (all _.and
                         (_.coverage [/.sign]
                                     (bit.= (/.= (.i64 0) (/.and /.sign signed))
                                            (i.positive? signed)))
                         (_.coverage [/.mask]
                                     (let [mask (/.mask idx)
                                           idempotency! (/.= (/.and mask pattern)
                                                             (/.and mask (/.and mask pattern)))

                                           limit (++ (.natural mask))
                                           limit! (if (n.< limit pattern)
                                                      (/.= pattern (/.and mask pattern))
                                                      (n.< limit (/.and mask pattern)))

                                           empty! (/.= /.false (/.mask 0))
                                           full! (/.= /.true (/.mask /.width))]
                                          (and idempotency!
                                               limit!

                                               empty!
                                               full!)))
                         (monad.let !
                                    [size (by ! each (n.% /.width) random.natural)
                                     .let [spare (n.- size /.width)]
                                     offset (by ! each (n.% spare) random.natural)]
                                    (_.coverage [/.region]
                                                (when size
                                                      0 (/.= /.false (/.region offset size))
                                                      _ (/.= (|> pattern
                                                                 (comment "NNNNYYYYNNNN")
                                                                 (/.>> offset)
                                                                 (comment "____NNNNYYYY")
                                                                 (/.<< spare)
                                                                 (comment "YYYY________")
                                                                 (/.>> spare)
                                                                 (comment "________YYYY")
                                                                 (/.<< offset)
                                                                 (comment "____YYYY____"))
                                                             (/.and (/.region offset size) pattern)))))
                         ))))

(the signature
     _.Test
     (all _.and
          (_.for [/.equality /.=]
                 (static.when (identical? /.equality /.=)
                              (equalityT.spec /.equality random.i64)))
          (_.for [/.hash]
                 (hashT.spec /.hash random.i64))
          (_.for [/.disjunction]
                 (monoidT.spec n.equality /.disjunction random.natural))
          (_.for [/.conjunction]
                 (monoidT.spec n.equality /.conjunction random.natural))
          ))

(the test_for_extension
     _.Test
     (all _.and
          (_.by_proof [.b64_=#]
                      [!.reflexivity_of_b64_=
                       !.symmetry_of_b64_=])
          (_.by_proof [.b64_or#]
                      [!.identity_of_b64_or
                       !.commutativity_of_b64_or
                       !.associativity_of_b64_or
                       !.non_idempotence_of_b64_or])
          (_.by_proof [.b64_and#]
                      [!.identity_of_b64_and
                       !.idempotence_of_b64_and
                       !.commutativity_of_b64_and
                       !.associativity_of_b64_and
                       !.annihilation_of_b64_and])
          (_.by_proof [.b64_and/or#]
                      [!.identity_of_b64_and/or
                       !.idempotence_of_b64_and/or
                       !.commutativity_of_b64_and/or
                       !.associativity_of_b64_and/or
                       !.annihilation_of_b64_and/or])
          (_.by_proof [.b64_<<#]
                      [!.<<_of_false
                       !.inverse_of_<<
                       !.<<_0
                       !.<<_2

                       !.distribution_of_<<_over_b64_or
                       !.distribution_of_<<_over_or

                       !.distribution_of_<<_over_b64_and
                       !.distribution_of_<<_over_and

                       !.distribution_of_<<_over_b64_and/or
                       !.distribution_of_<<_over_and/or])
          (_.by_proof [.b64_>>#]
                      [!.>>_of_false
                       !.inverse_of_>>
                       !.>>_0
                       !.>>_2

                       !.distribution_of_>>_over_b64_or
                       !.distribution_of_>>_over_or

                       !.distribution_of_>>_over_b64_and
                       !.distribution_of_>>_over_and

                       !.distribution_of_>>_over_b64_and/or
                       !.distribution_of_>>_over_and/or])
          ))

(the .public test
     _.Test
     (<| (_.covering /._)
         (_.for [.I64])
         (monad.let [! random.monad]
                    [pattern random.natural
                     idx (by ! each (n.% /.width) random.natural)

                     left random.natural
                     right random.natural

                     this random.i64
                     that random.i64
                     else random.i64]
                    (all _.and
                         (_.coverage [/.Number]
                                     (identical? .I64 /.Number))

                         ..test_for_extension
                         
                         (_.coverage [/.width /.bits_per_byte /.bytes_per_i64]
                                     (and (n.= /.bytes_per_i64
                                               (n./ /.bits_per_byte /.width))
                                          (n.= /.bits_per_byte
                                               (n./ /.bytes_per_i64 /.width))))
                         (_.by_proof [/.false]
                                     [!.false])
                         (_.by_proof [/.true]
                                     [!.true])
                         (_.by_proof [/.and/or]
                                     [!.identity_of_and/or
                                      !.idempotence_of_and/or
                                      !.commutativity_of_and/or
                                      !.associativity_of_and/or
                                      !.annihilation_of_and/or])
                         (_.by_proof [/.and]
                                     [!.identity_of_and
                                      !.idempotence_of_and
                                      !.commutativity_of_and
                                      !.associativity_of_and
                                      !.annihilation_of_and])
                         (_.by_proof [/.not]
                                     [!.double_negation])
                         (_.by_proof [/.or]
                                     [!.identity_of_or
                                      !.commutativity_of_or
                                      !.associativity_of_or
                                      !.non_idempotence_of_or
                                      !.complementation_of_or])
                         (_.coverage [/.ones]
                                     (let [zero&one!
                                           (if (/.one? idx pattern)
                                               (n.= (-- (/.ones pattern)) (/.ones (/.zero idx pattern)))
                                               (n.= (++ (/.ones pattern)) (/.ones (/.one idx pattern))))

                                           complementarity!
                                           (n.= /.width
                                                (n.+ (/.ones pattern)
                                                     (/.ones (/.not pattern))))]
                                          (and zero&one!
                                               complementarity!)))
                         (_.coverage [/.Rotation
                                      /.left_rotated /.right_rotated]
                                     (let [false!
                                           (and (/.= /.false (/.left_rotated idx /.false))
                                                (/.= /.false (/.right_rotated idx /.false)))

                                           true!
                                           (and (/.= /.true (/.left_rotated idx /.true))
                                                (/.= /.true (/.right_rotated idx /.true)))

                                           inverse!
                                           (and (|> pattern
                                                    (/.left_rotated idx)
                                                    (/.right_rotated idx)
                                                    (/.= pattern))
                                                (|> pattern
                                                    (/.right_rotated idx)
                                                    (/.left_rotated idx)
                                                    (/.= pattern)))

                                           nullity!
                                           (and (|> pattern
                                                    (/.left_rotated 0)
                                                    (/.= pattern))
                                                (|> pattern
                                                    (/.right_rotated 0)
                                                    (/.= pattern)))

                                           futility!
                                           (and (|> pattern
                                                    (/.left_rotated /.width)
                                                    (/.= pattern))
                                                (|> pattern
                                                    (/.right_rotated /.width)
                                                    (/.= pattern)))]
                                          (and false!
                                               true!
                                               inverse!
                                               nullity!
                                               futility!)))
                         (_.coverage [/.in_reverse]
                                     (and (|> pattern /.in_reverse /.in_reverse (/.= pattern))
                                          (and/or (|> pattern /.in_reverse (/.= pattern) not)
                                                  (let [high (/.and (number.base_16 "FFFFFFFF00000000")
                                                                    pattern)
                                                        low (/.and (number.base_16 "00000000FFFFFFFF")
                                                                   pattern)]
                                                       (/.= (/.in_reverse high)
                                                            low)))))
                         (_.coverage [/.decrement /.less /.previous /.before]
                                     (and (identical? .-- /.decrement)
                                          (identical? .-- /.less)
                                          (identical? .-- /.previous)
                                          (identical? .-- /.before)))
                         (_.coverage [/.increment /.more /.next /.after]
                                     (and (identical? .++ /.increment)
                                          (identical? .++ /.more)
                                          (identical? .++ /.next)
                                          (identical? .++ /.after)))
                         (_.coverage [/.highest_bit]
                                     (and (|> 0
                                              /.highest_bit
                                              (/.= /.width))
                                          (|> 1
                                              (/.<< idx)
                                              /.highest_bit
                                              (/.= idx))))
                         
                         ..bit
                         ..shift
                         ..mask
                         ..signature

                         /natural.test
                         /integer.test
                         /revolution.test
                         /real.test
                         /fraction.test
                         /complex.test
                         /rational.test
                         ))))
