(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]
    [[0] equality
     [[1 "T"] \\test]]
    [[0] format
     [[1 "T"] \\test]]]
   [data
    [collection
     [[0] dictionary]]]
   [math
    [[0] random (.only Random) (.open monad)]]
   [meta
    [[0] static]]
   [test
    [["_"] property (.only Test)]]]]
 [\\library
  [[0] /]])

(the .public (random size)
     (-> Natural
         (Random /.Query))
     (when size
           0 (random:pure /.empty)
           _ (monad.let random.monad
                        [key (random.upper_cased size)
                         value (random.lower_cased size)
                         query (random (-- size))]
                        (pure (dictionary.has key value query)))))

(the .public test
     Test
     (<| (_.covering /._)
         (monad.let [! random.monad]
                    [])
         (_.for [/.Query])
         (all _.and
              (_.for [/.equality /.=]
                     (static.when (identical? /.equality /.=)
                                  (equalityT.spec /.equality (..random 2))))
              (_.for [/.text]
                     (formatT.spec /.equality /.text (..random 3)))

              (_.coverage [/.empty]
                          (dictionary.empty? /.empty))
              )))
