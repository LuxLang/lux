(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad]]
   [control
    ["[0]" io]]
   [math
    ["[0]" random]]
   [macro
    ["[0]" template]]
   [test
    ["_" property (.only Test)]]]]
 [\\library
  ["[0]" /]]
 ["$[0]" /
  ["[1][0]" export]])

(/.the File
       ("static" SEPARATOR /.String))

(the .public test
     Test
     (monad.let [! random.monad]
                [boolean random.bit
                 integer random.integer
                 float random.real
                 string (random.lower_cased 1)]
                (<| (_.covering /._)
                    (`` (all _.and
                             (,, (template.with [<type> <sample>]
                                                [(_.coverage [<type>]
                                                             (exec
                                                              (is <type> <sample>)
                                                              true))]

                                                [[/.Boolean boolean]
                                                 [/.Integer integer]
                                                 [/.Float float]
                                                 [/.String string]]))
                             (_.for [/.Object]
                                    (all _.and
                                         (,, (template.with [<type>]
                                                            [(_.coverage [<type>]
                                                                         (exec
                                                                          (|> []
                                                                              (as (-> Any <type>))
                                                                              (is (for_some (_ a) (/.Object a))))
                                                                          true))]

                                                            [[/.Nil]
                                                             [/.Function]]))))
                             (_.coverage [/.the]
                                         (identical? (io.value (..File:SEPARATOR))
                                                     (io.value (..File:SEPARATOR))))
                             (_.coverage [/.nil?]
                                         (and (not (/.nil? boolean))
                                              (not (/.nil? integer))
                                              (not (/.nil? float))
                                              (not (/.nil? string))))
                             (_.coverage [/.nil]
                                         (/.nil? (/.nil [])))
                             
                             $/export.test
                             )))))
