(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]
    [functor
     [\\test (.only Injection Comparison)]]]
   [data
    [collection
     [[0] stack]]]
   [math
    [[0] random]
    [number
     [/64
      [["n"] natural]]]]
   [test
    [["_"] property]]
   [function
    [poly
     [["//"] type]]]]]
 [\\library
  [[0] / (.only Mix)]]
 [["!"] \\theorem])

(the .public test
     _.Test
     (monad.let random.monad
                [samples (random.stack 10 random.natural)
                 initial random.natural
                 left random.natural
                 right random.natural]
                (<| (_.covering /._)
                    (all _.and
                         (_.coverage [/.with_monoid]
                                     (n.= (stack.mix (by n.addition composite) samples (by n.addition identity))
                                          (/.with_monoid n.addition stack.mix samples)))
                         (_.by_proof [/.constant]
                                     [!.constant])
                         (_.by_proof [/.variable]
                                     [!.variable])
                         (_.by_proof [/.case]
                                     [!.case_of_left
                                      !.case_of_right])
                         (_.by_proof [/.pair]
                                     [!.pair])
                         (_.by_proof [/.recursion]
                                     [!.recursion])
                         ))))

(the .public (spec injection comparison it)
     (for_any (_ !)
              (-> (Injection !) (Comparison !) (/.Mix !)
                  _.Test))
     (<| (monad.let random.monad
                    [subject random.natural
                     parameter random.natural])
         (_.coverage [/.Mix]
                     (n.= (it n.+ (injection subject) parameter)
                          (n.+ parameter subject)))))
