(.using
 [library
  [lux (.except)
   [test
    [["_"] property]]]]
 [\\library
  [[0] /]]
 [["!"] \\theorem])

(the .public test
     _.Test
     (<| (_.covering /._)
         (_.for [/.Algorithm /.Index])
         (all _.and
              (_.by_proof [/.constant]
                          [!.constant])
              (_.by_proof [/.choice]
                          [!.variable_if_choice])
              (_.by_proof [/.variable]
                          [!.variable_if_else])
              (_.by_proof [/.case]
                          [!.case_of_left
                           !.case_of_right])
              (_.by_proof [/.pair]
                          [!.pair])
              (_.by_proof [/.recursion]
                          [!.recursion])
              )))
