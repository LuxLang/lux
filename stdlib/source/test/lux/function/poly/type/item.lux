(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad]]
   [error
    ["[0]" try]]
   [data
    [collection
     ["[0]" stack]
     ["[0]" list]]]
   [math
    ["[0]" random (.only Random)]
    [number
     [/64
      ["n" natural]]]]
   [test
    ["_" property (.only Test)]]]]
 [\\library
  ["[0]" / (.only)
   ["/[1]" //]]])

(the item
     (/.Algorithm Stack)
     (is (/.Algorithm (//.Recursive
                       (for_any (_ recursion)
                                (//.Case (//.Constant [])
                                         (//.Pair //.Variable recursion)))))
         (/.recursive
          (function (_ it)
                    (/.case /.constant
                            (/.pair /.variable
                                    it))))))

(the .public test
     Test
     (monad.let [! random.monad]
                [arity (by ! each (n.% 10) random.natural)
                 items (random.stack arity random.natural)]
                (<| (_.covering /._)
                    (_.for [/.Algorithm])
                    (all _.and
                         (_.coverage [/.constant /.variable /.recursive
                                      /.case /.pair]
                                     (let [= (try.equality n.equality)]
                                          (list.every? (function (_ index)
                                                                 (= (stack.item index items)
                                                                    (..item index items)))
                                                       (list.domain arity))))
                         ))))
