(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad]]
   [data
    [collection
     ["[0]" stack]]]
   [logic
    ["[0]" bit]]
   [math
    ["[0]" random (.only Random)]
    [number
     [/64
      ["n" natural]]]]
   [macro
    ["[0]" template]]
   [test
    ["_" property (.only Test)]]]]
 [\\library
  ["[0]" / (.only)
   ["/[1]" //]]])

(the every?
     (/.Algorithm Stack)
     (is (/.Algorithm (//.Recursive
                       (for_any (_ recursion)
                                (//.Case (//.Constant [])
                                         (//.Pair //.Variable recursion)))))
         (/.recursive
          (function (_ it)
                    (/.case /.constant
                            (/.pair /.variable
                                    it))))))

(the .public test
     Test
     (monad.let [! random.monad]
                [.let [natural (is (Random Natural)
                                   (by ! each (n.% 1,000,000) random.natural))
                       even (is (Random Natural)
                                (by ! each (n.x 2) natural))
                       odd (is (Random Natural)
                               (by ! each (n.+ 1) even))]
                 even_0 even
                 even_1 even
                 odd_0 odd]
                (<| (_.covering /._)
                    (_.for [/.Algorithm])
                    (all _.and
                         (_.coverage [/.constant /.variable /.recursive
                                      /.case /.pair]
                                     (`` (and (,, (template.with [,stack]
                                                                 [(let [it (is (Stack Natural)
                                                                               ,stack)]
                                                                       (bit.= (stack.every? n.odd? it)
                                                                              (..every? n.odd? it)))]

                                                                 [[(stack even_0 even_1 odd_0)]
                                                                  [(stack even_0 odd_0 even_1)]
                                                                  [(stack odd_0 even_0 even_1)]
                                                                  [(stack even_0 even_1 even_0)]])))))
                         ))))
