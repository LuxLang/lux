(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad (.only)
     ["[1]T" \\test]]
    ["[0]" functor
     ["[1]T" \\test (.only Injection Comparison)]]]
   [data
    [text
     ["%" \\injection]]]
   [math
    ["[0]" random]
    [number
     [/64
      ["n" natural]]]]
   [test
    ["_" property (.only Test)]]]]
 [\\library
  ["[0]" /]]
 ["[0]" /
  ["[1][0]" delimited]]
 ["!" \\theorem])

(the injection
     (for_any (_ o)
              (Injection (for_any (_ i)
                                  (/.Continuation i o))))
     (by /.monad pure))

(the comparison
     (Comparison /.Continuation)
     (function (_ == left right)
               (== (/.value left) (/.value right))))

(the .public test
     Test
     (<| (_.covering /._)
         (all _.and
              (_.for [/.Context]
                     (_.by_proof [/.empty]
                                 [!.empty]))
              (_.for [/.Continuation]
                     (all _.and
                          (_.by_proof [/.functor]
                                      [!.functor])
                          (_.for [/.monad]
                                 (monadT.spec ..injection ..comparison /.monad))

                          (_.by_proof [/.continued]
                                      [!.continued])
                          (_.by_proof [/.value]
                                      [!.value])
                          (_.by_proof [/.pending]
                                      [!.pending])
                          (monad.let random.monad
                                     [sample random.natural]
                                     (_.coverage [/.with_current /.call/cc]
                                                 (and (n.= (n.x 2 sample)
                                                           (/.value (monad.let [! /.monad]
                                                                               [value (<| /.with_current (function (_ k))
                                                                                          (monad.let !
                                                                                                     [temp (k sample)])
                                                                                          (comment "If this code where to run,"
                                                                                                   "the output would be"
                                                                                                   (n.x 4 sample)

                                                                                                   (k temp)))]
                                                                               (pure (n.x 2 value)))))
                                                      (identical? /.with_current /.call/cc))))))
              /delimited.test)))
