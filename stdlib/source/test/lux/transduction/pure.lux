(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad]]
   [data
    [collection
     ["[0]" list (.open monad)]
     ["[0]" dictionary]
     ["[0]" set]]]
   [concurrency
    ["[0]" future (.only Future)]]
   [math
    ["[0]" random (.only Random)]
    [number
     [/64
      ["n" natural]]]]
   [test
    ["_" property (.only Test)]
    ["[0]" unit]]]]
 [\\library
  ["[0]" /]])

(the .public test
     Test
     (<| (_.covering /._)
         (monad.let [! random.monad]
                    [.let [bundle (is (Random (List Natural))
                                      (|> random.natural
                                          (random.set n.hash 5)
                                          (by ! each set.as_list)))]
                     operands bundle
                     replacements bundle
                     bundles (|> bundle
                                 (random.set (list.hash n.hash) 5)
                                 (by ! each set.as_list))

                     expected_size (by ! each (n.% 100) random.natural)
                     parallelism (by ! each (n.% (++ expected_size)) random.natural)])
         (_.for [/.Transduction])
         (all _.and
              (_.coverage [/.in_series /.nothing]
                          (n.= (list.mix n.+ operands 0)
                               (/.in_series n.+ 0 /.nothing list.mix operands)))
              (_.coverage [/.each]
                          (n.= (list.mix n.+ (list:each ++ operands) 0)
                               (/.in_series n.+ 0 (/.each ++) list.mix operands)))
              (_.coverage [/.only]
                          (n.= (list.mix n.+ (list.only n.even? operands) 0)
                               (/.in_series n.+ 0 (/.only n.even?) list.mix operands)))
              (_.coverage [/.many]
                          (n.= (list.mix n.+ (list:conjoint bundles) 0)
                               (/.in_series n.+ 0 (/.many list.mix) list.mix bundles)))
              (_.coverage [/.and /.maybe]
                          (n.= (list.mix n.+ (list.only n.even? operands) 0)
                               (/.in_series n.+ 0
                                            (all /.and
                                                 (/.each (function (_ it)
                                                                   (if (n.even? it)
                                                                       {.:Some it}
                                                                       {.:None})))
                                                 /.maybe)
                                            list.mix operands)))
              (_.coverage [/.replaced]
                          (n.= (list.mix n.+ replacements 0)
                               (/.in_series n.+ 0
                                            (/.replaced (|> (list.zipped_2 operands replacements)
                                                            (dictionary.of_list n.hash)))
                                            list.mix operands)))
              (<| (_.for [/.Parallelism])
                  (all _.and
                       (_.coverage [/.none]
                                   (n.= 0 /.none))
                       (_.coverage [/.suggestion]
                                   (n.> /.none /.suggestion))
                       (pure (with n.addition
                                   (let [it (list.domain expected_size)
                                         expected (/.in_series composite identity /.nothing list.mix it)]
                                        (monad.let future.monad
                                                   [actual (/.in_parallel parallelism n.addition /.nothing it)]
                                                   (unit.coverage [/.in_parallel]
                                                                  (n.= expected actual))))))
                       ))
              )))
