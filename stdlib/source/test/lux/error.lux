(.using
 [library
  [lux (.except)
   [macro
    ["[0]" template]]
   [test
    ["_" property]]]]
 [\\library
  ["[0]" /]]
 ["!" \\theorem]
 ["[0]" /
  ["[1][0]" exception]
  ["[1][0]" try]
  ["[1][0]" condition]])

(the .public test
     _.Test
     (<| (_.covering /._)
         (_.for [.Error])
         (all _.and
              (<| (_.for [/.the])
                  (`` (all _.and
                           (,, (template.with [,name]
                                              [(`` (_.by_proof [,name]
                                                               [(,, (template.name [!._] [,name]))]))]
                                              
                                              [[/.not_valid]
                                               [/.not_known]
                                               [/.empty]
                                               [/.no_instance]
                                               [/.not_available]
                                               ]))
                           )))

              /exception.test
              /try.test
              /condition.test
              )))
