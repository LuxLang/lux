(.using
 [library
  [lux (.except)
   [abstract
    [[0] functor]]
   [function
    [poly
     [[0] type]]]
   [test
    [["_"] property]]]]
 [\\library
  [[0] /]]
 [["!"] \\theorem])

(the .public test
     _.Test
     (<| (_.covering /._)
         (_.for [/.Effect])
         (all _.and
              (_.by_proof [/.functor]
                          [!.functor])
              (_.coverage [/.Or /.or]
                          (and (identical? type.Case /.Or)
                               (identical? functor.case /.or)))
              )))
