(.using
 [library
  [lux (.except)
   [abstract
    [equality (.only Equality)]
    ["[0]" monad]]
   [control
    ["[0]" writer]
    ["[0]" scope]
    ["[0]" state]
    ["[0]" pure]]
   ["[0]" function (.only)
    [poly
     ["//" type]]]
   [data
    ["[0]" maybe]
    [collection
     ["[0]" stack]]]
   [math
    ["[0]" random]
    [number
     [/64
      ["n" natural]]]]
   [test
    ["_" property (.only Test)]]]]
 ["[0]" \\polytypic]
 ["!" \\theorem]
 [\\library
  ["[0]" / (.only Functor)
   ["[0]" pro]]]
 ["[0]" /
  ["[1][0]" contravariant]
  ["[1][0]" effect]])

(the (either left right)
     (for_any (_ it)
              (-> it it
                  it))
     right)

(the pure_functor
     (<| (is (Functor pure.Pure))
         (is (Functor //.Variable))
         (all either
              pure.functor
              (\\polytypic.functor pure.Pure)
              /.variable
              )))

(the maybe_functor
     (<| (is (Functor .Maybe))
         (is (Functor (//.Case (//.Constant Any) //.Variable)))
         (all either
              maybe.functor
              (\\polytypic.functor .Maybe)
              (/.case /.constant
                      /.variable)
              )))

(the writer_functor
     (<| (is (Functor (writer.Writer Text)))
         (is (Functor (//.Pair (//.Constant Text) //.Variable)))
         (all either
              writer.functor
              (\\polytypic.functor writer.Writer)
              (/.pair /.constant
                      /.variable)
              )))

(the scope_functor
     (<| (is (for_any (_ scope)
                      (Functor (scope.Scope scope))))
         (is (for_any (_ scope)
                      (Functor (/.Function scope //.Variable))))
         (all either
              scope.functor
              (\\polytypic.functor scope.Scope)
              (/.function /.variable)
              )))

(the state_functor
     (for_any (_ state)
              (Functor (state.State state)))
     (is (for_any (_ state)
                  (Functor (/.Function state (//.Pair (//.Constant state) //.Variable))))
         (all either
              state.functor
              (\\polytypic.functor state.State)
              (/.function (/.pair /.constant
                                  /.variable))
              )))

(the stack_functor
     (Functor .Stack)
     (is (Functor (//.Recursive (for_any (_ self)
                                         (//.Case (//.Constant Any)
                                                  (//.Pair //.Variable self)))))
         (all either
              stack.functor
              (\\polytypic.functor .Stack)
              (/.recursion
               (function (_ it)
                         (/.case /.constant
                                 (/.pair /.variable it))))
              )))

(the \\polytypic
     Test
     (<| (_.covering \\polytypic._)
         (_.coverage [\\polytypic.functor]
                     true)))

(the .public test
     Test
     (<| (_.covering /._)
         (all _.and
              (_.by_proof [/.constant]
                          [!.constant])
              (_.by_proof [/.variable]
                          [!.variable])
              (_.by_proof [/.case]
                          [!.case])
              (_.by_proof [/.pair]
                          [!.pair])
              (_.for [/.Function]
                     (_.by_proof [/.function]
                                 [!.function]))
              (_.for [/.Then]
                     (_.by_proof [/.composite]
                                 [!.composite]))
              (monad.let random.monad
                         [left random.natural
                          right random.natural
                          shift random.natural]
                         (_.coverage [/.recursion]
                                     (with (stack.equality n.equality)
                                           (= (with stack.functor
                                                    (each (n.+ shift) (stack left right)))
                                              (with (is (Functor (//.Recursive (for_any (_ self)
                                                                                        (//.Case (//.Constant Any)
                                                                                                 (//.Pair //.Variable self)))))
                                                        (/.recursion
                                                         (|>> (/.pair /.variable)
                                                              (/.case /.constant))))
                                                    (each (n.+ shift) (stack left right)))))))

              ..\\polytypic
              /contravariant.test
              /effect.test

              (<| (_.covering pro._)
                  (_.test "Placeholder"
                          false))
              )))

(every .public (Injection !)
       (for_any (_ it)
                (-> it
                    (! it))))

(every .public (Comparison !)
       (for_any (_ it)
                (-> (Equality it)
                    (Equality (! it)))))

(the .public (spec injection comparison functor)
     (for_any (_ !)
              (-> (Injection !) (Comparison !) (Functor !)
                  Test))
     (<| (monad.let [! random.monad]
                    [sample random.natural
                     increase (by ! each n.+ random.natural)
                     decrease (by ! each n.- random.natural)])
         (_.for [/.Functor])
         (_.coverage [/.each]
                     (<| (with "/:[0]" functor)
                         (let [identity!
                               ((comparison n.=)
                                (/:each function.identity (injection sample))
                                (injection sample))

                               homomorphism!
                               ((comparison n.=)
                                (/:each increase (injection sample))
                                (injection (increase sample)))

                               composition!
                               ((comparison n.=)
                                (|> (injection sample)
                                    (/:each increase)
                                    (/:each decrease))
                                (|> (injection sample)
                                    (/:each (|>> increase decrease))))]
                              (and identity!
                                   homomorphism!
                                   composition!
                                   ))))))
