(.using
 [library
  [lux (.except Variant Record)
   [abstract
    [[0] monad]
    [functor
     [[0] contravariant
      [[1 "T"] \\test]]]]
   [data
    [[0] any]
    [[0] text]
    [collection
     [[0] list]]]
   [logic
    [[0] bit]]
   [math
    [[0] random (.only Random)]
    [number
     [/64
      [["n"] natural]
      [["i"] integer]]]]
   [test
    [["_"] property (.only Test)]]
   [macro
    [[0] template]]]]
 [[0] \\polytypic]
 [["/"] \\library]
 [["!"] \\theorem])

(comment "https://en.wikipedia.org/wiki/Commutative_property"
         (template.the .public (commutativity ,+
                                              ,=
                                              ,0 ,1)
                       [(,= (,+ ,0 ,1)
                            (,+ ,1 ,0))]))

(comment "https://en.wikipedia.org/wiki/Reflexive_relation"
         (template.the .public (reflexivity ,=
                                            ,0)
                       [(,= ,0 ,0)]))

(comment "https://en.wikipedia.org/wiki/Transitive_relation"
         (template.the .public (transitivity ,=
                                             ,0 ,1 ,2)
                       [(bit.if (and (,= ,0 ,1)
                                     (,= ,1 ,2))
                                (,= ,0 ,2))]))

(comment "https://en.wikipedia.org/wiki/Equality_(mathematics)#Basic_properties"
         (template.the .public (= ,=
                                  ,random)
                       [(monad.let [! random.monad]
                                   [.let [random ,random]
                                    ,0 random
                                    ,1 random
                                    ,2 random]
                                   (_.coverage [,=]
                                               (and (..reflexivity ,=
                                                                   ,0)
                                                    (..commutativity ,=
                                                                     bit.=
                                                                     ,0 ,1)
                                                    (..transitivity ,=
                                                                    ,0 ,1 ,2))))]))

(template.the .public (specification ,implementation ,=
                                     ,random)
              [(all _.and
                    (..= ,=
                         ,random)
                    (<| (_.for [,implementation])
                        (_.coverage [/.Equality
                                     /.=]
                                    (identical? ,=
                                                (by ,implementation =)))))])

(the .public (spec equality random)
     (for_any (_ it)
              (-> (/.Equality it) (Random it)
                  Test))
     (<| (with ["/:" 0] equality)
         (_.for [/.Equality])
         (monad.let random.monad
                    [left random
                     right random])
         (_.coverage [/.=]
                     (let [reflexivity!
                           (/:= left left)

                           symmetry!
                           (bit.= (/:= left right)
                                  (/:= right left))]
                          (and reflexivity!
                               symmetry!
                               )))))

(every Variant
       (.Variant
        {:Case_0 Bit}
        {:Case_1 Integer}
        {:Case_2 Real}))

(every Recursive
       (Rec Recursive
            (.Variant
             {:Number Real}
             {:Addition Real Recursive})))

(every Record
       (.Record
        [:bit Bit
         :integer Integer
         :real Real
         :text Text
         :maybe (Maybe Integer)
         :list (List Integer)
         :variant Variant
         :tuple [Integer Real Text]
         :recursive Recursive]))

(the random_recursive
     (Random Recursive)
     (random.rec (function (_ random_recursive)
                           (random.or random.unit_real
                                      (random.and random.unit_real
                                                  random_recursive)))))

(the random
     (Random Record)
     (monad.let [! random.monad]
                [size (by ! each (n.% 2) random.natural)
                 .let [random_integer (is (Random Integer)
                                          (by ! each
                                              (|>> i.absolute
                                                   (i.% +1,000,000))
                                              random.integer))]]
                (all random.and
                     random.bit
                     random_integer
                     random.unit_real
                     (random.unicode size)
                     (random.maybe random_integer)
                     (random.list size random_integer)
                     (all random.or
                          random.bit
                          random_integer
                          random.unit_real)
                     (all random.and
                          random_integer
                          random.unit_real
                          (random.unicode size))
                     random_recursive
                     )))

(the equality
     (/.Equality ..Record)
     (\\polytypic.equality ..Record))

(the \\polytypic
     Test
     (<| (_.covering \\polytypic._)
         (_.for [\\polytypic.equality]
                (..spec ..equality ..random))))

(the .public test
     Test
     (monad.let random.monad
                [leftN random.natural
                 rightN random.natural
                 leftI random.integer
                 rightI random.integer
                 sample random.natural
                 different (|> random.natural (random.only (|>> (n.= sample) not)))
                 .let [equality (is (/.Equality (/.Equality Natural))
                                    (implementation
                                     (the (= left right)
                                          (and (bit.= (by left = leftN leftN)
                                                      (by right = leftN leftN))
                                               (bit.= (by left = rightN rightN)
                                                      (by right = rightN rightN))
                                               (bit.= (by left = leftN rightN)
                                                      (by right = leftN rightN))))))]]
                (<| (_.covering /._)
                    (all _.and
                         (_.for [/.functor]
                                (contravariantT.spec equality n.equality /.functor))

                         (_.coverage [/.class]
                                     (bit.= (by n.equality = leftN rightN)
                                            ((/.class n.equality leftN) rightN)))
                         (_.coverage [/.case]
                                     (let [both (/.case n.equality i.equality)]
                                          (and (bit.= (by both = {.:Left leftN} {.:Left rightN})
                                                      (by n.equality = leftN rightN))
                                               (bit.= (by both = {.:Right leftI} {.:Right rightI})
                                                      (by i.equality = leftI rightI)))))
                         (_.coverage [/.pair]
                                     (let [both (/.pair n.equality i.equality)]
                                          (bit.= (by both = [leftN leftI] [rightN rightI])
                                                 (and (by n.equality = leftN rightN)
                                                      (by i.equality = leftI rightI)))))
                         (_.coverage [/.recursive]
                                     (let [equality (is (/.Equality (Stack Natural))
                                                        (/.recursive
                                                         (|>> (/.pair n.equality)
                                                              (/.case any.equality))))]
                                          (and (by equality = (stack sample sample) (stack sample sample))
                                               (not (by equality = (stack sample sample) (stack sample)))
                                               (not (by equality = (stack sample sample) (stack different different))))))

                         ..\\polytypic
                         ))))
