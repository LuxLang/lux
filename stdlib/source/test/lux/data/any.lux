(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" hash
     ["[1]T" \\test]]]
   [math
    ["[0]" random (.only Random) (.open monad)]]
   [test
    ["_" property]]]]
 [\\library
  ["[0]" /]]
 ["!" \\theorem])

(the .public random
     (Random Any)
     (random:pure /.any))

(the .public test
     _.Test
     (<| (_.covering /._)
         (all _.and
              (_.by_proof [/.equality /.=]
                          [!.equality])
              (_.for [/.hash]
                     (hashT.spec /.hash ..random))
              
              (_.coverage [/.any]
                          true)
              )))
