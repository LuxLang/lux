(.using
 [library
  [lux (.except)
   [abstract
    [[0] enum]
    [[0] monad (.only)
     [[1 "T"] \\test]]
    [[0] equality
     [[1 "T"] \\test]]
    [[0] hash
     [[1 "T"] \\test]]]
   [function
    [poly
     [type
      [[0] mix
       [[1 "T"] \\test]]]]]
   [control
    [[0] pipe]
    [[0] io]
    [[0] pure (.only Pure)]]
   [error
    [[0] try]
    [[0] exception]]
   [[0] function (.only)
    [[0] predicate]]
   [data
    [[0] text]
    [collection
     [[0] list]
     [[0] set]]]
   [logic
    [[0] bit]]
   [math
    [[0] random (.only Random)]
    [number
     [/64
      [["n"] natural]
      [[0] integer]]]]
   [macro
    [[0] template]]
   [test
    [["_"] property]]
   [aspect
    [[0] view]]]]
 [\\library
  [[0] /]]
 [["!"] \\theorem])

(the bounded_size
     (Random Natural)
     (by random.monad each (n.% 100)
         random.natural))

(the random
     (Random (Stack Natural))
     (monad.let [! random.monad]
                [size ..bounded_size]
                (|> random.natural
                    (random.set n.hash size)
                    (by ! each (|>> set.as_list (view.as list.stack))))))

(the signatures
     _.Test
     (all _.and
          (_.for [/.equality]
                 (equalityT.spec (/.equality n.equality) ..random))
          (_.for [/.hash]
                 (|> random.natural
                     (by random.monad each (|>> stack))
                     (hashT.spec (/.hash n.hash))))
          (_.by_proof [/.empty]
                      [!.empty])
          (_.by_proof [/.composite]
                      [!.composite_of_Empty_start
                       !.composite_of_Top_start
                       !.composite_of_Empty_end])
          (_.by_proof [/.monoid]
                      [!.monoid])
          (_.by_proof [/.mix]
                      [!.mix_of_Empty
                       !.mix_of_Top
                       !.commutativity_in_mix
                       !.mix_with_constant_function])
          (_.by_proof [/.functor]
                      [!.functor])
          ))

(the whole
     _.Test
     (<| (with ["/:" 0] (/.equality n.equality))
         (monad.let [! random.monad]
                    [size ..bounded_size
                     sample (by ! each (|>> set.as_list (view.as list.stack)) (random.set n.hash size random.natural))
                     expected_head random.natural
                     expected_neck random.natural])
         (all _.and
              (_.by_proof [/.size]
                          [!.size_of_Empty
                           !.size_of_Top])
              (_.by_proof [/.empty?]
                          [!.empty?_of_Empty_=_true
                           !.empty?_of_Top_=_false])
              (_.by_proof [/.push]
                          [!.push])
              (_.by_proof [/.in_reverse]
                          [!.composite_in_reverse
                           !.in_reverse_of_Empty
                           !.in_reverse_of_one
                           !.in_reverse_of_Top
                           !.in_reverse_is_an_involution])
              (_.by_proof [/.any?]
                          [!.any?_of_Empty
                           !.any?_of_Top_failure
                           !.any?_of_Top_success])
              (_.by_proof [/.every?]
                          [!.every?_of_Empty
                           !.every?_of_Top_failure
                           !.every?_of_Top_success])
              (_.coverage [/.partial]
                          (when (/.partial expected_head expected_neck sample)
                                (/.partial actual_head actual_neck actual_sample)
                                (and (identical? expected_head actual_head)
                                     (identical? expected_neck actual_neck)
                                     (identical? sample actual_sample))

                                else
                                false))
              )))

(the domain
     _.Test
     (monad.let [! random.monad]
                [sample ..random
                 .let [size (/.size sample)]]
                (all _.and
                     (_.coverage [/.item]
                                 (list.every? (function (_ [index expected])
                                                        (when (/.item index sample)
                                                              {try.:Success actual}
                                                              (n.= expected actual)
                                                              
                                                              {try.:Failure _}
                                                              false))
                                              (list.enumeration (view.of list.stack sample))))
                     )))

(the slice
     _.Test
     (<| (with ["/:" 0] (/.equality n.equality))
         (with ["/:" 0] /.monoid)
         (monad.let [! random.monad]
                    [sample (random.only (|>> /.size (n.> 0))
                                         ..random)
                     .let [size (/.size sample)]
                     idx (by ! each (n.% size) random.natural)
                     sub_size (by ! each (|>> (n.% size) ++) random.natural)])
         (all _.and
              (_.by_proof [/.only]
                          [!.only_of_Empty
                           !.only_of_Top_keep
                           !.only_of_Top_skip])
              (_.coverage [/.split_when]
                          (let [[left right] (/.split_when n.even? sample)]
                               (/:= sample
                                    (/:composite left right))))
              )))

(the member
     _.Test
     (monad.let [! random.monad]
                [sample ..random]
                (all _.and
                     (_.coverage [/.member?]
                                 (/.every? (/.member? n.equality sample)
                                           sample))
                     (_.by_proof [/.top]
                                 [!.top_of_Empty
                                  !.top_of_Top])
                     (_.by_proof [/.pop]
                                 [!.pop_of_Empty
                                  !.pop_of_Top])
                     )))

(the search
     _.Test
     (<| (with ["/:" 0] /.functor)
         (let [choice (is (-> Natural (Maybe Text))
                          (function (_ value)
                                    (if (n.even? value)
                                        {.:Some (by n.base_10 as value)}
                                        {.:None})))])
         (monad.let [! random.monad]
                    [sample ..random])
         (all _.and
              (_.coverage [/.one]
                          (when [(|> sample
                                     (/.only n.even?)
                                     (/:each (by n.base_10 as))
                                     /.top)
                                 (/.one choice sample)]
                                [{try.:Success expected} {try.:Success actual}]
                                (text.= expected actual)

                                [{try.:Failure _} {try.:Failure _}]
                                true

                                _
                                false))
              (_.coverage [/.example]
                          (when (/.example n.even? sample)
                                {try.:Success found}
                                (n.even? found)

                                {try.:Failure _}
                                (not (/.any? n.even? sample))))
              (monad.let [! random.monad]
                         [expected_size (by ! each (|>> (n.% 100) ++) random.natural)
                          .let [random (is (Random (Stack Natural))
                                           (|> random.natural
                                               (random.set n.hash expected_size)
                                               (by ! each (|>> set.as_list
                                                               (view.as list.stack)))))]
                          expected random
                          difference random.natural]
                         (with (/.equality n.equality)
                               (all _.and
                                    (_.coverage [/.only']
                                                (and (= (/.only n.even? expected)
                                                        (is (Pure (Stack Natural))
                                                            (/.only' pure.monad n.even? expected)))
                                                     (= (/.only n.odd? expected)
                                                        (is (Pure (Stack Natural))
                                                            (/.only' pure.monad n.odd? expected)))))
                                    (_.coverage [/.mix']
                                                (with n.equality
                                                      (= (/.mix n.- expected 0)
                                                         (is (Pure Natural)
                                                             (/.mix' pure.monad
                                                                     (function (_ next total)
                                                                               (by pure.monad pure (n.- next total)))
                                                                     expected
                                                                     0)))))
                                    (_.coverage [/.each']
                                                (= (by /.functor each (n.+ difference) expected)
                                                   (is (Pure (Stack Natural))
                                                       (/.each' pure.monad
                                                                (|>> (n.+ difference)
                                                                     (by pure.monad pure))
                                                                expected)))))))
              )))

(the .public test
     _.Test
     (<| (_.covering /._)
         (_.for [.Stack
                 .:Empty .:Top])
         (all _.and
              ..signatures
              ..whole
              ..domain
              ..slice
              ..member
              ..search
              )))
