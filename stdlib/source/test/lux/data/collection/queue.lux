(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad]
    ["[0]" functor
     ["[1]T" \\test (.only Injection)]]
    ["[0]" equality
     ["[1]T" \\test]]]
   [error
    ["[0]" try]]
   [data
    [collection
     ["[0]" set]
     ["[0]" list (.open monoid)]]]
   [logic
    ["[0]" bit]]
   [math
    ["[0]" random]
    [number
     [/64
      ["n" natural]]]]
   [test
    ["_" property (.only Test)]]
   [aspect
    ["[0]" view (.only)
     ["[1]T" \\test]]]]]
 [\\library
  ["[0]" /]]
 ["!" \\theorem])

(the injection
     (Injection /.Queue)
     (|>> list
          (view.of /.list)))

(the .public test
     Test
     (<| (_.covering /._)
         (_.for [/.Queue
                 /.:front /.:rear])
         (monad.let [! random.monad]
                    [size (by ! each (n.% 100) random.natural)
                     members (random.set n.hash size random.natural)
                     non_member (random.only (|>> (set.member? members) not)
                                             random.natural)
                     .let [members (set.as_list members)
                           sample (view.of /.list members)]]
                    (all _.and
                         (_.for [/.equality]
                                (equalityT.spec (/.equality n.equality) (random.queue size random.natural)))
                         (_.for [/.functor]
                                (functorT.spec ..injection /.equality /.functor))
                         (_.for [/.list]
                                (monad.let [! random.monad]
                                           [size (by ! each (n.% 10) random.natural)]
                                           (viewT.specification /.list
                                                                (/.equality n.equality)
                                                                (list.equality n.equality)
                                                                
                                                                (random.queue size random.natural)
                                                                (random.list size random.natural))))

                         (_.by_proof [/.size]
                                     [!.size_of_empty
                                      !.size_of_end])
                         (_.by_proof [/.empty?]
                                     [!.empty?_of_empty
                                      !.empty?_of_end])
                         (_.by_proof [/.empty]
                                     [!.empty?_of_empty
                                      !.size_of_empty
                                      !.front_of_empty])
                         (_.by_proof [/.front]
                                     [!.front_of_empty
                                      !.front_of_end_of_empty])
                         (_.coverage [/.member?]
                                     (let [every_member_is_identified!
                                           (list.every? (/.member? n.equality sample)
                                                        (view.as /.list sample))

                                           non_member_is_not_identified!
                                           (not (/.member? n.equality sample non_member))]
                                          (and every_member_is_identified!
                                               non_member_is_not_identified!)))
                         (_.by_proof [/.end]
                                     [!.size_of_end
                                      !.empty?_of_end
                                      !.front_of_end_of_empty])
                         (_.coverage [/.next]
                                     (when (view.as list.stack members)
                                           {.:Top target expected}
                                           (let [popped (/.next sample)

                                                 size_decreases!
                                                 (n.= (-- (/.size sample))
                                                      (/.size popped))

                                                 popped_member_is_not_identified!
                                                 (not (/.member? n.equality popped target))

                                                 has_expected_order!
                                                 (by (list.equality n.equality) =
                                                     (view.of list.stack expected)
                                                     (view.as /.list popped))]
                                                (and size_decreases!
                                                     popped_member_is_not_identified!
                                                     has_expected_order!))
                                           
                                           {.:Empty}
                                           (and (/.empty? sample)
                                                (/.empty? (/.next sample)))))
                         ))))
