(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad]]
   [data
    [collection
     ["[0]" set]]]
   [math
    ["[0]" random]
    [number
     [/64
      ["n" natural]]]]
   [meta
    ["[0]" name]]
   [test
    ["_" property (.only Test)]]]]
 [\\library
  ["[0]" /]]
 [///
  [meta
   ["[0]T" name]]])

(the .public test
     Test
     (<| (_.covering /._)
         (_.for [/.Tally])
         (monad.let [! random.monad]
                    [left (nameT.random 1 1)
                     right (nameT.random 2 2)
                     expected_successes random.natural
                     expected_failures random.natural
                     expected_verification random.natural])
         (all _.and
              (_.coverage [/.empty]
                          (and (n.= 0 (its /.:every_success /.empty))
                               (n.= 0 (its /.:every_failure /.empty))
                               (n.= 0 (set.size (its /.:expectation /.empty)))
                               (n.= 0 (set.size (its /.:reality /.empty)))))
              (_.coverage [/.success /.:every_success]
                          (and (n.= 1 (its /.:every_success /.success))
                               (n.= 0 (its /.:every_failure /.success))
                               (n.= 0 (set.size (its /.:expectation /.success)))
                               (n.= 0 (set.size (its /.:reality /.success)))))
              (_.coverage [/.failure /.:every_failure]
                          (and (n.= 0 (its /.:every_success /.failure))
                               (n.= 1 (its /.:every_failure /.failure))
                               (n.= 0 (set.size (its /.:expectation /.failure)))
                               (n.= 0 (set.size (its /.:reality /.failure)))))
              (_.coverage [/.failed?]
                          (and (/.failed? /.failure)
                               (not (/.failed? /.success))))
              (_.coverage [/.and /.:expectation /.:reality]
                          (and (let [it (/.and /.success /.success)]
                                    (and (n.= 2 (its /.:every_success it))
                                         (n.= 0 (its /.:every_failure it))))
                               (let [it (/.and /.failure /.failure)]
                                    (and (n.= 0 (its /.:every_success it))
                                         (n.= 2 (its /.:every_failure it))))
                               (let [it (/.and /.success /.failure)]
                                    (and (n.= 1 (its /.:every_success it))
                                         (n.= 1 (its /.:every_failure it))))
                               (let [custom [/.:every_success expected_successes
                                             /.:every_failure expected_failures
                                             /.:every_verification expected_verification
                                             /.:expectation (set.of_list name.hash (list left))
                                             /.:reality (set.of_list name.hash (list right))
                                             /.:every_theorem (set.of_list name.hash (list))]]
                                    (and (let [it (/.and /.success custom)]
                                              (and (n.= (++ expected_successes) (its /.:every_success it))
                                                   (n.= expected_failures (its /.:every_failure it))
                                                   (set.= (its /.:expectation custom) (its /.:expectation it))
                                                   (set.= (its /.:reality custom) (its /.:reality it))))
                                         (let [it (/.and custom /.failure)]
                                              (and (n.= expected_successes (its /.:every_success it))
                                                   (n.= (++ expected_failures) (its /.:every_failure it))
                                                   (set.= (its /.:expectation custom) (its /.:expectation it))
                                                   (set.= (its /.:reality custom) (its /.:reality it))))))))
              )))
