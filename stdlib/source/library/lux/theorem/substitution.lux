(.using
 [library
  [lux (.except and pattern function if list)
   [abstract
    [[0] monad]]
   [error
    [[0] try (.only Try) (.open functor)]
    [[0] exception (.only Exception)]]
   [data
    [[0] text]
    [collection
     [[0] list (.open functor monoid)]]]
   [logic
    [[0] bit]]
   [math
    [number
     [/64
      [[0] natural]]]]
   [meta
    [[0] name]
    [[0] provenance]
    [[0] static]]
   [macro
    [["^"] pattern]
    [[0] template]
    [[0] expansion]]
   [compiler
    [["@" 0] type]
    [[0] reference]
    [[0] extension (.only)
     [[1 "/" 0] lux]]
    [language
     [lux
      [[0] analysis]]]]]]
 [//
  [state (.only State)]
  [["?"] proposition]
  [[0] term]])

(<| (the .public any
         term.Rule)
    (.function (_ state it))
    {try.:Success it})

(exception.the .public (not_valid [where term])
               (Exception [Name analysis.Term])
               (exception.report (.list ["Where" (name.as_text where)]
                                        ["Term" (term.as_text "" term)])))

(the .public (case expectation by_case
                   state it)
     (-> Bit
         (Change term.Rule))
     (when it
           (term.case @ reality it')
           (.if (bit.= expectation reality)
                (try:each (|>> (term.case @ reality))
                          (by_case state it'))
                (exception.except ..not_valid [(name ..case) it]))

           else
           (exception.except ..not_valid [(name ..case) else])))

(the (pattern it)
     (-> @type.Pattern
         analysis.Term)
     (when it
           {@type.:Simple_Pattern it}
           (`` (when it
                     {@type.:Simple_Unit}
                     (analysis.unit provenance.dummy)

                     (,, (template.with [,tag ,analysis]
                                        [{,tag it}
                                         (,analysis provenance.dummy it)]

                                        [[@type.:Simple_Bit analysis.bit]
                                         [@type.:Simple_Natural analysis.natural]
                                         [@type.:Simple_Integer analysis.integer]
                                         [@type.:Simple_Revolution analysis.revolution]
                                         [@type.:Simple_Real analysis.real]
                                         [@type.:Simple_Text analysis.text]]))))
           
           {@type.:Complex_Pattern it}
           (when it
                 {@type.:Complex_Variant it}
                 (analysis.variant provenance.dummy
                                   (revised @type.:value pattern it))
                 
                 {@type.:Complex_Tuple it}
                 (analysis.tuple provenance.dummy
                                 (list:each pattern it)))
           
           {@type.:List_Pattern it}
           (undefined)
           
           {@type.:Bind_Pattern it}
           (term.new provenance.dummy it "")))

(<| (comment "https://en.wikipedia.org/wiki/Hypothesis")
    (the .public (hypothesis match input)
         (-> @type.Pattern analysis.Term
             ?.Proposition))
    {?.:Identity [?.:slow (pattern match)
                  ?.:fast input]})

(the .public (if by_this by_then by_else
                 state it)
     (-> term.Rule term.Rule term.Rule
         term.Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.if))]
                             (.list this then else)}
           (monad.let [! try.monad]
                      [this (by_this state this)
                       then (by_then state then)
                       else (by_else state else)]
                      (pure {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.if))]
                                              (.list this then else)}))

           else
           (exception.except ..not_valid [(name ..if) it])))

(the .public (if_case by_case by_left by_right
                      state it)
     (-> term.Rule term.Rule term.Rule
         term.Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.if_case))]
                             (.list case left right)}
           (monad.let [! try.monad]
                      [case (by_case state case)
                       left (by_left state left)
                       right (by_right state right)]
                      (pure {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.if_case))]
                                              (.list case left right)}))

           else
           (exception.except ..not_valid [(name ..if_case) it])))

(.the .public (as_pair it)
      (-> analysis.Term
          (Try [analysis.Term analysis.Term]))
      (when it
            (term.pair @ left right)
            {try.:Success [left right]}

            else
            (exception.except ..not_valid [(name ..as_pair) it])))

(<| (the .public (pair in_left in_right
                       state it)
         (-> term.Rule term.Rule
             term.Rule))
    (monad.let try.monad
               [[left right] (as_pair it)
                left (in_left state left)
                right (in_right state right)])
    (pure (term.pair provenance.dummy left right)))

(<| (the (substitution_of_foreign expectation value)
         (-> @type.Register analysis.Term
             (Change analysis.Term)))
    (.function (substitution_of_foreign it))
    (when it
          {@type.:Simple @ _}
          it
          
          {@type.:Complex @ it}
          {@type.:Complex @ (when it
                                  {@type.:Complex_Variant it}
                                  {@type.:Complex_Variant (revised @type.:value substitution_of_foreign it)}
                                  
                                  {@type.:Complex_Tuple it}
                                  {@type.:Complex_Tuple (list:each substitution_of_foreign it)})}
          
          {@type.:Reference @ it'}
          (when it'
                {@type.:Variable_Reference it'}
                (when it'
                      {@type.:Local it'}
                      it
                      
                      {@type.:Foreign reality}
                      (.if (natural.= expectation reality)
                           value
                           it))
                
                {@type.:Constant_Reference it'}
                it)

          {@type.:When @ input [head tail]}
          {@type.:When @ (substitution_of_foreign input)
                       [(revised @type.:then substitution_of_foreign head)
                        (list:each (revised @type.:then substitution_of_foreign) tail)]}
          
          {@type.:Abstraction @ environment body}
          {@type.:Abstraction @ (list:each substitution_of_foreign environment)
                              body}
          
          {@type.:Application @ parameter abstraction}
          {@type.:Application @ (substitution_of_foreign parameter)
                              (substitution_of_foreign abstraction)}
          
          {@type.:Extension @ name parameters}
          {@type.:Extension @ name (list:each substitution_of_foreign parameters)}))

(the .public (function by_body
                       state it)
     (Change term.Rule)
     (when it
           {@type.:Abstraction @ closure body}
           (monad.let try.monad
                      [body (by_body state (list.mix (<| (.function (_ [@foreign 'foreign] it))
                                                         (substitution_of_foreign @foreign 'foreign it))
                                                     (list.enumeration closure)
                                                     body))]
                      (pure {@type.:Abstraction @ (.list) body}))

           else
           (exception.except ..not_valid [(name ..function) it])))

(the (extension expectation by_parameter/*
                state it)
     (for_any (_ it)
              (-> Name (List term.Rule)
                  term.Rule))
     (when it
           {@type.:Extension @ reality parameter/*}
           (.if (.and (name.= expectation reality)
                      (natural.= (list.size by_parameter/*)
                                 (list.size parameter/*)))
                (monad.let [! try.monad]
                           [parameter/* (list.each' ! (.function (_ [by_parameter parameter])
                                                                 (by_parameter state parameter))
                                                    (list.zipped_2 by_parameter/* parameter/*))]
                           (pure {@type.:Extension @ reality parameter/*}))
                (exception.except ..not_valid [(name ..extension) it]))

           else
           (exception.except ..not_valid [(name ..extension) it])))

(the (synthesis [module name])
     (Change Name)
     [module (extension.synthesis name)])

(the .public list
     (for_any (_ it)
              (-> (List term.Rule)
                  term.Rule))
     (..extension (..synthesis (name .list#))))

(exception.the .public (no_application [term])
               (Exception [analysis.Term])
               (exception.report (.list ["Term" (term.as_text "" term)])))

(the .public (application abstraction parameter
                          environment it)
     (-> term.Rule term.Rule
         term.Rule)
     (when it
           {@type.:Application @ parameter' abstraction'}
           (monad.let try.monad
                      [parameter' (parameter environment parameter')
                       abstraction' (abstraction environment abstraction')]
                      (pure {@type.:Application @ parameter' abstraction'}))

           else
           (exception.except ..no_application [it])))

(the .public (of by_abstraction every_parameter)
     (-> term.Rule (List term.Rule)
         term.Rule)
     (list.mix (.function (_ by_parameter by_abstraction)
                          (..application by_abstraction by_parameter))
               every_parameter
               by_abstraction))

(<| (the .public (= left right
                    state it)
         (-> term.Rule term.Rule
             (term.Fact ?.Proposition ?.Proposition)))
    (monad.let try.monad
               [[slow fast] (?.identity it)
                slow (left state slow)
                fast (right state fast)])
    (pure {?.:Identity [?.:slow slow
                        ?.:fast fast]}))

(<| (expansion.let [,Byte (these term.Rule term.Rule term.Rule term.Rule
                                 term.Rule term.Rule term.Rule term.Rule)])
    (the .public (b64 by_77 by_76 by_75 by_74 by_73 by_72 by_71 by_70
                      by_67 by_66 by_65 by_64 by_63 by_62 by_61 by_60
                      by_57 by_56 by_55 by_54 by_53 by_52 by_51 by_50
                      by_47 by_46 by_45 by_44 by_43 by_42 by_41 by_40
                      by_37 by_36 by_35 by_34 by_33 by_32 by_31 by_30
                      by_27 by_26 by_25 by_24 by_23 by_22 by_21 by_20
                      by_17 by_16 by_15 by_14 by_13 by_12 by_11 by_10
                      by_07 by_06 by_05 by_04 by_03 by_02 by_01 by_00
                      state it)
         (-> ,Byte ,Byte ,Byte ,Byte ,Byte ,Byte ,Byte ,Byte
             term.Rule)
         (when it
               {@type.:Extension @ [.prelude (static.text (extension.synthesis extension/lux.b64))]
                                 (.list '77 '76 '75 '74 '73 '72 '71 '70
                                        '67 '66 '65 '64 '63 '62 '61 '60
                                        '57 '56 '55 '54 '53 '52 '51 '50
                                        '47 '46 '45 '44 '43 '42 '41 '40
                                        '37 '36 '35 '34 '33 '32 '31 '30
                                        '27 '26 '25 '24 '23 '22 '21 '20
                                        '17 '16 '15 '14 '13 '12 '11 '10
                                        '07 '06 '05 '04 '03 '02 '01 '00)}
               (`` (monad.let [! try.monad]
                              [(,, (template.with [,proof ,term]
                                                  [,term (,proof state ,term)]

                                                  [[by_77 '77] [by_76 '76] [by_75 '75] [by_74 '74]
                                                   [by_73 '73] [by_72 '72] [by_71 '71] [by_70 '70]
                                                   
                                                   [by_67 '67] [by_66 '66] [by_65 '65] [by_64 '64]
                                                   [by_63 '63] [by_62 '62] [by_61 '61] [by_60 '60]
                                                   
                                                   [by_57 '57] [by_56 '56] [by_55 '55] [by_54 '54]
                                                   [by_53 '53] [by_52 '52] [by_51 '51] [by_50 '50]
                                                   
                                                   [by_47 '47] [by_46 '46] [by_45 '45] [by_44 '44]
                                                   [by_43 '43] [by_42 '42] [by_41 '41] [by_40 '40]
                                                   
                                                   [by_37 '37] [by_36 '36] [by_35 '35] [by_34 '34]
                                                   [by_33 '33] [by_32 '32] [by_31 '31] [by_30 '30]
                                                   
                                                   [by_27 '27] [by_26 '26] [by_25 '25] [by_24 '24]
                                                   [by_23 '23] [by_22 '22] [by_21 '21] [by_20 '20]
                                                   
                                                   [by_17 '17] [by_16 '16] [by_15 '15] [by_14 '14]
                                                   [by_13 '13] [by_12 '12] [by_11 '11] [by_10 '10]
                                                   
                                                   [by_07 '07] [by_06 '06] [by_05 '05] [by_04 '04]
                                                   [by_03 '03] [by_02 '02] [by_01 '01] [by_00 '00]]))]
                              (pure {@type.:Extension @ [.prelude (static.text (extension.synthesis extension/lux.b64))]
                                                      (.list '77 '76 '75 '74 '73 '72 '71 '70
                                                             '67 '66 '65 '64 '63 '62 '61 '60
                                                             '57 '56 '55 '54 '53 '52 '51 '50
                                                             '47 '46 '45 '44 '43 '42 '41 '40
                                                             '37 '36 '35 '34 '33 '32 '31 '30
                                                             '27 '26 '25 '24 '23 '22 '21 '20
                                                             '17 '16 '15 '14 '13 '12 '11 '10
                                                             '07 '06 '05 '04 '03 '02 '01 '00)})))

               else
               (exception.except ..not_valid [(name ..b64) it]))))

(template.with [,rule ,extension]
               [(the .public (,rule by_reference by_subject
                                    state it)
                     (-> term.Rule term.Rule
                         term.Rule)
                     (when it
                           {@type.:Extension @ [.prelude (static.text (extension.synthesis ,extension))]
                                             (.list 'reference 'subject)}
                           (monad.let try.monad
                                      ['reference (by_reference state 'reference)
                                       'subject (by_subject state 'subject)]
                                      (pure {@type.:Extension @ [.prelude (static.text (extension.synthesis ,extension))]
                                                              (.list 'reference 'subject)}))

                           else
                           (exception.except ..not_valid [(`` (name (,, (template.name [.._] [,rule]))))
                                                          it])))]

               [[b64_or extension/lux.b64_or]
                [b64_and extension/lux.b64_and]
                [b64_and/or extension/lux.b64_and/or]
                ])

(template.with [,rule ,extension]
               [(the .public (,rule by_it
                                    state it)
                     (Change term.Rule)
                     (when it
                           {@type.:Extension @ [.prelude (static.text (extension.analysis ,extension))]
                                             (.list 'it)}
                           (monad.let try.monad
                                      ['it (by_it state 'it)]
                                      (pure {@type.:Extension @ [.prelude (static.text (extension.analysis ,extension))]
                                                              (.list 'it)}))

                           else
                           (exception.except ..not_valid [(`` (name (,, (template.name [.._] [,rule]))))
                                                          it])))]

               [[b64_<< extension/lux.b64_<<]
                [b64_>> extension/lux.b64_>>]
                ])
