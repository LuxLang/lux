(.using
 [library
  [lux (.except the)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["in"] substitution]
    [["by"] rule]]
   [macro
    [[0] template]
    [[0] syntax]]
   [meta
    [code
     [[0] export]]]
   [data
    [collection
     [[0] list
      [["?" 1] \\projection]]]]]])

(syntax.the .public (the [[export_policy declaration] (export.with ?list.any)
                          proposition ?list.any])
            (pure (list (` (template.the (, export_policy) (, declaration)
                                         [(, proposition)])))))
