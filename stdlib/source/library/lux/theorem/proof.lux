(.using
 [library
  [lux (.except let if and with)
   [abstract
    [[0] monad]]
   [error
    [[0] try (.only Try)]
    [[0] exception (.only Exception)]]
   [meta
    [[0] code]]
   [compiler
    [["@" 0] type]
    [language
     [lux
      [[0] analysis]]]]]]
 [//
  [["?"] proposition]
  [["in"] substitution]
  [["by"] rule]
  [[0] context]
  [[0] state]])

(<| (comment "https://en.wikipedia.org/wiki/Mathematical_proof"
             "https://en.wikipedia.org/wiki/Formal_proof")
    (every .public Proof
           (in.Substitution ?.Proposition)))

(the .public (= left right
                context it)
     (-> in.Rule in.Rule
         Proof)
     (monad.let try.monad
                [it' (in.= left right context it)
                 identity (?.identity it')]
                (.if (.with analysis.equality
                            (= (its ?.:slow identity)
                               (its ?.:fast identity)))
                     (pure it)
                     (exception.except context.contradiction [(its state.:alias context) identity]))))

(<| (comment "https://en.wikipedia.org/wiki/Q.E.D.")
    (the .public qed
         Proof
         (= in.any
            in.any)))

(the .public (if then
                 context it)
     (-> (-> ?.Proposition
             Proof)
         Proof)
     (monad.let try.monad
                [[premise conclusion] (?.entailment it)]
                ((then premise) context conclusion)))

(the Case
     (type (Change Proof)))

(the (case proposition)
     (-> ?.Proposition
         Case)
     (function (_ proof
                  context it)
               (monad.let try.monad
                          [_ (proof context proposition)]
                          (pure it))))

(the .public (or then
                 context it)
     (-> (-> Case Case
             Proof)
         Proof)
     (monad.let try.monad
                [[this that] (?.disjunction it)]
                ((then (..case this) (..case that)) context it)))

(the .public (and of_this of_that
                  context it)
     (-> Proof Proof
         Proof)
     (monad.let try.monad
                [[this that] (?.conjunction it)
                 _ (of_this context this)
                 _ (of_that context that)]
                (pure it)))

(every .public Adaptation
       (-> ?.Proposition
           (Try ?.Proposition)))

(the .public any
     Adaptation
     (|>> {try.:Success}))

(<| (comment "https://en.wikipedia.org/wiki/Distributive_property#Truth_functional_connectives")
    (the .public (over_conjunction conjunction
                                   proposition)
         (Change Adaptation))
    (monad.let try.monad
               [[premise conclusion] (?.entailment proposition)
                conclusion (conjunction conclusion)
                [left right] (?.conjunction conclusion)])
    (pure {?.:Conjunction [{?.:Entailment [premise left]}
                           {?.:Entailment [premise right]}]}))

(the .public (with adaptation it
                   context proposition)
     (-> Adaptation
         (Change Proof))
     (monad.let try.monad
                [proposition (adaptation proposition)]
                (it context proposition)))

(<| (comment "https://en.wikipedia.org/wiki/Axiom")
    (the .public (axiom context it)
         Proof
         {try.:Success it}))
