(.using
 [library
  [lux (.except and if local by let name)
   [abstract
    ["[0]" monad]]
   [error
    ["[0]" try (.only Try) (.open functor)]
    ["[0]" exception (.only Exception)]]
   [data
    ["[0]" pair]
    [collection
     ["[0]" list (.open functor)]
     ["[0]" dictionary (.only Dictionary)]]]
   ["[0]" function]
   [logic
    ["[0]" bit]]
   [math
    [number
     [/64
      ["[0]" natural]
      ["[0]" integer]]]]
   ["[0]" meta (.only)
    ["[0]" binding]
    ["[0]" name]
    ["[0]" static]
    ["[0]" provenance]]
   [macro
    ["^" pattern]
    ["[0]" template]
    ["[0]" expansion]]
   [compiler
    ["@[0]" type]
    ["[0]" extension (.only)
     ["[1]/[0]" lux]]
    ["[0]" reference (.only)
     ["[0]" variable]]
    [language
     [lux
      ["[0]" analysis (.only)
       ["[0]" simple]
       ["[0]" pattern]]]]]]]
 [//
  ["?" proposition]
  ["in" substitution (.only Substitution Rule)]
  ["[0]" term]])

(the (substitution_of_local expectation value)
     (-> @type.Register analysis.Term
         (Change analysis.Term))
     (function (substitution_of_local it)
               (when it
                     {@type.:Simple @ _}
                     it
                     
                     {@type.:Complex @ it}
                     {@type.:Complex @ (when it
                                             {@type.:Complex_Variant it}
                                             {@type.:Complex_Variant (revised @type.:value substitution_of_local it)}
                                             
                                             {@type.:Complex_Tuple it}
                                             {@type.:Complex_Tuple (list:each substitution_of_local it)})}
                     
                     {@type.:Reference @ it'}
                     (when it'
                           {@type.:Variable_Reference it'}
                           (when it'
                                 {@type.:Local reality}
                                 (.if (natural.= expectation reality)
                                      value
                                      it)
                                 
                                 {@type.:Foreign it'}
                                 it)
                           
                           {@type.:Constant_Reference it'}
                           it)

                     {@type.:When @ input [head tail]}
                     {@type.:When @ (substitution_of_local input)
                                  [(revised @type.:then substitution_of_local head)
                                   (list:each (revised @type.:then substitution_of_local) tail)]}
                     
                     {@type.:Abstraction @ environment body}
                     {@type.:Abstraction @ (list:each substitution_of_local environment)
                                         body}
                     
                     {@type.:Application @ parameter abstraction}
                     {@type.:Application @ (substitution_of_local parameter)
                                         (substitution_of_local abstraction)}
                     
                     {@type.:Extension @ name parameters}
                     {@type.:Extension @ name (list:each substitution_of_local parameters)})))

(the .public (substitution_of_variable expectation value)
     (-> @type.Register analysis.Term
         (Change analysis.Term))
     (function (substitution_of_variable it)
               (when it
                     (term.new _ reality name)
                     (.if (natural.= expectation reality)
                          value
                          it)
                     
                     {@type.:Simple _}
                     it
                     
                     {@type.:Complex @ it}
                     {@type.:Complex @ (when it
                                             {@type.:Complex_Variant it}
                                             {@type.:Complex_Variant (revised @type.:value substitution_of_variable it)}
                                             
                                             {@type.:Complex_Tuple it}
                                             {@type.:Complex_Tuple (list:each substitution_of_variable it)})}
                     
                     {@type.:Reference _}
                     it

                     {@type.:When @ input [head tail]}
                     {@type.:When @ (substitution_of_variable input)
                                  [(revised @type.:then substitution_of_variable head)
                                   (list:each (revised @type.:then substitution_of_variable) tail)]}
                     
                     {@type.:Abstraction @ environment body}
                     {@type.:Abstraction @ (list:each substitution_of_variable environment)
                                         body}
                     
                     {@type.:Application @ parameter abstraction}
                     {@type.:Application @ (substitution_of_variable parameter)
                                         (substitution_of_variable abstraction)}
                     
                     {@type.:Extension @ name parameters}
                     {@type.:Extension @ name (list:each substitution_of_variable parameters)})))

(every .public Environment
       (Dictionary @type.Variable analysis.Term))

(the (beta_reduction local)
     (-> Environment
         (Change analysis.Term))
     (function (beta_reduction it)
               (when it
                     {@type.:Simple @ _}
                     it
                     
                     {@type.:Complex @ it}
                     {@type.:Complex @ (when it
                                             {@type.:Complex_Variant it}
                                             {@type.:Complex_Variant (revised @type.:value beta_reduction it)}
                                             
                                             {@type.:Complex_Tuple it}
                                             {@type.:Complex_Tuple (list:each beta_reduction it)})}
                     
                     {@type.:Reference @ it'}
                     (when it'
                           {@type.:Variable_Reference it'}
                           (|> local
                               (dictionary.value it')
                               (try.else it))
                           
                           {@type.:Constant_Reference _}
                           it)
                     
                     {@type.:When @ input [head tail]}
                     {@type.:When @ (beta_reduction input)
                                  [(revised @type.:then beta_reduction head)
                                   (list:each (revised @type.:then beta_reduction) tail)]}
                     
                     {@type.:Abstraction @ environment body}
                     {@type.:Abstraction @ (list:each beta_reduction environment)
                                         body}
                     
                     {@type.:Application @ parameter abstraction}
                     {@type.:Application @ (beta_reduction parameter)
                                         (beta_reduction abstraction)}
                     
                     {@type.:Extension @ name parameters}
                     {@type.:Extension @ name (list:each beta_reduction parameters)})))

(the .public (reification lux it)
     Rule
     (when it
           {@type.:Application @ parameter {@type.:Abstraction @ environment body}}
           (.let [local (|> environment
                            list.enumeration
                            (list:each (function (_ [foreign term])
                                                 [{@type.:Foreign foreign}
                                                  term]))
                            (dictionary.of_list variable.hash)
                            (dictionary.has {@type.:Local 0} {@type.:Abstraction @ environment body})
                            (dictionary.has {@type.:Local 1} parameter))]
                 {try.:Success (beta_reduction local body)})

           else
           (exception.except in.no_application [it])))

(the .public (and before after
                  context it)
     (for_any (_ before intermediate after)
              (-> (in.Fact before intermediate) (in.Fact intermediate after)
                  (in.Fact before after)))
     (monad.let try.monad
                [it (before context it)]
                (after context it)))

(the .public (of by_abstraction every_parameter)
     (-> Rule (List Rule)
         Rule)
     (list.mix (function (_ by_parameter by_abstraction)
                         (..and (in.application by_abstraction by_parameter)
                                ..reification))
               every_parameter
               by_abstraction))

(the (global_definition name lux)
     (-> Name Lux
         (Try analysis.Term))
     (<| (meta.value lux)
         (monad.let meta.monad
                    [[type expression value] (binding.export name)]
                    (when expression
                          {.:Some [original after_optimization]}
                          (pure original)

                          {.:None}
                          (meta.failure "")))))

(the .public (definition context it)
     Rule
     (when it
           {@type.:Reference _ {@type.:Constant_Reference @}}
           (all try.and/or
                (global_definition @ (its in.:every_global context))
                (exception.except in.not_valid [(.name ..definition) it]))

           else
           (exception.except in.not_valid [(.name ..definition) it])))

(the .public (name name
                   context it)
     (-> Name
         Rule)
     (all try.and/or
          (monad.let try.monad
                     [reference (global_definition name (its in.:every_global context))]
                     (.if (.by analysis.equality = reference it)
                          (pure (analysis.constant provenance.dummy name))
                          (exception.except in.not_valid [(.name ..name) it])))
          (exception.except in.not_valid [(.name ..name) it])))

(the .public (if by_reality by_case
                 context it)
     (-> Rule Rule
         Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.if))]
                             (list this then else)}
           (monad.let [! try.monad]
                      [this (by_reality context this)]
                      (when this
                            {@type.:Simple @ {@type.:Simple_Bit this}}
                            (by_case context (.if this
                                                  then
                                                  else))

                            else
                            (exception.except in.not_valid [(.name ..if) it])))

           else
           (exception.except in.not_valid [(.name ..if) it])))

(the .public (let_pair by_whole by_each_part
                       context it)
     (-> Rule Rule
         Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.let_pair))]
                             (list 'whole
                                   'body)}
           (monad.let try.monad
                      ['whole (by_whole context 'whole)]
                      (when 'whole
                            (term.pair @ 'left 'right)
                            (monad.let try.monad
                                       ['body ((..of in.any (list in.any in.any))
                                               context
                                               {@type.:Application @ 'right {@type.:Application @ 'left 'body}})]
                                       (by_each_part context 'body))

                            else
                            (exception.except in.not_valid [(.name ..let_pair) it])))

           else
           (exception.except in.not_valid [(.name ..let_pair) it])))

(<| (the .public (let_pair' by_whole by_each_part
                            context it)
         (-> Rule (in.Case ?.Proposition)
             Rule))
    (expansion.let [,failure (exception.except in.not_valid [(.name ..let_pair') it])])
    (when it
          {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.let_pair))]
                            (list 'whole
                                  'body)}
          (monad.let try.monad
                     ['whole (by_whole context 'whole)
                      foreign (when 'body
                                    (<| {@type.:Abstraction @ closure_of_left} {@type.:Abstraction @ closure_of_right} 'body)
                                    (list.one (function (_ [index value])
                                                        (when value
                                                              (analysis.local @ 1)
                                                              {.:Some index}

                                                              else
                                                              {.:None}))
                                              (list.enumeration closure_of_right))

                                    else
                                    ,failure)
                      .let ['left (analysis.foreign provenance.dummy foreign)
                            'right (analysis.local provenance.dummy 1)
                            identity {?.:Identity [?.:slow (term.pair provenance.dummy 'left 'right)
                                                   ?.:fast 'whole]}]
                      'body ((..of in.any (list in.any in.any)) context (|> 'body {@type.:Application @ 'left} {@type.:Application @ 'right}))]
                     ((by_each_part identity) context 'body))

          else
          ,failure))

(every .public Case
       Bit)

(template.with [,value ,name]
               [(the .public ,name Case ,value)]

               [[0b left]
                [1b right]
                ])

(the .public (if_case by_whole expectation by_case
                      context it)
     (-> Rule Case Rule
         Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.if_case))]
                             (list 'whole
                                   'left
                                   'right)}
           (monad.let try.monad
                      ['whole (by_whole context 'whole)]
                      (when 'whole
                            {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.case))]
                                              (list (analysis.bit @ reality)
                                                    'case)}
                            (.if (bit.= expectation reality)
                                 (monad.let try.monad
                                            ['case ((..of in.any (list in.any)) context {@type.:Application @ 'case (.if expectation 'right 'left)})]
                                            (by_case context 'case))
                                 (exception.except in.not_valid [(.name ..if_case) it]))

                            else
                            (exception.except in.not_valid [(.name ..if_case) it])))

           else
           (exception.except in.not_valid [(.name ..if_case) it])))

(exception.the .public (foreign_is_not_known [closure foreign])
               (Exception [(List analysis.Term) @type.Register])
               (exception.report (list ["Expected" (exception.listing (term.as_text "")
                                                                      closure)]
                                       ["Foreign" (.by natural.base_10 as foreign)])))

(the (with_closure closure)
     (-> (List analysis.Term) analysis.Term
         (Try analysis.Term))
     (.function (of it)
                (when it
                      {@type.:Simple @ _}
                      {try.:Success it}
                      
                      {@type.:Complex @ it}
                      (when it
                            {@type.:Complex_Variant it}
                            (try:each (.function (_ value)
                                                 (|> it
                                                     (has @type.:value value)
                                                     {@type.:Complex_Variant}
                                                     {@type.:Complex @}))
                                      (of (its @type.:value it)))
                            
                            {@type.:Complex_Tuple it}
                            (try:each (|>> {@type.:Complex_Tuple}
                                           {@type.:Complex @})
                                      (list.each' try.monad of it)))
                      
                      {@type.:Reference @ it'}
                      (when it'
                            {@type.:Variable_Reference it'}
                            (when it'
                                  {@type.:Local _}
                                  {try.:Success it}
                                  
                                  {@type.:Foreign foreign}
                                  (when (list.item foreign closure)
                                        {try.:Success it}
                                        {try.:Success it}

                                        {try.:Failure _}
                                        (exception.except ..foreign_is_not_known [closure foreign])))
                            
                            {@type.:Constant_Reference _}
                            {try.:Success it})
                      
                      {@type.:When @ input [head tail]}
                      (monad.let [! try.monad]
                                 [input (of input)
                                  .let [of_then (is (-> analysis.Branch
                                                        (Try analysis.Branch))
                                                    (.function (_ it)
                                                               (monad.let !
                                                                          [then (of (its @type.:then it))]
                                                                          (pure (has @type.:then then it)))))]
                                  head (of_then head)
                                  tail (list.each' try.monad of_then tail)]
                                 (pure {@type.:When @ input [head tail]}))
                      
                      {@type.:Abstraction @ environment body}
                      (monad.let try.monad
                                 [environment (list.each' try.monad of environment)]
                                 (pure {@type.:Abstraction @ environment body}))
                      
                      {@type.:Application @ parameter abstraction}
                      (monad.let try.monad
                                 [parameter (of parameter)
                                  abstraction (of abstraction)]
                                 (pure {@type.:Application @ parameter abstraction}))
                      
                      {@type.:Extension @ name parameters}
                      (monad.let try.monad
                                 [parameters (list.each' try.monad of parameters)]
                                 (pure {@type.:Extension @ name parameters})))))

(every Context
       (Dictionary @type.Register analysis.Term))

(the empty
     Context
     (dictionary.empty natural.hash))

(exception.the .public (cannot_extract_context [alias expected actual])
               (Exception [reference.Alias analysis.Term analysis.Term])
               (exception.report (list ["Expected" (term.pretty alias expected)]
                                       ["Actual" (term.pretty alias actual)])))

(exception.the .public (contradiction [alias expected actual])
               (Exception [reference.Alias analysis.Term analysis.Term])
               (exception.report (list ["Expected" (term.pretty alias expected)]
                                       ["Actual" (term.pretty alias actual)])))

(the (context alias original_expected original_actual it)
     (-> reference.Alias analysis.Term analysis.Term Context
         (Try Context))
     (loop (context [expected original_expected
                     actual original_actual
                     it it])
           (when [expected actual]
                 [(term.new _ @ name) _]
                 (when (dictionary.value @ it)
                       {try.:Success expected}
                       (.if (.with analysis.equality
                                   (= expected actual))
                            {try.:Success it}
                            (exception.except ..contradiction [alias original_expected original_actual]))

                       {try.:Failure not_known!}
                       {try.:Success (dictionary.has @ actual it)})
                 
                 [{@type.:Simple _ expected'} {@type.:Simple _ actual'}]
                 (.if (.with simple.equality
                             (= expected' actual'))
                      {try.:Success it}
                      (exception.except ..cannot_extract_context [alias original_expected original_actual]))
                 
                 [{@type.:Complex _ {@type.:Complex_Variant [expected_lefts expected_right? expected_choice]}}
                  {@type.:Complex _ {@type.:Complex_Variant [actual_lefts actual_right? actual_choice]}}]
                 (.if (.and (natural.= expected_lefts actual_lefts)
                            (bit.= expected_right? actual_right?))
                      (context expected_choice actual_choice it)
                      (exception.except ..cannot_extract_context [alias original_expected original_actual]))

                 [{@type.:Complex _ {@type.:Complex_Tuple expected'}}
                  {@type.:Complex _ {@type.:Complex_Tuple actual'}}]
                 (.if (natural.= (list.size expected') (list.size actual'))
                      (list.mix' try.monad (function.uncurried context) (list.zipped_2 expected' actual') it)
                      (exception.except ..cannot_extract_context [alias original_expected original_actual]))
                 
                 [{@type.:Reference _ expected'} {@type.:Reference _ actual'}]
                 (.if (.with reference.equality
                             (= expected' actual'))
                      {try.:Success it}
                      (exception.except ..cannot_extract_context [alias original_expected original_actual]))
                 
                 [{@type.:When _ expected_input
                               [[expected_output_head_pattern expected_output_head]
                                expected_output_tail]}
                  {@type.:When _ actual_input
                               [[actual_output_head_pattern actual_output_head]
                                actual_output_tail]}]
                 (.if (.and (natural.= (list.size expected_output_tail)
                                       (list.size actual_output_tail))
                            (pattern.= expected_output_head_pattern
                                       actual_output_head_pattern))
                      (monad.let [! try.monad]
                                 [it (context expected_input actual_input it)
                                  it (context expected_output_head actual_output_head it)]
                                 (list.mix' !
                                            (.function (_ [[expected_output_tail_pattern expected_output_tail]
                                                           [actual_output_tail_pattern actual_output_tail]]
                                                          it)
                                                       (.if (pattern.= expected_output_tail_pattern
                                                                       actual_output_tail_pattern)
                                                            (context expected_output_tail actual_output_tail it)
                                                            (exception.except ..cannot_extract_context [alias original_expected original_actual])))
                                            (list.zipped_2 expected_output_tail actual_output_tail)
                                            it))
                      (exception.except ..cannot_extract_context [alias original_expected original_actual]))
                 
                 [{@type.:Abstraction _ expected_environment expected_body}
                  {@type.:Abstraction _ actual_environment actual_body}]
                 (monad.let try.monad
                            [expected_body (with_closure expected_environment expected_body)
                             actual_body (with_closure actual_environment actual_body)]
                            (context expected_body actual_body it))
                 
                 [{@type.:Application _ expected_parameter expected_abstraction}
                  {@type.:Application _ actual_parameter actual_abstraction}]
                 (monad.let try.monad
                            [it (context expected_abstraction actual_abstraction it)]
                            (context expected_parameter actual_parameter it))
                 
                 [{@type.:Extension _ expected_name expected_parameters}
                  {@type.:Extension _ actual_name actual_parameters}]
                 (.if (.and (name.= expected_name actual_name)
                            (natural.= (list.size expected_parameters)
                                       (list.size actual_parameters)))
                      (list.mix' try.monad
                                 (function (_ [expected_parameter actual_parameter])
                                           (context expected_parameter actual_parameter))
                                 (list.zipped_2 expected_parameters actual_parameters)
                                 it)
                      (exception.except ..cannot_extract_context [alias original_expected original_actual]))

                 else
                 (exception.except ..cannot_extract_context [alias original_expected original_actual]))))

(the (substitution context)
     (-> Context analysis.Term
         (Try analysis.Term))
     (.function (substitution it)
                (when it
                      (term.new _ @ name)
                      (try.and/or (dictionary.value @ context)
                                  {try.:Success it})

                      (^.or {@type.:Simple @ _}
                            {@type.:Reference @ _})
                      {try.:Success it}

                      {@type.:Complex @ it}
                      (when it
                            {@type.:Complex_Variant [lefts right? it]}
                            (monad.let try.monad
                                       [it (substitution it)]
                                       (pure {@type.:Complex @ {@type.:Complex_Variant [lefts right? it]}}))
                            
                            {@type.:Complex_Tuple it}
                            (monad.let [! try.monad]
                                       [it (list.each' ! substitution it)]
                                       (pure {@type.:Complex @ {@type.:Complex_Tuple it}})))
                      
                      {@type.:Application @ parameter abstraction}
                      (monad.let try.monad
                                 [parameter (substitution parameter)
                                  abstraction (substitution abstraction)]
                                 (pure {@type.:Application @ parameter abstraction}))

                      {@type.:Abstraction @ environment body}
                      (monad.let try.monad
                                 [body (substitution body)]
                                 (pure {@type.:Abstraction @ environment body}))

                      {@type.:When _ input
                                   [[output_head_pattern output_head]
                                    output_tail]}
                      (monad.let [! try.monad]
                                 [input (substitution input)
                                  output_head (substitution output_head)
                                  output_tail (list.each' ! (.function (_ [pattern body])
                                                                       (monad.let !
                                                                                  [body (substitution body)]
                                                                                  (pure [pattern body])))
                                                          output_tail)]
                                 (pure {@type.:When _ input
                                                    [[output_head_pattern output_head]
                                                     output_tail]}))

                      {@type.:Extension _ name every_parameter}
                      (monad.let [! try.monad]
                                 [every_parameter (list.each' ! substitution every_parameter)]
                                 (pure {@type.:Extension _ name every_parameter})))))

(the (substitution' context it)
     (-> Context ?.Proposition
         (Try ?.Proposition))
     (when it
           {?.:Identity this that}
           (monad.let try.monad
                      [this (substitution context this)
                       that (substitution context that)]
                      (pure {?.:Identity this that}))

           {?.:Disjunction this that}
           (monad.let try.monad
                      [this (substitution' context this)
                       that (substitution' context that)]
                      (pure {?.:Disjunction this that}))

           {?.:Conjunction this that}
           (monad.let try.monad
                      [this (substitution' context this)
                       that (substitution' context that)]
                      (pure {?.:Conjunction this that}))

           {?.:Entailment premise conclusion}
           (monad.let try.monad
                      [premise (substitution' context premise)
                       conclusion (substitution' context conclusion)]
                      (pure {?.:Entailment premise conclusion}))))

(the .public (=' identity
                 context it)
     (-> ?.Proposition
         Rule)
     (monad.let try.monad
                [[slow fast] (?.identity identity)
                 context (..context (its in.:alias context) slow it ..empty)]
                (substitution context fast)))

(the .public proposition
     (for_any (_ proof)
              (-> [?.Proposition proof]
                  ?.Proposition))
     pair.left)

(the .public (= [identity _])
     (for_any (_ proof)
              (-> [?.Proposition proof]
                  Rule))
     (=' identity))

(template.with [,name ,extension ,function]
               [(the .public ,name
                     Rule
                     (function (_ context it)
                               (when it
                                     {@type.:Extension @ [.prelude (static.text (extension.synthesis (name.proper (.name ,extension))))]
                                                       (list (analysis.integer _ this)
                                                             (analysis.integer _ that))}
                                     {try.:Success (analysis.integer @ (,function this that))}

                                     else
                                     (exception.except in.not_valid [[(name.module (.name .._))
                                                                      (name.proper (.name ,name))]
                                                                     it]))))]

               [[+ .i64_+# integer.+]
                [- .i64_-# integer.-]
                [x .int_x# integer.x]
                [/ .int_/# integer./]
                [% .int_%# integer.%]
                ])

(the .public (let by_value by_body
                  context it)
     (-> Rule Rule
         Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.let))]
                             (list 'value
                                   'body)}
           (monad.let try.monad
                      ['value (by_value context 'value)
                       'body ((..of in.any (list in.any)) context {@type.:Application @ 'value 'body})]
                      (by_body context 'body))

           else
           (exception.except in.not_valid [(.name ..let) it])))
