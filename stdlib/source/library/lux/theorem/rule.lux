(.using
 [library
  [lux (.except and if local by let name)
   [abstract
    [[0] monad]]
   [error
    [[0] try (.only Try)]
    [[0] exception]]
   [data
    [[0] pair]
    [collection
     [[0] list (.open functor)]
     [[0] dictionary (.only Dictionary)]]]
   [logic
    [[0] bit]]
   [math
    [number
     [/64
      [[0] natural]
      [[0] integer]]]]
   [[0] meta (.only)
    [[0] binding]
    [[0] name]
    [[0] static]
    [[0] provenance]]
   [macro
    [[0] template]
    [[0] expansion]]
   [compiler
    [["@" 0] type]
    [[0] extension (.only)
     [[1 "/" 0] lux]]
    [[0] reference (.only)
     [[0] variable]]
    [language
     [lux
      [[0] analysis]]]]]]
 [//
  [["?"] proposition]
  [["in"] substitution (.only Substitution Rule)]
  [[0] term]
  [[0] context (.only Context)]])

(the (substitution_of_local expectation value)
     (-> @type.Register analysis.Term
         (Change analysis.Term))
     (function (substitution_of_local it)
               (when it
                     {@type.:Simple @ _}
                     it
                     
                     {@type.:Complex @ it}
                     {@type.:Complex @ (when it
                                             {@type.:Complex_Variant it}
                                             {@type.:Complex_Variant (revised @type.:value substitution_of_local it)}
                                             
                                             {@type.:Complex_Tuple it}
                                             {@type.:Complex_Tuple (list:each substitution_of_local it)})}
                     
                     {@type.:Reference @ it'}
                     (when it'
                           {@type.:Variable_Reference it'}
                           (when it'
                                 {@type.:Local reality}
                                 (.if (natural.= expectation reality)
                                      value
                                      it)
                                 
                                 {@type.:Foreign it'}
                                 it)
                           
                           {@type.:Constant_Reference it'}
                           it)

                     {@type.:When @ input [head tail]}
                     {@type.:When @ (substitution_of_local input)
                                  [(revised @type.:then substitution_of_local head)
                                   (list:each (revised @type.:then substitution_of_local) tail)]}
                     
                     {@type.:Abstraction @ environment body}
                     {@type.:Abstraction @ (list:each substitution_of_local environment)
                                         body}
                     
                     {@type.:Application @ parameter abstraction}
                     {@type.:Application @ (substitution_of_local parameter)
                                         (substitution_of_local abstraction)}
                     
                     {@type.:Extension @ name parameters}
                     {@type.:Extension @ name (list:each substitution_of_local parameters)})))

(the .public (substitution_of_variable expectation value)
     (-> @type.Register analysis.Term
         (Change analysis.Term))
     (function (substitution_of_variable it)
               (when it
                     (term.new _ reality name)
                     (.if (natural.= expectation reality)
                          value
                          it)
                     
                     {@type.:Simple _}
                     it
                     
                     {@type.:Complex @ it}
                     {@type.:Complex @ (when it
                                             {@type.:Complex_Variant it}
                                             {@type.:Complex_Variant (revised @type.:value substitution_of_variable it)}
                                             
                                             {@type.:Complex_Tuple it}
                                             {@type.:Complex_Tuple (list:each substitution_of_variable it)})}
                     
                     {@type.:Reference _}
                     it

                     {@type.:When @ input [head tail]}
                     {@type.:When @ (substitution_of_variable input)
                                  [(revised @type.:then substitution_of_variable head)
                                   (list:each (revised @type.:then substitution_of_variable) tail)]}
                     
                     {@type.:Abstraction @ environment body}
                     {@type.:Abstraction @ (list:each substitution_of_variable environment)
                                         body}
                     
                     {@type.:Application @ parameter abstraction}
                     {@type.:Application @ (substitution_of_variable parameter)
                                         (substitution_of_variable abstraction)}
                     
                     {@type.:Extension @ name parameters}
                     {@type.:Extension @ name (list:each substitution_of_variable parameters)})))

(every .public Environment
       (Dictionary @type.Variable analysis.Term))

(the (beta_reduction local)
     (-> Environment
         (Change analysis.Term))
     (function (beta_reduction it)
               (when it
                     {@type.:Simple @ _}
                     it
                     
                     {@type.:Complex @ it}
                     {@type.:Complex @ (when it
                                             {@type.:Complex_Variant it}
                                             {@type.:Complex_Variant (revised @type.:value beta_reduction it)}
                                             
                                             {@type.:Complex_Tuple it}
                                             {@type.:Complex_Tuple (list:each beta_reduction it)})}
                     
                     {@type.:Reference @ it'}
                     (when it'
                           {@type.:Variable_Reference it'}
                           (|> local
                               (dictionary.value it')
                               (try.else it))
                           
                           {@type.:Constant_Reference _}
                           it)
                     
                     {@type.:When @ input [head tail]}
                     {@type.:When @ (beta_reduction input)
                                  [(revised @type.:then beta_reduction head)
                                   (list:each (revised @type.:then beta_reduction) tail)]}
                     
                     {@type.:Abstraction @ environment body}
                     {@type.:Abstraction @ (list:each beta_reduction environment)
                                         body}
                     
                     {@type.:Application @ parameter abstraction}
                     {@type.:Application @ (beta_reduction parameter)
                                         (beta_reduction abstraction)}
                     
                     {@type.:Extension @ name parameters}
                     {@type.:Extension @ name (list:each beta_reduction parameters)})))

(the .public (reification lux it)
     Rule
     (when it
           {@type.:Application @ parameter {@type.:Abstraction @ environment body}}
           (.let [local (|> environment
                            list.enumeration
                            (list:each (function (_ [foreign term])
                                                 [{@type.:Foreign foreign}
                                                  term]))
                            (dictionary.of_list variable.hash)
                            (dictionary.has {@type.:Local 0} {@type.:Abstraction @ environment body})
                            (dictionary.has {@type.:Local 1} parameter))]
                 {try.:Success (beta_reduction local body)})

           else
           (exception.except in.no_application [it])))

(the .public (and before after
                  context it)
     (for_any (_ before intermediate after)
              (-> (in.Fact before intermediate) (in.Fact intermediate after)
                  (in.Fact before after)))
     (monad.let try.monad
                [it (before context it)]
                (after context it)))

(the .public (of by_abstraction every_parameter)
     (-> Rule (List Rule)
         Rule)
     (list.mix (function (_ by_parameter by_abstraction)
                         (..and (in.application by_abstraction by_parameter)
                                ..reification))
               every_parameter
               by_abstraction))

(the (global_definition name lux)
     (-> Name Lux
         (Try analysis.Term))
     (<| (meta.value lux)
         (monad.let meta.monad
                    [[type expression value] (binding.export name)]
                    (when expression
                          {.:Some [original after_optimization]}
                          (pure original)

                          {.:None}
                          (meta.failure "")))))

(the .public (definition context it)
     Rule
     (when it
           {@type.:Reference _ {@type.:Constant_Reference @}}
           (all try.and/or
                (global_definition @ (its in.:every_global context))
                (exception.except in.not_valid [(.name ..definition) it]))

           else
           (exception.except in.not_valid [(.name ..definition) it])))

(the .public (name name
                   context it)
     (-> Name
         Rule)
     (all try.and/or
          (monad.let try.monad
                     [reference (global_definition name (its in.:every_global context))]
                     (.if (.by analysis.equality = reference it)
                          (pure (analysis.constant provenance.dummy name))
                          (exception.except in.not_valid [(.name ..name) it])))
          (exception.except in.not_valid [(.name ..name) it])))

(the .public (if by_reality by_case
                 context it)
     (-> Rule Rule
         Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.if))]
                             (list this then else)}
           (monad.let [! try.monad]
                      [this (by_reality context this)]
                      (when this
                            {@type.:Simple @ {@type.:Simple_Bit this}}
                            (by_case context (.if this
                                                  then
                                                  else))

                            else
                            (exception.except in.not_valid [(.name ..if) it])))

           else
           (exception.except in.not_valid [(.name ..if) it])))

(the .public (let_pair by_whole by_each_part
                       context it)
     (-> Rule Rule
         Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.let_pair))]
                             (list 'whole
                                   'body)}
           (monad.let try.monad
                      ['whole (by_whole context 'whole)]
                      (when 'whole
                            (term.pair @ 'left 'right)
                            (monad.let try.monad
                                       ['body ((..of in.any (list in.any in.any))
                                               context
                                               {@type.:Application @ 'right {@type.:Application @ 'left 'body}})]
                                       (by_each_part context 'body))

                            else
                            (exception.except in.not_valid [(.name ..let_pair) it])))

           else
           (exception.except in.not_valid [(.name ..let_pair) it])))

(<| (the .public (let_pair' by_whole by_each_part
                            context it)
         (-> Rule (in.Case ?.Proposition)
             Rule))
    (expansion.let [,failure (exception.except in.not_valid [(.name ..let_pair') it])])
    (when it
          {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.let_pair))]
                            (list 'whole
                                  'body)}
          (monad.let try.monad
                     ['whole (by_whole context 'whole)
                      foreign (when 'body
                                    (<| {@type.:Abstraction @ closure_of_left} {@type.:Abstraction @ closure_of_right} 'body)
                                    (list.one (function (_ [index value])
                                                        (when value
                                                              (analysis.local @ 1)
                                                              {.:Some index}

                                                              else
                                                              {.:None}))
                                              (list.enumeration closure_of_right))

                                    else
                                    ,failure)
                      .let ['left (analysis.foreign provenance.dummy foreign)
                            'right (analysis.local provenance.dummy 1)
                            identity {?.:Identity [?.:slow (term.pair provenance.dummy 'left 'right)
                                                   ?.:fast 'whole]}]
                      'body ((..of in.any (list in.any in.any)) context (|> 'body {@type.:Application @ 'left} {@type.:Application @ 'right}))]
                     ((by_each_part identity) context 'body))

          else
          ,failure))

(every .public Case
       Bit)

(template.with [,value ,name]
               [(the .public ,name Case ,value)]

               [[0b left]
                [1b right]
                ])

(the .public (if_case by_whole expectation by_case
                      context it)
     (-> Rule Case Rule
         Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.if_case))]
                             (list 'whole
                                   'left
                                   'right)}
           (monad.let try.monad
                      ['whole (by_whole context 'whole)]
                      (when 'whole
                            {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.case))]
                                              (list (analysis.bit @ reality)
                                                    'case)}
                            (.if (bit.= expectation reality)
                                 (monad.let try.monad
                                            ['case ((..of in.any (list in.any)) context {@type.:Application @ 'case (.if expectation 'right 'left)})]
                                            (by_case context 'case))
                                 (exception.except in.not_valid [(.name ..if_case) it]))

                            else
                            (exception.except in.not_valid [(.name ..if_case) it])))

           else
           (exception.except in.not_valid [(.name ..if_case) it])))

(the .public (=' identity
                 context it)
     (-> ?.Proposition
         Rule)
     (monad.let try.monad
                [[slow fast] (?.identity identity)
                 context (context.new (its in.:alias context) slow it)]
                (context.substitution context fast)))

(the .public proposition
     (for_any (_ proof)
              (-> [?.Proposition proof]
                  ?.Proposition))
     pair.left)

(the .public (= [identity _])
     (for_any (_ proof)
              (-> [?.Proposition proof]
                  Rule))
     (=' identity))

(template.with [,name ,extension ,function]
               [(the .public ,name
                     Rule
                     (function (_ context it)
                               (when it
                                     {@type.:Extension @ [.prelude (static.text (extension.synthesis (name.proper (.name ,extension))))]
                                                       (list (analysis.integer _ this)
                                                             (analysis.integer _ that))}
                                     {try.:Success (analysis.integer @ (,function this that))}

                                     else
                                     (exception.except in.not_valid [[(name.module (.name .._))
                                                                      (name.proper (.name ,name))]
                                                                     it]))))]

               [[+ .i64_+# integer.+]
                [- .i64_-# integer.-]
                [x .int_x# integer.x]
                [/ .int_/# integer./]
                [% .int_%# integer.%]
                ])

(the .public (let by_value by_body
                  context it)
     (-> Rule Rule
         Rule)
     (when it
           {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.let))]
                             (list 'value
                                   'body)}
           (monad.let try.monad
                      ['value (by_value context 'value)
                       'body ((..of in.any (list in.any)) context {@type.:Application @ 'value 'body})]
                      (by_body context 'body))

           else
           (exception.except in.not_valid [(.name ..let) it])))
