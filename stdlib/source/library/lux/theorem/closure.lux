(.using
 [library
  [lux (.except and)
   [abstract
    [[0] monad]]
   [error
    [[0] try (.only Try)]]
   [data
    [collection
     [[0] list]]]
   [meta
    [[0] provenance]]
   [compiler
    [language
     [lux
      [[0] analysis]]]]]]
 [//
  [state (.only State)]
  [["?"] proposition]
  [[0] term]])

(every .public (Closure it)
       (-> (List analysis.Term) Natural State
           (Try [Natural it])))

(<| (the .public (any by_it)
         (-> term.Rule
             (Closure ?.Proposition)))
    (function (_ closure foreign state))
    (monad.let try.monad
               [term (list.item foreign closure)
                term (by_it state term)])
    (pure [(++ foreign) {?.:Identity [?.:slow (analysis.foreign provenance.dummy foreign)
                                      ?.:fast term]}]))

(<| (the .public (and this that)
         (for_any (_ this that)
                  (-> (Closure this) (Closure that)
                      (Closure (And this that)))))
    (function (_ closure foreign state))
    (monad.let try.monad
               [[foreign this] (this closure foreign state)
                [foreign that] (that closure foreign state)])
    (pure [foreign [this that]]))
