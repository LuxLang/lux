(.using
 [library
  [lux (.except Pattern
                let if quote and type)
   [abstract
    ["?" projection]
    ["[0]" equality (.only Equality)]
    ["[0]" monad]]
   [data
    ["[0]" case]
    ["[0]" pair]
    ["[0]" text]
    [collection
     ["[0]" stack]
     ["[0]" list (.open monad monoid)
      ["?[1]" \\projection]
      ["[0]" property]]]]
   ["[0]" meta (.only)
    ["[0]" name]
    ["[0]" provenance]
    ["[0]" static]
    ["[0]" binding]
    ["[0]" module]
    ["[0]" code (.only)
     ["?[1]" \\projection (.only Projection)]]]
   [compiler
    ["@[0]" type (.only Simple Complex Pattern)]
    ["[0]" reference]
    ["[0]" extension (.only)
     ["[1]/[0]" lux]]
    [language
     [lux
      ["[0]" phase]
      ["[0]" analysis (.only)
       ["[1]/[0]" type]
       ["[1]/[0]" simple]
       ["[1]/[0]" complex]
       ["[1]/[0]" pattern]
       ["[0]" scope]]]]
    [meta
     [archive (.only Archive)]]]
   ["[0]" type]
   ["[0]" macro (.only)
    ["[0]" template]
    ["[0]" syntax]
    ["[0]" expansion]]
   [math
    [number
     [/64
      ["n" natural]]]]
   ["[0]" error (.only)
    ["[0]" try (.only Try)]
    ["[0]" exception (.only Exception)]]
   [logic
    ["[0]" bit]]
   [aspect
    ["[0]" view]]]])

(comment "https://en.wikipedia.org/wiki/Identity_(mathematics)"
         (every .public Identity
                (Record [:slow analysis.Term
                         :fast analysis.Term])))

(every .public (Proposition _)
       (Variant {:Identity Identity}
                {:Disjunction [Proposition Proposition]}
                {:Conjunction [Proposition Proposition]}
                {:Entailment [Proposition Proposition]}))

(every .public Disjunction
       [Proposition Proposition])

(every .public Conjunction
       [Proposition Proposition])

(comment "https://en.wikipedia.org/wiki/Logical_consequence"
         (every .public Entailment
                [Proposition Proposition]))

(the equality_of_identity
     (Equality Identity)
     (pair.equality analysis.equality analysis.equality))

(the equality
     (Equality Proposition)
     (equality.recursive
      (function (_ equality)
                (.let [pair_equality (all pair.equality
                                          equality
                                          equality)]
                      (all case.equality
                           ..equality_of_identity
                           pair_equality
                           pair_equality
                           pair_equality)))))

(.the .public (in_reverse it)
      (Change Proposition)
      (when it
            {:Identity it}
            {:Identity (pair.in_reverse it)}
            
            else
            it))

(the (code_of_name it)
     (code.Injection Name)
     (code.tuple (.list (code.text (name.module it))
                        (code.text (name.proper it)))))

(the (code_of_provenance it)
     (code.Injection Provenance)
     (` [(, (code.text (its .:module it)))
         (, (code.natural (its .:line it)))
         (, (code.natural (its .:column it)))]))

(the (code_of_simple it)
     (code.Injection Simple)
     (`` (when it
               {@type.:Simple_Unit}
               (` {@type.:Simple_Unit})

               (,, (template.with [,tag ,code]
                                  [{,tag it}
                                   (` {,tag (, (,code it))})]

                                  [[@type.:Simple_Bit code.bit]
                                   [@type.:Simple_Natural code.natural]
                                   [@type.:Simple_Integer code.integer]
                                   [@type.:Simple_Revolution code.revolution]
                                   [@type.:Simple_Real code.real]
                                   [@type.:Simple_Text code.text]])))))

(the (code_of_complex code it)
     (for_any (_ it)
              (-> (code.Injection it)
                  (code.Injection (Complex it))))
     (when it
           {@type.:Complex_Variant it}
           (` {@type.:Complex_Variant [@type.:lefts (, (code.natural (its @type.:lefts it)))
                                       @type.:right? (, (code.bit (its @type.:right? it)))
                                       @type.:choice (, (code (its @type.:choice it)))]})
           
           {@type.:Complex_Tuple it}
           (` {@type.:Complex_Tuple (.list (,* (list:each code it)))})))

(the (code_of_pattern it)
     (code.Injection Pattern)
     (when it
           {@type.:Simple_Pattern it}
           (` {@type.:Simple_Pattern (, (code_of_simple it))})
           
           {@type.:Complex_Pattern it}
           (` {@type.:Complex_Pattern (, (code_of_complex code_of_pattern it))})
           
           {@type.:List_Pattern it}
           (` {@type.:List_Pattern (.list (,* (list:each code_of_pattern it)))})
           
           {@type.:Bind_Pattern it}
           (` {@type.:Bind_Pattern (, (code.natural it))})))

(the (code_of_branch code_of_analysis it)
     (-> (code.Injection analysis.Term)
         (code.Injection analysis.Branch))
     (` [@type.:when (, (code_of_pattern (its @type.:when it)))
         @type.:then (, (code_of_analysis (its @type.:then it)))]))

(the (code_of_match code_of_analysis [head tail])
     (-> (code.Injection analysis.Term)
         (code.Injection analysis.Match))
     (` [(, (code_of_branch code_of_analysis head))
         (.list (,* (list:each (code_of_branch code_of_analysis) tail)))]))

(the .public (code_of_analysis it)
     (code.Injection analysis.Term)
     (when it
           {@type.:Simple @ it}
           (` {@type.:Simple (, (code_of_provenance @))
                             (, (code_of_simple it))})
           
           {@type.:Complex @ it}
           (` {@type.:Complex (, (code_of_provenance @))
                              (, (code_of_complex code_of_analysis it))})
           
           {@type.:Reference @ it}
           (` {@type.:Reference (, (code_of_provenance @))
                                (, (when it
                                         {@type.:Variable_Reference it}
                                         (` {@type.:Variable_Reference (, (when it
                                                                                {@type.:Local it}
                                                                                (` {@type.:Local (, (code.natural it))})
                                                                                
                                                                                {@type.:Foreign it}
                                                                                (` {@type.:Foreign (, (code.natural it))})))})
                                         
                                         {@type.:Constant_Reference it}
                                         (` {@type.:Constant_Reference (, (code_of_name it))})))})
           
           {@type.:When @ input output}
           (` {@type.:When (, (code_of_provenance @))
                           (, (code_of_analysis input))
                           (, (code_of_match code_of_analysis output))})
           
           {@type.:Abstraction @ environment body}
           (` {@type.:Abstraction (, (code_of_provenance @))
                                  (.list (,* (list:each code_of_analysis environment)))
                                  (, (code_of_analysis body))})
           
           {@type.:Application @ parameter abstraction}
           (` {@type.:Application (, (code_of_provenance @))
                                  (, (code_of_analysis parameter))
                                  (, (code_of_analysis abstraction))})
           
           {@type.:Extension @ name parameters}
           (` {@type.:Extension (, (code_of_provenance @))
                                (, (code_of_name name))
                                (.list (,* (list:each code_of_analysis parameters)))})))

(every Variable
       [Text Code])

(the each_variable
     (Projection (List Variable))
     (?code.tuple (?.some (?.and ?code.local ?list.any))))

(every Body
       Code)

(the body
     (Projection Body)
     ?list.any)

(every Simple_Let
       [(List Variable)
        Body])

(the simple_let
     (Projection Simple_Let)
     (?.and each_variable
            body))

(the each_type_variable
     (Projection (List Text))
     (?code.tuple (?.some ?code.local)))

(every Type_Variable
       Text)

(every Complex_Let
       [(List Type_Variable)
        Simple_Let])

(the complex_let
     (Projection Complex_Let)
     (?.and each_type_variable
            simple_let))

(every Any_Let
       (Variant {:Complex Complex_Let}
                {:Simple Simple_Let}))

(the any_let
     (Projection Any_Let)
     (all ?.or
          complex_let
          simple_let))

(every .public Context
       (Record [:each_type (property.List Code)
                :each_term (List [Text Code])
                :each_substitution (List [Text Code])]))

(the .public empty
     Context
     [:each_type (list)
      :each_term (list)
      :each_substitution (list)])

(the (composite addition so_far)
     (-> Context Context
         Context)
     [:each_type (list:composite (its :each_type so_far) (its :each_type addition))
      :each_term (list:composite (its :each_term so_far) (its :each_term addition))
      :each_substitution (list:composite (its :each_substitution so_far) (its :each_substitution addition))])

(every .public (Proposition' it)
       (-> Context
           (-> analysis.Phase Archive
               (analysis.Operation it))))

(the (let' addition it
           context)
     (for_any (_ it)
              (-> Context
                  (Change (Proposition' it))))
     (it (composite addition context)))

(the (quote it)
     (Change Code)
     (` ((,' .') (, it))))

(the (every_parameter it)
     (-> (List [Text Code])
         Code)
     (` (.list (,* (list:each (function (_ [name type])
                                        (` [(, (code.text name))
                                            (, (..quote type))]))
                              it)))))

(syntax.the .public (let [it any_let])
            (when it
                  {:Complex [each_type each_term body]}
                  (monad.let [! meta.monad]
                             [each_type (list.each' ! (function (_ name)
                                                                (monad.let !
                                                                           [type analysis/type.existential]
                                                                           (pure [name (type.code type)])))
                                                    each_type)
                              .let ['each_type (|> each_type
                                                   (list:each (function (_ [name type])
                                                                        (list (code.local name) type)))
                                                   list:conjoint)
                                    each_term (list:each (function (_ [name type])
                                                                   [name (` (.let [(,* 'each_type)]
                                                                                  (.type (, type))))])
                                                         each_term)]]
                             (pure (list (` (..let' [..:each_type (, (every_parameter each_type))
                                                     ..:each_term (, (every_parameter each_term))
                                                     ..:each_substitution (.list)]
                                                    (, body))))))
                  
                  {:Simple [each_term body]}
                  (monad.let [! meta.monad]
                             [.let [each_term (list:each (function (_ [name type])
                                                                   [name (` (.type (, type)))])
                                                         each_term)]]
                             (pure (list (` (..let' [..:each_type (.list)
                                                     ..:each_term (, (every_parameter each_term))
                                                     ..:each_substitution (.list)]
                                                    (, body))))))))

(the current_module
     (name.module (name .._)))

(`` (template.the .public (term ,@ ,identity ,name)
                  [{@type.:Extension ,@ [(,, (static ..current_module)) "term"]
                                     (.list (analysis.natural ,@ ,identity)
                                            (analysis.text ,@ ,name))}]))

(`` (<| (template.the .public ('case ,@ ,case ,value))
        [{@type.:Extension ,@ [.prelude (,, (static.text (extension.analysis extension/lux.case)))]
                           (.list (analysis.bit ,@ ,case)
                                  ,value)}]))

(`` (<| (template.the .public ('pair ,@ ,left ,right))
        [{@type.:Extension ,@ [.prelude (,, (static.text (extension.analysis extension/lux.pair)))]
                           (.list ,left ,right)}]))

(the (analysis nesting each_variable)
     (-> Natural (List Text)
         (Change analysis.Term))
     (function (analysis it)
               (when it
                     {@type.:Simple @ _}
                     it
                     
                     {@type.:Complex @ it}
                     {@type.:Complex @ (when it
                                             {@type.:Complex_Variant it}
                                             {@type.:Complex_Variant (revised @type.:choice analysis it)}
                                             
                                             {@type.:Complex_Tuple it}
                                             {@type.:Complex_Tuple (list:each analysis it)})}
                     
                     {@type.:Reference @ it'}
                     (when it'
                           {@type.:Variable_Reference it'}
                           (when it'
                                 {@type.:Local local}
                                 (.if (n.< nesting local)
                                      (|> each_variable
                                          (list.item local)
                                          (try.else "")
                                          (..term provenance.dummy local))
                                      {@type.:Reference @ {@type.:Variable_Reference {@type.:Local (n.- nesting local)}}})
                                 
                                 {@type.:Foreign _}
                                 it)
                           
                           {@type.:Constant_Reference _}
                           it)
                     
                     {@type.:When @ input [head tail]}
                     {@type.:When @ (analysis input) [(revised @type.:then analysis head)
                                                      (list:each (revised @type.:then analysis) tail)]}
                     
                     {@type.:Abstraction @ environment body}
                     {@type.:Abstraction @ (list:each analysis environment) body}
                     
                     {@type.:Application @ parameter abstraction}
                     {@type.:Application @ (analysis parameter) (analysis abstraction)}
                     
                     {@type.:Extension @ name parameters}
                     {@type.:Extension @ name (list:each analysis parameters)})))

(the simple_=
     (Projection [Code Code])
     (?.and ?list.any
            ?list.any))

(the complex_=
     (Projection [Code Code Code])
     (?.and ?list.any
            simple_=))

(the any_=
     (Projection (Or [Code Code Code]
                     [Code Code]))
     (?.or complex_=
           simple_=))

(the (clean_term nesting it)
     (-> Natural
         (Change analysis.Term))
     (.if (n.= 0 nesting)
          it
          (when it
                {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.let))]
                                  (list input register it)}
                (clean_term (-- nesting) it)

                else
                (undefined))))

(the (type_in_context [each_type each_term each_substitution] it)
     (-> Context
         (Change Code))
     (` (.let [(,* (|> each_type
                       (list:each (function (_ [name type])
                                            (list (code.local name) type)))
                       list:conjoint))]
              (, it))))

(the each_type
     (property.List Code)
     property.empty)

(syntax.the .public (type [name ?code.local])
            (monad.let meta.monad
                       [[exported definition] (binding.definition (..name ..each_type))]
                       (when definition
                             {.:Definition [type expression value]}
                             (when (|> value
                                       (as (-> Any (type_of ..each_type)))
                                       (property.value name))
                                   {try.:Success it}
                                   (pure (list it))
                                   
                                   {try.:Failure _}
                                   (meta.failure ""))

                             {.:Alias real_name}
                             (meta.failure ""))))

(the (with_each_type new_value body
                     lux)
     (for_any (_ it)
              (-> (type_of ..each_type)
                  (Change (Meta it))))
     (monad.let try.monad
                [.let [[name_of_module proper_name] (..name ..each_type)
                       global' (is (Change [Bit Global])
                                   (function (_ [exported? old])
                                             [exported? (when old
                                                              {.:Definition [type expression old_value]}
                                                              {.:Definition [type expression new_value]}

                                                              {.:Alias real_name}
                                                              old)]))
                       every_definition' (is (Change (property.List [Bit Global]))
                                             (property.revised proper_name global'))
                       module' (is (Change Module)
                                   (revised .:definitions every_definition'))
                       every_module' (is (Change (property.List Module))
                                         (property.revised name_of_module module'))]
                 [_ it] (body (revised .:modules every_module' lux))]
                (pure [lux it])))

(the (='' type left right
          context analysis archive)
     (-> Type Code Code
         (Proposition' Proposition))
     (<| (.let [[each_type each_term each_substitution] context
                nesting (list.size each_term)
                type_context (|> each_type
                                 (list:each (function (_ [name value])
                                                      (list (code.local name)
                                                            (type_in_context context value))))
                                 list:conjoint)
                each_variable (list:each pair.left each_term)
                each_term (|> each_term
                              (list:each (function (_ [name type])
                                                   (list (code.local name)
                                                         (` (.as (.let [(,* type_context)]
                                                                       (.-> .Any (, type)))
                                                                 [])))))
                              list:conjoint)
                each_substitution (|> each_substitution
                                      (list:each (function (_ [name term])
                                                           (list (` (, (code.local name)))
                                                                 (` (.these (, term))))))
                                      list:conjoint)])
         (with_each_type each_type)
         (monad.let [! phase.monad]
                    [left (analysis/type.with type
                                              (analysis archive (` (<| (expansion.let [(,* each_substitution)])
                                                                       (.let [(,* each_term)])
                                                                       (, left)))))
                     right (analysis/type.with type
                                               (analysis archive (` (<| (expansion.let [(,* each_substitution)])
                                                                        (.let [(,* each_term)])
                                                                        (, right)))))])
         (pure {:Identity [(..analysis nesting each_variable (clean_term nesting left))
                           (..analysis nesting each_variable (clean_term nesting right))]})))

(the (=' it
         [each_type each_term each_substitution]
         analysis archive)
     (-> (Or [Code Code Code]
             [Code Code])
         (Proposition' Proposition))
     (when it
           {.:Left [type left right]}
           (monad.let [! phase.monad]
                      [type (meta.eval Type (` (.let [(,* (|> each_type
                                                              (list:each (function (_ [name type])
                                                                                   (list (code.local name) type)))
                                                              list:conjoint))]
                                                     (.type (, type)))))]
                      (='' (as (-> Any Type) type) left right
                           [each_type each_term each_substitution]
                           analysis archive))
           
           {.:Right [left right]}
           (='' Any left right
                [each_type each_term each_substitution]
                analysis archive)))

(syntax.the .public (= [it any_=])
            (pure (list (when it
                              {.:Left [type left right]}
                              (` (..=' {.:Left [(, (..quote type))
                                                (, (..quote left))
                                                (, (..quote right))]}))
                              
                              {.:Right [left right]}
                              (` (..=' {.:Right [(, (..quote left))
                                                 (, (..quote right))]}))))))

(the .public (if premise conclusion
                 context analysis archive)
     (-> (Proposition' Proposition) (Proposition' Proposition)
         (Proposition' Proposition))
     (monad.let phase.monad
                [premise (premise context analysis archive)
                 conclusion (conclusion context analysis archive)]
                (pure {:Entailment [premise conclusion]})))

(the .public (or this that
                 context analysis archive)
     (-> (Proposition' Proposition) (Proposition' Proposition)
         (Proposition' Proposition))
     (monad.let phase.monad
                [this (this context analysis archive)
                 that (that context analysis archive)]
                (pure {:Disjunction [this that]})))

(the .public (and this that
                  context analysis archive)
     (-> (Proposition' Proposition) (Proposition' Proposition)
         (Proposition' Proposition))
     (monad.let phase.monad
                [this (this context analysis archive)
                 that (that context analysis archive)]
                (pure {:Conjunction [this that]})))

(the .public (as_code it)
     (code.Injection Proposition)
     (`` (when it
               (,, (template.with [,tag ,as_code]
                                  [{,tag [left right]}
                                   (` {,tag [(, (,as_code left))
                                             (, (,as_code right))]})]

                                  [[:Identity code_of_analysis]
                                   [:Disjunction as_code]
                                   [:Conjunction as_code]
                                   [:Entailment as_code]])))))

(the (tail_of_tuple it)
     (-> analysis.Term
         (Stack analysis.Term))
     (when it
           (..'pair @ 'left 'right)
           (stack.partial 'left (tail_of_tuple 'right))

           else
           (stack it)))

(the (nested_variant [every_left left_or_right 'term])
     (Change [Natural Bit analysis.Term])
     [(++ every_left) left_or_right 'term])

(the (as_variant left_or_right 'term)
     (-> Bit analysis.Term
         [Natural Bit analysis.Term])
     (when left_or_right
           0b [0 left_or_right 'term]
           1b (when 'term
                    (..'case @ left_or_right 'term)
                    (nested_variant (as_variant left_or_right 'term))

                    else
                    [0 left_or_right 'term])))

(the .public (analysis:as_text relative_to analysis)
     (-> module.Name
         (text.Injection analysis.Term))
     (.when analysis
            {@type.:Simple @ it}
            (analysis/simple.as_text it)
            
            {@type.:Complex @ it}
            (analysis/complex.as_text (analysis:as_text relative_to) it)
            
            {@type.:Reference @ it}
            (reference.relative relative_to it)
            
            {@type.:When @ analysis [head tail]}
            (.let [branch (is (-> analysis.Branch Text)
                              (function (_ [when then])
                                        (.text (analysis/pattern.as_text when)
                                               " " (analysis:as_text relative_to then))))]
                  (.text "(.when# "
                         (analysis:as_text relative_to analysis)
                         " "
                         (branch head)
                         (|> tail
                             (list:each (|>> branch (.text " ")))
                             text.together)
                         ")"))
            
            {@type.:Abstraction @ environment body}
            (|> (analysis:as_text relative_to body)
                (.text (|> environment
                           (list:each (analysis:as_text relative_to))
                           (text.interposed " ")
                           (text.inside ["[" "]"]))
                       " ")
                (text.inside ["(.function# " ")"]))
            
            {@type.:Application @ _}
            (.let [[abstraction parameters] (analysis.reification analysis)]
                  (|> (.text (analysis:as_text relative_to abstraction)
                             " "
                             (|> parameters
                                 (list:each (analysis:as_text relative_to))
                                 (text.interposed " ")))
                      (text.inside ["(" ")"])))

            (..term @ register name)
            (text "(" (by n.base_10 as register)
                  " " (text.as_text name)
                  ")")

            (..'case @ left_or_right 'term)
            (.let [[every_left left_or_right 'term] (as_variant left_or_right 'term)]
                  (text "{" (by n.base_10 as every_left)
                        " " (bit.as_text left_or_right)
                        " " (analysis:as_text relative_to 'term)
                        "}"))

            (..'pair @ 'left 'right)
            (|> (stack.partial 'left (tail_of_tuple 'right))
                (view.of list.stack)
                (list:each (analysis:as_text relative_to))
                (text.interposed " ")
                (text.inside ["[" "]"]))
            
            {@type.:Extension @ name parameters}
            (|> parameters
                (list:each (|>> (analysis:as_text relative_to) (.text " ")))
                text.together
                (.text (by (name.relative relative_to) as name))
                (text.inside ["(" ")"]))))

(the .public (as_text relative_to it)
     (-> module.Name
         (text.Injection Proposition))
     (when it
           {:Identity this that}
           (text "(="
                 " " (analysis:as_text relative_to this)
                 " " (analysis:as_text relative_to that)
                 ")")

           {:Disjunction this that}
           (text "(|"
                 " " (as_text relative_to this)
                 " " (as_text relative_to that)
                 ")")

           {:Conjunction this that}
           (text "(&"
                 " " (as_text relative_to this)
                 " " (as_text relative_to that)
                 ")")

           {:Entailment premise conclusion}
           (text "(=>"
                 " " (as_text relative_to premise)
                 " " (as_text relative_to conclusion)
                 ")")))

(template.with [,check ,tag ,type ,exception]
               [(exception.the .public (,exception [it])
                               (Exception [Proposition])
                               (exception.report
                                (list ["Proposition" (code.as_text (as_code it))])))

                (the .public (,check it)
                     (-> Proposition
                         (Try ,type))
                     (when it
                           {,tag it}
                           {try.:Success it}

                           else
                           (exception.except ,exception [it])))]

               [[identity :Identity Identity not_identity]
                [disjunction :Disjunction Disjunction not_disjunction]
                [conjunction :Conjunction Conjunction not_conjunction]
                [entailment :Entailment Entailment not_entailment]
                ])

(exception.the .public (no_instance [entailment every_condition])
               (Exception [Proposition (Stack Proposition)])
               (exception.report
                (list ["Entailment" (code.as_text (as_code entailment))]
                      ["Every Condition" (|> every_condition
                                             (view.of list.stack)
                                             (exception.listing (|>> as_code code.as_text)))])))

(the .public (of entailment every_condition)
     (-> Proposition (Stack Proposition)
         (Try Proposition))
     (when [entailment every_condition]
           [it {.:Empty}]
           {try.:Success it}
           
           [{:Entailment premise conclusion} {.:Top head tail}]
           (.if (by ..equality = premise head)
                (of conclusion tail)
                (exception.except ..no_instance [entailment every_condition]))

           else
           (exception.except ..no_instance [entailment every_condition])))
