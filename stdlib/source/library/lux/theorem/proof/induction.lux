(.comment "https://en.wikipedia.org/wiki/Mathematical_induction"
          (.using
           [library
            [lux (.except tuple function)
             [abstract
              ["[0]" monad]]
             [error
              ["[0]" try (.only Try)]
              ["[0]" exception (.only Exception)]]
             [meta
              ["[0]" provenance]]
             [compiler
              ["@[0]" type]
              [reference
               ["[0]" register]]
              [language
               [lux
                ["[0]" analysis]]]]
             [math
              [number
               [/64
                ["[0]" natural]]]]
             [data
              ["[0]" text]
              [collection
               ["[0]" list (.open functor)]
               ["[0]" dictionary (.only Dictionary)]]]
             [function
              [predicate (.only Predicate)]]]]
           ["!" // (.only)
            [//
             ["?" proposition]
             ["in" substitution]
             ["by" rule]]]))

(every .public Variable
       Text)

(every Registry
       (Dictionary Variable @type.Register))

(.the (registry''' term it)
      (-> analysis.Term
          (Change Registry))
      (when term
            (?.variable _ register name)
            (dictionary.has name register it)
            
            {@type.:Simple _}
            it
            
            {@type.:Complex @ term}
            (when term
                  {@type.:Complex_Variant term}
                  (registry''' (its @type.:value term) it)
                  
                  {@type.:Complex_Tuple term}
                  (list.mix registry''' term it))
            
            {@type.:Reference _}
            it

            {@type.:When @ input [head tail]}
            (|> it
                (registry''' input)
                (registry''' (its @type.:then head))
                (list.mix registry'''
                          (list:each (its @type.:then) tail)))
            
            {@type.:Abstraction @ environment body}
            (|> it
                (registry''' body)
                (list.mix registry'''
                          environment))
            
            {@type.:Application @ parameter abstraction}
            (|> it
                (registry''' parameter)
                (registry''' abstraction))
            
            {@type.:Extension @ name parameters}
            (list.mix registry''' parameters it)))

(.the (registry'' it)
      (-> ?.Identity
          (Change Registry))
      (|>> (registry''' (its ?.:slow it))
           (registry''' (its ?.:fast it))))

(.the (registry' term it)
      (-> ?.Proposition
          (Change Registry))
      (when term
            {?.:Identity term}
            (registry'' term it)
            
            {?.:Disjunction left right}
            (|> it
                (registry' left)
                (registry' right))
            
            {?.:Conjunction left right}
            (|> it
                (registry' left)
                (registry' right))
            
            {?.:Entailment premise conclusion}
            (|> it
                (registry' premise)
                (registry' conclusion))))

(the ignorance
     Registry
     (dictionary.empty text.hash))

(the .public (registry it)
     (-> ?.Proposition
         Registry)
     (registry' it ..ignorance))

(the .public (next_variable registry)
     (-> Registry
         @type.Register)
     (list.mix (by natural.maximum composite)
               (list:each ++ (dictionary.values registry))
               register.first))

(the .public (valid? it)
     (Predicate ?.Proposition)
     (when (?.identity it)
           {try.:Success [left right]}
           (with analysis.equality
                 (= left right))

           else
           false))

(the (in_identity term)
     (-> (Change analysis.Term)
         (Change ?.Identity))
     (|>> (revised ?.:slow term)
          (revised ?.:fast term)))

(the .public (in_proposition term it)
     (-> (Change analysis.Term)
         (Change ?.Proposition))
     (when it
           {?.:Identity it}
           {?.:Identity (in_identity term it)}
           
           {?.:Disjunction left right}
           {?.:Disjunction (in_proposition term left)
                           (in_proposition term right)}
           
           {?.:Conjunction left right}
           {?.:Conjunction (in_proposition term left)
                           (in_proposition term right)}
           
           {?.:Entailment premise conclusion}
           {?.:Entailment (in_proposition term premise)
                          (in_proposition term conclusion)}))

(the .public (bit name_of_variable if_false if_true
                  context it)
     (-> Variable !.Proof !.Proof
         !.Proof)
     (monad.let try.monad
                [register_of_variable (dictionary.value name_of_variable (..registry it))
                 false! (|> it
                            (in_proposition (by.substitution_of_variable register_of_variable (analysis.bit provenance.dummy false)))
                            (if_false context))
                 true! (|> it
                           (in_proposition (by.substitution_of_variable register_of_variable (analysis.bit provenance.dummy true)))
                           (if_true context))]
                (pure (if (valid? false!)
                          true!
                          false!))))

(exception.the .public (name_is_already_in_use [registry name])
               (Exception [Registry Variable])
               (exception.report (list ["Name" (text.as_text name)]
                                       ["Registry" (exception.report (list:each (.function (_ [name register])
                                                                                           [(by natural.base_10 as register)
                                                                                            (text.as_text name)])
                                                                                (dictionary.entries registry)))])))

(the .public (case name_of_variable [name_of_left if_left] [name_of_right if_right]
                   context it)
     (-> Variable [Variable !.Proof] [Variable !.Proof]
         !.Proof)
     (monad.let try.monad
                [.let [registry (..registry it)
                       register_of_case (..next_variable registry)]
                 register_of_variable (dictionary.value name_of_variable registry)
                 left! (if (dictionary.in_domain? registry name_of_left)
                           (exception.except ..name_is_already_in_use [registry name_of_left])
                           (|> it
                               (in_proposition (|> (?.variable provenance.dummy register_of_case name_of_left)
                                                   (?.'case provenance.dummy by.left)
                                                   (by.substitution_of_variable register_of_variable)))
                               (if_left context)))
                 right! (if (dictionary.in_domain? registry name_of_right)
                            (exception.except ..name_is_already_in_use [registry name_of_right])
                            (|> it
                                (in_proposition (|> (?.variable provenance.dummy register_of_case name_of_right)
                                                    (?.'case provenance.dummy by.right)
                                                    (by.substitution_of_variable register_of_variable)))
                                (if_right context)))]
                (pure (if (valid? left!)
                          right!
                          left!))))

(the .public (function name_of_variable by_application
                       context it)
     (-> Variable
         (Change !.Proof))
     (monad.let try.monad
                [[expectation reality] (?.identity it)
                 .let [registry (..registry it)
                       register_of_variable (..next_variable registry)
                       argument (?.variable provenance.dummy register_of_variable name_of_variable)]]
                (if (dictionary.in_domain? registry name_of_variable)
                    (exception.except ..name_is_already_in_use [registry name_of_variable])
                    (by_application context
                                    {?.:Identity [?.:slow {@type.:Application provenance.dummy argument expectation}
                                                  ?.:fast {@type.:Application provenance.dummy argument reality}]}))))

(the .public (pair name_of_variable [name_of_left name_of_right]
                   if_pair
                   context it)
     (-> Variable [Variable Variable]
         (Change !.Proof))
     (monad.let try.monad
                [.let [registry (..registry it)]
                 register_of_variable (dictionary.value name_of_variable registry)
                 .let [register_of_left (..next_variable registry)
                       register_of_right (++ register_of_left)]]
                (if (dictionary.in_domain? registry name_of_left)
                    (exception.except ..name_is_already_in_use [registry name_of_left])

                    (dictionary.in_domain? registry name_of_right)
                    (exception.except ..name_is_already_in_use [registry name_of_right])

                    (comment "else"
                             (|> it
                                 (in_proposition (by.substitution_of_variable register_of_variable
                                                                              (?.'pair provenance.dummy
                                                                                       (?.variable provenance.dummy register_of_left name_of_left)
                                                                                       (?.variable provenance.dummy register_of_right name_of_right))))
                                 (if_pair context))))))

(every .public Scenario
       (-> ?.Proposition
           !.Proof))

(the .public (or disjunction if_left if_right
                 context it)
     (-> (Try ?.Proposition) Scenario Scenario
         !.Proof)
     (monad.let try.monad
                [disjunction disjunction
                 [left right] (?.disjunction disjunction)
                 left ((if_left left) context it)]
                ((if_right right) context it)))
