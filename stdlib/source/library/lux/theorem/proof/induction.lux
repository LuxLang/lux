(.comment "https://en.wikipedia.org/wiki/Mathematical_induction"
          (.using
           [library
            [lux (.except tuple function)
             [abstract
              ["[0]" monad]]
             [error
              ["[0]" try (.only Try)]
              ["[0]" exception (.only Exception)]]
             [meta
              ["[0]" provenance]]
             [compiler
              ["@[0]" type]
              [language
               [lux
                ["[0]" analysis]]]]
             [math
              [number
               [/64
                ["[0]" natural]]]]
             [data
              [collection
               ["[0]" list (.open functor)]]]
             [function
              [predicate (.only Predicate)]]]]
           ["!" // (.only)
            [//
             ["?" proposition]
             ["in" substitution]
             ["by" rule]]]))

(the (valid? it)
     (Predicate ?.Proposition)
     (when (?.identity it)
           {try.:Success [left right]}
           (with analysis.equality
                 (= left right))

           else
           false))

(the (in_identity term)
     (-> (Change analysis.Term)
         (Change ?.Identity))
     (|>> (revised ?.:slow term)
          (revised ?.:fast term)))

(the (in_proposition term it)
     (-> (Change analysis.Term)
         (Change ?.Proposition))
     (when it
           {?.:Identity it}
           {?.:Identity (in_identity term it)}
           
           {?.:Disjunction left right}
           {?.:Disjunction (in_proposition term left)
                           (in_proposition term right)}
           
           {?.:Conjunction left right}
           {?.:Conjunction (in_proposition term left)
                           (in_proposition term right)}
           
           {?.:Entailment premise conclusion}
           {?.:Entailment (in_proposition term premise)
                          (in_proposition term conclusion)}))

(the .public (bit if_false if_true
                  context it)
     (-> !.Proof !.Proof
         !.Proof)
     (<| (let [variable (its in.:next_induction context)
               context (revised in.:next_induction ++ context)])
         (monad.let try.monad
                    [false! (|> it
                                (in_proposition (by.substitution_of_variable variable (analysis.bit provenance.dummy false)))
                                (if_false context))
                     true! (|> it
                               (in_proposition (by.substitution_of_variable variable (analysis.bit provenance.dummy true)))
                               (if_true context))])
         (pure (if (valid? false!)
                   true!
                   false!))))

(the .public (case if_left if_right
                   context it)
     (-> !.Proof !.Proof
         !.Proof)
     (monad.let try.monad
                [.let [content (?.term provenance.dummy (its in.:next_term context))
                       variable (its in.:next_induction context)
                       context (|> context
                                   (revised in.:next_term ++)
                                   (revised in.:next_induction ++))]
                 left! (|> it
                           (in_proposition (by.substitution_of_variable variable (in.'case provenance.dummy by.left content)))
                           (if_left context))
                 right! (|> it
                            (in_proposition (by.substitution_of_variable variable (in.'case provenance.dummy by.right content)))
                            (if_right context))]
                (pure (if (valid? left!)
                          right!
                          left!))))

(the .public (function by_application
                       context it)
     (Change !.Proof)
     (monad.let try.monad
                [[expectation reality] (?.identity it)
                 .let [argument (?.variable provenance.dummy (its in.:next_variable context))]]
                (by_application (revised in.:next_variable ++ context)
                                {?.:Identity [?.:slow {@type.:Application provenance.dummy argument expectation}
                                              ?.:fast {@type.:Application provenance.dummy argument reality}]})))

(the .public (pair if_pair
                   context it)
     (Change !.Proof)
     (|> it
         (in_proposition (by.substitution_of_variable (its in.:next_induction context)
                                                      (in.'pair provenance.dummy
                                                                (?.term provenance.dummy (its in.:next_term context))
                                                                (?.term provenance.dummy (++ (its in.:next_term context))))))
         (if_pair (|> context
                      (revised in.:next_term (|>> ++ ++))
                      (revised in.:next_induction ++)))))

(exception.the .public (not_tuple [arity])
               (Exception [Natural])
               (exception.report
                (list ["Arity" (by natural.base_10 as arity)])))

(the .public (tuple arity if_tuple
                    context it)
     (-> Natural
         (Change !.Proof))
     (if (natural.>= 2 arity)
         (|> it
             (in_proposition (by.substitution_of_variable (its in.:next_induction context)
                                                          (let [offset (its in.:next_term context)]
                                                               (|> (list.domain arity)
                                                                   (list:each (|>> (natural.+ offset)
                                                                                   (?.term provenance.dummy)))
                                                                   (analysis.tuple provenance.dummy)))))
             (if_tuple (|> context
                           (revised in.:next_term (natural.+ arity))
                           (revised in.:next_induction ++))))
         (exception.except ..not_tuple [arity])))

(every .public Scenario
       (-> ?.Proposition
           !.Proof))

(the .public (or disjunction left_case right_case
                 context it)
     (-> (Try ?.Proposition) Scenario Scenario
         !.Proof)
     (monad.let try.monad
                [disjunction disjunction
                 [left right] (?.disjunction disjunction)
                 left ((left_case left) context it)]
                ((right_case right) context it)))
