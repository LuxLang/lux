(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]]
   [error
    [[0] try]
    [[0] exception (.only Exception)]]
   [data
    [[0] text]]
   [math
    [number
     [/64
      [[0] natural]
      [[0] integer]
      [[0] revolution]]]]
   [meta
    [[0] name]
    [[0] code]
    [[0] static]]
   [compiler
    [["@" 0] type]
    [[0] extension (.only)
     [[1 "/" 0] lux]]
    [language
     [lux
      [[0] analysis]]]]
   [function
    [predicate (.only Predicate)]]]]
 [[0] // (.only)
  [//
   [["?"] proposition]
   [["in"] substitution]
   [["if"] hypothesis]
   [[0] term]]])

(the (potentially_identical? it)
     (Predicate ?.Identity)
     (when it
           [(term.bit_0 @) (term.bit_1 @)]
           false

           [(term.bit_1 @) (term.bit_0 @)]
           false
           
           [{@type.:Simple @ {@type.:Simple_Natural slow}}
            {@type.:Simple @ {@type.:Simple_Natural fast}}]
           (natural.= slow fast)
           
           [{@type.:Simple @ {@type.:Simple_Integer slow}}
            {@type.:Simple @ {@type.:Simple_Integer fast}}]
           (integer.= slow fast)
           
           [{@type.:Simple @ {@type.:Simple_Revolution slow}}
            {@type.:Simple @ {@type.:Simple_Revolution fast}}]
           (revolution.= slow fast)
           
           [{@type.:Simple @ {@type.:Simple_Text slow}}
            {@type.:Simple @ {@type.:Simple_Text fast}}]
           (text.= slow fast)
           
           else
           true))

(the (contradiction? it)
     (Predicate ?.Proposition)
     (when it
           {?.:Identity it}
           (not (..potentially_identical? it))
           
           else
           false))

(exception.the .public (not_valid [where it])
               (Exception [Name ?.Proposition])
               (exception.report (list ["Where" (name.as_text where)]
                                       ["Proposition" (code.as_text (?.as_code it))])))

(<| (the .public (then else
                       context it)
         (-> //.Proof
             (if.Component [?.Proposition ?.Proposition])))
    (monad.let [! try.monad]
               [[slow fast] (?.identity it)])
    (when slow
          {@type.:Extension @ [.prelude (static.text (extension.analysis extension/lux.if))]
                            (.list reality body_for_then body_for_else)}
          (monad.let !
                     [else (else context {?.:Identity [?.:slow body_for_else
                                                       ?.:fast fast]})]
                     (if (contradiction? else)
                         (pure [{?.:Identity [?.:slow reality
                                              ?.:fast (analysis.bit_1 @)]}
                                {?.:Identity [?.:slow body_for_then
                                              ?.:fast fast]}])
                         (exception.except ..not_valid [(name ..then) else])))

          else
          (exception.except ..not_valid [(name ..then) it])))
