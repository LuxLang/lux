(.using
 [library
  [lux (.except)
   [data
    ["[0]" text (.only \n)]
    [collection
     ["[0]" list (.open functor)]
     ["[0]" stack]]]
   [compiler
    ["@[0]" type]
    ["[0]" reference]
    ["[0]" extension (.only)
     ["[1]/[0]" lux]]
    [language
     [lux
      ["[0]" analysis (.only)
       ["[1]/[0]" simple]
       ["[1]/[0]" pattern]
       ["[1]/[0]" complex]]]]]
   [function
    [predicate (.only Predicate)]]
   [math
    [number
     [/64
      ["[0]" natural]]]]
   [macro
    ["[0]" template]]
   [meta
    ["[0]" static]
    ["[0]" name]
    ["[0]" module]]
   [aspect
    ["[0]" view]]
   [logic
    ["[0]" bit]]]])

(`` (template.the .public (new ,@ ,identity ,name)
                  [{@type.:Extension ,@ [(,, (static.text (name.module (name .._)))) "term"]
                                     (.list (analysis.natural ,@ ,identity)
                                            (analysis.text ,@ ,name))}]))

(`` (<| (template.the .public (case ,@ ,case ,value))
        [{@type.:Extension ,@ [.prelude (,, (static.text (extension.analysis extension/lux.case)))]
                           (.list (analysis.bit ,@ ,case)
                                  ,value)}]))

(`` (<| (template.the .public (pair ,@ ,left ,right))
        [{@type.:Extension ,@ [.prelude (,, (static.text (extension.analysis extension/lux.pair)))]
                           (.list ,left ,right)}]))

(the (tail_of_tuple it)
     (-> analysis.Term
         (Stack analysis.Term))
     (when it
           (..pair @ 'left 'right)
           (stack.partial 'left (tail_of_tuple 'right))

           else
           (stack it)))

(the (nested_variant [every_left left_or_right 'term])
     (Change [Natural Bit analysis.Term])
     [(++ every_left) left_or_right 'term])

(the (as_variant left_or_right 'term)
     (-> Bit analysis.Term
         [Natural Bit analysis.Term])
     (when left_or_right
           0b [0 left_or_right 'term]
           1b (when 'term
                    (..case @ left_or_right 'term)
                    (nested_variant (as_variant left_or_right 'term))

                    else
                    [0 left_or_right 'term])))

(the (indentation it)
     (-> Natural
         Text)
     (|> " "
         (list.repeated it)
         text.together))

(the (nest indentation it)
     (-> Text
         (Change Text))
     (text.replaced \n (text \n indentation) it))

(the line?
     (Predicate Text)
     (|>> (text.contains? \n)
          not))

(<| (the .public (pretty alias)
         (-> reference.Alias
             (text.Injection analysis.Term)))
    (function (pretty analysis))
    (when analysis
          {@type.:Simple @ it}
          (analysis/simple.as_text it)
          
          {@type.:Complex @ it}
          "???"
          
          {@type.:Reference @ it}
          (reference.custom alias it)
          
          {@type.:When @ analysis [head tail]}
          "???"
          
          {@type.:Abstraction @ environment body}
          (.let [prefix "(.function# "
                 indentation (..indentation (text.size prefix))]
                (text prefix
                      (|> environment
                          (list:each pretty)
                          (text.interposed (text \n " "))
                          (text.inside ["[" "]"])
                          (nest indentation))
                      (nest indentation (text \n (pretty body)))
                      ")"))
          
          {@type.:Application @ _}
          (.let [[abstraction every_parameter] (analysis.reification analysis)
                 abstraction (pretty abstraction)
                 size_of_parenthesis 1
                 size_of_space 1
                 prefix (text "(" (nest (..indentation size_of_parenthesis) abstraction))
                 line? (line? abstraction)
                 indentation (..indentation (.if line?
                                                 (natural.+ size_of_space (text.size prefix))
                                                 size_of_space))]
                (text prefix
                      (|> every_parameter
                          (list:each pretty)
                          (text.interposed \n)
                          (text " ")
                          (nest indentation))
                      ")"))

          (..new @ register name)
          (text "(" (by natural.base_10 as register)
                " " (text.as_text name)
                ")")

          (..case @ left_or_right 'term)
          (.let [[every_left left_or_right 'term] (as_variant left_or_right 'term)
                 prefix (text "{" (by natural.base_10 as every_left)
                              " " (bit.as_text left_or_right)
                              " ")]
                (text prefix
                      (nest (..indentation (text.size prefix))
                            (pretty 'term))
                      "}"))

          (..pair @ 'left 'right)
          (|> (stack.partial 'left (tail_of_tuple 'right))
              (view.of list.stack)
              (list:each pretty)
              (text.interposed \n)
              (text.inside ["[" "]"])
              (nest (..indentation 1)))
          
          {@type.:Extension @ name every_parameter}
          (.let [prefix (text "(" (by (name.relative "") as name) " ")]
                (text prefix
                      (|> every_parameter
                          (list:each pretty)
                          (text.interposed \n)
                          (nest (..indentation (text.size prefix))))
                      ")"))))

(the .public (as_text relative_to analysis)
     (-> module.Name
         (text.Injection analysis.Term))
     (when analysis
           {@type.:Simple @ it}
           (analysis/simple.as_text it)
           
           {@type.:Complex @ it}
           (analysis/complex.as_text (as_text relative_to) it)
           
           {@type.:Reference @ it}
           (reference.relative relative_to it)
           
           {@type.:When @ analysis [head tail]}
           (.let [branch (is (-> analysis.Branch Text)
                             (function (_ [when then])
                                       (.text (analysis/pattern.as_text when)
                                              " " (as_text relative_to then))))]
                 (.text "(.when# "
                        (as_text relative_to analysis)
                        " "
                        (branch head)
                        (|> tail
                            (list:each (|>> branch (.text " ")))
                            text.together)
                        ")"))
           
           {@type.:Abstraction @ environment body}
           (|> (as_text relative_to body)
               (.text (|> environment
                          (list:each (as_text relative_to))
                          (text.interposed " ")
                          (text.inside ["[" "]"]))
                      " ")
               (text.inside ["(.function# " ")"]))
           
           {@type.:Application @ _}
           (.let [[abstraction parameters] (analysis.reification analysis)]
                 (|> (.text (as_text relative_to abstraction)
                            " "
                            (|> parameters
                                (list:each (as_text relative_to))
                                (text.interposed " ")))
                     (text.inside ["(" ")"])))

           (..new @ register name)
           (text "(" (by natural.base_10 as register)
                 " " (text.as_text name)
                 ")")

           (..case @ left_or_right 'term)
           (.let [[every_left left_or_right 'term] (as_variant left_or_right 'term)]
                 (text "{" (by natural.base_10 as every_left)
                       " " (bit.as_text left_or_right)
                       " " (as_text relative_to 'term)
                       "}"))

           (..pair @ 'left 'right)
           (|> (stack.partial 'left (tail_of_tuple 'right))
               (view.of list.stack)
               (list:each (as_text relative_to))
               (text.interposed " ")
               (text.inside ["[" "]"]))
           
           {@type.:Extension @ name parameters}
           (|> parameters
               (list:each (|>> (as_text relative_to) (.text " ")))
               text.together
               (.text (by (name.relative relative_to) as name))
               (text.inside ["(" ")"]))))
