(.using
 [library
  [lux (.except and let)
   [abstract
    ["[0]" monad]]
   [error
    ["[0]" try (.only Try)]]]]
 [//
  ["?" proposition]
  ["!" proof]])

(every .public (Component it)
       (-> ?.Proposition
           (Try it)))

(the .public any
     (Component ?.Proposition)
     (|>> {try.:Success}))

(the .public (and the_left the_right
                  it)
     (for_any (_ left right)
              (-> (Component left) (Component right)
                  (Component [left right])))
     (monad.let try.monad
                [[left right] (?.conjunction it)
                 left (the_left left)
                 right (the_right right)]
                (pure [left right])))

(the .public (let [component hypothesis
                   body]
                  context it)
     (for_any (_ it)
              (-> [(Component it) ?.Proposition
                   (-> it
                       !.Proof)]
                  !.Proof))
     (monad.let try.monad
                [hypothesis (component hypothesis)]
                ((body hypothesis) context it)))
