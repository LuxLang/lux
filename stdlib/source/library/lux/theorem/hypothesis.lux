(.using
 [library
  [lux (.except and let as)
   [abstract
    [[0] monad]]
   [error
    [[0] try]]]]
 [//
  [["?"] proposition]
  [["in"] substitution]
  [["!"] proof]])

(every .public (Component it)
       (in.Fact ?.Proposition it))

(the .public (any context it)
     (Component ?.Proposition)
     {try.:Success it})

(the .public (and the_left the_right
                  context it)
     (for_any (_ left right)
              (-> (Component left) (Component right)
                  (Component [left right])))
     (monad.let try.monad
                [[left right] (?.conjunction it)
                 left (the_left context left)
                 right (the_right context right)]
                (pure [left right])))

(the .public (as proof
                 context it)
     (for_any (_ it)
              (Change (Component it)))
     (proof context it))

(the .public (let [hypothesis component
                   body]
                  context it)
     (for_any (_ it)
              (-> [?.Proposition (Component it)
                   (-> it
                       !.Proof)]
                  !.Proof))
     (monad.let try.monad
                [hypothesis (component context hypothesis)]
                ((body hypothesis) context it)))
