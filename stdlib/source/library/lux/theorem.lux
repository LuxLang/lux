(.using
 [library
  [lux (.except the with alias)
   [abstract
    [["??"] projection]
    [[0] monad]]
   [error
    [[0] try (.only Try)]
    [[0] exception (.only Exception)]]
   [data
    [[0] pair]
    [[0] text (.only)
     [["%"] \\injection]]
    [collection
     [[0] dictionary]
     [[0] list (.open functor)
      [["?" 1] \\projection]]]]
   [math
    [number
     [/64
      [[0] natural]]]]
   [[0] meta (.open functor)
    [[0] module]
    [[0] name]
    [[0] provenance]
    [[0] extension]
    [[0] code
     [["?" 1] \\projection]
     [[0] export]]]
   [macro
    [[0] syntax]
    [[0] template]]
   [compiler
    [["@" 0] type]
    [[0] reference]
    [language
     [lux
      [[0] phase]
      [[0] analysis (.only)
       [[0] type]]]]]]]
 [/
  [proof (.only Proof)]
  [["?"] proposition]
  [["by"] rule]
  [["in"] substitution]
  [[0] state]])

(every .public (Condition it)
       (-> ?.Proposition
           (Try it)))

(.the .public (any it)
      (Condition ?.Proposition)
      {try.:Success it})

(.the .public (pair in_left in_right
                    it)
      (for_any (_ left right)
               (-> (Condition left) (Condition right)
                   (Condition (And left right))))
      (monad.let [! try.monad]
                 [[slow fast] (?.identity it)
                  [slow_left slow_right] (in.as_pair slow)
                  [fast_left fast_right] (in.as_pair fast)]
                 (monad.and !
                            (in_left {?.:Identity [slow_left fast_left]})
                            (in_right {?.:Identity [slow_right fast_right]}))))

(.the .public (with condition then
                    lemma
                    context it)
      (for_any (_ it)
               (-> (Condition it) (-> it in.Rule)
                   (-> ?.Proposition in.Rule)))
      (monad.let try.monad
                 [lemma (condition lemma)]
                 ((then lemma) context it)))

(exception.the .public (entailment_mismatch [expectation reality])
               (Exception [Natural Natural])
               (exception.report (list ["Expectation" (%.natural expectation)]
                                       ["Reality" (%.natural reality)])))

(.the alias
      (Meta reference.Alias)
      (meta:each (|>> pair.right
                      (its @type.:module_aliases)
                      (list:each pair.in_reverse)
                      (dictionary.of_list text.hash))
                 module.current))

(.the the'
      (<| (extension.analysis (_ analysis archive
                                 ['name ?list.any
                                  'proposition ?list.any
                                  'proof ?list.any]))
          (monad.let [! phase.monad]
                     [proposition (meta.eval (type (?.Proposition' ?.Proposition))
                                             'proposition)
                      proposition ((as (-> Any (?.Proposition' ?.Proposition)) proposition) ?.empty analysis archive)
                      proof (meta.eval (-> ?.Proposition
                                           Proof)
                                       'proof)
                      state_of_compiler phase.state
                      alias ..alias])
          (when (((as (-> Any
                          (-> ?.Proposition
                              Proof))
                      proof)
                  proposition)
                 [state.:every_global state_of_compiler
                  state.:alias alias]
                 proposition)
                {try.:Success theorem}
                (analysis archive (?.as_code proposition))
                
                {try.:Failure error}
                (meta.failure error))))

(every .public Theorem
       (Record [:proposition ?.Proposition
                :proof (-> ?.Proposition
                           Proof)]))

(.the .public the
      (syntax.macro (_ state_of_compiler
                       [['export_policy 'name] (export.with ?list.any)
                        'proposition ?list.any
                        'proof ?list.any])
                    (let ['proof (` (function ((, 'name) (, 'name))
                                              (, 'proof)))]
                         (pure (list (` (.the (, 'export_policy) (, 'name)
                                              Theorem
                                              [:proposition (..the' (, 'name)
                                                                    (, 'proposition)
                                                                    (, 'proof))
                                               :proof (, 'proof)])))))))

(.the .public (proof it)
      (-> Theorem
          Proof)
      ((its :proof it) (its :proposition it)))
