(.using
 [library
  [lux (.except)]])

(the template:with (.in_module# .prelude .template:with))
(the template:macro (.in_module# .prelude .template:macro))

(every .public (Co it)
       (-> Any
           it))

(every .public (Contra it)
       (-> it
           Any))

(every .public (In it)
       (-> it
           it))

(every .public (Mutable r w)
       (Nominal ".Mutable" [[1b (-> w r)]]))

(template:with [<name> <type>]
               [(the .public <name>
                     (template:macro
                      (<name> it)
                      [((.is (.for_any (_ r w) <type>)
                             (.|>> .as_expected))
                        it)]))]

               [[read (.-> (..Mutable r w) r)]
                [write (.-> w (..Mutable r w))]
                ])

(every .public (Read_Only a)
       (Mutable a Nothing))

(every .public (Write_Only a)
       (Mutable Any a))

(template:with [<name> <type>]
               [(the .public <name>
                     (template:macro
                      (<name> it)
                      [((.is (.for_any (_ r w) <type>)
                             (.|>>))
                        it)]))]

               [[read_only (.-> (..Mutable r w) (..Read_Only r))]
                [write_only (.-> (..Mutable r w) (..Write_Only w))]
                ])
