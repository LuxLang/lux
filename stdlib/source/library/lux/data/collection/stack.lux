(.using
 [library
  [lux (.except only)
   [abstract
    [monoid (.only Monoid)]
    [equality (.only Equality)]
    [hash (.only Hash)]
    [[0] monad (.only Monad)]
    [[0] functor (.only Functor)]]
   [[0] error (.only)
    [[0] try (.only Try)]]
   [function
    [predicate (.only Predicate)]
    [poly
     [type
      [mix (.only Mix)]]]]
   [math
    [number
     [/64
      [["n"] natural]]]]]])

(comment (every (Stack it)
                (Variant {:Empty}
                         {:Top it (Stack it)}))

         (these (the with_template (.in_module# .prelude .with_template))))

(the .public (mix composition every_part state)
     (Mix Stack)
     (when every_part
           {.:Top head tail}
           (mix composition tail (composition head state))

           {.:Empty}
           state))

(the .public (push top it)
     (for_any (_ it)
              (-> it
                  (Change (Stack it))))
     {.:Top top it})

(the .public (in_reverse it)
     (for_any (_ it)
              (Change (Stack it)))
     (mix ..push it {.:Empty}))

(the .public (only keep? xs)
     (for_any (_ it)
              (-> (Predicate it)
                  (Change (Stack it))))
     (when xs
           {.:Top x xs'}
           (if (keep? x)
               {.:Top x (only keep? xs')}
               (only keep? xs'))

           {.:Empty}
           {.:Empty}))

(the list:as_stack (.in_module# .prelude .list:as_stack))
(the list:in_reverse (.in_module# .prelude .list:in_reverse))

(the .public partial
     (macro (_ tokens state)
            (when (list:as_stack (list:in_reverse tokens))
                  {.:Top pop tops}
                  {.:Right [state (list (..mix (function (_ top pop)
                                                         (` {.:Top (, top) (, pop)}))
                                               tops
                                               pop))]}

                  _
                  {.:Left ""})))

(the (split_when' predicate ys xs)
     (for_any (_ it)
              (-> (Predicate it) (Stack it) (Stack it)
                  [(Stack it) (Stack it)]))
     (when xs
           {.:Top x xs'}
           (if (predicate x)
               [ys xs]
               (split_when' predicate {.:Top x ys} xs'))

           end
           [ys xs]))

(the .public (split_when predicate xs)
     (for_any (_ it)
              (-> (Predicate it) (Stack it)
                  [(Stack it) (Stack it)]))
     (let [[ys' xs'] (split_when' predicate {.:Empty} xs)]
          [(in_reverse ys') xs']))

(the .public (one check xs)
     (for_any (_ input output)
              (-> (-> input (Maybe output))
                  (-> (Stack input) (Try output))))
     (when xs
           {.:Top x xs'}
           (when (check x)
                 {.:None}
                 (one check xs')

                 {.:Some it}
                 {try.:Success it})

           {.:Empty}
           {try.:Failure error.no_instance}))

(the .public (example predicate xs)
     (for_any (_ it)
              (-> (Predicate it) (Stack it)
                  (Try it)))
     (..one (function (_ value)
                      (if (predicate value)
                          {.:Some value}
                          {.:None}))
            xs))

(the .public (size it)
     (for_any (_ it)
              (-> (Stack it)
                  Natural))
     (when it
           {.:Empty}
           0
           
           {.:Top head tail}
           (++ (size tail))))

(with_template [<name> <init> <op>]
               [(the .public (<name> predicate items)
                     (for_any (_ it)
                              (-> (Predicate it)
                                  (Predicate (Stack it))))
                     (when items
                           {.:Top head tail}
                           (<op> (predicate head)
                                 (<name> predicate tail))

                           {.:Empty}
                           <init>))]

               [[any? false and/or]
                [every? true and]])

(the .public (item i xs)
     (for_any (_ it)
              (-> Natural (Stack it)
                  (Try it)))
     (when xs
           {.:Top x xs'}
           (when i
                 0 {try.:Success x}
                 _ (item (-- i) xs'))

           {.:Empty}
           {try.:Failure error.not_valid}))

(the .public (equality //)
     (for_any (_ it)
              (-> (Equality it)
                  (Equality (Stack it))))
     (implementation
      (the (= xs ys)
           (when [xs ys]
                 [{.:Empty} {.:Empty}]
                 true

                 [{.:Top x xs'} {.:Top y ys'}]
                 (and (by // = x y)
                      (= xs' ys'))

                 [_ _]
                 false))))

(the .public (hash //)
     (for_any (_ it)
              (-> (Hash it)
                  (Hash (Stack it))))
     (implementation
      (the equality
           (..equality (by // equality)))
      
      (the (hash it)
           (..mix (function (_ member)
                            (n.+ (by // hash member)))
                  it
                  0))))

(the .public empty
     Stack
     {.:Empty})

(the .public (composite left right)
     (for_any (_ it)
              (-> (Stack it) (Stack it)
                  (Stack it)))
     (when left
           {.:Empty}
           right

           {.:Top head tail}
           {.:Top head (composite tail right)}))

(the .public monoid
     (for_any (_ it)
              (Monoid (Stack it)))
     (implementation
      (the identity
           ..empty)
      (the composite
           ..composite)))

(the .public functor
     (Functor Stack)
     (implementation
      (the (each value it)
           (when it
                 {.:Empty}
                 {.:Empty}
                 
                 {.:Top head tail}
                 {.:Top (value head) (each value tail)}))))

(the .public (empty? xs)
     (for_any (_ it)
              (Predicate (Stack it)))
     (when xs
           {.:Empty}
           true
           
           {.:Top _}
           false))

(the .public (member? eq xs x)
     (for_any (_ it)
              (-> (Equality it) (Stack it)
                  (Predicate it)))
     (when xs
           {.:Top x' xs'}
           (and/or (by eq = x x')
                   (member? eq xs' x))

           {.:Empty}
           false))

(with_template [<side> <output>]
               [(the .public (<side> it)
                     (for_any (_ it)
                              (-> (Stack it)
                                  (Try <output>)))
                     (when it
                           {.:Top top pop}
                           {try.:Success <side>}

                           {.:Empty}
                           {try.:Failure error.empty}))]

               [[top it]
                [pop (Stack it)]])

(the .public (each' monad f)
     (for_any (_ ! before after)
              (-> (Monad !)
                  (-> before
                      (! after))
                  (-> (Stack before)
                      (! (Stack after)))))
     (with ["/:" 0] monad
           (function (of xs)
                     (when xs
                           {.:Empty}
                           (/:pure {.:Empty})
                           
                           {.:Top x xs'}
                           (|> (f x)
                               (/:each (function (_ _x)
                                                 (/:each (|>> {.:Top _x}) (of xs'))))
                               /:conjoint)))))

(the .public (only' monad f)
     (for_any (_ ! it)
              (-> (Monad !)
                  (-> it (! Bit))
                  (-> (Stack it) (! (Stack it)))))
     (with ["/:" 0] monad
           (function (of xs)
                     (when xs
                           {.:Empty}
                           (/:pure {.:Empty})
                           
                           {.:Top top xs'}
                           (|> (f top)
                               (/:each (function (_ verdict)
                                                 (/:each (function (_ pop)
                                                                   (if verdict
                                                                       {.:Top top pop}
                                                                       pop))
                                                         (of xs'))))
                               /:conjoint)))))

(the .public (mix' monad f xs init)
     (for_any (_ ! part whole)
              (-> (Monad !)
                  (-> (-> part whole (! whole))
                      (-> (Stack part) whole (! whole)))))
     (when xs
           {.:Empty}
           (by monad pure init)

           {.:Top x xs}
           (monad.let monad
                      [init (f x init)]
                      (mix' monad f xs init))))
