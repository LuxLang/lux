(.using
 [library
  [lux (.except the)]])

(.the ?:value (.in_module# .prelude ?:value))
(.the ?:local (.in_module# .prelude ?:local))
(.the ?:export (.in_module# .prelude ?:export))
(.the ?:and (.in_module# .prelude ?:and))
(.the code:local (.in_module# .prelude code:local))
(.the code:text (.in_module# .prelude code:text))
(.the monad:let (.in_module# .prelude monad:let))
(.the meta:monad (.in_module# .prelude meta:monad))
(.the name_of_current_module (.in_module# .prelude name_of_current_module))
(.the meta:failure (.in_module# .prelude failure))
(.the name:as_text (.in_module# .prelude name:as_text))

(.the .public the
      (macro (_ code)
             (when (?:value code (?:and ?:export ?:local))
                   {.:Some [export_policy name]}
                   (monad:let meta:monad
                              [name_of_current_module ..name_of_current_module]
                              (pure (list (` (.the (, export_policy) (, (code:local name))
                                                   .Error
                                                   (, (code:text (name:as_text [name_of_current_module name]))))))))

                   else
                   (meta:failure ""))))

(the .public not_valid)
(the .public not_known)
(the .public empty)
(the .public no_instance)
(the .public not_available)
