(.comment "Profunctor Optics: Modular Data Accessors"
          "https://arxiv.org/abs/1703.10857"
          (.using
           [library
            [lux (.except as with)
             [abstract
              [functor
               [[0] pro]]]
             [[0] function]]]
           [[0] //]))

(every .public (Of' context context'
                    analogy analogy')
       (-> analogy'
           context'))

(every .public (As' context context'
                    analogy analogy')
       (-> context
           analogy))

(every .public (View' context context'
                      analogy analogy')
       (Record [:of (Of' context context'
                         analogy analogy')
                :as (As' context context'
                         analogy analogy')]))

(every .public (Of context analogy)
       (Of' context context
            analogy analogy))

(every .public (As context analogy)
       (As' context context
            analogy analogy))

(every .public (View context analogy)
       (View' context context
              analogy analogy))

(the .public (new of as)
     (<| (for_any (_ context analogy))
         (-> (Of context analogy) (As context analogy)
             (View context analogy)))
     [:of of
      :as as])

(the .public (in_reverse it)
     (<| (for_any (_ context analogy))
         (-> (View context analogy)
             (View analogy context)))
     (<| (.with ["/" 0] it)
         (new /:as /:of)))

(the with_template (.in_module# .prelude .with_template))

(with_template [,name ,type ,tag]
               [(the .public ,name
                     (<| (for_any (_ context analogy))
                         (-> (View context analogy)
                             (,type context analogy)))
                     (its ,tag))]

               [[of Of :of]
                [as As :as]
                ])

(the .public identity
     (<| (for_any (_ it))
         (View it it))
     (..new function.identity function.identity))

(the .public (with it change)
     (<| (for_any (_ context analogy))
         (-> (View context analogy)
             (-> (Change analogy)
                 (Change context))))
     (|>> (as it)
          change
          (of it)))

(<| (every .public (Aspect context context' analogy analogy'))
    (for_any (_ =>))
    (-> (pro.Functor =>)
        (//.Aspect => context context' analogy analogy')))

(the functor
     (<| (for_any (_ analogy analogy'))
         (pro.Functor (<| (for_any (_ context context'))
                          (View' context context'
                                 analogy analogy'))))
     (implementation
      (the (each before after it)
           (<| (.with ["/" 0] it)
               [:of (|>> /:of after)
                :as (|>> before /:as)]))))

(the .public (as_aspect it
                        [pro_functor])
     (<| (for_any (_ context context' analogy analogy'))
         (-> (View' context context' analogy analogy')
             (Aspect context context' analogy analogy'
                     (<| (for_any (_ context context'))
                         (View' context context' analogy analogy')))))
     (<| (.with ["/" 0] it)
         (.with pro_functor)
         (each /:as /:of)))

(the .public (of_aspect =>)
     (<| (for_any (_ context context' analogy analogy'))
         (-> (Aspect context context' analogy analogy'
                     (<| (for_any (_ context context'))
                         (View' context context' analogy analogy')))
             (View' context context' analogy analogy')))
     (=> [..functor]
         [:of function.identity
          :as function.identity]))
