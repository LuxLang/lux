(.comment "Profunctor Optics: Modular Data Accessors"
          "https://arxiv.org/abs/1703.10857"
          (.using
           [library
            [lux (.except if when)
             [abstract
              [functor
               [[0] pro]]]
             [[0] function]]]
           [[0] //]))

(the with_template (.in_module# .prelude with_template))

(comment "Inlined the following functions in order to get around a circular dependency."
         (these (<| (the (case:either on_left on_right)
                         (<| (for_any (_ a b c))
                             (-> (-> a c) (-> b c)
                                 (-> (Or a b) c))))
                    (function (_ input))
                    (.when input
                           {0b l} (on_left l)
                           {1b r} (on_right r)))

                (<| (the (case:then on_left on_right)
                         (<| (for_any (_ l l' r r'))
                             (-> (-> l l') (-> r r')
                                 (-> (Or l r) (Or l' r')))))
                    (function (_ input))
                    (.when input
                           {0b l} {0b (on_left l)}
                           {1b r} {1b (on_right r)}))))

(every .public (If' context context'
                    case case')
       (-> context
           (Or context' case)))

(every .public (Some' context context'
                      case case')
       (-> case'
           context'))

(every .public (Case' context context'
                      case case')
       (Record [:if (If' context context' case case')
                :some (Some' context context' case case')]))

(every .public (If context case)
       (If' context context
            case case))

(every .public (Some context case)
       (Some' context context
              case case))

(every .public (Case context case)
       (Case' context context
              case case))

(the .public (new if some)
     (<| (for_any (_ context case))
         (-> (If context case) (Some context case)
             (Case context case)))
     [:if if
      :some some])

(the .public identity
     (<| (for_any (_ it))
         (Case it it))
     (new (|>> {1b})
          function.identity))

(with_template [,name ,type ,tag]
               [(the .public ,name
                     (<| (for_any (_ context case))
                         (-> (Case context case)
                             (,type context case)))
                     (.its ,tag))]

               [[if If :if]
                [some Some :some]
                ])

(the .public (composite outer inner)
     (<| (for_any (_ context middle case))
         (-> (Case context middle) (Case middle case)
             (Case context case)))
     (new (<| (function (_ context))
              (.when (..if outer context)
                     {.:Left context}
                     {.:Left context}

                     {.:Right middle})
              (.when (..if inner middle)
                     {.:Left middle}
                     {.:Left context}

                     {.:Right case}
                     {.:Right case}))
          (function.composite (..some outer)
                              (..some inner))))

(every .public (Aspect context context' case case')
       (<| (for_any (_ =>))
           (-> [(pro.Functor =>) (pro.Co_Cartesian =>)]
               (//.Aspect => context context' case case'))))

(the functor
     (<| (for_any (_ case case'))
         (pro.Functor (<| (for_any (_ context context'))
                          (Case' context context'
                                 case case'))))
     (implementation
      (<| (the (each before after it))
          (with ["/" 0] it)
          [:if (|>> before
                    /:if
                    (case:then after function.identity))
           :some (|>> /:some
                      after)])))

(the co_cartesian
     (<| (for_any (_ case case'))
         (pro.Co_Cartesian (<| (for_any (_ context context'))
                               (Case' context context'
                                      case case'))))
     (implementation
      (<| (the (when_left it))
          (with ["/" 0] it)
          [:if (case:either (|>> /:if
                                 (case:then (|>> {0b})
                                            function.identity))
                            (|>> {1b}
                                 {0b}))
           :some (|>> /:some
                      {0b})])
      (<| (the (when_right it))
          (with ["/" 0] it)
          [:if (case:either (|>> {0b}
                                 {0b})
                            (|>> /:if
                                 (case:then (|>> {1b})
                                            function.identity)))
           :some (|>> /:some
                      {1b})])))

(<| (the .public (as_aspect it
                            [pro_functor co_cartesian])
         (<| (for_any (_ context context' case case'))
             (-> (Case' context context' case case')
                 (Aspect context context' case case'
                         (<| (for_any (_ context context'))
                             (Case' context context'
                                    case case'))))))
    (with ["/" 0] it)
    (with pro_functor)
    (with co_cartesian)
    (|>> when_right
         (each /:if (case:either function.identity /:some))))

(the .public (of_aspect =>)
     (<| (for_any (_ context context' case case'))
         (-> (Aspect context context' case case' (<| (for_any (_ context context'))
                                                     (Case' context context'
                                                            case case')))
             (Case' context context' case case')))
     (=> [..functor ..co_cartesian]
         [:if (|>> {1b})
          :some function.identity]))

(with_template [,name]
               [(the ,name
                     (<| (.in_module# .prelude)
                         ,name))]

               [[?:value]
                [?:and]
                [?:any]
                [?:variant]
                [?:some]
                [?:local]
                [code:local]
                [failure]
                [list:each]
                [list:mix]
                [monad:let]
                [meta:monad]
                [generated_name]
                ])

(<| (the .public when)
    (macro (_ tokens))
    (.when (<| (?:value tokens)
               (all ?:and
                    ?:any
                    (?:some (?:and (?:variant (?:and ?:any (?:some ?:any)))
                                   ?:any))
                    (?:and ?:local
                           ?:any)))
           {.:Some [input cases [else_binding else_branch]]}
           (monad:let meta:monad
                      ['else (generated_name "'else")
                       'input (generated_name "'input")]
                      (pure (list (` (.let [(, 'input) (, input)]
                                           (, (list:mix (function (_ [[case bindings] then] else)
                                                                  (` (.when (..if (, case) (, 'input))
                                                                            {.:Right [(,* bindings)]}
                                                                            (, then)
                                                                            
                                                                            (, 'else)
                                                                            (, else))))
                                                        cases
                                                        (` (.let [(, (code:local else_binding)) (, 'input)]
                                                                 (, else_branch))))))))))
           
           {.:None}
           (failure "")))
