(.comment "Profunctor Optics: Modular Data Accessors"
          "https://arxiv.org/abs/1703.10857"
          (.using
           [library
            [lux (.except its revised has)
             [abstract
              [functor
               [[0] pro]]]
             [[0] function]
             [data
              [[0] pair]]]]
           [[0] //]))

(every .public (Its' context context'
                     focus focus')
       (-> context
           focus))

(every .public (Has' context context'
                     focus focus')
       (-> [focus' context]
           context'))

(every .public (Property' context context'
                          focus focus')
       (Record [:its (Its' context context'
                           focus focus')
                :has (Has' context context'
                           focus focus')]))

(every .public (Its context focus)
       (Its' context context
             focus focus))

(every .public (Has context focus)
       (Has' context context
             focus focus))

(every .public (Property context focus)
       (Property' context context
                  focus focus))

(the .public (new its has)
     (<| (for_any (_ context focus))
         (-> (Its context focus) (Has context focus)
             (Property context focus)))
     [:its its
      :has has])

(the .public identity
     (<| (for_any (_ it))
         (Property it it))
     (new function.identity pair.left))

(the .public its
     (<| (for_any (_ context focus))
         (-> (Property context focus)
             (Its context focus)))
     (.its :its))

(the .public (has property value context)
     (<| (for_any (_ context focus))
         (-> (Property context focus)
             (-> focus
                 (Change context))))
     ((.its :has property) [value context]))

(the .public (revised property change context)
     (<| (for_any (_ context focus))
         (-> (Property context focus)
             (-> (Change focus)
                 (Change context))))
     (has property (change (its property context)) context))

(the .public (composite outer inner)
     (<| (for_any (_ context middle focus))
         (-> (Property context middle) (Property middle focus)
             (Property context focus)))
     (new (function.composite (its inner) (its outer))
          (function (_ [focus context])
                    (revised outer (has inner focus) context))))

(<| (every .public (Aspect context context' focus focus'))
    (for_any (_ =>))
    (-> [(pro.Functor =>) (pro.Cartesian =>)]
        (//.Aspect => context context' focus focus')))

(the functor
     (<| (for_any (_ focus focus'))
         (pro.Functor (<| (for_any (_ context context'))
                          (Property' context context'
                                     focus focus'))))
     (implementation
      (the (each before after it)
           (<| (with ["/" 0] it)
               [:its (|>> before
                          /:its)
                :has (|>> (pair.by function.identity before)
                          /:has
                          after)]))))

(the cartesian
     (<| (for_any (_ focus focus'))
         (pro.Cartesian (<| (for_any (_ context context'))
                            (Property' context context'
                                       focus focus'))))
     (implementation
      (the (in_left it)
           (<| (with ["/" 0] it)
               [:its (|>> pair.left
                          /:its)
                :has (function.and (|>> (pair.by function.identity pair.left)
                                        /:has)
                                   (|>> pair.right
                                        pair.right))]))
      (the (in_right it)
           (<| (with ["/" 0] it)
               [:its (|>> pair.right
                          /:its)
                :has (function.and (|>> pair.right
                                        pair.left)
                                   (|>> (pair.by function.identity pair.right)
                                        /:has))]))))

(the .public (as_aspect it
                        [pro_functor cartesian])
     (<| (for_any (_ context context' focus focus'))
         (-> (Property' context context' focus focus')
             (Aspect context context' focus focus'
                     (<| (for_any (_ context context'))
                         (Property' context context' focus focus')))))
     (<| (with ["/" 0] it)
         (with ["//:" 0] pro_functor)
         (with ["//:" 0] cartesian)
         (|>> //:in_left
              (//:each (function.and /:its function.identity) /:has))))

(the .public (of_aspect =>)
     (<| (for_any (_ context context' focus focus'))
         (-> (Aspect context context' focus focus' (<| (for_any (_ context context'))
                                                       (Property' context context' focus focus')))
             (Property' context context' focus focus')))
     (=> [..functor ..cartesian]
         [:its function.identity
          :has pair.left]))
