(.using
 [library
  [lux (.except)
   [abstract
    [functor (.only Functor)]
    [monad (.only Monad)]]
   [[0] function]
   [data
    [collection
     [[0] list
      [["?" 1] \\projection]]]]
   [macro (.only with_names)
    [[0] syntax]
    [[0] template]]
   [meta
    [[0] code (.only)
     [["<" 1 ">"] \\projection]]]]])

(every .public (Context it answer)
       (-> it
           answer))

(the .public empty
     (for_any (_ it)
              (Context it it))
     function.identity)

(every .public (Continuation it)
       (for_any (_ answer)
                (-> (Context it answer)
                    answer)))

(the .public (continued next cont)
     (for_any (_ it answer)
              (-> (Context it answer) (Continuation it answer)
                  answer))
     (cont next))

(the .public value
     (for_any (_ it)
              (-> (Continuation it)
                  it))
     (..continued ..empty))

(the Implementation
     (template.macro (_ <interface>)
                     [(for_any (_ answer)
                               (<interface> (for_any (_ it)
                                                     (Continuation it answer))))]))

(the .public functor
     (Implementation Functor)
     (implementation
      (the (each $ it)
           (function (_ next)
                     (it (function.composite next $))))))

(the .public monad
     (Implementation Monad)
     (implementation
      (the functor ..functor)

      (the (pure value)
           (function (_ next)
                     (next value)))

      (the (conjoint ffa)
           (function (_ next)
                     (ffa (continued next))))))

(the .public (with_current context)
     (for_any (_ local_return global_return final_return)
              (-> (-> (-> local_return (Continuation global_return final_return))
                      (Continuation local_return final_return))
                  (Continuation local_return final_return)))
     (function (_ after_pause)
               (context (function (_ value)
                                  (function (_ after_resumption)
                                            (after_pause value)))
                        after_pause)))

(alias [call/cc]
       ..with_current)

(<| (syntax.the .public (pending ['it ?list.any]))
    (with_names ['_ 'next])
    (pure (list (` (.function ((, '_) (, 'next))
                              ((, 'next) (, 'it)))))))
