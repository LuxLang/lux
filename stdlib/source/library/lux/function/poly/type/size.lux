(.using
 [library
  [lux (.except)
   [[0] function]
   [data
    [[0] pair]]
   [math
    [number
     [/64
      [["n"] natural]]]]]]
 [[0] //])

(comment "https://en.wikipedia.org/wiki/Algorithm"
         (every .public (Algorithm ! it)
                (-> (! it)
                    Natural)))

(the .public constant
     (for_any (_ it)
              (Algorithm (//.Constant it)))
     (function.constant 0))

(the .public variable
     (Algorithm //.Variable)
     (function.constant 1))

(the .public (recursive size)
     (for_any (_ it)
              (-> (-> (Algorithm it)
                      (Algorithm it))
                  (Algorithm it)))
     (function (recursion value)
               (size recursion value)))

(the .public (case left right)
     (for_any (_ left right)
              (-> (Algorithm left) (Algorithm right)
                  (Algorithm (//.Case left right))))
     (function (_ it)
               (when it
                     {0b it} (left it)
                     {1b it} (right it))))

(the .public (pair left right)
     (for_any (_ left right)
              (-> (Algorithm left) (Algorithm right)
                  (Algorithm (//.Pair left right))))
     (function (_ it)
               (n.+ (left (pair.left it))
                    (right (pair.right it)))))
