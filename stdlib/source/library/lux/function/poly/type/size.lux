(.using
 [library
  [lux (.except)
   [[0] function]
   [math
    [number
     [/64
      [["n"] natural]]]]]]
 [[0] //])

(<| (comment "https://en.wikipedia.org/wiki/Size")
    (every .public Size)
    Natural)

(<| (comment "https://en.wikipedia.org/wiki/Algorithm")
    (every .public (Algorithm ! it))
    (-> (! it)
        Size))

(the .public constant
     (for_any (_ it)
              (Algorithm (//.Constant it)))
     (function.constant 0))

(the .public variable
     (Algorithm //.Variable)
     (function.constant 1))

(the .public (case left right)
     (for_any (_ left right)
              (-> (Algorithm left) (Algorithm right)
                  (Algorithm (//.Case left right))))
     (function (_ it)
               (when it
                     {0b it} (left it)
                     {1b it} (right it))))

(the .public (pair left right)
     (for_any (_ left right)
              (-> (Algorithm left) (Algorithm right)
                  (Algorithm (//.Pair left right))))
     (function (_ [the_left the_right])
               (n.+ (left the_left)
                    (right the_right))))

(the .public (recursion size)
     (for_any (_ it)
              (-> (-> (Algorithm it)
                      (Algorithm it))
                  (Algorithm it)))
     (function (recursion value)
               (size recursion value)))
