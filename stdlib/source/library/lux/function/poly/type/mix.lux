(.using
 [library
  [lux (.except)
   [abstract
    [monoid (.only Monoid)]]
   [transduction (.only Reduction)]]]
 [[0] //])

(every .public (Mix context)
       (for_any (_ whole piece)
                (-> (Reduction whole piece)
                    (Reduction whole (context piece)))))

(the .public (with_monoid monoid mix value)
     (for_any (_ ! it)
              (-> (Monoid it) (Mix !) (! it)
                  it))
     (mix (by monoid composite) value (by monoid identity)))

(the .public constant
     (for_any (_ it)
              (Mix (//.Constant it)))
     (function (_ value it init)
               init))

(the .public variable
     (Mix //.Variable)
     (function (_ value it init)
               (value it init)))

(the .public (case left right)
     (for_any (_ left right)
              (-> (Mix left) (Mix right)
                  (Mix (//.Case left right))))
     (function (_ value it init)
               (when it
                     {0b it}
                     (left value it init)
                     
                     {1b it}
                     (right value it init))))

(the .public (pair left right)
     (for_any (_ left right)
              (-> (Mix left) (Mix right)
                  (Mix (//.Pair left right))))
     (function (_ value [the_left the_right])
               (|>> (left value the_left)
                    (right value the_right))))

(the .public (recursion body)
     (for_any (_ it)
              (-> (Change (Mix it))
                  (Mix it)))
     (function (recursion value it init)
               ((body recursion) value it init)))
