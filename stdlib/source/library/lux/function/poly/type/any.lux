(.using
 [library
  [lux (.except)
   [[0] error (.only)
    [[0] try (.only Try)]]
   [function
    [predicate (.only Predicate)]]
   [data
    [[0] pair]]]]
 [[0] //])

(<| (comment "https://en.wikipedia.org/wiki/Algorithm")
    (every .public (Algorithm ! it)
           (-> (Predicate it) (! it)
               (Try it))))

(error.the .public none)

(the .public (constant ? _)
     (for_any (_ it)
              (Algorithm (//.Constant it)))
     {try.:Failure ..none})

(the .public (variable ? it)
     (Algorithm //.Variable)
     (if (? it)
         {try.:Success it}
         {try.:Failure ..none}))

(the .public (case left right
                   ? it)
     (for_any (_ left right)
              (-> (Algorithm left) (Algorithm right)
                  (Algorithm (//.Case left right))))
     (when it
           {0b it} (left ? it)
           {1b it} (right ? it)))

(the .public (pair left right
                   ? it)
     (for_any (_ left right)
              (-> (Algorithm left) (Algorithm right)
                  (Algorithm (//.Pair left right))))
     (try.and/or (left ? (pair.left it))
                 (right ? (pair.right it))))

(the .public (recursive it)
     (for_any (_ it)
              (-> (-> (Algorithm it)
                      (Algorithm it))
                  (Algorithm it)))
     (function (recursion value)
               (it recursion value)))
