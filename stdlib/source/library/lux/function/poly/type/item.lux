(.using
 [library
  [lux (.except)
   [function
    [predicate (.only Predicate)]]
   [data
    [[0] maybe]]
   [math
    [number
     [/64
      [[0] natural]]]]]]
 [[0] //])

(the .public Index
     Natural)

(the .public choice
     Index
     0)

(comment "https://en.wikipedia.org/wiki/Algorithm"
         (every .public (Algorithm ! it)
                (-> Index (! it)
                    (Maybe it))))

(the .public (constant index _)
     (for_any (_ it)
              (Algorithm (//.Constant it)))
     {.:None})

(the .public (variable index it)
     (Algorithm //.Variable)
     (when index
           ..choice
           {.:Some it}
           
           else
           {.:None}))

(the .public (case left right
                   index it)
     (for_any (_ left right)
              (-> (Algorithm left) (Algorithm right)
                  (Algorithm (//.Case left right))))
     (when it
           {0b it} (left index it)
           {1b it} (right index it)))

(the .public (pair left right
                   index [the_left the_right])
     (for_any (_ left right)
              (-> (Algorithm left) (Algorithm right)
                  (Algorithm (//.Pair left right))))
     (maybe.and/or (left index the_left)
                   (right (-- index) the_right)))

(the .public (recursion it)
     (for_any (_ it)
              (-> (Change (Algorithm it))
                  (Algorithm it)))
     (function (recursion value)
               (it recursion value)))
