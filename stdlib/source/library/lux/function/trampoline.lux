(.using
 [library
  [lux (.except)
   [abstract
    [functor (.only Functor)]
    [monad (.only Monad)]]
   [data
    [collection
     ["[0]" list
      ["?[1]" \\projection]]]]
   ["[0]" macro (.only)
    ["[0]" syntax]]
   [meta
    ["[0]" code
     ["?[1]" \\projection]]]]]
 ["[0]" //])

(every .public (Trampoline it)
       (Variant {:Return it}
                {:Jump (-> Any
                           (Trampoline it))}))

(the .public return
     (for_any (_ value)
              (-> value
                  (Trampoline value)))
     (|>> {:Return}))

(<| (syntax.the .public (jump [thunk ?list.any]))
    (macro.with_names ['_])
    (pure (list (` {:Jump (function ((, '_) (, '_))
                                    (, thunk))}))))

(the .public (value it)
     (for_any (_ value)
              (-> (Trampoline value)
                  value))
     (when it
           {:Return it}
           it
           
           {:Jump next}
           (value (next []))))

(the .public functor
     (Functor Trampoline)
     (implementation
      (the (each value it)
           (when it
                 {:Return it}
                 {:Return (value it)}
                 
                 {:Jump next}
                 {:Jump (//.composite (each value)
                                      next)}))))

(the .public monad
     (Monad Trampoline)
     (implementation
      (the functor ..functor)
      (the pure ..return)
      (the conjoint ..value)))
