(.using
 [library
  [lux (.except)
   [abstract
    [hash (.only Hash)]
    [enum (.only Enum)]
    [interval (.only Interval)]
    [monoid (.only Monoid)]
    [equality (.only Equality)]
    [format (.only Format)]
    [order (.only Order)]]
   [[0] error (.only)
    [[0] try (.only Try)]]
   [function
    [predicate (.only Predicate)]]]]
 [[0] // (.only)
  [[1 0] natural]
  [//
   [[0] signum]]])

(the template:with (.in_module# .prelude .template:with))

(the .public Number
     .Integer)

(the It
     ..Number)

(template:with [,value ,name]
               [(the .public ,name
                     It
                     ,value)]

               [[+0 zero]
                [+1 positive_one]
                [-1 negative_one]
                ])

(template:with [<name> <op>]
               [(the .public (<name> param subject)
                     (-> It It
                         Bit)
                     (<op> param subject))]

               [[= .b64_=#]
                [< .int_<#]
                ])

(the .public (<= reference it)
     (-> It It
         Bit)
     (if (.int_<# reference it)
         true
         (.b64_=# reference it)))

(the .public (> reference it)
     (-> It It
         Bit)
     (.int_<# it reference))

(the .public (>= reference it)
     (-> It It
         Bit)
     (if (.int_<# it reference)
         true
         (.b64_=# reference it)))

(template:with [<comparison> <name>]
               [(the .public <name>
                     (Predicate It)
                     (<comparison> +0))]

               [[..> positive?]
                [..< negative?]
                [..= zero?]
                ])

(template:with [<name> <test>]
               [(the .public (<name> left right)
                     (-> It It
                         It)
                     (if (<test> right left)
                         left
                         right))]

               [[minor ..<]
                [major ..>]
                ])

(template:with [<name> <op>]
               [(the .public (<name> param subject)
                     (-> It
                         (Change It))
                     (<op> param subject))]

               [[+ .b64_+#]
                [- .b64_-#]
                [x .int_x#]
                [/ .int_/#]
                [% .int_%#]
                ])

(the .public (/% param subject)
     (-> It It
         [It It])
     [(../ param subject)
      (..% param subject)])

(<| (comment "https://en.wikipedia.org/wiki/Exponentiation"
             "https://en.wikipedia.org/wiki/Exponentiation_by_squaring")
    (the .public (^ power base)
         (-> //natural.Exponent
             (Change It)))
    (loop (^ [power power
              base base
              it +1]))
    (if (.b64_=# 0 power)
        it)
    (^ (//.>> 1 power)
       (.int_x# base base)
       (if (.b64_=# 1 (.b64_and# 1 power))
           (.int_x# base it)
           it)))

(the .public (opposite it)
     (Change It)
     (..- it ..zero))

(the .public (absolute it)
     (Change It)
     (if (..< +0 it)
         (..opposite it)
         it))

(the .public (signum it)
     (Change It)
     (if (..= +0 it)
         +0
         
         (..< +0 it)
         -1
         
         (comment "else"
                  +1)))

(comment "https://en.wikipedia.org/wiki/Modulo"
         "https://rob.conery.io/2018/08/21/mod-and-remainder-are-not-the-same/"
         (the .public (modulo divisor dividend)
              (-> It It
                  It)
              (let [remainder (..% divisor dividend)]
                   (if (and/or (and (..< +0 divisor)
                                    (..> +0 remainder))
                               (and (..> +0 divisor)
                                    (..< +0 remainder)))
                       (..+ divisor remainder)
                       remainder))))

(the .public even?
     (Predicate It)
     (|>> (..% +2)
          (.b64_=# +0)))

(the .public odd?
     (Predicate It)
     (|>> ..even?
          not))

(comment "https://en.wikipedia.org/wiki/Greatest_common_divisor"
         (the .public (greatest_common_divisor a b)
              (-> It It
                  It)
              (.integer (//natural.greatest_common_divisor (.natural (..absolute a))
                                                           (.natural (..absolute b))))))

(alias [gcd]
       ..greatest_common_divisor)

(comment "https://en.wikipedia.org/wiki/Coprime_integers"
         (the .public (co_prime? a b)
              (-> It
                  (Predicate It))
              (..= +1 (..greatest_common_divisor a b))))

(comment "https://en.wikipedia.org/wiki/Extended_Euclidean_algorithm"
         (the .public (extended_greatest_common_divisor a b)
              (-> It It
                  [[It It] It])
              (loop (extended_greatest_common_divisor [x +1 x1 +0
                                                       y +0 y1 +1
                                                       a1 (..absolute a) b1 (..absolute b)])
                    (when b1
                          +0 [[x y] a1]
                          _ (let [q (/ b1 a1)]
                                 (extended_greatest_common_divisor x1 (- (..x q x1) x)
                                                                   y1 (- (..x q y1) y)
                                                                   b1 (- (..x q b1) a1)))))))

(comment "https://en.wikipedia.org/wiki/Least_common_multiple"
         (`` (the .public (least_common_multiple a b)
                  (-> It It
                      It)
                  (when [a b]
                        (,, (template:with [<pattern>]
                                           [<pattern>
                                            +0]

                                           [[[_ +0]]
                                            [[+0 _]]
                                            ]))

                        _
                        (/ (greatest_common_divisor a b)
                           (x a b))))))

(alias [lcm]
       ..least_common_multiple)

(the .public real
     (-> It
         Real)
     (|>> .int_f64#))

(the .public equality
     (Equality It)
     (implementation
      (the = ..=)))

(the .public order
     (Order It)
     (implementation
      (the equality ..equality)
      (the < ..<)))

(the .public enum
     (Enum It)
     (implementation
      (the order ..order)
      (the succ ++)
      (the pred --)))

(comment "TODO: Find out why the numeric literals fail during JS compilation."
         (the .public interval
              (Interval It)
              (implementation
               (the enum ..enum)
               (the maximum
                    (comment +9,223,372,036,854,775,807
                             (let [half (//.<< 62 +1)]
                                  (+ half
                                     (-- half)))))
               (the minimum
                    (comment -9,223,372,036,854,775,808
                             (//.<< 63 +1))))))

(template:with [<name> <composite> <identity>]
               [(the .public <name>
                     (Monoid It)
                     (implementation
                      (the identity <identity>)
                      (the composite <composite>)))]

               [[addition       ..+   +0]
                [multiplication ..x   +1]
                [maximum        ..major (by ..interval minimum)]
                [minimum        ..minor (by ..interval maximum)]
                ])

(template:with [,character ,signum]
               [(the ,character
                     (signum.as_text ,signum))]

               [[+sign signum.positive]
                [-sign signum.negative]
                ])

(template:with [<struct> <format>]
               [(the .public <struct>
                     (Format Text It)
                     (implementation
                      (the (as value)
                           (if (..< +0 value)
                               (|> value ++ ..opposite .natural ++ (by <format> as) (.text_composite# ..-sign))
                               (|> value .natural (by <format> as) (.text_composite# ..+sign))))

                      (the (of repr)
                           (let [input_size (.text_size# repr)]
                                (if (//natural.> 1 input_size)
                                    (when (.text_clip# 0 1 repr)
                                          ..+sign
                                          (|> repr
                                              (.text_clip# 1 (-- input_size))
                                              (by <format> of)
                                              (by try.functor each (|>> .integer)))
                                          
                                          ..-sign
                                          (|> repr
                                              (.text_clip# 1 (-- input_size))
                                              (by <format> of)
                                              (by try.functor each (|>> -- .integer ..opposite --)))
                                          
                                          _
                                          {try.:Failure error.not_valid})
                                    {try.:Failure error.not_valid})))))]

               [[base_02 //natural.base_02]
                [base_08 //natural.base_08]
                [base_10 //natural.base_10]
                [base_16 //natural.base_16]
                ])

(the .public hash
     (Hash It)
     (implementation
      (the equality ..equality)
      (the hash (|>> .natural))))

(the _expansion:let (.in_module# .prelude .expansion:let))

(the .public (>> parameter subject)
     (-> Natural It
         It)
     (<| (_expansion:let [<positive> (//.>> parameter subject)])
         (if (< +0 subject)
             (|> +1
                 (//.<< parameter)
                 --
                 (//.<< (//natural.- parameter //.width))
                 (//.and/or <positive>))
             <positive>)))

(the .public (multiple? reference it)
     (-> It
         (Predicate It))
     (|> it
         (% reference)
         (.b64_=# +0)))

(the .public (divisor? reference it)
     (-> It
         (Predicate It))
     (multiple? it reference))

(the .public infinity
     It
     (//.<< 63 +1))

(the .public (reflection origin it)
     (-> It
         (Change It))
     (- (- origin it) origin))
