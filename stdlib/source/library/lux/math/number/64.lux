(.using
 [library
  [lux (.except and and/or not false true)
   [abstract
    [equality (.only Equality)]
    [hash (.only Hash)]
    [monoid (.only Monoid)]]
   [error
    [[0] try (.only Try)]]
   [function
    [predicate (.only Predicate)]]]])

(the .public Number
     .I64)

(the template:with (.in_module# .prelude .template:with))

(the .public bits_per_byte
     8)

(the .public bytes_per_i64
     8)

(the template:macro (.in_module# .prelude template:macro))

(template:with [,name ,extension]
               [(<| (the ,name)
                    (template:macro (_ ,parameter ,subject))
                    [(,extension ,parameter ,subject)])]

               [[n:= .b64_=#]
                [n:+ .i64_+#]
                [n:- .i64_-#]
                ])

(template:with [<name> <op>]
               [(the .public (<name> parameter subject)
                     (<| (-> (I64 Any))
                         (for_any (_ it))
                         (Change (I64 it)))
                     (<op> parameter subject))]

               [[or .b64_or#]
                [and .b64_and#]
                [and/or .b64_and/or#]
                ])

(the .public width
     Natural
     (.natural (.int_x# (.integer ..bits_per_byte)
                        (.integer ..bytes_per_i64))))

(<| (comment "TODO: Do some form of type specialization.")
    (every .public Shift)
    Natural)

(the mask_of_shift
     Shift
     (-- ..width))

(the .public shift
     (-> Natural
         Shift)
     (..and ..mask_of_shift))

(the .public (opposite it)
     (Change Shift)
     (n:- (shift it) ..width))

(the high
     (-> (I64 Any)
         I64)
     (|>> (.i64_right# 32)))

(the low
     (-> (I64 Any)
         I64)
     (let [mask (|> 1 (.i64_left# 32) (.i64_-# 1))]
          (|>> (.b64_and# mask))))

(the (n:< reference it)
     (-> Natural Natural
         Bit)
     (let [referenceH (..high reference)
           itH (..high it)]
          (if (.int_<# referenceH itH)
              .true
              (if (.b64_=# referenceH itH)
                  (.int_<# (..low reference)
                           (..low it))
                  .false))))

(<| (comment "https://en.wikipedia.org/wiki/Mask_(computing)")
    (every .public Mask)
    I64)

(template:with [,b ,name]
               [(the .public ,name
                     Mask
                     (.b64# ,b ,b ,b ,b ,b ,b ,b ,b
                            ,b ,b ,b ,b ,b ,b ,b ,b
                            ,b ,b ,b ,b ,b ,b ,b ,b
                            ,b ,b ,b ,b ,b ,b ,b ,b
                            ,b ,b ,b ,b ,b ,b ,b ,b
                            ,b ,b ,b ,b ,b ,b ,b ,b
                            ,b ,b ,b ,b ,b ,b ,b ,b
                            ,b ,b ,b ,b ,b ,b ,b ,b))]

               [[0b false]
                [1b true]
                ])

(the meta:failure (.in_module# .prelude .failure))
(the meta:pure (.in_module# .prelude meta:pure))

(template:with [,name ,extension]
               [(<| (the ,name)
                    (macro (_ parameter,'subject))
                    (when parameter,'subject
                          (list {.:Natural @ parameter} 'subject)
                          (meta:pure (list (loop (of [parameter parameter
                                                      'it 'subject])
                                                 (when parameter
                                                       0 'it
                                                       _ (of (-- parameter)
                                                             (` (,extension 1 (, 'it))))))))

                          else
                          (meta:failure "")))]

               [[static_<< .i64_left#]
                [static_>> .i64_right#]
                ])

(<| (the shift_by)
    (template:macro (_ ,by ,<> ,extension ,parameter ,subject))
    [(,<> (n:- ,by ,parameter) (,extension ,by ,subject))])

(<| (the if_shift)
    (template:macro (_ ,by ,<> ,extension ,parameter ,subject
                       ,under))
    [(if (n:< ,by ,parameter)
         ,under
         (shift_by ,by ,<> ,extension ,parameter ,subject))])

(template:with [,<> ,static ,extension]
               [(the .public (,<> parameter subject)
                     (<| (-> Shift)
                         (for_any (_ it))
                         (Change (I64 it)))
                     (if (n:< 64 parameter)
                         (<| (if_shift 32 ,<> ,static parameter subject)
                             (if_shift 16 ,<> ,static parameter subject)
                             (if_shift 08 ,<> ,static parameter subject)
                             (if_shift 04 ,<> ,static parameter subject)
                             (if_shift 02 ,<> ,static parameter subject)
                             (if (n:< 01 parameter)
                                 (,static 00 subject)
                                 (,static 01 subject)))
                         (,extension parameter subject)))]

               [[dynamic_<< static_<< .i64_left#]
                [dynamic_>> static_>> .i64_right#]
                ])

(template:with [,name ,static ,dynamic]
               [(<| (the .public ,name)
                    (macro (_ parameter,'subject))
                    (when parameter,'subject
                          (list {.:Natural @ parameter} 'subject)
                          (meta:pure (list (` (,static (, {.:Natural @ parameter}) (, 'subject)))))

                          (list {.:Natural @ parameter})
                          (meta:pure (list (` (|>> (,static (, {.:Natural @ parameter}))))))

                          (list 'parameter 'subject)
                          (meta:pure (list (` (,dynamic (, 'parameter) (, 'subject)))))

                          (list 'parameter)
                          (meta:pure (list (` (,dynamic (, 'parameter)))))

                          else
                          (meta:failure "")))]

               [[<< ..static_<< ..dynamic_<<]
                [>> ..static_>> ..dynamic_>>]
                ])

(every .public Address
       Natural)

(the .public (bit position)
     (-> Address
         Mask)
     (<< (..and ..mask_of_shift position)
         (.i64 1)))

(the .public sign
     Mask
     (..bit (-- ..width)))

(the .public not
     (for_any (_ it)
              (Change (I64 it)))
     (..or ..true))

(the .public (mask amount_of_bits)
     (-> Natural
         Mask)
     (when amount_of_bits
           0 ..false
           bits (when (..and ..mask_of_shift bits)
                      0 ..true
                      bits (|> 1 .i64 (<< (..and ..mask_of_shift bits)) .--))))

(the (with_shift shift value)
     (-> Shift
         (Change Natural))
     (|> value
         (>> shift)
         (n:+ value)))

(the .public (ones it)
     (-> (I64 Any)
         Natural)
     (let [ones' (n:- (|> it (>> 1) (..and 6148914691236517205) i64)
                      (i64 it))]
          (|> ones'
              (>> 2) (..and 3689348814741910323) (n:+ (..and 3689348814741910323 ones'))
              (with_shift 4) (..and 1085102592571150095)
              (with_shift 8)
              (with_shift 16)
              (with_shift 32)
              (..and 127))))

(the .public (zero index input)
     (for_any (_ it)
              (-> Address
                  (Change (I64 it))))
     (|> index ..bit ..not (..and input)))

(template:with [<name> <op>]
               [(the .public (<name> index input)
                     (for_any (_ it)
                              (-> Address
                                  (Change (I64 it))))
                     (|> index ..bit (<op> input)))]

               [[one     ..and/or]
                [flipped ..or]
                ])

(the .public (zero? index input)
     (-> Address
         (Predicate (I64 Any)))
     (|> (.i64 input)
         (..and (..bit index))
         (n:= 0)))

(the .public (one? index input)
     (-> Address
         (Predicate (I64 Any)))
     (.not (..zero? index input)))

(every .public Rotation
       Shift)

(template:with [<name> <forward> <backward>]
               [(the .public (<name> distance input)
                     (for_any (_ it)
                              (-> Rotation
                                  (Change (I64 it))))
                     (..and/or (<forward> (shift distance) input)
                               (<backward> (opposite distance) input)))]

               [[left_rotated  << >>]
                [right_rotated >> <<]
                ])

(the .public (region offset size)
     (-> Rotation Natural
         Mask)
     (..left_rotated offset (..mask size)))

(the .public equality
     (for_any (_ it)
              (Equality (I64 it)))
     (implementation
      (the (= expected actual)
           (n:= expected actual))))

(alias [=]
       ..equality)

(the .public hash
     (for_any (_ it)
              (Hash (I64 it)))
     (implementation
      (the equality ..equality)

      (the hash (|>> .natural))))

(template:with [<monoid> <identity> <composite>]
               [(the .public <monoid>
                     (for_any (_ it)
                              (Monoid (I64 it)))
                     (implementation
                      (the identity <identity>)
                      (the composite <composite>)))]

               [[disjunction ..false ..and/or]
                [conjunction ..true ..and]
                ])

(the .public in_reverse
     (<| (for_any (_ it))
         (Change (I64 it)))
     (let [in_reverse' (<| (is (<| (-> Natural Natural)
                                   (for_any (_ it))
                                   (Change (I64 it))))
                           (function (_ power pattern value))
                           (let [size (<< power 1)])
                           (..or (>> size (..and pattern value))
                                 (<< size (..and (..not pattern) value))))]
          (|>> (in_reverse' 5 11111111,11111111,11111111,11111111,00000000,00000000,00000000,00000000,b)
               (in_reverse' 4 11111111,11111111,00000000,00000000,11111111,11111111,00000000,00000000,b)
               (in_reverse' 3 11111111,00000000,11111111,00000000,11111111,00000000,11111111,00000000,b)
               (in_reverse' 2 11110000,11110000,11110000,11110000,11110000,11110000,11110000,11110000,b)
               (in_reverse' 1 11001100,11001100,11001100,11001100,11001100,11001100,11001100,11001100,b)
               (in_reverse' 0 10101010,10101010,10101010,10101010,10101010,10101010,10101010,10101010,b))))

(template:with [<--> <++>]
               [(alias [<-->]
                       .--)

                (alias [<++>]
                       .++)]

               [[decrement increment]
                [predecessor successor]
                [less more]
                [previous next]
                [before after]
                ])

(<| (the (highest_bit' shift it)
         (-> Natural (I64 Any)
             Natural))
    (when (.natural it)
          0 0
          else)
    (when shift
          0 0
          else)
    (let [cut_off (<< shift 1)])
    (if (n:< cut_off (.natural it))
        (highest_bit' (>> 1 shift) it)
        (n:+ shift (highest_bit' (>> 1 shift) (>> shift it)))))

(the .public (highest_bit it)
     (-> (I64 Any)
         Natural)
     (when (.natural it)
           0 ..width
           _ (highest_bit' 32 it)))
