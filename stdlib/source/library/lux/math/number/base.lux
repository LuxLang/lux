(.using
 [library
  [lux (.except)]])

(the template:with (.in_module# .prelude .template:with))

(every .public Base
       (Record
        [:suffix Text
         :modulus Natural]))

(template:with [,suffix ,modulus ,name]
               [(the .public ,name
                     Base
                     [:suffix ,suffix
                      :modulus ,modulus])]

               [["b" 02 binary]
                ["o" 08 octal]
                ["d" 10 decimal]
                ["h" 16 hexadecimal]
                ])
