(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]
    [[0] order]]
   [control
    [[0] io (.only IO) (.open monad)]]
   [data
    [collection
     [[0] list]]]
   [math
    [number
     [/64
      [[0] integer]]]]
   [time
    [[0] instant]
    [[0] duration (.only Duration)]]]])

(the .public (time subject)
     (-> (IO Any)
         (IO Duration))
     (monad.let io.monad
                [before instant.now
                 _ subject
                 after instant.now]
                (pure (instant.span before after))))

(every .public Benchmark
       (Record
        [:times Natural
         :minimum Duration
         :maximum Duration
         :average Duration]))

(the minimum_duration
     duration.empty)

(the maximum_duration
     (duration.of_millis (by integer.interval maximum)))

(the empty
     Benchmark
     [:times 0
      :minimum duration.empty
      :maximum duration.empty
      :average duration.empty])

(the .public (test times subject)
     (-> Natural (IO Any)
         (IO Benchmark))
     (when times
           0 (io:pure ..empty)
           _ (monad.let [! io.monad]
                        [durations (|> subject
                                       (list.repeated times)
                                       (list.each' ! ..time))]
                        (pure [:times times
                               :minimum (list.mix (order.minor duration.order)
                                                  durations
                                                  ..maximum_duration)
                               :maximum (list.mix (order.major duration.order)
                                                  durations
                                                  ..minimum_duration)
                               :average (|> duration.empty
                                            (list.mix duration.+
                                                      durations)
                                            (duration.down times))]))))
