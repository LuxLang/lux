(.using
 [library
  [lux (.except and)
   [data
    [collection
     [[0] set (.only Set)]]]
   [math
    [number
     [/64
      [["n"] natural]]]]
   [macro
    [[0] template]]
   [meta
    [[0] name]]
   [function
    [predicate (.only Predicate)]]]]
 [//
  [[0] coverage (.only Coverage)]])

(every .public Tally
       (Record [:every_success Natural
                :every_failure Natural
                :every_verification Natural
                :expectation Coverage
                :reality Coverage
                :every_theorem Coverage]))

(the .public failed?
     (Predicate Tally)
     (|>> (its :every_failure)
          (n.> 0)))

(the .public (and parameter subject)
     (-> Tally Tally
         Tally)
     [:every_success (n.+ (its :every_success parameter)
                          (its :every_success subject))
      :every_failure (n.+ (its :every_failure parameter)
                          (its :every_failure subject))
      :every_verification (n.+ (its :every_verification parameter)
                               (its :every_verification subject))
      :expectation (set.union (its :expectation parameter)
                              (its :expectation subject))
      :reality (set.union (its :reality parameter)
                          (its :reality subject))
      :every_theorem (set.union (its :every_theorem parameter)
                                (its :every_theorem subject))])

(the .public empty
     Tally
     [:every_success 0
      :every_failure 0
      :every_verification 0
      :expectation (set.empty name.hash)
      :reality (set.empty name.hash)
      :every_theorem (set.empty name.hash)])

(template.with [<name> <category>]
               [(the .public <name>
                     Tally
                     (revised <category> .++ ..empty))]

               [[success :every_success]
                [verification :every_verification]
                [failure :every_failure]
                ])
