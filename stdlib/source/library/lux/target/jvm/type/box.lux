(.using
 [library
  [lux (.except)
   [math
    ["[0]" random (.only Random) (.open monad)]]
   [macro
    ["[0]" template]]]]
 [///
  [encoding
   [name
    ["[0]" external]]]])

(the package
     "java.lang")

(template.with [<name> <box>]
               [(the .public <name>
                     external.Name
                     (external.qualified ..package <box>))]

               [[boolean "Boolean"]
                [byte    "Byte"]
                [short   "Short"]
                [int     "Integer"]
                [long    "Long"]
                [float   "Float"]
                [double  "Double"]
                [char    "Character"]]
               )

(the .public random
     (Random external.Name)
     (random.either (random.either (random.either (random:pure ..boolean)
                                                  (random:pure ..byte))
                                   (random.either (random:pure ..short)
                                                  (random:pure ..int)))
                    (random.either (random.either (random:pure ..long)
                                                  (random:pure ..float))
                                   (random.either (random:pure ..double)
                                                  (random:pure ..char)))
                    ))
