(.using
 [library
  [lux (.except Type
                static has)
   [abstract
    ["[0]" equality (.only Equality)]]
   [error
    ["[0]" try (.only Try) (.open functor)]]
   [data
    [binary
     [\\injection (.only Injection)]]
    [collection
     ["[0]" list (.open functor)]]]
   [math
    ["[0]" random (.only Random) (.open monad)]
    [number
     ["[0]" /08
      ["[1]" natural]]
     ["[0]" /16
      ["[1]" natural]]
     [/64
      ["n" natural]]]]
   [macro
    ["[0]" template]]
   [type
    ["[0]" nominal]]]]
 [//
  ["[0]" datum]
  [////
   ["[0]" type (.only)
    ["[1]/[0]" projection]]]])

(every .public Register
       /08.Number)

(the Reification
     /16.Number)

(nominal.every .public Registry
               Reification

               (the .public registry
                    (-> Reification
                        Registry)
                    (|>> nominal.of))

               (the (minimal type)
                    (-> type.Method
                        Natural)
                    (let [[type_variables inputs output exceptions] (type/projection.method type)]
                         (list.mix n.+
                                   (list:each (|>> datum.for /16.as) inputs)
                                   0)))

               (template.with [<start> <name>]
                              [(the .public <name>
                                    (-> type.Method
                                        Registry)
                                    (|>> ..minimal
                                         (n.+ <start>)
                                         /16.of
                                         nominal.of))]

                              [[0 static]
                               [1 virtual]])

               (the .public equality
                    (Equality Registry)
                    (by equality.functor each
                        (|>> nominal.as)
                        /16.equality))

               (alias [=]
                      ..equality)

               (the .public as_binary
                    (Injection Registry)
                    (|>> nominal.as
                         /16.as_binary))

               (the .public (has needed)
                    (-> Registry Registry
                        Registry)
                    (|>> nominal.as
                         (/16.major (nominal.as needed))
                         nominal.of))

               (template.with [<name> <extra>]
                              [(the .public <name>
                                    (-> Register
                                        Registry)
                                    (|>> /08.as
                                         /16.of
                                         (/16.+ <extra>)
                                         nominal.of))]

                              [[for datum.small]
                               [for_wide datum.big]])

               (the .public random
                    (Random Registry)
                    (let [limit (++ (/16.as /16.maximum))]
                         (random:each (|>> (n.% limit)
                                           /16.of
                                           nominal.of)
                                      random.natural)))
               )

(the .public length
     /16.size)
