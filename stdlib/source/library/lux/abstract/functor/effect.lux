(.using
 [library
  [lux (.except Or)
   [[0] function (.only)
    [poly
     [[0] type]]]]]
 [[0] // (.only Functor)])

(every .public (Effect input output !)
       [input (-> output !)])

(the .public functor
     (for_any (_ input output)
              (Functor (Effect input output)))
     (implementation
      (the (each value [input next])
           [input (function.composite value
                                      next)])))

(the .public Or
     type.Case)

(the .public or
     //.case)
