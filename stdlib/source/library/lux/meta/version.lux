(.using
 [library
  [lux (.except if)
   [abstract
    [["<>"] projection]
    [[0] monad]]
   [error
    [[0] exception]]
   [data
    [[0] text]
    [collection
     [[0] list (.only)
      [["?" 1] \\projection]]]]
   [macro
    [[0] syntax]]
   [[0] meta (.open functor)
    [[0] code (.only)
     [["<" 1 ">"] \\projection]]]
   [compiler
    [version (.only Version)]]]])

(the .public latest
     Version
     00,10,00)

(syntax.the .public (current [])
            (meta:each (|>> code.text list)
                       meta.version))

(exception.the .public invalid)

(syntax.the .public (if [specializations (<>.some (<>.and <code>.text ?list.any))
                         default (<>.maybe ?list.any)])
            (monad.let meta.monad
                       [current meta.version]
                       (when (list.mix (function (_ [when then] choice)
                                                 (.if (text.= when current)
                                                      {.:Some then}
                                                      choice))
                                       specializations
                                       default)
                             {.:Some it}
                             (pure (list it))
                             
                             {.:None}
                             (meta.failure (exception.error ..invalid [])))))
