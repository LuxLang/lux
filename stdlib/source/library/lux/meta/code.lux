(.using
 [library
  [lux (.except text natural integer revolution local global name variant tuple with)
   [abstract
    [equality (.only Equality)]]
   [data
    [[0] text]
    [collection
     [[0] list (.open functor)]]]
   [logic
    [[0] bit]]
   [math
    [number
     [/64
      [[0] natural]
      [[0] integer]
      [[0] revolution]
      [[0] real]]]]
   [meta
    [[0] provenance]
    [[0] name]]
   [compiler
    [["/"] type]]]])

(the template:with (.in_module# .prelude template:with))

(every .public (Injection it)
       (-> it
           /.Code))

(template:with [<name> <type> <tag>]
               [(the .public <name>
                     (Injection <type>)
                     (|>> {<tag> provenance.dummy}))]
               
               [[bit /.Bit /.:Bit]
                [natural /.Natural /.:Natural]
                [integer /.Integer /.:Integer]
                [revolution /.Revolution /.:Revolution]
                [real /.Real /.:Real]
                [text /.Text /.:Text]
                [name /.Name /.:Name]
                ])

(template:with [<name> <tag>]
               [(the .public <name>
                     (Injection (/.List /.Code))
                     (|>> {<tag> provenance.dummy}))]
               
               [[variant /.:Variant]
                [tuple /.:Tuple]
                [form /.:Form]
                ])

(the .public local
     (Injection /.Text)
     (|>> [""]
          {/.:Name provenance.dummy}))

(`` (the .public equality
         (Equality /.Code)
         (implementation
          (the (= x y)
               (when [x y]
                     (,, (template:with [<tag> <eq>]
                                        [[{<tag> _ x} {<tag> _ y}]
                                         (by <eq> = x y)]

                                        [[/.:Bit bit.equality]
                                         [/.:Natural natural.equality]
                                         [/.:Integer integer.equality]
                                         [/.:Revolution revolution.equality]
                                         [/.:Real real.equality]
                                         [/.:Text text.equality]
                                         [/.:Name name.equality]
                                         ]))

                     (,, (template:with [<tag>]
                                        [[{<tag> _ xs} {<tag> _ ys}]
                                         (by (list.equality =) = xs ys)]

                                        [[/.:Form]
                                         [/.:Variant]
                                         [/.:Tuple]
                                         ]))
                     
                     _
                     false)))))

(alias [=]
       ..equality)

(the .public (absolute it)
     (text.Injection /.Code)
     (`` (when it
               (,, (template:with [<tag> <struct>]
                                  [{<tag> _ value}
                                   (by <struct> as value)]

                                  [[/.:Bit bit.text]
                                   [/.:Natural natural.base_10]
                                   [/.:Integer integer.base_10]
                                   [/.:Revolution revolution.base_10]
                                   [/.:Real real.base_10]
                                   [/.:Name name.absolute]
                                   ]))

               {/.:Text _ value}
               (text.as_text value)

               (,, (template:with [<open> <close> <tag>]
                                  [{<tag> _ members}
                                   (.text <open>
                                          (list.mix (function (_ next prev)
                                                              (let [next (absolute next)]
                                                                   (if (text.= "" prev)
                                                                       next
                                                                       (.text prev " " next))))
                                                    members
                                                    "")
                                          <close>)]

                                  [["(" ")" /.:Form]
                                   ["{" "}" /.:Variant]
                                   ["[" "]" /.:Tuple]
                                   ]))
               )))

(the .public (relative module it)
     (-> Text
         (text.Injection /.Code))
     (`` (when it
               (,, (template:with [<tag> <struct>]
                                  [{<tag> _ value}
                                   (by <struct> as value)]

                                  [[/.:Bit bit.text]
                                   [/.:Natural natural.base_10]
                                   [/.:Integer integer.base_10]
                                   [/.:Revolution revolution.base_10]
                                   [/.:Real real.base_10]
                                   [/.:Name (name.relative module)]
                                   ]))

               {/.:Text _ value}
               (text.as_text value)

               (,, (template:with [<open> <close> <tag>]
                                  [{<tag> _ members}
                                   (.text <open>
                                          (list.mix (function (_ next prev)
                                                              (let [next (relative module next)]
                                                                   (if (text.= "" prev)
                                                                       next
                                                                       (.text prev " " next))))
                                                    members
                                                    "")
                                          <close>)]

                                  [["(" ")" /.:Form]
                                   ["{" "}" /.:Variant]
                                   ["[" "]" /.:Tuple]
                                   ]))
               )))

(`` (the .public (replaced original substitute)
         (-> /.Code /.Code
             (Change /.Code))
         (function (replaced it)
                   (if (by ..equality = original it)
                       substitute
                       (when it
                             (,, (template:with [<tag>]
                                                [{<tag> provenance parts}
                                                 {<tag> provenance (list:each replaced parts)}]

                                                [[/.:Form]
                                                 [/.:Variant]
                                                 [/.:Tuple]
                                                 ]))

                             _
                             it)))))

(alias [as_text]
       ..absolute)

(the .public (provenance it)
     (-> /.Code
         /.Provenance)
     (`` (when it
               (,, (template:with [,tag]
                                  [{,tag it _}
                                   it]

                                  [[/.:Bit]
                                   [/.:Natural]
                                   [/.:Integer]
                                   [/.:Revolution]
                                   [/.:Real]
                                   [/.:Text]
                                   [/.:Name]
                                   [/.:Form]
                                   [/.:Variant]
                                   [/.:Tuple]
                                   ])))))

(the .public (with provenance it)
     (-> /.Provenance
         (Change /.Code))
     (`` (when it
               (,, (template:with [,tag]
                                  [{,tag _ it}
                                   {,tag provenance it}]

                                  [[/.:Bit]
                                   [/.:Natural]
                                   [/.:Integer]
                                   [/.:Revolution]
                                   [/.:Real]
                                   [/.:Text]
                                   [/.:Name]
                                   [/.:Form]
                                   [/.:Variant]
                                   [/.:Tuple]
                                   ])))))
