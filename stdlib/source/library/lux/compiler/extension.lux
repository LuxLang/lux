(.using
 [library
  [lux (.except Name name)
   [data
    [[0] text]]]])

(every .public Name
       Text)

(the .public suffix
     "#")

(the .public name
     (-> Text
         Name)
     (text.suffix ..suffix))

(the .public suffix_of_analysis
     (text "A" ..suffix))

(the .public analysis
     (Change Name)
     (text.suffix ..suffix_of_analysis))

(the .public suffix_of_synthesis
     (text "S" ..suffix))

(the .public synthesis
     (Change Name)
     (text.suffix ..suffix_of_synthesis))
