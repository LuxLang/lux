(.using
 [library
  [lux (.except Alias
                local)
   [abstract
    [equality (.only Equality)]
    [hash (.only Hash)]]
   [control
    [[0] pipe]]
   [data
    [[0] text (.only Injection)
     [["%"] \\injection]]
    [collection
     [[0] dictionary (.only Dictionary)]]]
   [math
    [[0] random (.only Random)]
    [number
     [/64
      [["n"] natural]]]]
   [macro
    [["^"] pattern]
    [[0] template]]
   [meta
    [[0] name]
    [[0] module]]
   [compiler
    [["@" 0] type (.only Reference)]]
   [error
    [[0] try]]]]
 [[0] /
  [[1 0] variable]])

(the .public equality
     (Equality Reference)
     (implementation
      (the (= expected actual)
           (`` (when [expected actual]
                     (,, (template.with [<tag> <equality>]
                                        [[{<tag> expected} {<tag> actual}]
                                         (by <equality> = expected actual)]

                                        [[@type.:Variable_Reference /variable.equality]
                                         [@type.:Constant_Reference name.equality]]))

                     _
                     false)))))

(alias [=]
       ..equality)

(the .public hash
     (Hash Reference)
     (implementation
      (the equality
           ..equality)

      (the (hash value)
           (`` (when value
                     (,, (template.with [<factor> <tag> <hash>]
                                        [{<tag> value}
                                         (|> value
                                             (by <hash> hash)
                                             (n.x <factor>))]

                                        [[2 @type.:Variable_Reference /variable.hash]
                                         [3 @type.:Constant_Reference name.hash]]))
                     )))))

(template.with [<name> <tag>]
               [(the .public <name>
                     (template.macro (<name> content)
                                     [(<| {@type.:Variable_Reference}
                                          {<tag>}
                                          content)]))]

               [[local   @type.:Local]
                [foreign @type.:Foreign]])

(template.with [<name> <tag>]
               [(the .public <name>
                     (template.macro (<name> content)
                                     [(<| {<tag>}
                                          content)]))]

               [[variable @type.:Variable_Reference]
                [constant @type.:Constant_Reference]])

(`` (the .public self
         (template.macro (self)
                         [(..variable (,, (/variable.self)))])))

(every .public Alias
       (Dictionary module.Name Text))

(the .public default
     Alias
     (dictionary.empty text.hash))

(the (with_alias alias [module proper])
     (-> Alias
         (Change Name))
     [(try.else module (dictionary.value module alias))
      proper])

(the .public (custom alias)
     (-> Alias
         (Injection Reference))
     (|>> (pipe.when
           {@type.:Variable_Reference variable}
           (/variable.as_text variable)
           
           {@type.:Constant_Reference it}
           (name.as_text (with_alias alias it)))))

(the .public (relative name_of_module)
     (-> module.Name
         (Injection Reference))
     (|>> (pipe.when
           {@type.:Variable_Reference variable}
           (/variable.as_text variable)
           
           {@type.:Constant_Reference constant}
           (by (name.relative name_of_module) as constant))))

(the .public as_text
     (Injection Reference)
     (|>> (pipe.when
           {@type.:Variable_Reference variable}
           (/variable.as_text variable)
           
           {@type.:Constant_Reference constant}
           (name.as_text constant))))

(the random_constant
     (Random @type.Constant)
     (all random.and
          (random.lower_cased 1)
          (random.upper_cased 1)
          ))

(the .public random
     (Random Reference)
     (all random.or
          /variable.random
          ..random_constant
          ))
