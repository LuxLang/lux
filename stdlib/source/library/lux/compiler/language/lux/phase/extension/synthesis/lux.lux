(.using
 [library
  [lux (.except if with let)
   [abstract
    [["?"] projection (.open functor)]
    [[0] monad]]
   [error
    [[0] try (.only Try) (.open functor)]]
   [data
    [[0] pair]
    [[0] maybe (.open functor)]
    [[0] text]
    [collection
     [[0] dictionary]
     [[0] stack]
     [[0] list (.open monad monoid)
      [["?" 1] \\projection]]]]
   [[0] function (.only)
    [predicate (.only Predicate)]]
   [macro
    [["^"] pattern]
    [[0] template]
    [[0] expansion]]
   [meta
    [[0] provenance]
    [[0] name]
    [[0] static]]
   [math
    [number
     [/64
      [["n"] natural]]]]
   [compiler
    [["@" 0] type]
    [reference
     [[0] register]]]
   [aspect
    [[0] view]]]]
 [[0] /// (.only)
  [///
   [[0] phase]
   [[0] analysis
    [["?" 1] \\projection]]
   [[0] synthesis (.only Operation Phase Bundle)
    [["?" 1] \\projection]
    [[0] path]
    [[0] access]]
   [///
    [meta
     [archive (.only Archive)]]
    [[0] extension (.only)
     [[1 "/" 0] lux]]]]])

(every Handler
       (-> extension.Name
           synthesis.Handler))

(the .public (with name anonymous)
     (-> extension.Name Handler
         (Change Bundle))
     (dictionary.has (extension.analysis name) (anonymous name)))

(the .public (custom [syntax handler]
                     extension_name)
     (for_any (_ it)
              (-> [(?analysis.Projection it)
                   (-> extension.Name Phase Archive it (Operation synthesis.Term))]
                  Handler))
     (function (_ synthesis archive args)
               (when (?list.value args syntax)
                     {try.:Success inputs}
                     (handler extension_name synthesis archive inputs)

                     {try.:Failure error}
                     (phase.failure error))))

(the (as_exec'' as_exec' it)
     (-> (-> (path.Path synthesis.Term)
             (Try (path.Path synthesis.Term)))
         (for_any (_ value)
                  (-> (path.Road value (path.Path synthesis.Term))
                      (Try (path.Road value (path.Path synthesis.Term))))))
     (try:each (|>> [path.:when (its path.:when it)
                     path.:then])
               (as_exec' (its path.:then it))))

(the (as_exec' as_exec)
     (-> (-> synthesis.Term
             (Try synthesis.Term))
         (-> (path.Path synthesis.Term)
             (Try (path.Path synthesis.Term))))
     (function (as_exec' it)
               (`` (when it
                         (^.or {path.:Pop}
                               {path.:Access _}
                               {path.:List _})
                         {try.:Success it}
                         
                         {path.:Bind reality}
                         {try.:Success {path.:Bind (-- reality)}}
                         
                         {path.:Bit_Fork when then {.:None}}
                         (monad.let try.monad
                                    [then (as_exec' then)]
                                    (pure {path.:Bit_Fork when then {.:None}}))

                         {path.:Bit_Fork when then {.:Some else}}
                         (monad.let try.monad
                                    [then (as_exec' then)
                                     else (as_exec' else)]
                                    (pure {path.:Bit_Fork when then {.:Some else}}))
                         
                         (,, (template.with [,tag]
                                            [{,tag [head tail]}
                                             (monad.let [! try.monad]
                                                        [head (as_exec'' as_exec' head)
                                                         tail (list.each' ! (as_exec'' as_exec') tail)]
                                                        (pure {,tag [head tail]}))]

                                            [[path.:I64_Fork]
                                             [path.:F64_Fork]
                                             [path.:Text_Fork]]))

                         (,, (template.with [,tag]
                                            [{,tag this that}
                                             (monad.let try.monad
                                                        [this (as_exec' this)
                                                         that (as_exec' that)]
                                                        (pure {,tag this that}))]

                                            [[path.:Or]
                                             [path.:And]]))

                         {path.:Then it'}
                         (try:each (|>> {path.:Then}) (as_exec it'))))))

(the (as_exec expectation)
     (-> @type.Register
         (-> synthesis.Term
             (Try synthesis.Term)))
     (function (as_exec it)
               (when it
                     {synthesis.:Simple @ _}
                     {try.:Success it}

                     {synthesis.:Variable @ it'}
                     (when it'
                           {@type.:Local reality}
                           (.if (n.= expectation reality)
                                {try.:Failure (static.text (name.as_text (.name ..as_exec)))}

                                (n.> expectation reality)
                                {try.:Success {synthesis.:Variable @ {@type.:Local (-- reality)}}}

                                (comment (n.< expectation reality)
                                         {try.:Success it}))

                           {@type.:Foreign _}
                           {try.:Success it})

                     {synthesis.:Control @ it'}
                     (when it'
                           {synthesis.:When [input path]}
                           (monad.let try.monad
                                      [input (as_exec input)
                                       path (as_exec' as_exec path)]
                                      (pure {synthesis.:Control @ {synthesis.:When [input path]}}))
                           
                           {synthesis.:Function [synthesis.:arity arity
                                                 synthesis.:environment environment
                                                 synthesis.:body body]}
                           (monad.let [! try.monad]
                                      [environment (list.each' ! as_exec environment)]
                                      (pure {synthesis.:Control @ {synthesis.:Function [synthesis.:arity arity
                                                                                        synthesis.:environment environment
                                                                                        synthesis.:body body]}})))

                     {synthesis.:Extension @ name every_argument}
                     (monad.let [! try.monad]
                                [every_argument (list.each' ! as_exec every_argument)]
                                (pure {synthesis.:Extension @ name every_argument})))))

(the (road path it)
     (-> (Change (path.Path synthesis.Term))
         (for_any (_ value)
                  (Change (path.Road value (path.Path synthesis.Term)))))
     [path.:when (its path.:when it)
      path.:then (path (its path.:then it))])

(template.with [,name ,special]
               [(the (,name expectation term)
                     (-> @type.Register
                         (-> (Change synthesis.Term)
                             (Change (path.Path synthesis.Term))))
                     (function (path it)
                               (`` (when it
                                         {path.:Bit_Fork when then else}
                                         {path.:Bit_Fork when (path then) (maybe:each path else)}
                                         
                                         (,, (template.with [,tag]
                                                            [{,tag [head tail]}
                                                             {,tag [(..road path head)
                                                                    (list:each (..road path) tail)]}]

                                                            [[path.:I64_Fork]
                                                             [path.:F64_Fork]
                                                             [path.:Text_Fork]]))

                                         (,, (template.with [,tag]
                                                            [{,tag this that}
                                                             {,tag (path this)
                                                                   (path that)}]

                                                            [[path.:Or]
                                                             [path.:And]]))

                                         {path.:Then it'}
                                         {path.:Then (term it')}

                                         (,, (template.spliced ,special))
                                         
                                         else
                                         it))))]

               [[no_alias' [{path.:Bind reality}
                            {path.:Bind (-- reality)}]]
                [no_duplication' []]])

(the (duplication environment alias variable)
     (-> (@type.Environment synthesis.Term) synthesis.Term synthesis.Term
         (Maybe [@type.Register @type.Register]))
     (.if (and (list.any? (synthesis.= alias) environment)
               (list.any? (synthesis.= variable) environment))
          (.let [environment (list.enumeration environment)]
                (monad.let maybe.monad
                           [[the_alias _] (list.example (|>> pair.right (synthesis.= alias)) environment)
                            [the_variable _] (list.example (|>> pair.right (synthesis.= variable)) environment)]
                           (pure [the_alias the_variable])))
          {.:None}))

(template.with [,name ,name'
                ,expectation ,variable
                ,start_of_loop
                ,type
                ,substitution]
               [(the (,name expectation variable)
                     (-> @type.Register ,type
                         (Change synthesis.Term))
                     (function (term it)
                               (when it
                                     (,expectation @ reality)
                                     (.if (n.= expectation reality)
                                          ,substitution

                                          (n.> expectation reality)
                                          (,expectation @ (-- reality))

                                          (comment (n.< expectation reality)
                                                   it))

                                     (synthesis.loop @ start inits iteration)
                                     (synthesis.loop @
                                                     (,start_of_loop start)
                                                     (list:each term inits)
                                                     (term iteration))

                                     (synthesis.iteration @ it)
                                     (synthesis.iteration @ (list:each term it))
                                     
                                     {synthesis.:Control @ it'}
                                     {synthesis.:Control @ (when it'
                                                                 {synthesis.:When [input path]}
                                                                 {synthesis.:When [(term input)
                                                                                   (,name' expectation term path)]}
                                                                 
                                                                 {synthesis.:Function [synthesis.:arity arity
                                                                                       synthesis.:environment environment
                                                                                       synthesis.:body body]}
                                                                 {synthesis.:Function (when (duplication environment
                                                                                                         (,expectation @ expectation)
                                                                                                         ,variable)
                                                                                            {.:Some [the_alias the_variable]}
                                                                                            [synthesis.:arity arity
                                                                                             synthesis.:environment (|> (list:composite (list.first the_alias environment)
                                                                                                                                        (list.after (++ the_alias) environment))
                                                                                                                        (list:each term))
                                                                                             synthesis.:body (no_duplication the_alias the_variable body)]

                                                                                            else
                                                                                            [synthesis.:arity arity
                                                                                             synthesis.:environment (list:each term environment)
                                                                                             synthesis.:body body])})}
                                     
                                     (synthesis.reification @ function every_argument)
                                     (synthesis.reification @ (term function) (list:each term every_argument))

                                     {synthesis.:Extension @ name every_argument}
                                     {synthesis.:Extension @ name (list:each term every_argument)}

                                     else
                                     it)))]

               [[no_duplication no_duplication'
                 synthesis.foreign (synthesis.foreign @ variable)
                 <|
                 @type.Register
                 (synthesis.foreign @ (.if (n.> expectation variable)
                                           (-- variable)
                                           variable))]
                [no_alias no_alias'
                 synthesis.local variable
                 --
                 synthesis.Term
                 variable]])

(<| (the (as_fork as_path [head tail])
         (-> (Change (path.Path synthesis.Term))
             (for_any (_ value)
                      (Change (path.Fork value (path.Path synthesis.Term))))))
    [(revised path.:then as_path head)
     (list:each (revised path.:then as_path) tail)])

(<| (the (as_path register term)
         (-> (Change @type.Register) (Change synthesis.Term)
             (Change (path.Path synthesis.Term))))
    (function (path it))
    (when it
          {path.:Pop}
          it
          
          {path.:Bind it}
          {path.:Bind (register it)}
          
          {path.:Access _}
          it
          
          {path.:List _}
          it
          
          {path.:Bit_Fork condition then else}
          {path.:Bit_Fork condition (path then) (maybe:each path else)}
          
          {path.:I64_Fork it}
          {path.:I64_Fork (as_fork path it)}
          
          {path.:F64_Fork it}
          {path.:F64_Fork (as_fork path it)}
          
          {path.:Text_Fork it}
          {path.:Text_Fork (as_fork path it)}

          {path.:Or left right}
          {path.:Or (path left) (path right)}

          {path.:And left right}
          {path.:And (path left) (path right)}

          {path.:Then it}
          {path.:Then (term it)}))

(<| (the (as_body register closure)
         (-> @type.Register (@type.Environment synthesis.Term)
             (Change synthesis.Term)))
    (function (term body))
    (when body
          {synthesis.:Simple @ _}
          body
          
          {synthesis.:Variable @ it}
          (when it
                {@type.:Local it}
                (<| {synthesis.:Variable @}
                    {@type.:Local (n.+ register it)})
                
                {@type.:Foreign it}
                (|> closure
                    (list.item it)
                    (try.else body)))
          
          {synthesis.:Control @ it}
          (<| {synthesis.:Control @}
              (when it
                    {synthesis.:When [synthesis.:input input
                                      synthesis.:output output]}
                    {synthesis.:When [synthesis.:input (term input)
                                      synthesis.:output (as_path (n.+ register) term output)]}
                    
                    {synthesis.:Function [synthesis.:arity arity
                                          synthesis.:environment environment
                                          synthesis.:body body]}
                    {synthesis.:Function [synthesis.:arity arity
                                          synthesis.:environment (list:each term environment)
                                          synthesis.:body body]}))

          (synthesis.reification @ function every_argument)
          (synthesis.reification @ (term function) (list:each term every_argument))
          
          {synthesis.:Extension @ name every_parameter}
          {synthesis.:Extension @ name (list:each term every_parameter)}))

(<| (the with_absorption)
    (is (Change synthesis.Term))
    (function (term it))
    (when it
          {synthesis.:Simple @ _}
          it
          
          {synthesis.:Variable @ _}
          it
          
          {synthesis.:Control @ it'}
          (<| {synthesis.:Control @}
              (when it'
                    {synthesis.:When [synthesis.:input input
                                      synthesis.:output output]}
                    {synthesis.:When [synthesis.:input (term input)
                                      synthesis.:output (as_path function.identity term output)]}
                    
                    {synthesis.:Function [synthesis.:arity arity
                                          synthesis.:environment environment
                                          synthesis.:body body]}
                    {synthesis.:Function [synthesis.:arity arity
                                          synthesis.:environment (list:each term environment)
                                          synthesis.:body body]}))

          (synthesis.reification @ function every_argument)
          (when [function (view.as list.stack every_argument)]
                [(synthesis.local @' register.abstraction)
                 (stack.partial (synthesis.local @' register.argument)
                                every_argument)]
                (synthesis.reification @ function (list:each term (view.of list.stack every_argument)))

                else
                (synthesis.reification @ (term function) (list:each term every_argument)))
          
          {synthesis.:Extension @ name every_argument}
          {synthesis.:Extension @ name (list:each term every_argument)}))

(<| (the (with_substitution foreign)
         (-> @type.Register
             (Change synthesis.Term)))
    (function (term it))
    (when it
          {synthesis.:Simple @ _}
          it
          
          {synthesis.:Variable @ it}
          (<| {synthesis.:Variable @}
              (when it
                    {@type.:Local register.abstraction}
                    {@type.:Local register.abstraction}

                    {@type.:Local register.argument}
                    {@type.:Foreign foreign}
                    
                    {@type.:Local it}
                    {@type.:Local (-- it)}
                    
                    {@type.:Foreign it}
                    {@type.:Foreign it}))
          
          {synthesis.:Control @ it'}
          (<| {synthesis.:Control @}
              (when it'
                    {synthesis.:When [synthesis.:input input
                                      synthesis.:output output]}
                    {synthesis.:When [synthesis.:input (term input)
                                      synthesis.:output (as_path (|>> --) term output)]}
                    
                    {synthesis.:Function [synthesis.:arity arity
                                          synthesis.:environment environment
                                          synthesis.:body body]}
                    {synthesis.:Function [synthesis.:arity arity
                                          synthesis.:environment (list:each term environment)
                                          synthesis.:body body]}))

          (synthesis.reification @ function every_argument)
          (synthesis.reification @ (term function) (list:each term every_argument))
          
          {synthesis.:Extension @ name every_argument}
          {synthesis.:Extension @ name (list:each term every_argument)}))

(the (valid_body register it)
     (-> @type.Register synthesis.Term
         (Try synthesis.Term))
     (when it
           (synthesis.abstraction @ [synthesis.:environment environment
                                     synthesis.:arity arity
                                     synthesis.:body body])
           (when arity
                 1 (try:each (as_body register environment)
                             (as_exec register.abstraction body))
                 _ (<| {try.:Success}
                       (synthesis.abstraction @)
                       (when (as_exec register.argument body)
                             {try.:Success body}
                             [synthesis.:environment environment
                              synthesis.:arity (-- arity)
                              synthesis.:body body]
                             
                             {try.:Failure error}
                             [synthesis.:environment (list:composite environment
                                                                     (list (synthesis.local @ register)))
                              synthesis.:arity (-- arity)
                              synthesis.:body (|> body
                                                  with_absorption
                                                  (with_substitution (list.size environment)))])))

           else
           {try.:Failure (static.text (name.as_text (.name ..valid_body)))}))

(the let
     Handler
     (..custom
      [(all ?.and ?list.any ?list.any)
       (function (_ name synthesis archive ['value 'body])
                 (monad.let phase.monad
                            ['value (synthesis archive 'value)
                             'body (synthesis archive 'body)
                             register synthesis.locals
                             .let [@ (synthesis.provenance 'value)]]
                            (when (valid_body register 'body)
                                  {try.:Success 'body}
                                  (pure (when (as_exec register 'body)
                                              {try.:Success 'body}
                                              (synthesis.exec @
                                                              'value
                                                              'body)

                                              {try.:Failure error}
                                              (when 'value
                                                    (^.or (synthesis.local _ _)
                                                          (synthesis.foreign _ _))
                                                    (no_alias register 'value 'body)

                                                    else
                                                    (synthesis.let @ register 'value 'body))))
                                  
                                  {try.:Failure error}
                                  (phase.failure (static.text (name.as_text (.name ..let)))))))]))

(template.with [,name ,extension ,type]
               [(template.the (,name ,@ ,reference ,it)
                              [{synthesis.:Extension ,@ [.prelude (static.text (extension.synthesis ,extension))]
                                                     (list (,type @ ,reference)
                                                           ,it)}])]

               [[i64_= extension/lux.i64_= synthesis.i64]
                [f64_= extension/lux.f64_= synthesis.f64]
                [text_= extension/lux.text_= synthesis.text]])

(template.with [,name ,type ,tag]
               [(the (,name @ [input every_case else])
                     (-> Provenance [synthesis.Term (List [,type synthesis.Term]) synthesis.Term]
                         synthesis.Term)
                     (<| {synthesis.:Control @}
                         {synthesis.:When}
                         [synthesis.:input input
                          synthesis.:output]
                         (when (list.split 1 every_case)
                               [(list [head/when head/then])
                                tail]
                               {path.:Or {,tag [path.:when head/when
                                                path.:then {path.:Then head/then}]
                                               (list:each (function (_ [tail/when tail/then])
                                                                    [path.:when tail/when
                                                                     path.:then {path.:Then tail/then}])
                                                          tail)}
                                         {path.:Then else}}

                               _
                               {path.:Then else})))]

               [[switch_i64 I64 path.:I64_Fork]
                [switch_f64 Real path.:F64_Fork]
                [switch_text Text path.:Text_Fork]])

(the if
     Handler
     (..custom
      [(all ?.and ?list.any ?list.any ?list.any)
       (function (_ name synthesis archive [this then else])
                 (monad.let phase.monad
                            [this (synthesis archive this)
                             then (synthesis archive then)
                             else (synthesis archive else)]
                            (pure (`` (when (is synthesis.Term this)
                                            (,, (template.with [,= ,synthesis ,switch]
                                                               [(,= @ reference this)
                                                                (,switch @ (when else
                                                                                 {synthesis.:Control @ {synthesis.:When else'}}
                                                                                 (when (,synthesis else')
                                                                                       {.:Some [input every_case else']}
                                                                                       (.if (synthesis.= this input)
                                                                                            [input (list:composite (list [reference then]) every_case) else']
                                                                                            [this (list [reference then]) else])

                                                                                       _
                                                                                       [this (list [reference then]) else])
                                                                                 
                                                                                 _
                                                                                 [this (list [reference then]) else]))]

                                                               [[i64_= synthesis.when_i64 switch_i64]
                                                                [f64_= synthesis.when_f64 switch_f64]
                                                                [text_= synthesis.when_text switch_text]]))

                                            _
                                            (<| {synthesis.:Control (synthesis.provenance this)}
                                                {synthesis.:When}
                                                [synthesis.:input this
                                                 synthesis.:output {path.:Bit_Fork .true {path.:Then then} {.:Some {path.:Then else}}}]))))))]))

(the case
     Handler
     (..custom
      [(all ?.and ?analysis.bit ?list.any)
       (function (_ name synthesis archive [right? choice])
                 (expansion.let [,extension (static.text (extension.synthesis extension/lux.case))
                                 ,by_default (.let [@ (synthesis.provenance choice)]
                                                   {synthesis.:Extension @ [.prelude ,extension] (list (synthesis.i64 @ (.i64 0))
                                                                                                       (synthesis.bit @ right?)
                                                                                                       choice)})]
                                (monad.let phase.monad
                                           [choice (synthesis archive choice)]
                                           (pure (.if right?
                                                      (when choice
                                                            {synthesis.:Extension @ [.prelude ,extension] (list (synthesis.i64 @ every_left)
                                                                                                                (synthesis.bit @ right?)
                                                                                                                choice)}
                                                            {synthesis.:Extension @ [.prelude ,extension] (list (synthesis.i64 @ (++ every_left))
                                                                                                                (synthesis.bit @ right?)
                                                                                                                choice)}

                                                            else
                                                            ,by_default)
                                                      ,by_default)))))]))

(every Case
       [(Maybe @type.Register) synthesis.Term])

(the (any_case it)
     (-> (path.Path synthesis.Term)
         (Maybe Case))
     (when it
           {path.:And {path.:Bind register}
                      {path.:Then body}}
           {.:Some [{.:Some register} body]}

           {path.:Then body}
           {.:Some [{.:None} body]}

           else
           {.:None}))

(the (without_temporary_register temporary_register
                                 [register body])
     (-> @type.Register Case
         (Maybe Case))
     (maybe:each (|>> [(maybe:each -- register)])
                 (as_exec temporary_register body)))

(the (every_case it)
     (-> (path.Path synthesis.Term)
         (Maybe [Case (Stack Case)]))
     (when it
           {path.:Or {path.:And {path.:Access {access.:Side left_side}}
                                the_left}
                     (all {path.:And}
                          {path.:Access {access.:Side right_side}}
                          {path.:Bind expectation_of_temporary_register}
                          {path.:Then (<| {synthesis.:Control @}
                                          {synthesis.:When {synthesis.:Variable @ {@type.:Local reality_of_temporary_register}}}
                                          sub_path)})}
           (monad.let [! maybe.monad]
                      [the_left (any_case the_left)
                       maybe.whether (n.= expectation_of_temporary_register reality_of_temporary_register)
                       [the_right every_left] (every_case sub_path)
                       every_left (stack.each' ! (without_temporary_register expectation_of_temporary_register) every_left)]
                      (pure [the_right {.:Top the_left every_left}]))

           {path.:Or {path.:And {path.:Access {access.:Side left_side}}
                                the_left}
                     {path.:And {path.:Access {access.:Side right_side}}
                                the_right}}
           (monad.let maybe.monad
                      [the_left (any_case the_left)
                       the_right (any_case the_right)
                       the_right (when the_right
                                       [{.:Some right_register} right_body]
                                       (when (as_exec right_register right_body)
                                             {.:Some right_body}
                                             (pure [{.:None} right_body])

                                             {.:None}
                                             (pure the_right))
                                       
                                       [{.:None} right_body]
                                       (pure the_right))]
                      (pure [the_right (stack the_left)]))

           {path.:Or {path.:And {path.:Access {access.:Side left_side}}
                                the_left}
                     the_right}
           (monad.let maybe.monad
                      [the_left (any_case the_left)
                       [last previous] (every_case the_right)]
                      (pure [last {.:Top the_left previous}]))

           else
           {.:None}))

(the (of_flat_if_case it)
     (-> synthesis.Term
         (Maybe [synthesis.Term Case (Stack Case)]))
     (when it
           (<| {synthesis.:Control @}
               {synthesis.:When case}
               path)
           (monad.let maybe.monad
                      [[last_right every_left] (every_case path)]
                      (pure [case last_right (stack.in_reverse every_left)]))

           else
           {.:None}))

(the (flat_access every_left right? [register body])
     (-> Natural Bit Case
         (path.Path synthesis.Term))
     {path.:And {path.:Access {access.:Side [every_left right?]}}
                (when register
                      {.:Some register}
                      {path.:And {path.:Bind register}
                                 {path.:Then body}}

                      {.:None}
                      {path.:Then body})})

(the (as_flat_if_case [case right every_left])
     (-> [synthesis.Term Case (Stack Case)]
         synthesis.Term)
     (.let [maximum_left (-- (stack.size every_left))
            [_ path] (stack.mix (function (_ left [every_left right])
                                          [(-- every_left) {path.:Or (flat_access every_left false left)
                                                                     right}])
                                every_left
                                [maximum_left (flat_access maximum_left true right)])]
           (<| {synthesis.:Control (synthesis.provenance case)}
               {synthesis.:When case}
               path)))

(the if_case
     Handler
     (..custom
      [(all ?.and
            ?list.any
            ?list.any
            ?list.any)
       (function (_ name synthesis archive ['case 'left 'right])
                 (monad.let phase.monad
                            ['case (synthesis archive 'case)
                             'left (synthesis archive 'left)
                             'right (synthesis archive 'right)
                             register synthesis.locals
                             naive (when [(valid_body register 'left)
                                          (valid_body register 'right)]
                                         [{try.:Success 'left} {try.:Success 'right}]
                                         (pure (<| {synthesis.:Control (synthesis.provenance 'case)}
                                                   {synthesis.:When 'case}
                                                   {path.:Or {path.:And {path.:Access {access.:Side [0 0b]}}
                                                                        (when (as_exec register 'left)
                                                                              {.:Some 'left}
                                                                              {path.:Then 'left}

                                                                              {.:None}
                                                                              {path.:And {path.:Bind register}
                                                                                         {path.:Then 'left}})}
                                                             {path.:And {path.:Access {access.:Side [0 1b]}}
                                                                        (when (as_exec register 'right)
                                                                              {.:Some 'right}
                                                                              {path.:Then 'right}

                                                                              {.:None}
                                                                              {path.:And {path.:Bind register}
                                                                                         {path.:Then 'right}})}}))
                                         
                                         else
                                         (phase.failure (static.text (name.as_text (.name ..if_case)))))]
                            (pure (|> (of_flat_if_case naive)
                                      (maybe:each as_flat_if_case)
                                      (maybe.else naive)))))]))

(the pair
     Handler
     (..custom
      [(all ?.and ?list.any ?list.any)
       (function (_ name synthesis archive [left right])
                 (expansion.let [,extension (static.text (extension.synthesis extension/lux.pair))]
                                (template.let [(flat_pair ,left ,right)
                                               [(when ,right
                                                      {synthesis.:Extension @ [.prelude ,extension] tail}
                                                      {synthesis.:Extension @ [.prelude ,extension] (list:composite (list ,left) tail)}

                                                      else
                                                      {synthesis.:Extension (synthesis.provenance ,left) [.prelude ,extension] (list ,left ,right)})]]
                                              (monad.let phase.monad
                                                         [left (synthesis archive left)
                                                          right (synthesis archive right)]
                                                         (pure (flat_pair left right))))))]))

(every Side
       [Natural Bit @type.Register])

(the (as_side @ [every_left right? register])
     (-> Provenance Side
         (List synthesis.Term))
     (list (synthesis.i64 @ (.i64 every_left))
           (synthesis.bit @ right?)
           (synthesis.local @ register)))

(the ?side
     (?synthesis.Projection Side)
     (all ?.and
          (?:each (|>> .natural) ?synthesis.i64)
          ?synthesis.bit
          ?synthesis.local))

(every Let_pair
       (Record [:pair synthesis.Term
                :every_side (List Side)
                :body synthesis.Term]))

(the ?let_pair
     (?synthesis.Projection Let_pair)
     (all ?.and
          ?list.any
          (?.many ?side)
          ?list.any))

(the (in_right [every_left right? register])
     (Change [Natural Bit @type.Register])
     [(++ every_left) right? register])

(the (skip [every_left right? register])
     (Change [Natural Bit @type.Register])
     [every_left right? (-- register)])

(the (let_pair_as_extension it)
     (-> Let_pair
         synthesis.Term)
     (when (its :every_side it)
           (list)
           (.let [@ (synthesis.provenance (its :pair it))]
                 (synthesis.exec @
                                 (its :pair it)
                                 (its :body it)))

           every_side
           (.let [@ (synthesis.provenance (its :pair it))]
                 {synthesis.:Extension @ [.prelude (extension.synthesis extension/lux.let_pair)]
                                       (list:conjoint (list (list (its :pair it))
                                                            (list:conjoint (list:each (as_side @) every_side))
                                                            (list (its :body it))))})))

(the (with_side side it)
     (-> Side
         (Change Let_pair))
     (.let [[every_left right? register] side]
           (when (as_exec register (its :body it))
                 {.:Some body}
                 [:pair (its :pair it)
                  :every_side (list:each ..skip (its :every_side it))
                  :body body]

                 {.:None}
                 (revised :every_side (list:composite (list side)) it))))

(the let_pair
     Handler
     (..custom
      [(all ?.and ?list.any ?list.any)
       (function (_ name synthesis archive [pair body])
                 (<| (monad.let phase.monad
                                [pair (synthesis archive pair)
                                 body (synthesis archive body)
                                 left synthesis.locals
                                 .let [right (++ left)]])
                     phase.of_try
                     (monad.let try.monad
                                [body (valid_body left body)
                                 body (valid_body right body)])
                     pure
                     let_pair_as_extension
                     (expansion.let [,extension (static.text (extension.synthesis extension/lux.let_pair))
                                     ,default (these (|> [:pair pair
                                                          :every_side (list)
                                                          :body body]
                                                         (with_side [0 1b right])
                                                         (with_side [0 0b left])))]
                                    (when body
                                          {synthesis.:Extension @ [.prelude ,extension] tape}
                                          (when (?list.value tape ?let_pair)
                                                {try.:Success [pair' every_side' body']}
                                                (.if (synthesis.= (synthesis.local @ right) pair')
                                                     (when (as_exec right body')
                                                           {.:Some body'}
                                                           (|> [:pair pair
                                                                :every_side (list:each (|>> ..in_right ..skip) every_side')
                                                                :body body']
                                                               (with_side [0 0b left]))
                                                           
                                                           {.:None}
                                                           ,default)
                                                     ,default)

                                                {try.:Failure error}
                                                ,default)

                                          else
                                          ,default))))]))

(the if_list
     Handler
     (..custom
      [(all ?.and
            ?list.any
            ?list.any
            ?list.any)
       (<| (function (_ name synthesis archive ['list 'nil 'cons]))
           (monad.let phase.monad
                      ['list (synthesis archive 'list)
                       'nil (synthesis archive 'nil)
                       register_of_head synthesis.locals
                       .let [register_of_tail (++ register_of_head)]
                       'cons (synthesis archive 'cons)])
           phase.of_try
           (monad.let try.monad
                      ['cons (valid_body register_of_head 'cons)
                       'cons (valid_body register_of_tail 'cons)])
           (pure (.let [@ (synthesis.provenance 'list)]
                       {synthesis.:Extension @ [.prelude (extension.synthesis name)]
                                             (list 'list
                                                   'nil
                                                   (synthesis.local @ register_of_head)
                                                   'cons)})))]))

(the (flat_text_composite expected)
     (-> Name
         (Change (List synthesis.Term)))
     (|>> (list:each (function (_ it)
                               (when it
                                     {synthesis.:Extension @ actual parameters}
                                     (.if (name.= expected actual)
                                          parameters
                                          (list it))

                                     _
                                     (list it))))
          list:conjoint))

(the (text_composite name)
     Handler
     (.let [name [.prelude (extension.synthesis name)]]
           (function (_ synthesis archive parts)
                     (monad.let [! phase.monad]
                                [parts (list.each' ! (synthesis archive) parts)]
                                (pure {synthesis.:Extension provenance.dummy name (flat_text_composite name parts)})))))

(the .public bundle
     Bundle
     (`` (|> ///.empty
             (,, (template.with [,name]
                                [(..with (template.name [extension/lux._] [,name])
                                         (template.name [.._] [,name]))]

                                [[..let]
                                 [..if]
                                 [..case]
                                 [..if_case]
                                 [..pair]
                                 [..let_pair]
                                 [..if_list]
                                 [..text_composite]]
                                )))))
