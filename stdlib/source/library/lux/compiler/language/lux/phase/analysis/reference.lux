(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]]
   [[0] meta (.only)
    [[0] code]
    [[0] module]
    [[0] provenance]]]]
 [////
  [[0] phase]
  [["/"] analysis (.only Operation Phase Extender)
   [[0] scope]]
  [///
   [meta
    [archive (.only Archive)]]
   [["@" 0] type]]])

(the .public (reference extender analysis archive quoted_module it)
     (-> Extender Phase Archive Text Name
         (Operation /.Term))
     (when it
           ["" proper]
           (monad.let [! phase.monad]
                      [?var (scope.variable proper)]
                      (when ?var
                            {.:Some _}
                            (/.delegated extender analysis archive (name .local#)
                                         (list {@type.:Name provenance.dummy it}))

                            {.:None}
                            (monad.let !
                                       [this_module phase.name_of_current_module]
                                       (/.delegated extender analysis archive (name .global#)
                                                    (list {@type.:Text provenance.dummy quoted_module}
                                                          {@type.:Name provenance.dummy [this_module proper]})))))

           else
           (/.delegated extender analysis archive (name .global#)
                        (list {@type.:Text provenance.dummy quoted_module}
                              {@type.:Name provenance.dummy it}))))
