(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad]]
   [data
    ["[0]" pair]
    ["[0]" maybe (.open monad)]
    [collection
     ["[0]" list (.open monoid functor)]]]
   [math
    [number
     [/64
      ["n" natural]]]]
   [macro
    ["[0]" expansion]
    ["[0]" template]]
   [function
    [predicate (.only Predicate)]]
   [logic
    ["[0]" bit]]]]
 [////
  ["/" synthesis (.only Abstraction)
   ["[0]" path (.only Path)]]
  [///
   [arity (.only Arity)]
   ["@[0]" type (.only Register Variable Environment)]
   ["[0]" reference (.only)
    ["[0]" variable]]]])

(every (Transform it)
       (-> it
           (Maybe [Bit it])))

(the .public (register_optimization offset)
     (-> Register
         (Change Register))
     (|>> -- (n.+ offset)))

(the .public no_iteration
     Bit
     false)

(the .public some_iteration
     Bit
     (not no_iteration))

(the (path_optimization body_optimization offset)
     (-> (Transform /.Term) Register
         (Transform (Path /.Term)))
     (function (of path)
               (`` (when path
                         {path.:Bind register}
                         {.:Some [..no_iteration
                                  {path.:Bind (register_optimization offset register)}]}

                         (,, (template.with [<tag>]
                                            [{<tag> left right}
                                             (monad.let maybe.monad
                                                        [[iteration_in_left left'] (of left)
                                                         [iteration_in_right right'] (of right)]
                                                        (pure [(and/or iteration_in_left
                                                                       iteration_in_right)
                                                               {<tag> left' right'}]))]

                                            [[path.:Or]
                                             [path.:And]]))

                         {path.:Bit_Fork test then else}
                         (monad.let [! maybe.monad]
                                    [[iteration_in_then then] (of then)
                                     [iteration_in_else else] (when else
                                                                    {.:Some else}
                                                                    (by ! each
                                                                        (function (_ [iteration_in_it it])
                                                                                  [iteration_in_it
                                                                                   {.:Some it}])
                                                                        (of else))

                                                                    {.:None}
                                                                    (pure [..no_iteration
                                                                           {.:None}]))]
                                    (pure [(and/or iteration_in_then
                                                   iteration_in_else)
                                           {path.:Bit_Fork test then else}]))
                         
                         (,, (template.with [<tag>]
                                            [{<tag> [[test then] elses]}
                                             (monad.let [! maybe.monad]
                                                        [[iteration_in_then then] (of then)
                                                         elses (list.each' ! (function (_ [else_test else_then])
                                                                                       (monad.let !
                                                                                                  [[iteration_in_else_then else_then] (of else_then)]
                                                                                                  (pure [iteration_in_else_then
                                                                                                         [else_test else_then]])))
                                                                           elses)]
                                                        (pure [(list.mix (by bit.disjunction composite)
                                                                         (list:each pair.left elses)
                                                                         iteration_in_then)
                                                               {<tag> [[test then]
                                                                       (list:each pair.right elses)]}]))]

                                            [[path.:I64_Fork]
                                             [path.:F64_Fork]
                                             [path.:Text_Fork]]))
                         
                         {path.:Then body}
                         (|> body
                             body_optimization
                             (maybe:each (function (_ [iteration_in_it it])
                                                   [iteration_in_it
                                                    {path.:Then it}])))

                         _
                         {.:Some [..no_iteration
                                  path]}))))

(the (body_optimization true_loop? offset tail_recursion_environment arity expr)
     (-> Bit Register (Environment /.Term) Arity
         (Transform /.Term))
     (loop (of [return? true
                expr expr])
           (when expr
                 {/.:Simple @ _}
                 {.:Some [..no_iteration
                          expr]}

                 {/.:Reference @ reference}
                 (when reference
                       {@type.:Variable_Reference (variable.self)}
                       (if true_loop?
                           {.:None}
                           {.:Some [..no_iteration
                                    expr]})
                       
                       (reference.constant constant)
                       {.:Some [..no_iteration
                                expr]}

                       (reference.local register)
                       {.:Some [..no_iteration
                                {/.:Reference @ (reference.local (register_optimization offset register))}]}

                       (reference.foreign register)
                       (if true_loop?
                           (maybe:each (|>> [..no_iteration])
                                       (list.item register tail_recursion_environment))
                           {.:Some [..no_iteration
                                    expr]}))

                 (/.when @ [input path])
                 (monad.let maybe.monad
                            [[_ input'] (of false input)
                             [iteration_in_path path'] (path_optimization (of return?) offset path)]
                            (pure [iteration_in_path
                                   (/.when @ [input' path'])]))

                 (/.loop @ the_start the_initializatioon the_iteration)
                 (monad.let [! maybe.monad]
                            [the_initializatioon (list.each' ! (of false) the_initializatioon)
                             [iteration_in_the_iteration the_iteration] (of return? the_iteration)]
                            (pure [iteration_in_the_iteration
                                   (/.loop @ (register_optimization offset the_start)
                                           (list:each pair.right the_initializatioon)
                                           the_iteration)]))

                 (/.iteration @ args)
                 (|> args
                     (list.each' maybe.monad (of false))
                     (maybe:each (|>> (list:each pair.right)
                                      (/.iteration @)
                                      [..no_iteration])))

                 (/.abstraction @ [/.:environment environment
                                   /.:arity arity
                                   /.:body body])
                 (monad.let [! maybe.monad]
                            [environment (list.each' ! (of false) environment)]
                            (pure [..no_iteration
                                   (/.abstraction @ [/.:environment (list:each pair.right environment)
                                                     /.:arity arity
                                                     /.:body body])]))
                 
                 (/.reification @ [abstraction arguments])
                 (monad.let [! maybe.monad]
                            [arguments (|> arguments
                                           (list.each' ! (of false))
                                           (by ! each (list:each pair.right)))]
                            (expansion.let [<application> (these (monad.let !
                                                                            [[_ abstraction] (of false abstraction)]
                                                                            (pure [..no_iteration
                                                                                   (/.reification @ [abstraction arguments])])))]
                                           (when abstraction
                                                 {/.:Reference @ {@type.:Variable_Reference (variable.self)}}
                                                 (if (and return?
                                                          (n.= arity (list.size arguments)))
                                                     (pure [..some_iteration
                                                            (/.iteration @ arguments)])
                                                     (if true_loop?
                                                         {.:None}
                                                         <application>))
                                                 
                                                 _
                                                 <application>)))

                 {/.:Extension @ [.prelude "when_char#|translation"] parameters}
                 (comment "TODO: Stop relying on this custom code."
                          (if return?
                              (monad.let [! maybe.monad]
                                         [input (list.item 0 parameters)
                                          else (list.item 1 parameters)

                                          [_ input] (of false input)
                                          matches (list.each' !
                                                              (is (Transform /.Term)
                                                                  (function (_ match)
                                                                            (when match
                                                                                  (/.tuple @ (list when then))
                                                                                  (monad.let !
                                                                                             [[_ when] (of false when)
                                                                                              [iteration_in_then then] (of return? then)]
                                                                                             (pure [iteration_in_then
                                                                                                    (/.tuple @ (list when then))]))

                                                                                  _
                                                                                  (of false match))))
                                                              (list.after 2 parameters))
                                          [iteration_in_else else] (of return? else)]
                                         (pure [(list.mix (by bit.disjunction composite)
                                                          (list:each pair.left matches)
                                                          iteration_in_else)
                                                {/.:Extension @ [.prelude "when_char#|translation"]
                                                              (list:composite (list input else)
                                                                              (list:each pair.right matches))}]))
                              {.:None}))

                 {/.:Extension @ name args}
                 (|> args
                     (list.each' maybe.monad (of false))
                     (maybe:each (|>> (list:each pair.right)
                                      [name]
                                      {/.:Extension @}
                                      [..no_iteration]))))))

(the .public (optimization true_loop? offset inits functionS)
     (-> Bit Register (List /.Term) Abstraction
         (Maybe [Bit [Register (List /.Term) /.Term]]))
     (|> (its /.:body functionS)
         (body_optimization true_loop? offset (its /.:environment functionS) (its /.:arity functionS))
         (maybe:each (function (_ [iteration? body])
                               [iteration?
                                [offset inits body]]))))
