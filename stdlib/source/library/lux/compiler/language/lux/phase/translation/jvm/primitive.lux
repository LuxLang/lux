(.using
 [library
  [lux (.except i64 text)
   [[0] ffi]
   [error
    [[0] try]]
   [math
    [number
     [/64
      [["i"] integer]]]]
   [macro
    [[0] template]]
   [target
    [jvm
     [["_"] bytecode]
     [[0] type]
     [encoding
      [[0] signed]]]]]]
 [//
  [["//"] runtime]
  [[0] value]])

(the $Boolean (type.class (list) "java.lang.Boolean"))

(the .public (bit value)
     (-> Bit
         //.Value)
     (_.getstatic $Boolean (if value "TRUE" "FALSE") $Boolean))

(the .public (i64' value)
     (-> (I64 Any)
         (_.Bytecode Any))
     (`` (when (.integer value)
               (,, (template.with [<integer> <instruction>]
                                  [<integer>
                                   <instruction>]

                                  [[+0 _.lconst_0]
                                   [+1 _.lconst_1]]
                                  ))

               (,, (template.with [<integer> <instruction>]
                                  [<integer>
                                   (all _.composite
                                        <instruction>
                                        _.i2l)]

                                  [[-1 _.iconst_m1]
                                   [+2 _.iconst_2]
                                   [+3 _.iconst_3]
                                   [+4 _.iconst_4]
                                   [+5 _.iconst_5]]
                                  ))

               value
               (when (signed.s1 value)
                     {try.:Success value}
                     (all _.composite
                          (_.bipush value)
                          _.i2l)

                     {try.:Failure _}
                     (when (signed.s2 value)
                           {try.:Success value}
                           (all _.composite
                                (_.sipush value)
                                _.i2l)

                           {try.:Failure _}
                           (_.long value))))))

(the .public (i64 value)
     (-> (I64 Any)
         //.Value)
     (all _.composite
          (..i64' value)
          (value.boxed type.long)))

(ffi.the java/lang/Double
         ("static" doubleToRawLongBits [double] long))

(the double_bits
     (-> Real
         Integer)
     (|>> [] java/lang/Double:doubleToRawLongBits
          ffi.of_long))

(the d0_bits
     Integer
     (double_bits +0.0))

(the .public (f64' value)
     (-> Real
         (_.Bytecode Any))
     (`` (when value
               (,, (template.with [<integer> <instruction>]
                                  [<integer>
                                   <instruction>]

                                  [[+1.0 _.dconst_1]]
                                  ))

               (,, (template.with [<integer> <instruction>]
                                  [<integer>
                                   (all _.composite
                                        <instruction>
                                        _.f2d)]

                                  [[+2.0 _.fconst_2]]
                                  ))

               (,, (template.with [<integer> <instruction>]
                                  [<integer>
                                   (all _.composite
                                        <instruction>
                                        _.i2d)]

                                  [[-1.0 _.iconst_m1]
                                   [+3.0 _.iconst_3]
                                   [+4.0 _.iconst_4]
                                   [+5.0 _.iconst_5]]
                                  ))
               
               _
               (if (|> value
                       ..double_bits
                       (i.= ..d0_bits))
                   _.dconst_0
                   (_.double value)))))

(the .public (f64 value)
     (-> Real
         //.Value)
     (all _.composite
          (..f64' value)
          (value.boxed type.double)))

(the .public text
     (-> Text
         //.Value)
     _.string)
