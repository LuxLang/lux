(.using
 [library
  [lux (.except Type Label with)
   [abstract
    [["?"] projection (.open functor)]
    [[0] monad]]
   [control
    [["|"] pipe]]
   [error
    [[0] try]]
   [[0] function]
   [data
    [[0] pair]
    [collection
     [[0] list (.open monad)
      [["?" 1] \\projection]]
     [[0] dictionary]]]
   [math
    [number
     [[0] /32
      [[1] integer]]]]
   [macro
    [[0] template]]
   [target
    [jvm
     [["_"] bytecode (.only Label Bytecode) (.open monad)]
     [[0] type (.only Type)
      [category (.only Primitive Class)]
      [[0] box]]]]]]
 [/////
  [["//"] extension]
  [translation
   [extension (.only Nullary Unary Binary Trinary Variadic
                     nullary unary binary trinary variadic)]
   [[0] jvm
    [[1 "/" 0] type]
    [[1 "/" 0] value]
    [[1 "/" 0] primitive]
    [[1 "/" 0] complex]
    [[1 "/" 0] runtime (.only Operation Phase Bundle Handler)]
    [[1 "/" 0] when]
    [[1 "/" 0] function
     [[1] abstract]]]]
  [//
   [[0] phase (.open monad)]
   [[0] synthesis (.only)
    [["?" 1] \\projection (.only Projection)]]
   [///
    [type (.only Register)]
    [meta
     [archive (.only Archive)]]
    [[0] extension (.only)
     [[1 "/" 0] lux]]]]])

(the .public (with name anonymous)
     (-> extension.Name Handler
         (Change Bundle))
     (dictionary.has (extension.synthesis name) anonymous))

(the .public (custom [projection handler])
     (for_any (_ it)
              (-> [(Projection it)
                   (-> Phase Archive it (Operation (Bytecode Any)))]
                  Handler))
     (function (_ phase archive input)
               (when (?list.value input projection)
                     {try.:Success input'}
                     (handler phase archive input')

                     {try.:Failure error}
                     (phase.failure error))))

(the $Boolean (type.class (list) box.boolean))
(the $Double (type.class (list) box.double))
(the $Character (type.class (list) box.char))
(the $String (type.class (list) "java.lang.String"))
(the $CharSequence (type.class (list) "java.lang.CharSequence"))
(the $Object (type.class (list) "java.lang.Object"))
(the $PrintStream (type.class (list) "java.io.PrintStream"))
(the $System (type.class (list) "java.lang.System"))
(the $Error (type.class (list) "java.lang.Error"))

(the lux_i64
     (Bytecode Any)
     (all _.composite
          _.i2l
          (jvm/value.boxed type.long)))

(the lux_natural
     ..lux_i64)

(the jvm_int
     (Bytecode Any)
     (all _.composite
          (jvm/value.primitive type.long)
          _.l2i))

(the .public (predicate bytecode)
     (-> (-> Label (Bytecode Any))
         (Bytecode Any))
     (monad.let _.monad
                [@then _.new_label
                 @end _.new_label]
                (all _.composite
                     (bytecode @then)
                     (_.getstatic $Boolean "FALSE" $Boolean)
                     (_.goto @end)
                     (_.set_label @then)
                     (_.getstatic $Boolean "TRUE" $Boolean)
                     (_.set_label @end)
                     )))

(comment "TODO: Get rid of this ASAP"
         (the lux:syntax_char_case!
              (..custom [(all ?.and
                              ?list.any
                              ?list.any
                              (?.some (?synthesis.tuple (all ?.and
                                                             (?synthesis.tuple (?.many ?synthesis.i64))
                                                             ?list.any))))
                         (function (_ phase archive [inputS elseS conditionalsS])
                                   (monad.let [! phase.monad]
                                              [@end jvm/runtime.forge_label
                                               inputG (phase archive inputS)
                                               elseG (phase archive elseS)
                                               conditionalsG+ (is (Operation (List [(List [/32.Number Label])
                                                                                    (Bytecode Any)]))
                                                                  (list.each' ! (function (_ [chars branch])
                                                                                          (monad.let !
                                                                                                     [branchG (phase archive branch)
                                                                                                      @branch jvm/runtime.forge_label]
                                                                                                     (pure [(list:each (function (_ char)
                                                                                                                                 [(/32.of (.integer char)) @branch])
                                                                                                                       chars)
                                                                                                            (all _.composite
                                                                                                                 (_.set_label @branch)
                                                                                                                 branchG
                                                                                                                 (_.when_continuous (_.goto @end)))])))
                                                                              conditionalsS))
                                               .let [table (|> conditionalsG+
                                                               (list:each pair.left)
                                                               list:conjoint)
                                                     conditionalsG (|> conditionalsG+
                                                                       (list:each pair.right)
                                                                       (list.complete _.monad))]]
                                              (pure (monad.let _.monad
                                                               [@else _.new_label]
                                                               (all _.composite
                                                                    inputG (jvm/value.primitive type.long) _.l2i
                                                                    (_.lookupswitch @else table)
                                                                    conditionalsG
                                                                    (_.set_label @else)
                                                                    elseG
                                                                    (<| (_.when_acknowledged @end)
                                                                        (_.set_label @end))
                                                                    )))))])))

(the (lux:is [referenceG sampleG])
     (Binary (Bytecode Any))
     (all _.composite
          referenceG
          sampleG
          (..predicate _.if_acmpeq)))

(the (lux:try riskyG)
     (Unary (Bytecode Any))
     (all _.composite
          riskyG
          (_.checkcast jvm/function.class)
          jvm/runtime.try))

(the case
     (<| ..custom
         [(all ?.and ?synthesis.i64 ?synthesis.bit ?list.any)]
         (function (_ translation archive [every_left right? choice])
                   (jvm/complex.variant translation archive [(.natural every_left) right? choice]))))

(the pair
     (<| ..custom
         [(?.at_least 2 ?list.any)]
         jvm/complex.tuple))

(the side
     (Projection [Natural Bit Register])
     (all ?.and
          (?:each (|>> .natural) ?synthesis.i64)
          ?synthesis.bit
          ?synthesis.local))

(the let_pair
     (<| ..custom
         [(all ?.and ?list.any (?.many ..side) ?list.any)]
         (function (_ translation archive [pair every_side body])
                   (monad.let phase.monad
                              [pair (translation archive pair)
                               body (translation archive body)]
                              (pure (all _.composite
                                         pair
                                         (list.mix (function (_ [every_next_side [every_left right? register]] then)
                                                             (let [after_dup (all _.composite
                                                                                  (if right?
                                                                                      (jvm/when.right_of_tuple every_left)
                                                                                      (jvm/when.left_of_tuple every_left))
                                                                                  (_.astore register)
                                                                                  then)]
                                                                  (when every_next_side
                                                                        0 after_dup
                                                                        _ (all _.composite
                                                                               _.dup
                                                                               after_dup))))
                                                   (list.enumeration (list.in_reverse every_side))
                                                   body)))))))

(the size_of_list
     (Bytecode Any)
     _.arraylength)

(the item_of_list
     (Bytecode Any)
     _.aaload)

(the head_of_list
     (Bytecode Any)
     (all _.composite
          (_.int (/32.of +0))
          ..item_of_list))

(the system:arraycopy
     (Bytecode Any)
     (_.invokestatic ..$System "arraycopy"
                     (type.method [(list)
                                   (list jvm/type.value type.int
                                         jvm/type.value type.int
                                         type.int)
                                   type.void
                                   (list)])))

(the tail_of_list
     (Bytecode Any)
     (let [size_of_tail (all _.composite
                             ..size_of_list
                             (_.int (/32.of +1))
                             _.isub)
           empty_tail (_.anewarray $Object)]
          (comment [complete_list]
                   (all _.composite
                        _.dup size_of_tail
                        _.dup empty_tail

                        (comment [empty_tail
                                  complete_list
                                  size_of_tail
                                  empty_tail]
                                 _.dup_x2)

                        (comment [empty_tail
                                  complete_list
                                  empty_tail
                                  size_of_tail]
                                 _.swap)

                        (_.int (/32.of +1))
                        _.dup_x2
                        (comment [empty_tail
                                  complete_list +1
                                  empty_tail
                                  size_of_tail]
                                 _.pop)

                        (_.int (/32.of +0))
                        _.dup_x1
                        (comment [empty_tail
                                  complete_list +1
                                  empty_tail +0
                                  size_of_tail]
                                 _.pop)
                        
                        (comment [empty_tail]
                                 system:arraycopy)))))

(the if_list
     (<| ..custom
         [(all ?.and
               ?list.any
               ?list.any
               (?.and ?synthesis.local
                      ?list.any))]
         (function (_ translation archive [the_list if_nil [register_of_head if_cons]])
                   (monad.let phase.monad
                              [the_list (translation archive the_list)
                               if_nil (translation archive if_nil)
                               if_cons (translation archive if_cons)
                               .let [register_of_tail (++ register_of_head)

                                     size_of_list! (all _.composite
                                                        _.dup
                                                        ..size_of_list)
                                     bind_head! (all _.composite
                                                     _.dup
                                                     head_of_list
                                                     (_.astore register_of_head))
                                     bind_tail! (all _.composite
                                                     tail_of_list
                                                     (_.astore register_of_tail))]]
                              (pure (monad.let _.monad
                                               [@nil _.new_label
                                                @end _.new_label
                                                .let [if_nil! (all _.composite
                                                                   (_.set_label @nil)
                                                                   _.pop
                                                                   if_nil
                                                                   (<| (_.when_acknowledged @end)
                                                                       (_.set_label @end)))
                                                      if_cons! (all _.composite
                                                                    bind_head!
                                                                    bind_tail!
                                                                    if_cons
                                                                    (_.when_continuous (_.goto @end)))
                                                      if_list! (all _.composite
                                                                    size_of_list!
                                                                    (_.ifeq @nil)
                                                                    if_cons!
                                                                    if_nil!)]]
                                               (all _.composite
                                                    the_list
                                                    (_.checkcast jvm/type.list)
                                                    if_list!)))))))

(the with_basic
     (Change Bundle)
     (|>> (with extension/lux.when_char ..lux:syntax_char_case!)
          (with extension/lux.is? (binary ..lux:is))
          (with extension/lux.try (unary ..lux:try))
          (with extension/lux.case ..case)
          (with extension/lux.pair ..pair)
          (with extension/lux.let_pair ..let_pair)
          (with extension/lux.if_list ..if_list)))

(template.with [<name> <op>]
               [(the (<name> [maskG inputG])
                     (Binary (Bytecode Any))
                     (all _.composite
                          inputG (jvm/value.primitive type.long)
                          maskG (jvm/value.primitive type.long)
                          <op> (jvm/value.boxed type.long)))]

               [[i64:and _.land]
                [i64:or  _.lor]
                [i64:xor _.lxor]])

(template.with [<name> <op>]
               [(the (<name> [shiftG inputG])
                     (Binary (Bytecode Any))
                     (all _.composite
                          inputG (jvm/value.primitive type.long)
                          shiftG ..jvm_int
                          <op> (jvm/value.boxed type.long)))]

               [[i64:<< _.lshl]
                [i64:>> _.lushr]])

(template.with [<name> <type> <op>]
               [(the (<name> [paramG subjectG])
                     (Binary (Bytecode Any))
                     (all _.composite
                          subjectG (jvm/value.primitive <type>)
                          paramG (jvm/value.primitive <type>)
                          <op> (jvm/value.boxed <type>)))]

               [[i64:+ type.long   _.ladd]
                [i64:- type.long   _.lsub]
                [i64:x type.long   _.lmul]
                [i64:/ type.long   _.ldiv]
                [i64:% type.long   _.lrem]
                
                [f64:+ type.double _.dadd]
                [f64:- type.double _.dsub]
                [f64:x type.double _.dmul]
                [f64:/ type.double _.ddiv]
                [f64:% type.double _.drem]])

(template.with [<eq> <lt> <type> <cmp>]
               [(template.with [<name> <reference>]
                               [(the (<name> [paramG subjectG])
                                     (Binary (Bytecode Any))
                                     (all _.composite
                                          subjectG (jvm/value.primitive <type>)
                                          paramG (jvm/value.primitive <type>)
                                          <cmp>
                                          <reference>
                                          (..predicate _.if_icmpeq)))]
                               
                               [[<eq> _.iconst_0]
                                [<lt> _.iconst_m1]])]

               [[i64:= i64:< type.long   _.lcmp]
                [f64:= f64:< type.double _.dcmpg]])

(the (:toString class from)
     (-> (Type Class) (Type Primitive)
         (Bytecode Any))
     (_.invokestatic class "toString" (type.method [(list) (list from) ..$String (list)])))

(template.with [<name> <prepare> <transform>]
               [(the (<name> inputG)
                     (Unary (Bytecode Any))
                     (all _.composite
                          inputG
                          <prepare>
                          <transform>))]

               [[i64:f64
                 (jvm/value.primitive type.long)
                 (all _.composite
                      _.l2d
                      (jvm/value.boxed type.double))]

                [i64:char
                 (jvm/value.primitive type.long)
                 (all _.composite
                      _.l2i
                      _.i2c
                      (..:toString ..$Character type.char))]

                [f64:i64
                 (jvm/value.primitive type.double)
                 (all _.composite
                      _.d2l
                      (jvm/value.boxed type.long))]])

(the with_i64
     (Change Bundle)
     (|>> (with extension/lux.i64_and (binary ..i64:and))
          (with extension/lux.i64_or (binary ..i64:or))
          (with extension/lux.i64_xor (binary ..i64:xor))
          (with extension/lux.i64_left (binary ..i64:<<))
          (with extension/lux.i64_right (binary ..i64:>>))

          (with extension/lux.i64_= (binary ..i64:=))
          (with extension/lux.i64_+ (binary ..i64:+))
          (with extension/lux.i64_- (binary ..i64:-))))

(the with_integer
     (Change Bundle)
     (|>> (with extension/lux.int_< (binary ..i64:<))
          (with extension/lux.int_x (binary ..i64:x))
          (with extension/lux.int_/ (binary ..i64:/))
          (with extension/lux.int_% (binary ..i64:%))
          
          (with extension/lux.int_f64 (unary ..i64:f64))
          (with extension/lux.int_char (unary ..i64:char))))

(the with_real
     (Change Bundle)
     (|>> (with extension/lux.f64_+ (binary ..f64:+))
          (with extension/lux.f64_- (binary ..f64:-))
          (with extension/lux.f64_x (binary ..f64:x))
          (with extension/lux.f64_/ (binary ..f64:/))
          (with extension/lux.f64_% (binary ..f64:%))

          (with extension/lux.f64_= (binary ..f64:=))
          (with extension/lux.f64_< (binary ..f64:<))
          
          (with extension/lux.f64_int (unary ..f64:i64))))

(the $String:length
     (_.invokevirtual ..$String "length" (type.method [(list) (list) type.int (list)])))

(the (text:size inputG)
     (Unary (Bytecode Any))
     (all _.composite
          inputG
          (_.checkcast $String)
          $String:length
          ..lux_i64))

(the no_op
     (Bytecode Any)
     (_:pure []))

(template.with [<name> <pre_subject> <pre_param> <op> <post>]
               [(the (<name> [paramG subjectG])
                     (Binary (Bytecode Any))
                     (all _.composite
                          subjectG <pre_subject>
                          paramG <pre_param>
                          <op> <post>))]

               [[text:= ..no_op ..no_op
                 (_.invokevirtual ..$Object "equals" (type.method [(list) (list ..$Object) type.boolean (list)]))
                 (jvm/value.boxed type.boolean)]
                [text:< (_.checkcast $String) (_.checkcast $String)
                 (_.invokevirtual ..$String "compareTo" (type.method [(list) (list ..$String) type.int (list)]))
                 (..predicate _.iflt)]
                [text:char (_.checkcast $String) ..jvm_int
                 (_.invokevirtual ..$String "charAt" (type.method [(list) (list type.int) type.char (list)]))
                 ..lux_natural]])

(the text:composite
     (Variadic (Bytecode Any))
     (let [$StringBuilder (type.class (list) "java.lang.StringBuilder")
           add_part! (is (-> (Bytecode Any)
                             (Bytecode Any))
                         (function (_ it)
                                   (all _.composite
                                        it
                                        (_.checkcast $String)
                                        )))
           update_size! (is (Bytecode Any)
                            (all _.composite
                                 _.dup
                                 $String:length
                                 _.dup2_x1
                                 _.pop2
                                 _.iadd
                                 ))
           new_StringBuilder (is (Bytecode Any)
                                 (all _.composite
                                      (_.new $StringBuilder)
                                      _.dup_x1
                                      _.swap
                                      (_.invokespecial $StringBuilder "<init>" (type.method [(list) (list type.int) type.void (list)]))
                                      ))
           compose_part! (is (Bytecode Any)
                             (all _.composite
                                  _.swap
                                  (_.invokevirtual $StringBuilder "append" (type.method [(list) (list ..$String) $StringBuilder (list)]))
                                  ))]
          (|>> (|.when
                (list)
                (_.string "")

                (list single)
                single

                (list left right)
                (all _.composite
                     left (_.checkcast $String)
                     right (_.checkcast $String)
                     (_.invokevirtual ..$String "concat" (type.method [(list) (list ..$String) ..$String (list)])))

                parts
                (monad.let [! _.monad]
                           [_ (_.int (/32.of +0))
                            _ (list.each' ! (is (-> (Bytecode Any)
                                                    (Bytecode Any))
                                                (function (_ it)
                                                          (all _.composite
                                                               (add_part! it)
                                                               update_size!
                                                               )))
                                          (list.in_reverse parts))
                            _ new_StringBuilder
                            _ (list.each' ! (function.constant compose_part!)
                                          parts)]
                           (_.invokevirtual $StringBuilder "toString" (type.method [(list) (list) ..$String (list)])))
                ))))

(the (text:clip [offset! length! subject!])
     (Trinary (Bytecode Any))
     (all _.composite
          subject! (_.checkcast $String)
          offset! ..jvm_int
          _.dup
          length! ..jvm_int
          _.iadd
          (_.invokevirtual ..$String "substring" (type.method [(list) (list type.int type.int) ..$String (list)]))))

(the index_method (type.method [(list) (list ..$String type.int) type.int (list)]))
(the (text:index [startG partG textG])
     (Trinary (Bytecode Any))
     (monad.let _.monad
                [@not_found _.new_label
                 @end _.new_label]
                (all _.composite
                     textG (_.checkcast $String)
                     partG (_.checkcast $String)
                     startG ..jvm_int
                     (_.invokevirtual ..$String "indexOf" index_method)
                     _.dup
                     _.iconst_m1
                     (_.if_icmpeq @not_found)
                     ..lux_natural
                     jvm/runtime.some
                     (_.goto @end)
                     (_.set_label @not_found)
                     _.pop
                     jvm/runtime.none
                     (_.set_label @end))))

(the with_text
     (Change Bundle)
     (|>> (with extension/lux.text_= (binary ..text:=))
          (with extension/lux.text_< (binary ..text:<))
          
          (with extension/lux.text_composite (variadic ..text:composite))
          (with extension/lux.text_index (trinary ..text:index))
          (with extension/lux.text_size (unary ..text:size))
          (with extension/lux.text_char (binary ..text:char))
          (with extension/lux.text_clip (trinary ..text:clip))))

(the string_method (type.method [(list) (list ..$String) type.void (list)]))
(the (io:log messageG)
     (Unary (Bytecode Any))
     (all _.composite
          (_.getstatic ..$System "out" ..$PrintStream)
          messageG
          (_.checkcast $String)
          (_.invokevirtual ..$PrintStream "println" ..string_method)
          jvm/runtime.unit))

(the (io:error messageG)
     (Unary (Bytecode Any))
     (all _.composite
          (_.new ..$Error)
          _.dup
          messageG
          (_.checkcast $String)
          (_.invokespecial ..$Error "<init>" ..string_method)
          _.athrow))

(the with_io
     (Change Bundle)
     (|>> (with extension/lux.log! (unary ..io:log))
          (with extension/lux.error (unary ..io:error))))

(the (lux:list elements)
     (Variadic (Bytecode Any))
     (all _.composite
          (_.int (/32.of (.integer (list.size elements))))
          (_.anewarray $Object)
          (|> elements
              list.enumeration
              (list:each (function (_ [where what])
                                   (all _.composite
                                        _.dup
                                        (_.int (/32.of (.integer where)))
                                        what
                                        _.aastore)))
              (list.complete _.monad))))

(the (lux:list_size it)
     (Unary (Bytecode Any))
     (all _.composite
          it
          (_.checkcast jvm/type.list)
          ..size_of_list
          ..lux_natural))

(the (lux:list_item [address it])
     (Binary (Bytecode Any))
     (all _.composite
          it (_.checkcast jvm/type.list)
          address ..jvm_int
          ..item_of_list))

(the (lux:list_composite [prefix suffix])
     (Binary (Bytecode Any))
     (let [swap2
           (all _.composite
                _.dup2_x2
                _.pop2)

           swap_2,1
           (all _.composite
                _.dup2_x1
                _.pop2)

           swap_1,2
           (all _.composite
                _.dup_x2
                _.pop)

           as_list (function (_ it)
                             (all _.composite
                                  it
                                  (_.checkcast jvm/type.list)
                                  ))

           with_size
           (all _.composite
                _.dup
                _.arraylength)
           
           empty_composite
           (all _.composite
                _.iadd
                (_.anewarray $Object))

           beginning
           (_.int (/32.of +0))

           copy_of_prefix
           (all _.composite
                _.dup2_x1
                _.swap beginning _.dup_x2 _.swap
                system:arraycopy)

           copy_of_suffix
           (all _.composite
                swap_1,2
                swap2 _.swap _.dup2_x2 _.pop
                beginning _.swap swap2 _.swap
                system:arraycopy)]
          (all _.composite
               (as_list suffix) with_size
               _.dup
               (as_list prefix) with_size
               swap_2,1
               _.swap _.dup_x1 empty_composite
               copy_of_prefix
               copy_of_suffix)))

(the with_list
     (Change Bundle)
     (|>> (with extension/lux.list (variadic ..lux:list))
          (with extension/lux.list_size (unary ..lux:list_size))
          (with extension/lux.list_item (binary ..lux:list_item))
          (with extension/lux.list_composite (binary ..lux:list_composite))
          ))

(the (array it)
     (Unary (Bytecode Any))
     (all _.composite
          it
          ..jvm_int
          (_.anewarray jvm/type.value)))

(the array_size
     ..lux:list_size)

(the array_its
     ..lux:list_item)

(the (array_has [address value it])
     (Trinary (Bytecode Any))
     (all _.composite
          it
          (_.checkcast jvm/type.list)
          _.dup
          address ..jvm_int
          value
          _.aastore))

(the (array_lacks [address it])
     (Binary (Bytecode Any))
     (array_has [address _.aconst_null it]))

(the (array_lacks? [address it])
     (Binary (Bytecode Any))
     (all _.composite
          (array_its [address it])
          (..predicate _.ifnull)))

(the with_array
     (Change Bundle)
     (|>> (with extension/lux.array (unary ..array))
          (with extension/lux.array_size (unary ..array_size))
          (with extension/lux.array_its (binary ..array_its))
          (with extension/lux.array_has (trinary ..array_has))
          (with extension/lux.array_lacks (binary ..array_lacks))
          (with extension/lux.array_lacks? (binary ..array_lacks?))
          ))

(the .public bundle
     Bundle
     (|> //.empty
         with_basic
         with_io
         with_text
         with_i64
         with_integer
         with_real
         with_list
         with_array
         ))
