(.using
 [library
  [lux (.except)
   [abstract
    [equality (.only Equality)]
    [hash (.only Hash)]]
   [data
    [[0] case]
    [text (.only Injection)
     [["%"] \\injection]]]
   [math
    [[0] random (.only Random)]
    [number
     [/64
      [[0] natural]]]]]]
 [[0] /
  [[1 0] side (.only Side)]
  [[1 0] member (.only Member)]])

(every .public Access
       (Variant {:Member Member}))

(the .public as_text
     (Injection Access)
     /member.as_text)

(the .public hash
     (Hash Access)
     (all case.hash
          /member.hash
          ))

(the .public equality
     (Equality Access)
     (by ..hash equality))

(alias [=]
       ..equality)

(the .public random
     (Random Access)
     (all random.or
          /member.random
          ))
