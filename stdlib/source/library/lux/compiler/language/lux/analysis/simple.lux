(.using
 [library
  [lux (.except)
   [abstract
    [equality (.only Equality)]]
   [data
    [[0] text (.only Injection)
     [["%"] \\injection]]]
   [logic
    [[0] bit]]
   [math
    [number
     [/64
      [["n"] natural]
      [["i"] integer]
      [["r"] revolution]
      [[0] real]]]]
   [macro
    [[0] template]]
   [compiler
    [["@" 0] type (.only Simple)]]]])

(the .public equality
     (Equality Simple)
     (implementation
      (the (= expected actual)
           (`` (when [expected actual]
                     [{@type.:Simple_Unit} {@type.:Simple_Unit}]
                     true
                     
                     (,, (template.with [<tag> <=>]
                                        [[{<tag> expected} {<tag> actual}]
                                         (<=> expected actual)]

                                        [[@type.:Simple_Bit bit.=]
                                         [@type.:Simple_Natural n.=]
                                         [@type.:Simple_Integer i.=]
                                         [@type.:Simple_Revolution r.=]
                                         [@type.:Simple_Real real.=]
                                         [@type.:Simple_Text text.=]
                                         ]))
                     
                     _
                     false)))))

(alias [=]
       ..equality)

(the .public (as_text it)
     (Injection Simple)
     (`` (when it
               {@type.:Simple_Unit}
               "[]"

               (,, (template.with [<tag> <injection>]
                                  [{<tag> value}
                                   (<injection> value)]

                                  [[@type.:Simple_Bit bit.as_text]
                                   [@type.:Simple_Natural %.natural]
                                   [@type.:Simple_Integer %.integer]
                                   [@type.:Simple_Revolution %.revolution]
                                   [@type.:Simple_Real %.real]
                                   [@type.:Simple_Text %.text]
                                   ])))))
