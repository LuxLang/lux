                                                                                                              {:Left ""})
                                                                                                   (function' (_ self_name,args)
                                                                                                              (.let_pair# self_name,args
                                                                                                                          (function' (_ self_name args)
                                                                                                                                     {:Right [lux
                                                                                                                                              (.list# (.let# (.if_case# args
