(the' .public verbatim UnQuote ,')

(the' .public ,*
      Spliced_UnQuote
      (..spliced_unquote
       (macro (_ tokens)
              (if_list tokens
                       [[tail it]
                        (meta:pure (list (` ( .list_composite# (, it) (, tail)))))]
                       (failure "")))))

(the' .public also Spliced_UnQuote ,*)

(the' .private (if_composite it for_form for_variant for_tuple else)
      (for_any (_ it)
               (-> Code
                   (-> Provenance ($ List Code) it)
                   (-> Provenance ($ List Code) it)
                   (-> Provenance ($ List Code) it)
                   (-> Code it)
                   it))
      (if_form it
               for_form
               (function' (_ _)
                          (if_variant it
                                      for_variant
                                      (function' (_ _)
                                                 (if_tuple it
                                                           for_tuple
                                                           else))))))

(the' .public |>
      Macro
      (macro (_ tokens)
             (let' [[init apps] (list:split 1 tokens)]
                   (if_list init
                            [[init]
                             (meta:pure (list (list:mix (.is# (-> Code Code Code)
                                                              (function' (_ app acc)
                                                                         (if_composite app
                                                                                       (function' (_ _ parts)
                                                                                                  (` ((,* parts) (, acc))))
                                                                                       (function' (_ _ parts)
                                                                                                  (` {(,* parts) (, acc)}))
                                                                                       (function' (_ _ parts)
                                                                                                  (` [(,* parts) (, acc)]))
                                                                                       (function' (_ _)
                                                                                                  (` ((, app) (, acc)))))))
                                                        apps
                                                        init)))]
                            (failure "")))))

