(the' .private monad:let
      Macro
      (macro (_ tokens)
             (if_list tokens
                      [[monad _,bindings body]
                       (if_tuple _,bindings
                                 (function' (_ _ bindings)
                                            (if_case (pairs (list:as_stack bindings))
                                                     [_
                                                      (failure "")]
                                                     [bindings
                                                      (let' ['pure (code:local "pure")
                                                             'then (code:local " then ")
                                                             body' (stack:mix (.is# (-> (Tuple Code Code) Code Code)
                                                                                    (function' (_ binding body')
                                                                                               (let' [[var value] binding]
                                                                                                     (if_name var
                                                                                                              (function' (_ @ module,proper)
                                                                                                                         (let' [[module proper] module,proper]
                                                                                                                               (.if# (.text_=# "" module)
                                                                                                                                     (code:form (list 'then
                                                                                                                                                      ('function {:None}
                                                                                                                                                                 (stack var)
                                                                                                                                                                 body')
                                                                                                                                                      value))
                                                                                                                                     (code:form (list var value body')))))
                                                                                                              (function' (_ _)
                                                                                                                         (code:form (list 'then
                                                                                                                                          ('function {:None}
                                                                                                                                                     (stack var)
                                                                                                                                                     body')
                                                                                                                                          value)))))))
                                                                              body
                                                                              (stack:in_reverse bindings))]
                                                            (meta:pure (list ('let_pair ['pure 'then] monad
                                                                                        body'))))]))
                                 (function' (_ _)
                                            (failure "")))]
                      (failure ""))))

(the' .private (monad:mix ! mix every_input initial_state)
      (for_any (_ ! mix input)
               (-> ($ Monad !)
                   (-> input mix ($ ! mix))
                   (-> ($ List input) mix ($ ! mix))))
      (list:mix (function' (_ partial state)
                           (monad:let !
                                      [state state]
                                      (mix partial state)))
                every_input
                (let' [[pure _] !]
                      (pure initial_state))))

(the' .private (monad:each ! value it)
      (for_any (_ ! input output)
               (-> ($ Monad !)
                   (-> input
                       ($ ! output))
                   (-> ($ List input)
                       ($ ! ($ List output)))))
      (monad:mix !
                 (function' (_ head tail)
                            (monad:let !
                                       [head (value head)]
                                       (pure (.list_composite# tail (list head)))))
                 it
                 (list)))

(the' .private 'if
      (-> Code Code Code
          Code)
      (function' (_ 'this 'then 'else)
                 (code:form (list ('prelude "if#") 'this 'then 'else))))

(the' .public if
      Macro
      (macro (_ tokens)
             (if_case (list:as_stack (list:in_reverse tokens))
                      [_
                       (comment :Empty
                                (failure ""))]
                      [else,then,test/*
                       (comment :Top
                                (let' [[else then,test/*] else,then,test/*]
                                      (if_case (pairs then,test/*)
                                               [_
                                                (failure "")]
                                               [then,test/*
                                                (meta:pure (list (stack:mix (function' (_ then,test else)
                                                                                       (let' [[then test] then,test]
                                                                                             ('if test then else)))
                                                                            else then,test/*)))])))])))

(the' .private Property_List
      Type
      (for_any (_ it)
               ($ List (And Text it))))

(the' .private Equality
      Type
      (for_any (_ it)
               (-> it
                   (Predicate it))))

(the' .private (text:= reference it)
      ($ Equality Text)
      (.text_=# reference it))

(the' .private (property:address' = expected it)
      (for_any (_ key it)
               (-> ($ Equality key) key ($ List (And key it))
                   ($ Maybe Natural)))
      (let' [limit (.list_size# it)]
            ((.is# (for_any (_ key it)
                            (-> (-> key (Predicate key)) key ($ List (And key it))
                                (-> Natural ($ Maybe Natural))))
                   (function' (_ = expected it)
                              (function' (property:address item)
                                         (if (.int_<# (.as# (-> Natural Integer) limit)
                                                      (.as# (-> Natural Integer) item))
                                             (let' [[actual value] (.list_item# item it)]
                                                   (if (= expected actual)
                                                       {:Some item}
                                                       (property:address (.i64_+# 1 item))))
                                             {:None}))))
             = expected it 0)))

(the' .private property:address
      (for_any (_ it)
               (-> Text ($ Property_List it)
                   ($ Maybe Natural)))
      (property:address' text:=))

(the' .private (property:value' = expected it)
      (for_any (_ key it)
               (-> ($ Equality key) key ($ List (And key it))
                   ($ Maybe it)))
      (if_case (property:address' = expected it)
               [_
                {:None}]
               [address
                (let' [[key value] (.list_item# address it)]
                      {:Some value})]))

(the' .private property:value
      (for_any (_ it)
               (-> Text ($ Property_List it)
                   ($ Maybe it)))
      (property:value' text:=))

(the' .private (property:with' = key value it)
      (for_any (_ key it)
               (-> ($ Equality key) key it
                   ($ Change ($ List (And key it)))))
      (if_case (property:address' = key it)
               [_
                (.list_composite# it (list [key value]))]
               [address
                (list:of_array (.array_has# address [key value] (array:clone (list:as_array it))))]))

(the' .private property:with
      (for_any (_ it)
               (-> Text it
                   ($ Change ($ Property_List it))))
      (property:with' text:=))

(the' ..private (name:as_text full_name)
      (-> Name
          Text)
      (let' [[module name] full_name]
            (if (.text_=# "" module)
                name
                (text module (.constant_literal# "delimiter_for_name") name))))

(the' .private (bit:= reference it)
      (-> Bit
          (Predicate Bit))
      (if reference
          it
          (not it)))

(the' .private (and' left right)
      (-> Bit Bit
          Bit)
      (if left
          right
          false))

(the' ..private (default? it)
      (-> Type
          Bit)
      (if_case it
               [name_of_type,variance,type_of_default
                (let' [[name_of_type variance,type_of_default] name_of_type,variance,type_of_default]
                      (if_list variance,type_of_default
                               [[variance,type_of_default]
                                (let' [[variance type_of_default] variance,type_of_default]
                                      (and' (bit:= ..co_variant variance)
                                            (.text_=# name_of_type (.type_name# "default"))))]
                               (comment "else"
                                        false)))]
               [else
                false]))

(the' .private (global_name full_name state)
      (-> Name
          ($ Meta Name))
      (let' [[module name] full_name
             [lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] state]
            (if_case (property:value module lux:modules)
                     [else
                      {:Left (text "Unknown module: " module " @ " (name:as_text full_name))}]
                     [the_module
                      (let' [[module:module_hash module:module_aliases module:definitions module:imports module:module_state] the_module]
                            (if_case (property:value name module:definitions)
                                     [_
                                      {:Left (text "Unknown definition: " (name:as_text full_name))}]
                                     [_,constant
                                      (let' [[_ constant] _,constant]
                                            (if_case constant
                                                     [real_name
                                                      {:Right [state real_name]}]
                                                     [definition
                                                      (let' [[type expression value] definition]
                                                            (if (default? type)
                                                                {:Left (text "Unknown definition: " (name:as_text full_name))}
                                                                {:Right [state full_name]}))]))]))])))

(the' .private (untemplated_text value)
      (-> Text
          Code)
      (code:variant (list ('prelude ":Text")
                          ..no_provenance
                          (code:text value))))

(the' .private UnQuote
      Type
      {:Named [..prelude "UnQuote"]
              {:Nominal ".Macro/UnQuote" (.list#)}})

(the' .private (unquote it)
      (-> Macro
          UnQuote)
      (.as# (-> Macro UnQuote) it))

(the' .private (unquote_macro it)
      (-> UnQuote
          Macro')
      (.as# (-> UnQuote Macro') it))

(the' .private Spliced_UnQuote
      Type
      {:Named [..prelude "Spliced_UnQuote"]
              {:Nominal ".Macro/Spliced_UnQuote" (.list#)}})

(the' .private (spliced_unquote it)
      (-> Macro
          Spliced_UnQuote)
      (.as# (-> Macro Spliced_UnQuote) it))

(the' .private (spliced_unquote_macro it)
      (-> Spliced_UnQuote
          Macro')
      (.as# (-> Spliced_UnQuote Macro') it))

(the' .private (list:one choice it)
      (for_any (_ input output)
               (-> (-> input ($ Maybe output))
                   (-> ($ List input) ($ Maybe output))))
      (.let# (.list_size# it)
             (function' (_ limit)
                        ((.is# (for_any (_ input output)
                                        (-> (-> input ($ Maybe output)) ($ List input)
                                            (-> Natural ($ Maybe output))))
                               (function' (_ choice it)
                                          (function' (list:one item)
                                                     (if (.int_<# (.as# (-> Natural Integer) limit)
                                                                  (.as# (-> Natural Integer) item))
                                                         (if_case (choice (.list_item# item it))
                                                                  [_
                                                                   (list:one (.i64_+# 1 item))]
                                                                  [choice
                                                                   {:Some choice}])
                                                         {:None}))))
                         choice it 0))))

(the' .private (list:conjoint it)
      (for_any (_ it)
               (-> ($ List ($ List it))
                   ($ List it)))
      (list:mix' (function' (_ _ right left)
                            (.list_composite# left right))
                 it
                 (list)))

(the' .private (list:all choice it)
      (for_any (_ input output)
               (-> (-> input ($ Maybe output))
                   (-> ($ List input) ($ List output))))
      (list:conjoint (list:each (function' (_ it)
                                           (if_case (choice it)
                                                    [_
                                                     (list)]
                                                    [it
                                                     (list it)]))
                                it)))

(the' .private (stack:one f xs)
      (for_any (_ input output)
               (-> (-> input ($ Maybe output)) ($ Stack input)
                   ($ Maybe output)))
      (if_case xs
               [_
                {:None}]
               [x,xs'
                (let' [[x xs'] x,xs']
                      (if_case (f x)
                               [_
                                (stack:one f xs')]
                               [y
                                {:Some y}]))]))

(the' .private (in_env name state)
      (-> Text Lux
          ($ Maybe Type))
      (let' [[lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] state]
            (stack:one (.is# (-> Scope ($ Maybe Type))
                             (function' (_ env)
                                        (let' [[scope:locals scope:captured] env
                                               [bindings:counter bindings:mappings] scope:locals]
                                              (list:one (.is# (-> (Tuple Text (Tuple Type Any)) ($ Maybe Type))
                                                              (function' (_ it)
                                                                         (let' [[bname type] it
                                                                                [type _] type]
                                                                               (if (.text_=# name bname)
                                                                                   {:Some type}
                                                                                   {:None}))))
                                                        bindings:mappings))))
                       lux:scopes)))

(the' .private (available? expectation_for_module current_module exported?)
      (-> Text ($ Maybe Text) Bit
          Bit)
      (if exported?
          1b
          (if_case current_module
                   [_
                    0b]
                   [current_module
                    (.text_=# expectation_for_module current_module)])))

(the' .private (definition_value name state)
      (-> Name
          ($ Meta (Tuple Type Any)))
      (let' [[expectation_for_module expectation_for_proper] name
             [lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] state]
            (if_case (property:value expectation_for_module lux:modules)
                     [else
                      {:Left (text "Unknown definition: " (name:as_text name))}]
                     [the_module
                      (let' [[module:module_hash module:module_aliases module:definitions module:imports module:module_state] the_module]
                            (if_case (property:value expectation_for_proper module:definitions)
                                     [_
                                      {:Left (text "Unknown definition: " (name:as_text name))}]
                                     [exported?,definition
                                      (let' [[exported? definition] exported?,definition]
                                            (if_case definition
                                                     [real_name
                                                      (definition_value real_name state)]
                                                     [definition
                                                      (let' [[def_type expression def_value] definition]
                                                            (if (default? def_type)
                                                                {:Left (text "No value for default: " (name:as_text name))}
                                                                (if (available? expectation_for_module lux:current_module exported?)
                                                                    {:Right [state [def_type def_value]]}
                                                                    {:Left (text "Unavailable definition: " (name:as_text name))})))]))]))])))

(the' .private (global_value global lux)
      (-> Name
          ($ Meta ($ Maybe (Tuple Type Any))))
      (let' [[module proper] global]
            (if_case (if (.text_=# "" module)
                         (if_case (in_env proper lux)
                                  [_
                                   (definition_value global lux)]
                                  [_
                                   {:Left (text "Not a global value: " (name:as_text global))}])
                         (definition_value global lux))
                     [error
                      {:Right [lux {:None}]}]
                     [lux',type,value
                      (let' [[lux' type,value] lux',type,value]
                            {:Right [lux' {:Some type,value}]})])))

(the' .private (name:= left right)
      (-> Name
          (Predicate Name))
      (let' [[moduleL properL] left
             [moduleR properR] right]
            (all and'
                 (.text_=# moduleL moduleR)
                 (.text_=# properL properR))))

(the' .private (list:every? ? it)
      (for_any (_ it)
               (-> (Predicate it)
                   (Predicate ($ List it))))
      (list:mix' (function' (_ _ _2 _1)
                            (if _1
                                (? _2)
                                0b))
                 it
                 1b))

(the' .private (natural:minor left right)
      (-> Natural Natural
          Natural)
      (if (.int_<# (.as# (-> Natural Integer) left)
                   (.as# (-> Natural Integer) right))
          right
          left))

(the' .private (list:zipped_2 left right)
      (for_any (_ left right)
               (-> ($ List left) ($ List right)
                   ($ List (Tuple left right))))
      (.let# (natural:minor (.list_size# left) (.list_size# right))
             (function' (_ limit)
                        ((.is# (for_any (_ left right)
                                        (-> ($ List left) ($ List right)
                                            (-> Natural ($ Change ($ List (Tuple left right))))))
                               (function' (_ left right)
                                          (function' (list:zipped_2 item output)
                                                     (if (.int_<# (.as# (-> Natural Integer) limit)
                                                                  (.as# (-> Natural Integer) item))
                                                         (list:zipped_2 (.i64_+# 1 item)
                                                                        (.list_composite# output
                                                                                          (list [(.list_item# item left)
                                                                                                 (.list_item# item right)])))
                                                         output))))
                         left right 0 (list)))))

(the' .private (stack:every? ?)
      (for_any (_ it)
               (-> (Predicate it)
                   (Predicate ($ Stack it))))
      (stack:mix (function' (_ _2 _1)
                            (if _1
                                (? _2)
                                0b))
                 1b))

(the' .private (stack:zipped_2 xs ys)
      (for_any (_ left right)
               (-> ($ Stack left) ($ Stack right)
                   ($ Stack (Tuple left right))))
      (if_case xs
               [else
                (stack)]
               [x,xs'
                (let' [[x xs'] x,xs']
                      (if_case ys
                               [_
                                (stack)]
                               [y,ys'
                                (let' [[y ys'] y,ys']
                                      {:Top [x y] (stack:zipped_2 xs' ys')})]))]))

(the' .private (type:= left right)
      (-> Type
          (Predicate Type))
      (.when# [left right]
              [{:Nominal left'} {:Nominal right'}]
              (let' [[nameL parametersL] left'
                     [nameR parametersR] right']
                    (all and'
                         (.text_=# nameL nameR)
                         (.i64_=# (.list_size# parametersL)
                                  (.list_size# parametersR))
                         (list:every? (function' (_ l,r)
                                                 (let' [[polarityL,itL polarityR,itR] l,r
                                                        [polarityL itL] polarityL,itL
                                                        [polarityR itR] polarityR,itR]
                                                       (and' (bit:= polarityL polarityR)
                                                             (type:= itL itR))))
                                      (list:zipped_2 parametersL parametersR))))

              [{:Reification left'} {:Reification right'}]
              (let' [[leftL rightL] left'
                     [leftR rightR] right']
                    (all and'
                         (type:= leftL leftR)
                         (type:= rightL rightR)))

              [{:Parameter left'} {:Parameter right'}]
              (let' [[parameter_of_reference idL] left'
                     [parameter_of_it idR] right']
                    (and' (bit:= parameter_of_reference parameter_of_it)
                          (.i64_=# idL idR)))

              [{:Variable left'} {:Variable right'}]
              (let' [[quality_of_reference idL] left'
                     [quality_of_it idR] right']
                    (and' (bit:= quality_of_reference quality_of_it)
                          (.i64_=# idL idR)))

              [{:Quantification left'} {:Quantification right'}]
              (let' [[quantification_of_reference envL bodyL] left'
                     [quantification_of_it envR bodyR] right']
                    (all and'
                         (bit:= quantification_of_reference quantification_of_it)
                         (.i64_=# (stack:size envL) (stack:size envR))
                         (stack:every? (function' (_ l,r)
                                                  (let' [[reference it] l,r
                                                         [abstraction_of_reference argument_of_reference] reference
                                                         [abstraction_of_it argument_of_it] it]
                                                        (and' (type:= abstraction_of_reference abstraction_of_it)
                                                              (type:= argument_of_reference argument_of_it))))
                                       (stack:zipped_2 envL envR))
                         (type:= bodyL bodyR)))

              [{:Named left'} anonR]
              (let' [[nameL anonL] left']
                    (type:= anonL anonR))

              [anonL {:Named right'}]
              (let' [[nameR anonR] right']
                    (type:= anonL anonR))

              _
              0b))

(the' .private (one_expansion it)
      (-> ($ Meta ($ List Code))
          ($ Meta Code))
      (monad:let meta:monad
                 [it it]
                 (if_list it
                          [[it]
                           (pure it)]
                          (failure "Must expand to 1 element."))))

(the' .private (name_of_current_module state)
      ($ Meta Text)
      (let' [[lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] state]
            (if_case lux:current_module
                     [_
                      {:Left "Cannot get the module name without a module!"}]
                     [module_name
                      {:Right [state module_name]}])))

(the' .private (name:normal full_name)
      (-> Name
          ($ Meta Name))
      (let' [[module_name proper_name] full_name]
            (if (.text_=# "" module_name)
                (monad:let meta:monad
                           [module_name ..name_of_current_module]
                           (pure [module_name proper_name]))
                (meta:pure full_name))))

(the' .private (with_provenance provenance it)
      (-> Provenance
          (-> Code
              Code))
      (if_case it
               [_,it
                (let' [[_ it] _,it]
                      {:Bit provenance it})]
               [_,it
                (let' [[_ it] _,it]
                      {:Natural provenance it})]
               [_,it
                (let' [[_ it] _,it]
                      {:Integer provenance it})]
               [_,it
                (let' [[_ it] _,it]
                      {:Revolution provenance it})]
               [_,it
                (let' [[_ it] _,it]
                      {:Real provenance it})]
               [_,it
                (let' [[_ it] _,it]
                      {:Text provenance it})]
               [_,it
                (let' [[_ it] _,it]
                      {:Name provenance it})]
               [_,it
                (let' [[_ it] _,it]
                      {:Form provenance it})]
               [_,it
                (let' [[_ it] _,it]
                      {:Variant provenance it})]
               [_,it
                (let' [[_ it] _,it]
                      {:Tuple provenance it})]))

(the' .private (untemplated_composite tag @composite untemplated replace? subst elements)
      (-> Code Provenance
          (-> Bit Text Code ($ Meta Code))
          (-> Bit Text ($ List Code) ($ Meta Code)))
      (monad:let meta:monad
                 [.let' [empty_list ('list (list))
                         composite_list (.is# (-> Code Code
                                                  Code)
                                              (function' (_ before after)
                                                         (code:form (list ('prelude "list_composite#") before after))))
                         singleton_list (.is# (-> Code Code)
                                              (function' (_ it) ('list (list it))))
                         expanded_list (.is# (-> Code Code ($ Meta Code))
                                             (function' (_ head tail)
                                                        (monad:let meta:monad
                                                                   [head (untemplated replace? subst head)]
                                                                   (pure (composite_list (singleton_list head)
                                                                                         tail)))))]
                  output (if replace?
                             (monad:mix meta:monad
                                        (function' (_ head tail)
                                                   (if_form head
                                                            (function' (_ @composite global,parameters)
                                                                       (let' [[@name,global parameters] (list:split 1 global,parameters)]
                                                                             (if_list @name,global
                                                                                      [[@name,global]
                                                                                       (if_name @name,global
                                                                                                (function' (_ @name global)
                                                                                                           (monad:let meta:monad
                                                                                                                      [|global| (name:normal global)
                                                                                                                       ?type,value (global_value |global|)]
                                                                                                                      (if_case ?type,value
                                                                                                                               [_
                                                                                                                                (expanded_list head tail)]
                                                                                                                               [type,value
                                                                                                                                (let' [[type value] type,value]
                                                                                                                                      (if (type:= Spliced_UnQuote type)
                                                                                                                                          (monad:let meta:monad
                                                                                                                                                     [.let' [it (spliced_unquote_macro (.as# (-> Any Spliced_UnQuote) value))]
                                                                                                                                                      output (one_expansion (it (.list_composite# (list tail) parameters)))]
                                                                                                                                                     (pure (with_provenance @composite output)))
                                                                                                                                          (expanded_list head tail)))])))
                                                                                                (function' (_ _)
                                                                                                           (expanded_list head tail)))]
                                                                                      (expanded_list head tail))))
                                                            (function' (_ _)
                                                                       (expanded_list head tail))))
                                        (list:in_reverse elements)
                                        empty_list)
                             (monad:let meta:monad
                                        [=elements (monad:each meta:monad (untemplated replace? subst) elements)]
                                        (pure ('list =elements))))]
                 (pure (with_provenance @composite
                                        (code:variant (list tag
                                                            ..no_provenance
                                                            output))))))

(the' .private untemplated_form
      (-> Provenance
          (-> Bit Text Code ($ Meta Code))
          (-> Bit Text ($ List Code) ($ Meta Code)))
      (untemplated_composite ('prelude ":Form")))

(the' .private untemplated_variant
      (-> Provenance
          (-> Bit Text Code ($ Meta Code))
          (-> Bit Text ($ List Code) ($ Meta Code)))
      (untemplated_composite ('prelude ":Variant")))

(the' .private untemplated_tuple
      (-> Provenance
          (-> Bit Text Code ($ Meta Code))
          (-> Bit Text ($ List Code) ($ Meta Code)))
      (untemplated_composite ('prelude ":Tuple")))

(the' .private (untemplated replace? subst token)
      (-> Bit Text Code
          ($ Meta Code))
      (if_case token
               [@token,value
                (let' [[@token value] @token,value]
                      (meta:pure (code:variant (list ('prelude ":Bit")
                                                     ..no_provenance
                                                     (code:bit value)))))]
               [@token,value
                (let' [[@token value] @token,value]
                      (meta:pure (code:variant (list ('prelude ":Natural")
                                                     ..no_provenance
                                                     (code:natural value)))))]
               [@token,value
                (let' [[@token value] @token,value]
                      (meta:pure (code:variant (list ('prelude ":Integer")
                                                     ..no_provenance
                                                     (code:integer value)))))]
               [@token,value
                (let' [[@token value] @token,value]
                      (meta:pure (code:variant (list ('prelude ":Revolution")
                                                     ..no_provenance
                                                     (code:revolution value)))))]
               [@token,value
                (let' [[@token value] @token,value]
                      (meta:pure (code:variant (list ('prelude ":Real")
                                                     ..no_provenance
                                                     (code:real value)))))]
               [@token,value
                (let' [[@token value] @token,value]
                      (meta:pure (untemplated_text value)))]
               [@token,value
                (if replace?
                    (let' [[@token value] @token,value
                           [module name] value]
                          (monad:let meta:monad
                                     [real_name (if (.text_=# "" module)
                                                    (if (.text_=# "" subst)
                                                        (pure [module name])
                                                        (global_name [subst name]))
                                                    (pure [module name]))
                                      .let' [[module name] real_name]]
                                     (meta:pure (code:variant (list ('prelude ":Name")
                                                                    (code:provenance [module 0 0])
                                                                    (code:tuple (list (code:text module) (code:text name))))))))
                    (let' [[@token value] @token,value
                           [module name] value]
                          (meta:pure (code:variant (list ('prelude ":Name")
                                                         (code:provenance @token)
                                                         (code:tuple (list (code:text module) (code:text name))))))))]
               [@composite,elements
                (if replace?
                    (let' [[@composite elements] @composite,elements
                           [@name,global parameters] (list:split 1 elements)]
                          (if_list @name,global
                                   [[@name,global]
                                    (if_name @name,global
                                             (function' (_ @name global)
                                                        (monad:let meta:monad
                                                                   [|global| (name:normal global)
                                                                    ?type,value (global_value |global|)]
                                                                   (if_case ?type,value
                                                                            [_
                                                                             (untemplated_form @composite untemplated replace? subst (.list_composite# (list {:Name @name global}) parameters))]
                                                                            [type,value
                                                                             (let' [[type value] type,value]
                                                                                   (if (type:= UnQuote type)
                                                                                       (monad:let meta:monad
                                                                                                  [.let' [it (unquote_macro (.as# (-> Any UnQuote) value))]
                                                                                                   output (one_expansion (it parameters))]
                                                                                                  (pure (with_provenance @composite
                                                                                                                         output)))
                                                                                       (untemplated_form @composite untemplated replace? subst (.list_composite# (list {:Name @name global}) parameters))))])))
                                             (function' (_ _)
                                                        (untemplated_form @composite untemplated replace? subst elements)))]
                                   (untemplated_form @composite untemplated replace? subst elements)))
                    (let' [[@composite elements] @composite,elements]
                          (untemplated_form @composite untemplated replace? subst elements)))]
               [@composite,elements
                (let' [[@composite elements] @composite,elements]
                      (untemplated_variant @composite untemplated replace? subst elements))]
               [@composite,elements
                (let' [[@composite elements] @composite,elements]
                      (untemplated_tuple @composite untemplated replace? subst elements))]))

(the' .public Nominal
      Macro
      (macro (_ tokens)
             (if_list tokens
                      [[_,class_name]
                       (.when# _,class_name
                               {:Text _,class_name}
                               (let' [[_ class_name] _,class_name]
                                     (meta:pure (list (code:variant (list ':Nominal (code:text class_name) ('list (list)))))))

                               else
                               (failure ""))]
                      [[_,class_name _,params]
                       (.when# [_,class_name _,params]
                               [{:Text _,class_name}
                                {:Tuple _,params}]
                               (let' [[_ class_name] _,class_name
                                      [_ params] _,params]
                                     (meta:pure (list (code:variant (list ':Nominal (code:text class_name) ('list params))))))

                               else
                               (failure ""))]
                      (comment "else"
                               (failure "")))))

(the' .private 'Code
      Code
      ('prelude "Code"))

