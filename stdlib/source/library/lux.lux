(the' .public (__adjusted_quantified_type__ permission depth type)
      (Function Natural (Function Natural ($ Change Type)))
      (.if# (.i64_=# 0 permission)
            (.if_case# type
                       (function' (_ name,parameters)
                                  (comment :Nominal
                                           (.let_pair# name,parameters
                                                       (function' (_ name parameters)
                                                                  (comment "Recur"
                                                                           {:Nominal name (list:each (function' (_ it)
                                                                                                                (.let_pair# it
                                                                                                                            (function' (_ polarity it)
                                                                                                                                       [polarity (__adjusted_quantified_type__ permission depth it)])))
                                                                                                     parameters)})))))
                       (function' (_ &else)
                                  (.if_case# &else
                                             (function' (_ parameter,id)
                                                        (comment :Parameter
                                                                 (.let_pair# parameter,id
                                                                             (function' (_ parameter id)
                                                                                        (comment "Jackpot!"
                                                                                                 (.let# (.i64_-# (.i64_-# depth id) 0)
                                                                                                        (function' (_ id')
                                                                                                                   {:Parameter parameter (.i64_-# 1 id')})))))))
                                             (function' (_ &else)
                                                        (.if_case# &else
                                                                   (function' (_ _)
                                                                              (comment :Variable
                                                                                       "Leave these alone."
                                                                                       type))
                                                                   (function' (_ &else)
                                                                              (.if_case# &else
                                                                                         (function' (_ quantification,environment,body)
                                                                                                    (comment :Quantification
                                                                                                             (.let_pair# quantification,environment,body
                                                                                                                         (function' (_ quantification environment,body)
                                                                                                                                    (.let_pair# environment,body
                                                                                                                                                (function' (_ environment body)
                                                                                                                                                           {:Quantification quantification
                                                                                                                                                                            environment
                                                                                                                                                                            (__adjusted_quantified_type__ permission (next_level depth) body)}))))))
                                                                                         (function' (_ &else)
                                                                                                    (.if_case# &else
                                                                                                               (function' (_ parameter,function)
                                                                                                                          (comment :Reification
                                                                                                                                   (.let_pair# parameter,function
                                                                                                                                               (function' (_ parameter function)
                                                                                                                                                          {:Reification (__adjusted_quantified_type__ permission depth parameter)
                                                                                                                                                                        (__adjusted_quantified_type__ permission depth function)}))))
                                                                                                               (function' (_ _)
                                                                                                                          (comment :Named
                                                                                                                                   "Leave these alone."
                                                                                                                                   type)))))))))))
            type))

