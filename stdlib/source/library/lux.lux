             (failure "")))

(<| (the' .private meta:let
          Macro)
    (macro (_ tokens))
    (if_list tokens
             [['lux _,'binding,'term 'body]
              (if_tuple _,'binding,'term
                        (function' (_ _ 'binding,'term)
                                   (if_list 'binding,'term
                                            [['binding 'term]
                                             (meta:pure (list ('if_case# (` ((, 'term) (, 'lux)))
                                                                         'lux (` {..:Left (, 'lux)})
                                                                         'binding ('let_pair ['lux 'binding] 'binding
                                                                                             'body))))]
                                            (failure "")))
                        (function' (_ _)
                                   (failure "")))]
             (failure "")))

(the' .private (function:composite f g)
      (for_any (_ start middle end)
               (-> (-> middle end) (-> start middle)
                   (-> start end)))
      (function' (_ x)
                 (f (g x))))

(the' .private (full_name x)
      (-> Code
          ($ Maybe Name))
      (if_name x
               (function' (_ @ sname)
                          {:Some sname})
               (function' (_ _)
                          {:None})))

(the' .private (proper_name x)
      (-> Code
          ($ Maybe Text))
      (if_name x
               (function' (_ _ full_name)
                          (let' [[module it] full_name]
                                (if (.text_=# "" module)
                                    {:Some it}
                                    {:None})))
               (function' (_ _)
                          {:None})))

(the' .private (tuple_list tuple)
      (-> Code
          ($ Maybe ($ List Code)))
      (if_tuple tuple
                (function' (_ _ members)
                           {:Some members})
                (function' (_ _)
                           {:None})))

(the' .private (high_bits value)
      (-> ($ I64 Any)
          I64)
      (.i64_right# 32 value))

(the' .private low_mask
      I64
      (|> 1 (.i64_left# 32) (.i64_-# 1)))

(the' .private (low_bits value)
      (-> ($ I64 Any)
          I64)
      (.i64_and# low_mask value))

(the' .private (natural:< reference it)
      (-> Natural
          (Predicate Natural))
      (let' [referenceH (high_bits reference)
             itH (high_bits it)]
            (if (.int_<# referenceH itH)
                1b
                (if (.i64_=# referenceH itH)
                    (.int_<# (low_bits reference)
                             (low_bits it))
                    0b))))

(<| (the' .public name
          Macro)
    (macro (_ tokens))
    (if_list tokens
             [[_,module,name]
              (if_name _,module,name
                       (function' (_ _ module,name)
                                  (let' [[module name] module,name]
                                        (meta:pure (list (code:tuple (list (code:text module) (code:text name)))))))
                       (function' (_ _)
                                  (failure "")))]
             (failure "")))

(the' .private Replacement_Environment
      Type
      ($ Property_List Code))

(the' .private replacement_environment
      (Function ($ List Text) (Function ($ List Code) Replacement_Environment))
      list:zipped_2)

(the' .private (replacement for)
      (Function Text (Function Replacement_Environment ($ Maybe Code)))
      (list:one (function' (_ variable,value)
                           (let' [[variable value] variable,value]
                                 (.if# (.text_=# for variable)
                                       {:Some value}
                                       {:None})))))

(the' .private (realized_template env template)
      (-> Replacement_Environment
          ($ Change Code))
      (if_name template
               (function' (_ _ name_of_module,proper_name)
                          (let' [[name_of_module proper_name] name_of_module,proper_name]
                                (if (.text_=# "" name_of_module)
                                    (if_case (..replacement proper_name env)
                                             [_
                                              template]
                                             [subst
                                              subst])
                                    template)))
               (function' (_ _)
                          (if_composite template
                                        (function' (_ meta it)
                                                   {:Form meta (list:each (realized_template env) it)})
                                        (function' (_ meta it)
                                                   {:Variant meta (list:each (realized_template env) it)})
                                        (function' (_ meta it)
                                                   {:Tuple meta (list:each (realized_template env) it)})
                                        (function' (_ _)
                                                   template)))))

(<| (the' .private with_template
          Macro)
    (macro (_ tokens))
    (if_list tokens
             [[_,bindings _,templates _,data]
              (if_tuple _,bindings
                        (function' (_ _ bindings)
                                   (if_tuple _,templates
                                             (function' (_ _ templates)
                                                        (if_tuple _,data
                                                                  (function' (_ _ data)
                                                                             (if_case (.is# ($ Maybe ($ List Text))
                                                                                            (monad:each maybe:monad ..proper_name bindings))
                                                                                      [else
                                                                                       (failure "")]
                                                                                      [bindings'
                                                                                       (if_case (.is# ($ Maybe ($ List ($ List Code)))
                                                                                                      (monad:each maybe:monad ..tuple_list data))
                                                                                                [else
                                                                                                 (failure "")]
                                                                                                [data'
                                                                                                 (let' [reification (.is# (-> Replacement_Environment ($ List Code))
                                                                                                                          (function' (_ env)
                                                                                                                                     (list:each (realized_template env)
                                                                                                                                                templates)))
                                                                                                        num_bindings (.list_size# bindings')]
                                                                                                       (if (list:every? (function' (_ it) (|> it .list_size# (.i64_=# num_bindings)))
                                                                                                                        data')
                                                                                                           (|> data'
                                                                                                               (list:each (all function:composite
                                                                                                                               reification
                                                                                                                               (replacement_environment bindings')))
                                                                                                               list:conjoint
                                                                                                               meta:pure)
                                                                                                           (failure "")))])]))
                                                                  (function' (_ else)
                                                                             (failure ""))))
                                             (function' (_ else)
                                                        (failure ""))))
                        (function' (_ else)
                                   (failure "")))]
             (failure "")))

(<| (the' .public these
          Macro)
    (macro (_ tokens compiler))
    {:Right [compiler tokens]})

(these (the' .private (list:item address it)
             (for_any (_ it)
                      (-> Natural ($ List it)
                          ($ Maybe it)))
             (if (natural:< (.list_size# it) address)
                 {:Some (.list_item# address it)}
                 {:None}))

       (the' .private (natural:next it)
             ($ Change Natural)
             (.i64_+# 1 it))

       (the' .private Projection
             Type
             {:Named [..prelude "Projection"]
                     (for_any (_ it)
                              (-> (And Natural ($ List Code))
                                  ($ Maybe (And (And Natural ($ List Code)) it))))})

       (the' .private (?:pure it tape)
             (for_any (_ it)
                      (-> it
                          ($ Projection it)))
             {:Some [tape it]})

       (the' .private (?:each value it
                              tape)
             (for_any (_ cause effect)
                      (-> (-> cause
                              effect)
                          (-> ($ Projection cause)
                              ($ Projection effect))))
             (if_case (it tape)
                      [_
                       {:None}]
                      [tape,it
                       (let' [[tape it] tape,it]
                             {:Some [tape (value it)]})]))

       (the' .private (?:value tape projection)
             (for_any (_ it)
                      (-> ($ List Code) ($ Projection it)
                          ($ Maybe it)))
             (let' [expected (.list_size# tape)]
                   (if_case (projection [0 tape])
                            [else
                             {:None}]
                            [<items_read,_>,it
                             (let' [[items_read,_ it] <items_read,_>,it
                                    [items_read _] items_read,_]
                                   (if (.i64_=# expected items_read)
                                       {:Some it}
                                       {:None}))])))

       (the' .private (?:or left right tape)
             (for_any (_ left right)
                      (-> ($ Projection left) ($ Projection right)
                          ($ Projection (Or left right))))
             (if_case (left tape)
                      [else
                       (if_case (right tape)
                                [_
                                 {:None}]
                                [tape,right
                                 (let' [[tape right] tape,right]
                                       {:Some [tape {:Right right}]})])]
                      [tape,left
                       (let' [[tape left] tape,left]
                             {:Some [tape {:Left left}]})]))

       (the' .private (?:either left right tape)
             (for_any (_ it)
                      (-> ($ Projection it)
                          ($ Change ($ Projection it))))
             (if_case (left tape)
                      [_
                       (right tape)]
                      [some
                       {.:Some some}]))

       (the' .private (?:and left right tape)
             (for_any (_ left right)
                      (-> ($ Projection left) ($ Projection right)
                          ($ Projection (And left right))))
             (monad:let maybe:monad
                        [left (left tape)
                         .let' [[tape left] left]
                         right (right tape)
                         .let' [[tape right] right]]
                        (pure [tape [left right]])))

       (the' .private (?:after left right tape)
             (for_any (_ _ it)
                      (-> ($ Projection _)
                          ($ Change ($ Projection it))))
             (monad:let maybe:monad
                        [left (left tape)
                         .let' [[tape left] left]]
                        (right tape)))

       (the' .private (?:some it tape)
             (for_any (_ it)
                      (-> ($ Projection it)
                          ($ Projection ($ List it))))
             (if_case (it tape)
                      [else
                       {:Some [tape (list)]}]
                      [tape,head
                       (monad:let maybe:monad
                                  [.let' [[tape head] tape,head]
                                   tail (?:some it tape)
                                   .let' [[tape tail] tail]]
                                  (pure [tape (.list_composite# (list head) tail)]))]))

       (the' .private (?:rest tape)
             ($ Projection ($ List Code))
             (let' [[to_skip tape] tape]
                   {:Some [[(.list_size# tape) tape]
                           (list:after to_skip tape)]}))

       (the' .private (?:many it tape)
             (for_any (_ it)
                      (-> ($ Projection it)
                          ($ Projection ($ List it))))
             (monad:let maybe:monad
                        [head (it tape)
                         .let' [[tape head] head]
                         tail (?:some it tape)
                         .let' [[tape tail] tail]]
                        (pure [tape (.list_composite# (list head) tail)])))

       (the' .private (?:maybe it tape)
             (for_any (_ it)
                      (-> ($ Projection it)
                          ($ Projection ($ Maybe it))))
             (if_case (it tape)
                      [_
                       {:Some [tape {:None}]}]
                      [tape,it
                       (let' [[tape it] tape,it]
                             {:Some [tape {:Some it}]})]))

       (the' .private (?:default else it
                                 tape)
             (for_any (_ it)
                      (-> it
                          ($ Change ($ Projection it))))
             (if_case (it tape)
                      [_
                       {:Some [tape else]}]
                      [tape,it
                       (let' [[tape it] tape,it]
                             {:Some [tape it]})]))

       (the' .private (?:else else it
                              tape)
             (for_any (_ it)
                      (-> it
                          ($ Change ($ Projection it))))
             (if_case (it tape)
                      [_
                       {:Some [tape else]}]
                      [tape,it
                       (let' [[tape it] tape,it]
                             {:Some [tape it]})]))

       (with_template [,name ,if]
                      [(the' .private (,name it tape)
                             (for_any (_ it)
                                      ($ Change ($ Projection it)))
                             (let' [[address tape] tape]
                                   (if_case (list:item address tape)
                                            [else
                                             {:None}]
                                            [the_some
                                             (,if the_some
                                                  (function' (_ _ complex)
                                                             (monad:let maybe:monad
                                                                        [it (?:value complex it)]
                                                                        (pure [[(natural:next address) tape]
                                                                               it])))
                                                  (function' (_ _)
                                                             {:None}))])))]

                      [[?:variant if_variant]
                       [?:tuple if_tuple]
                       [?:form if_form]
                       ])

       (the' .private (?:binding tape)
             ($ Projection (And Text Code))
             (let' [[address tape] tape
                    address_of_value (natural:next address)]
                   (if_case (list:item address tape)
                            [else
                             {:None}]
                            [the_address
                             (if_name the_address
                                      (function' (_ _ the_name)
                                                 (let' [[the_module name] the_name]
                                                       (if (text:= "" the_module)
                                                           (if_case (list:item address_of_value tape)
                                                                    [else
                                                                     {:None}]
                                                                    [value
                                                                     {:Some [[(natural:next address_of_value) tape]
                                                                             [name value]]}])
                                                           {:None})))
                                      (function' (_ _)
                                                 {:None}))])))

       (the' .private (?:any tape)
             ($ Projection Code)
             (let' [[address tape] tape]
                   (if_case (list:item address tape)
                            [_
                             {:None}]
                            [it
                             {:Some [[(natural:next address) tape]
                                     it]}])))

       (the' .private (?:local tape)
             ($ Projection Text)
             (let' [[address tape] tape]
                   (if_case (list:item address tape)
                            [else
                             {:None}]
                            [the_address
                             (if_name the_address
                                      (function' (_ _ full_name)
                                                 (let' [[name_of_module it] full_name]
                                                       (if (.text_=# "" name_of_module)
                                                           {:Some [[(natural:next address) tape]
                                                                   it]}
                                                           {:None})))
                                      (function' (_ _)
                                                 {:None}))])))

       (the' .private (?:global tape)
             ($ Projection Name)
             (let' [[address tape] tape]
                   (if_case (list:item address tape)
                            [else
                             {:None}]
                            [the_address
                             (if_name the_address
                                      (function' (_ _ full_name)
                                                 (let' [[name_of_module proper_name] full_name]
                                                       (if (.text_=# "" name_of_module)
                                                           {:None}
                                                           {:Some [[(natural:next address) tape]
                                                                   full_name]})))
                                      (function' (_ _)
                                                 {:None}))])))

       (with_template [,name ,type ,tag]
                      [(the' .private (,name tape)
                             ($ Projection ,type)
                             (let' [[address tape] tape]
                                   (if_case (list:item address tape)
                                            [else
                                             {:None}]
                                            [the_address
                                             (.when# the_address
                                                     {,tag _,it}
                                                     (let' [[_ it] _,it]
                                                           {:Some [[(natural:next address) tape]
                                                                   it]})

                                                     else
                                                     {:None})])))]

                      [[?:bit Bit :Bit]
                       [?:natural Natural :Natural]
                       [?:integer Integer :Integer]
                       [?:revolution Revolution :Revolution]
                       [?:real Real :Real]
                       [?:text Text :Text]
                       [?:name Name :Name]
                       ])

       (with_template [,name ,type ,projection ,=]
                      [(the' .private (,name reference tape)
                             (-> ,type
                                 ($ Projection Any))
                             (if_case (,projection tape)
                                      [else
                                       {:None}]
                                      [tape,it
                                       (let' [[tape it] tape,it]
                                             (if (,= reference it)
                                                 {:Some [tape []]}
                                                 {:None}))]))]

                      [[?:this_name Name ?:name name:=]
                       [?:this_bit Bit ?:bit bit:=]
                       ])
       )

(the' .private (natural:/ param subject)
      (-> Natural
          ($ Change Natural))
      (if (.int_<# +0 (.as# (-> Natural Integer) param))
          (if (natural:< param subject)
              0
              1)
          (let' [quotient (|> subject
                              (.i64_right# 1)
                              (.int_/# (.as# (-> Natural Integer) param))
                              (.i64_left# 1))
                 flat (.int_x# (.as# (-> Natural Integer) param)
                               (.as# (-> Natural Integer) quotient))
                 remainder (.i64_-# flat subject)]
                (if (natural:< param remainder)
                    quotient
                    (.i64_+# 1 quotient)))))

(the' .private (natural:% param subject)
      (-> Natural
          ($ Change Natural))
      (let' [flat (.int_x# (.as# (-> Natural Integer) param)
                           (.as# (-> Natural Integer) (natural:/ param subject)))]
            (.i64_-# flat subject)))

(the' .private (bit:as_text it)
      (-> Bit
          Text)
      (if it
          "1b"
          "0b"))

(the' .private (digit:injection digit)
      (-> Natural
          Text)
      (if (.i64_=# 0 digit) "0"
          (.i64_=# 1 digit) "1"
          (.i64_=# 2 digit) "2"
          (.i64_=# 3 digit) "3"
          (.i64_=# 4 digit) "4"
          (.i64_=# 5 digit) "5"
          (.i64_=# 6 digit) "6"
          (.i64_=# 7 digit) "7"
          (.i64_=# 8 digit) "8"
          (comment (.i64_=# 9 digit)
                   "9")))

(the' .private (natural:as_text value)
      (-> Natural
          Text)
      (if (.i64_=# 0 value)
          "0"
          (let' [loop (.is# (-> Natural ($ Change Text))
                            (function' (of input output)
                                       (if (.i64_=# 0 input)
                                           output
                                           (of (natural:/ 10 input)
                                               (text (|> input (natural:% 10) digit:injection)
                                                     output)))))]
                (loop value ""))))

(the' .private (integer:abs value)
      ($ Change Integer)
      (if (.int_<# +0 value)
          (.i64_-# value +0)
          value))

(the' .private (integer:as_text value)
      (-> Integer
          Text)
      (let' [sign (if (.int_<# +0 value)
                      "-"
                      "+")]
            ((.is# (-> Integer ($ Change Text))
                   (function' (of input output)
                              (if (.i64_=# +0 input)
                                  (text sign output)
                                  (of (.int_/# +10 input)
                                      (text (|> input (.int_%# +10) (.as# (-> Integer Natural)) digit:injection)
                                            output)))))
             (|> value (.int_/# +10) integer:abs)
             (|> value (.int_%# +10) integer:abs (.as# (-> Integer Natural)) digit:injection))))

(the' .private (named_macro' modules current_module module name)
      (-> ($ Property_List Module) Text Text Text
          ($ Maybe Macro))
      (monad:let maybe:monad
                 [$module (property:value module modules)
                  exported?,gdef (let' [[module:module_hash module:module_aliases module:definitions module:imports module:module_state] (.is# Module $module)]
                                       (property:value name module:definitions))
                  .let' [[exported? gdef] exported?,gdef]]
                 (if_case (.is# Global gdef)
                          [alias
                           (let' [[r_module r_name] alias]
                                 (named_macro' modules current_module r_module r_name))]
                          [definition
                           (let' [[def_type expression def_value] definition]
                                 (if (type:= ..Macro def_type)
                                     (if exported?
                                         {:Some (.as# (-> Any Macro) def_value)}
                                         (if (.text_=# module current_module)
                                             {:Some (.as# (-> Any Macro) def_value)}
                                             {:None}))
                                     {:None}))])))

(<| (the' .private (named_macro full_name)
          (-> Name
              ($ Meta ($ Maybe Macro))))
    (function' (_ lux))
    (meta:let lux [current_module ..name_of_current_module])
    (let' [[module name] full_name
           [lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] lux])
    (meta:return lux (named_macro' lux:modules current_module module name)))

(<| (the' .private (macro? name)
          (-> Name
              ($ Meta Bit)))
    (function' (_ lux))
    (meta:let lux [name (name:normal name)])
    (meta:let lux [output (named_macro name)])
    (meta:return lux (if_case output
                              [_
                               0b]
                              [_
                               1b])))

(the' .private (text:as_text original)
      (-> Text
          Text)
      (text \'' original \''))

(the' .private (text:enclosed delimiters it)
      (-> (Pair Text Text)
          ($ Change Text))
      (let' [[<' '>] delimiters]
            (text <' it '>)))

(the' .private (list:interposed delimiter it)
      (for_any (_ it)
               (-> it
                   ($ Change ($ List it))))
      (let' [size (.list_size# it)]
            (if (.i64_=# 0 size)
                it
                
                (.i64_=# 1 size)
                it

                (comment "else"
                         (let' [interpositions (.i64_-# 1 size)
                                new_size (.i64_+# interpositions size)
                                last_item (.i64_-# 1 new_size)]
                               (|> (.array# new_size)
                                   (list:mix' (function' (_ address item it)
                                                         (let' [address (.i64_+# address address)]
                                                               (if (.i64_=# last_item address)
                                                                   (|> it
                                                                       (.array_has# address item))
                                                                   (|> it
                                                                       (.array_has# address item)
                                                                       (.array_has# (.i64_+# 1 address) delimiter)))))
                                              it)
                                   (.as# (for_any (_ it)
                                                  (-> ($ Array it)
                                                      ($ List it))))))))))

(the' .private (text:composite x y)
      (-> Text Text
          Text)
      (text x y))

(the' .private (code:as_text code)
      (-> Code
          Text)
      (if_case code
               [_,value
                (let' [[_ value] _,value]
                      (bit:as_text value))]
               [_,value
                (let' [[_ value] _,value]
                      (natural:as_text value))]
               [_,value
                (let' [[_ value] _,value]
                      (integer:as_text value))]
               [_
                "[code:as_text :Revolution]"]
               [_
                "[code:as_text :Real]"]
               [_,value
                (let' [[_ value] _,value]
                      (text:as_text value))]
               [_,module,name
                (let' [[_ module,name] _,module,name
                       [module name] module,name]
                      (name:as_text [module name]))]
               [_,it
                (let' [[_ it] _,it]
                      (|> ""
                          (list:mix text:composite (|> it
                                                       (list:each code:as_text)
                                                       (list:interposed " ")
                                                       list:in_reverse))
                          (text:enclosed ["(" ")"])))]
               [_,it
                (let' [[_ it] _,it]
                      (|> ""
                          (list:mix text:composite (|> it
                                                       (list:each code:as_text)
                                                       (list:interposed " ")
                                                       list:in_reverse))
                          (text:enclosed ["[" "]"])))]
               [_,it
                (let' [[_ it] _,it]
                      (|> ""
                          (list:mix text:composite (|> it
                                                       (list:each code:as_text)
                                                       (list:interposed " ")
                                                       list:in_reverse))
                          (text:enclosed ["{" "}"])))]))

(the' .private (single_expansion token)
      (-> Code
          ($ Meta ($ List Code)))
      (if_case (?:value (list token)
                        (?:form (?:and ?:name ?:rest)))
               [else
                (meta:pure (list token))]
               [name,args
                (let' [[name args] name,args]
                      (<| (function' (_ lux))
                          (meta:let lux [name' (name:normal name)])
                          (meta:let lux [?macro (named_macro name')])
                          (if_case ?macro
                                   [else
                                    (meta:return lux (list token))]
                                   [macro
                                    (((.as# (-> Macro Macro') macro) args) lux)])))]))

(the' .private (complete_expansion token)
      (-> Code
          ($ Meta ($ List Code)))
      (if_case (?:value (list token)
                        (?:form (?:and ?:name ?:rest)))
               [else
                (meta:pure (list token))]
               [name,args
                (let' [[name args] name,args]
                      (<| (function' (_ lux))
                          (meta:let lux [name' (name:normal name)])
                          (meta:let lux [?macro (named_macro name')])
                          (if_case ?macro
                                   [else
                                    (meta:return lux (list token))]
                                   [macro
                                    (<| (meta:let lux [maximum_level_expansion ((.as# (-> Macro Macro') macro) args)])
                                        (meta:let lux [recursive_expansion (.is# ($ Meta ($ List ($ List Code)))
                                                                                 (monad:each meta:monad complete_expansion maximum_level_expansion))])
                                        (meta:return lux (list:conjoint recursive_expansion)))])))]))

(the' .private (type_reification abstraction parameters)
      (-> Code ($ List Code)
          Code)
      (list:mix (.is# (-> Code ($ Change Code))
                      (function' (_ parameter abstraction)
                                 (` {..:Reification (, parameter) (, abstraction)})))
                parameters
                abstraction))

(<| (the' .private (normal_type_reification normal_type abstraction parameters)
          (-> (-> Code ($ Meta Code)) Code ($ List Code)
              ($ Meta Code)))
    (function' (_ lux))
    (meta:let lux [parameters (.is# ($ Meta ($ List Code))
                                    (monad:each meta:monad normal_type parameters))])
    (meta:return lux (type_reification abstraction parameters)))

(<| (the' .private (expanded_type_reification normal_type @ binding parameters)
          (-> (-> Code ($ Meta Code)) Provenance Name ($ List Code)
              ($ Meta Code)))
    (function' (_ lux))
    (meta:let lux [binding (name:normal binding)])
    (meta:let lux [?macro (named_macro binding)])
    (if_case ?macro
             [else
              ((normal_type_reification normal_type {:Name @ binding} parameters) lux)]
             [macro
              (<| (meta:let lux [expansion ((.as# (-> Macro Macro') macro) parameters)])
                  (if_list expansion
                           [[singular]
                            (meta:return lux (` (..type (, singular))))]
                           (meta:failure "The expansion of the type-syntax has to yield a single element.")))]))

(the' .private (normal_type type' it)
      ($ Change (-> Code ($ Meta Code)))
      (.when# it
              {:Variant _ (.list# {:Name _ ["library/lux" ":Named"]}
                                  name
                                  anonymous)}
              (<| (function' (_ lux))
                  (meta:let lux [anonymous (normal_type type' anonymous)])
                  (meta:return lux (` {..:Named (, name) (, anonymous)})))

              {:Form _ (.list# {:Name _ ["library/lux" "in_module#"]}
                               {:Text _,module}
                               it')}
              (let' [[_ module] _,module]
                    (<| (function' (_ lux))
                        (meta:let lux [it' (normal_type type' it')])
                        (meta:return lux (` (.in_module# (, (code:text module)) (, it'))))))

              {:Form _ (.list# {:Name _ ["" ","]}
                               expression)}
              (meta:pure expression)

              {:Form @form (.list# {:Name @name ["library/lux" "let#"]}
                                   binding
                                   {:Form @form (.list# {:Name @name ["library/lux" "function#"]}
                                                        value
                                                        value
                                                        body)})}
              (<| (function' (_ lux))
                  (meta:return lux {:Form @form (list {:Name @name ["library/lux" "let#"]}
                                                      binding
                                                      {:Form @form (list {:Name @name ["library/lux" "function#"]}
                                                                         value
                                                                         value
                                                                         (` (..type (, body))))})}))

              {:Form @form (.list# {:Name @name ["library/lux" "__adjusted_quantified_type__"]}
                                   _permission
                                   _level
                                   body)}
              (<| (function' (_ lux))
                  (meta:let lux [body (normal_type type' body)])
                  (meta:return lux {:Form @form (list {:Name @name [..prelude "__adjusted_quantified_type__"]}
                                                      _permission
                                                      _level
                                                      body)}))

              {:Form _ (.list# {:Form _ (.list# {:Name _ ["library/lux" "in_module#"]}
                                                {:Text _ "library/lux"}
                                                {:Name _ ["library/lux" "type"]})}
                               it')}
              (type' it')

              {:Variant _,it}
              (let' [[_ it] _,it]
                    (<| (function' (_ lux))
                        (meta:let lux [it (.is# ($ Meta ($ List Code))
                                                (monad:each meta:monad (normal_type type') it))])
                        (meta:return lux (` {(,* it)}))))

              {:Tuple _ (.list# {:Bit _,polarity} it)}
              (let' [[_ polarity] _,polarity]
                    (<| (function' (_ lux))
                        (meta:let lux [it (.is# ($ Meta Code)
                                                (normal_type type' it))])
                        (meta:return lux (` [(, (code:bit polarity)) (, it)]))))

              {:Tuple _ it}
              (<| (function' (_ lux))
                  (meta:let lux [it (.is# ($ Meta ($ List Code))
                                          (monad:each meta:monad (normal_type type') it))])
                  (meta:return lux (` (Tuple (,* it)))))

              {:Form _ binding,parameters}
              (let' [[the_head members|parameters|args] (list:split 1 binding,parameters)]
                    (if_list the_head
                             [[type_fn]
                              (if_name type_fn
                                       (<| (function' (_ @binding binding))
                                           (let' [[module global] binding])
                                           (if (if (.text_=# ..prelude module)
                                                   (.text_=# "list#" global)
                                                   false)
                                               (<| (let' [members members|parameters|args])
                                                   (function' (_ lux))
                                                   (meta:let lux [members (.is# ($ Meta ($ List Code))
                                                                                (monad:each meta:monad (normal_type type') members))])
                                                   (meta:return lux ('list members)))
                                               (<| (let' [parameters members|parameters|args])
                                                   (function' (_ lux))
                                                   (if (.text_=# "" module)
                                                       (let' [local global]
                                                             (if_case (in_env local lux)
                                                                      [not_a_local
                                                                       ((expanded_type_reification (normal_type type') @binding binding parameters) lux)]
                                                                      [type_of_local
                                                                       ((normal_type_reification (normal_type type') {:Name @binding binding} parameters) lux)]))
                                                       ((expanded_type_reification (normal_type type') @binding binding parameters) lux)))))
                                       (<| (function' (_ _))
                                           (let' [args members|parameters|args])
                                           (function' (_ lux))
                                           (meta:let lux [type_fn (normal_type type' type_fn)])
                                           (meta:let lux [args (.is# ($ Meta ($ List Code))
                                                                     (monad:each meta:monad (normal_type type') args))])
                                           (meta:return lux (type_reification type_fn args))))]
                             (meta:pure it)))

              _
              (meta:pure it)))

(the' .private (with_quantification' body lux)
      ($ Change ($ Meta Code))
      (let' [[lux:info/pre lux:source/pre lux:provenance/pre lux:current_module/pre
              lux:modules/pre lux:scopes/pre lux:type_context/pre lux:expected/pre
              lux:seed/pre lux:eval/pre] lux]
            (if_case (body [..:info lux:info/pre
                            ..:source lux:source/pre
                            ..:current_module lux:current_module/pre
                            ..:modules lux:modules/pre
                            ..:scopes {:Top [:locals [:counter 0
                                                      :mappings (list [..level_of_quantification [.Natural (.as# (-> Integer Natural) -1)]])]
                                             :captured [:counter 0
                                                        :mappings (list)]]
                                            lux:scopes/pre}
                            ..:type_context lux:type_context/pre
                            ..:seed lux:seed/pre
                            ..:expected lux:expected/pre
                            ..:provenance lux:provenance/pre
                            ..:eval lux:eval/pre])
                     [failure
                      {.:Left failure}]
                     [lux/post,output
                      (let' [[lux/post output] lux/post,output
                             [lux:info/post lux:source/post lux:provenance/post lux:current_module/post
                              lux:modules/post lux:scopes/post lux:type_context/post lux:expected/post
                              lux:seed/post lux:eval/post] lux/post]
                            {..:Right [[..:info lux:info/post
                                        ..:source lux:source/post
                                        ..:current_module lux:current_module/post
                                        ..:modules lux:modules/post
                                        ..:scopes lux:scopes/pre
                                        ..:type_context lux:type_context/post
                                        ..:seed lux:seed/post
                                        ..:expected lux:expected/post
                                        ..:provenance lux:provenance/post
                                        ..:eval lux:eval/post]
                                       output]})])))

(<| (the' .private (type' it)
          (-> Code
              ($ Meta Code)))
    (function' (_ lux))
    (if (initialized_quantification? lux)
        ((normal_type type' it) lux)
        (<| (meta:let lux [it (with_quantification'
                               (type' it))])
            (meta:return lux (..quantified it)))))

(<| (the' .public type
          Macro)
    (macro (_ tokens))
    (if_list tokens
             [[it]
              (<| (function' (_ lux))
                  (meta:let lux [it (type' it)])
                  (meta:return lux (list it)))]
             (failure "")))

(<| (the' .public is
          Macro)
    (macro (_ tokens))
    (if_list tokens
             [[type term]
              (meta:pure (list (` (.is# (..type (, type))
                                        (, term)))))]
             (failure "")))

(<| (the' .public as
          Macro)
    (macro (_ tokens))
    (if_list tokens
             [[type value]
              (meta:pure (list (` (.as# (..type (, type))
                                        (, value)))))]
             (failure "")))

(with_template [<name> <side>]
               [(the' .private (<name> left,right)
                      (for_any (_ left right)
                               (-> (Tuple left right)
                                   <side>))
                      (let' [[left right] left,right]
                            <side>))]

               [[pair:left  left]
                [pair:right right]
                ])

(the' .private (generated_name prefix state)
      (-> Text
          ($ Meta Code))
      (let' [[lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] state]
            {:Right [[..:info lux:info
                      ..:source lux:source
                      ..:provenance lux:provenance
                      ..:current_module lux:current_module
                      ..:modules lux:modules
                      ..:scopes lux:scopes
                      ..:type_context lux:type_context
                      ..:expected lux:expected
                      ..:seed (.i64_+# 1 lux:seed)
                      ..:eval lux:eval]
                     (code:local (text "__gensym__" prefix (natural:as_text lux:seed)))]}))

(the' .public exec
      Macro
      (macro (_ tokens)
             (if_case (?:value (list:in_reverse tokens)
                               (?:and ?:any ?:rest))
                      [else
                       (failure "")]
                      [value,actions
                       (let' [[value actions] value,actions]
                             (monad:let meta:monad
                                        ['_ (generated_name "_")]
                                        (pure (list (list:mix ('let '_) actions value)))))])))

(the' .private (flat_reification it)
      (type (-> Type
                [Type (List Type)]))
      (.when# it
              {:Reification head,func'}
              (let' [[head func'] head,func'
                     [abstraction tail] (flat_reification func')]
                    [abstraction (.list_composite# (list head) tail)])

              _
              [it (list)]))

(the' .private (type:as_text type)
      (-> Type
          Text)
      (if_case type
               [name,params
                (let' [[name params] name,params]
                      (text "(Nominal " (text:as_text name)
                            (list:mix' (function' (_ _ left right) (text left right))
                                       (|> params
                                           (list:each (function' (_ it)
                                                                 (let' [[polarity it] it]
                                                                       (text " "
                                                                             "[" (bit:as_text polarity)
                                                                             " " (type:as_text it)
                                                                             "]"))))
                                           list:in_reverse)
                                       "")
                            ")"))]
               [parameter,id
                (let' [[parameter id] parameter,id]
                      (text "(" (if parameter
                                    "argument"
                                    "abstraction")
                            " " (natural:as_text id)
                            ")"))]
               [quality,id
                (let' [[quality id] quality,id]
                      (if (bit:= .general quality)
                          (text "-" (natural:as_text id))
                          (text "+" (natural:as_text id))))]
               [quantification,env,body
                (let' [[quantification env body] quantification,env,body]
                      (text "("
                            (if (bit:= .universal quantification)
                                "for_any"
                                "for_some")
                            " "
                            (type:as_text body)
                            ")"))]
               [_
                (let' [[func args] (flat_reification type)]
                      (text "(" (type:as_text func) " "
                            (list:mix text:composite
                                      (|> args
                                          (list:each type:as_text)
                                          (list:interposed " ")
                                          list:in_reverse)
                                      "")
                            ")"))]
               [name,_
                (let' [[name _] name,_]
                      (name:as_text name))]))

(the' .private (meta:try it)
      (type (for_any (_ it)
                     (-> (Meta it)
                         (Meta (Either Text it)))))
      (function' (_ state)
                 (if_case (it state)
                          [error
                           {:Right [state {:Left error}]}]
                          [state,output
                           (let' [[state output] state,output]
                                 {:Right [state {:Right output}]})])))

(the' .private (anonymous_type it)
      ($ Change Type)
      (.when# it
              {:Named _,it}
              (let' [[_ it] _,it]
                    (anonymous_type it))
              
              _
              it))

(the' .private static'
      (type (-> Bit Code
                (Meta Code)))
      (let' [simple_literal (is (-> Name
                                    (Meta Code))
                                (function' (_ name)
                                           (monad:let meta:monad
                                                      [type+value (meta:try (definition_value name))]
                                                      (if_case type+value
                                                               [error
                                                                (pure (code:name name))]
                                                               [type,value
                                                                (let' [[type value] type,value]
                                                                      (.when# (anonymous_type type)
                                                                              {:Nominal name_of_type (.list#)}
                                                                              (if (.text_=# name_of_type (.type_name# "bit"))
                                                                                  (pure (code:bit (as (-> Any Bit) value)))

                                                                                  (.text_=# name_of_type (.type_name# "real"))
                                                                                  (pure (code:real (as (-> Any Real) value)))

                                                                                  (.text_=# name_of_type (.type_name# "text"))
                                                                                  (pure (code:text (as (-> Any Text) value)))

                                                                                  (if (.text_=# name_of_type (.type_name# "tag"))
                                                                                      1b
                                                                                      (comment "else"
                                                                                               (.text_=# name_of_type (.type_name# "slot"))))
                                                                                  (pure (code:name name))

                                                                                  (comment "else"
                                                                                           (failure "")))

                                                                              {:Nominal name_of_type (.list# [1b {:Nominal name_of_specialization (.list#)}])}
                                                                              (if (.text_=# name_of_type (.type_name# "i64"))
                                                                                  (if (.text_=# name_of_specialization (.type_name# "natural"))
                                                                                      (pure (code:natural (as (-> Any Natural) value)))

                                                                                      (.text_=# name_of_specialization (.type_name# "integer"))
                                                                                      (pure (code:integer (as (-> Any Integer) value)))

                                                                                      (.text_=# name_of_specialization (.type_name# "revolution"))
                                                                                      (pure (code:revolution (as (-> Any Revolution) value)))

                                                                                      (comment "else"
                                                                                               (failure "")))

                                                                                  (comment "else"
                                                                                           (failure "")))

                                                                              else
                                                                              (failure "")))]))))]
            (function' (literal only_global? token)
                       (if_name token
                                (function' (_ _ def_module,def_name)
                                           (let' [[def_module def_name] def_module,def_name]
                                                 (if (.text_=# "" def_module)
                                                     (if only_global?
                                                         (meta:pure (code:name [def_module def_name]))
                                                         (monad:let meta:monad
                                                                    [current_module ..name_of_current_module]
                                                                    (simple_literal [current_module def_name])))
                                                     (simple_literal [def_module def_name]))))
                                (function' (_ _)
                                           (if_composite token
                                                         (function' (_ meta parts)
                                                                    (monad:let meta:monad
                                                                               [=parts (monad:each meta:monad (literal only_global?) parts)]
                                                                               (pure {:Form meta =parts})))
                                                         (function' (_ meta parts)
                                                                    (monad:let meta:monad
                                                                               [=parts (monad:each meta:monad (literal only_global?) parts)]
                                                                               (pure {:Variant meta =parts})))
                                                         (function' (_ meta parts)
                                                                    (monad:let meta:monad
                                                                               [=parts (monad:each meta:monad (literal only_global?) parts)]
                                                                               (pure {:Tuple meta =parts})))
                                                         (function' (_ _)
                                                                    (meta:pure token))))))))

(the' .public static
      Macro
      (macro (_ tokens)
             (if_list tokens
                      [[pattern]
                       (monad:let meta:monad
                                  [pattern' (static' 0b pattern)]
                                  (pure (list pattern')))]
                      (failure ""))))

(the' .public Pattern
      Type
      {:Named [..prelude "Pattern"]
              (Nominal ".Macro/Pattern")})

(the' .public (pattern it)
      (-> Macro
          Pattern)
      (as (-> Macro Pattern)
          it))

(the' .private (total_expansion' total_expansion name args)
      (-> (-> Code ($ Meta ($ List Code))) Name ($ List Code)
          ($ Meta ($ List Code)))
      (<| (function' (_ lux))
          (meta:let lux [name' (name:normal name)])
          (meta:let lux [?macro (named_macro name')])
          (if_case ?macro
                   [else
                    (<| (meta:let lux [args' (.is# ($ Meta ($ List ($ List Code)))
                                                   (monad:each meta:monad total_expansion args))])
                        (meta:return lux (list (` ((, (code:name name)) (,* (list:conjoint args')))))))]
                   [macro
                    (<| (meta:let lux [expansion ((as (-> Macro Macro') macro) args)])
                        (meta:let lux [expansion' (.is# ($ Meta ($ List ($ List Code)))
                                                        (monad:each meta:monad total_expansion expansion))])
                        (meta:return lux (list:conjoint expansion')))])))

(the' .private (total_expansion syntax)
      (type (-> Code
                (Meta (List Code))))
      (if_case (|> (all ?:or
                        (?:variant ?:rest)
                        (?:tuple ?:rest)
                        (?:form (?:and ?:name ?:rest))
                        (?:form ?:rest))
                   (.is# (type (Projection (Or (List Code)
                                               (List Code)
                                               (Or [Name (List Code)]
                                                   (List Code))))))
                   (?:value (list syntax)))
               [else
                (meta:pure (list syntax))]
               [the_some
                (if_case the_some
                         [variant
                          (<| (function' (_ lux))
                              (meta:let lux [variant (.is# (type (Meta (List (List Code))))
                                                           (monad:each meta:monad total_expansion variant))])
                              (meta:return lux (list (code:variant (list:conjoint variant)))))]
                         [tuple
                          (<| (function' (_ lux))
                              (meta:let lux [tuple (.is# (type (Meta (List (List Code))))
                                                         (monad:each meta:monad total_expansion tuple))])
                              (meta:return lux (list (code:tuple (list:conjoint tuple)))))]
                         [name,tail
                          (let' [[name tail] name,tail]
                                (..total_expansion' total_expansion name tail))]
                         [form
                          (<| (function' (_ lux))
                              (meta:let lux [form (.is# (type (Meta (List (List Code))))
                                                        (monad:each meta:monad total_expansion form))])
                              (meta:return lux (list (code:form (list:conjoint form)))))])]))

(the' .private (when_expansion:macro pattern body
                                     when_expansion branches)
      (type (-> Code Code
                (Change (-> (List Code) (Meta (List Code))))))
      (monad:let meta:monad
                 [pattern (one_expansion (total_expansion pattern))
                  pattern (static' 1b pattern)
                  branches (when_expansion branches)]
                 (pure (.list_composite# (list pattern body)
                                         branches))))

(the' .private (when_expansion branches)
      (type (-> (List Code)
                (Meta (List Code))))
      (if_case (|> (?:or (all ?:and
                              (?:or (?:form (?:and ?:name ?:rest))
                                    ?:any)
                              ?:any
                              ?:rest)
                         (?:pure []))
                   (?:value branches))
               [else
                (failure "")]
               [the_some
                (if_case the_some
                         [global|pattern,body,branches'
                          (let' [[global|pattern body branches'] global|pattern,body,branches']
                                (if_case global|pattern
                                         [global,parameters
                                          (let' [[global parameters] global,parameters]
                                                (monad:let meta:monad
                                                           [|global| (name:normal global)
                                                            ?type,value (global_value |global|)]
                                                           (if_case ?type,value
                                                                    [else
                                                                     (when_expansion:macro (` ((, (code:name global)) (,* parameters)))
                                                                                           body
                                                                                           when_expansion
                                                                                           branches')]
                                                                    [type,value
                                                                     (let' [[type value] type,value]
                                                                           (if (type:= Pattern type)
                                                                               (monad:let meta:monad
                                                                                          [branches'' ((as (-> Any Macro') value)
                                                                                                       (.list_composite# (list (code:form parameters) body)
                                                                                                                         branches'))]
                                                                                          (when_expansion branches''))
                                                                               (when_expansion:macro (` ((, (code:name global)) (,* parameters)))
                                                                                                     body
                                                                                                     when_expansion
                                                                                                     branches')))])))]
                                         [pattern
                                          (when_expansion:macro pattern body when_expansion branches')]))]
                         [_
                          (meta:pure (list))])]))

(the' .private (?:member it)
      (type (Projection Text))
      ((?:either ?:local
                 (?:tuple ?:member))
       it))

(the' .private Bundle
      Type
      {:Named [.prelude "Bundle"]
              (type (for_any (Bundle _)
                             (Or Text
                                 [(Bundle _) (Bundle _)])))})

(the' .private (as_bundle it)
      (type (-> (Stack Code)
                (Maybe Bundle)))
      (if_case it
               [else
                (comment :Empty
                         {:None})]
               [head,tail
                (comment :Top
                         (let' [[head tail] head,tail]
                               (if_name head
                                        (function' (_ _ the_name)
                                                   (let' [[the_module head] the_name]
                                                         (if (text:= the_module"" )
                                                             (if_case tail
                                                                      [else
                                                                       {:Some {:Left head}}]
                                                                      [_
                                                                       (monad:let maybe:monad
                                                                                  [tail (as_bundle tail)]
                                                                                  (pure {:Right [{:Left head} tail]}))])
                                                             {:None})))
                                        (function' (_ _)
                                                   (if_tuple head
                                                             (function' (_ _ head)
                                                                        (if_case tail
                                                                                 [else
                                                                                  (as_bundle (list:as_stack head))]
                                                                                 [_
                                                                                  (monad:let maybe:monad
                                                                                             [head (as_bundle (list:as_stack head))
                                                                                              tail (as_bundle tail)]
                                                                                             (pure {:Right [head tail]}))]))
                                                             (function' (_ _)
                                                                        {:None}))))))]))

(the' .private (?:bundle tape)
      (type (Projection Bundle))
      (let' [[address' tape'] tape]
            (if (.int_<# (as (-> Natural Integer) (.list_size# tape'))
                         (as (-> Natural Integer) address'))
                (if_case (as_bundle (stack (.list_item# address' tape')))
                         [else
                          {:None}]
                         [it
                          {:Some [[(.i64_+# 1 address') tape'] it]}])
                {:None})))

(the' .private (let_pair tuple 'value 'body)
      (type (-> Bundle Code Code
                (Meta Code)))
      (if_case tuple
               [name
                (meta:pure (` (.let# (, 'value)
                                     (.function# (, (code:local name)) (, (code:local name))
                                                 (, 'body)))))]
               [left,right
                (let' [[left right] left,right]
                      (if_case left
                               [left
                                (if_case right
                                         [right
                                          (meta:pure ('let_pair [(code:local left) (code:local right)] 'value
                                                                'body))]
                                         [else
                                          (monad:let meta:monad
                                                     ['right (generated_name "'right")
                                                      'body (let_pair right 'right 'body)]
                                                     (pure ('let_pair [(code:local left) 'right] 'value
                                                                      'body)))])]
                               [else
                                (if_case right
                                         [right
                                          (monad:let meta:monad
                                                     ['left (generated_name "'left")
                                                      'body (let_pair left 'left 'body)]
                                                     (pure ('let_pair ['left (code:local right)] 'value
                                                                      'body)))]
                                         [else
                                          (monad:let meta:monad
                                                     ['left (generated_name "'left")
                                                      'right (generated_name "'right")
                                                      'body (let_pair left 'left 'body)
                                                      'body (let_pair right 'right 'body)]
                                                     (pure ('let_pair ['left 'right] 'value
                                                                      'body)))])]))]))

(the' .private Alternative
      Type
      (type [[Name (List Bundle)]
             Code]))

(the' .private Else
      Type
      (type [Text
             Code]))

(the' .private Binary_Clause
      Type
      (type [[Bit Text]
             Code]))

(the' .private When
      Type
      (type (Or [Code Code]
                [Bit Code Else]
                [(List [Natural Code]) Else]
                [(List [Integer Code]) Else]
                [(List [Revolution Code]) Else]
                [(List [Real Code]) Else]
                [(List [Text Code]) Else]
                [Binary_Clause Binary_Clause]
                [Binary_Clause Else]
                [Alternative (List Alternative) (Maybe Else)]
                [[[Name Code] (List [Name Code])] Code]
                [(List [(List Text) Code]) Else]
                [Bundle Code])))

(the' .private every_tag_of_when
      (type (List Name))
      (list [..prelude ":When/Complete_If"]
            [..prelude ":When/Partial_If"]
            [..prelude ":When/If_Natural"]
            [..prelude ":When/If_Integer"]
            [..prelude ":When/If_Revolution"]
            [..prelude ":When/If_Real"]
            [..prelude ":When/If_Text"]
            [..prelude ":When/Complete_Binary_Of_Alternative"]
            [..prelude ":When/Partial_Binary_Of_Alternative"]
            [..prelude ":When/Complete_Of_Alternative"]
            [..prelude ":When/Simple_Record"]
            [..prelude ":When/If_List"]
            [..prelude ":When/Let"]))
(the' .private :When/Complete_If Tag (..tag [{:Some [00 0b ..every_tag_of_when]} When]))
(the' .private :When/Partial_If Tag (..tag [{:Some [01 0b ..every_tag_of_when]} When]))
(the' .private :When/If_Natural Tag (..tag [{:Some [02 0b ..every_tag_of_when]} When]))
(the' .private :When/If_Integer Tag (..tag [{:Some [03 0b ..every_tag_of_when]} When]))
(the' .private :When/If_Revolution Tag (..tag [{:Some [04 0b ..every_tag_of_when]} When]))
(the' .private :When/If_Real Tag (..tag [{:Some [05 0b ..every_tag_of_when]} When]))
(the' .private :When/If_Text Tag (..tag [{:Some [06 0b ..every_tag_of_when]} When]))
(the' .private :When/Complete_Binary_Of_Alternative Tag (..tag [{:Some [07 0b ..every_tag_of_when]} When]))
(the' .private :When/Partial_Binary_Of_Alternative Tag (..tag [{:Some [08 0b ..every_tag_of_when]} When]))
(the' .private :When/Complete_Of_Alternative Tag (..tag [{:Some [09 0b ..every_tag_of_when]} When]))
(the' .private :When/Simple_Record Tag (..tag [{:Some [10 0b ..every_tag_of_when]} When]))
(the' .private :When/If_List Tag (..tag [{:Some [11 0b ..every_tag_of_when]} When]))
(the' .private :When/Let Tag (..tag [{:Some [11 1b ..every_tag_of_when]} When]))

(the' .private ?:when/complete_if
      (type (Projection [Code Code]))
      (?:either (all ?:and
                     (?:after (?:this_bit true)
                              ?:any)
                     (?:after (?:this_bit false)
                              ?:any))
                (?:each (function' (_ it)
                                   (let' [[left right] it]
                                         [right left]))
                        (all ?:and
                             (?:after (?:this_bit false)
                                      ?:any)
                             (?:after (?:this_bit true)
                                      ?:any)))))

(the' .private ?:when/else
      (type (Projection Else))
      (?:and ?:member
             ?:any))

(the' .private ?:when/let
      (type (Projection [Bundle Code]))
      (?:either (?:and ?:bundle ?:any)
                (?:and (?:tuple ?:bundle) ?:any)))

(the' .private ?:when/partial_if
      (type (Projection [Bit Code Else]))
      (all ?:and
           ?:bit
           ?:any
           ?:when/else))

(the' .private ?:any_case
      (type (Projection Alternative))
      (?:and (?:variant (?:and ?:name (?:some ?:bundle)))
             ?:any))

(the' .private ?:binary_clause
      (type (Projection Binary_Clause))
      (?:and (?:variant (?:and ?:bit ?:member))
             ?:any))

(the' .private ?:when/complete_binary_of_case
      (type (Projection [Binary_Clause Binary_Clause]))
      (?:and ?:binary_clause
             ?:binary_clause))

(the' .private ?:when/partial_binary_of_case
      (type (Projection [Binary_Clause Else]))
      (?:and ?:binary_clause
             ?:when/else))

(the' .private ?:when/complete_of_case
      (type (Projection [Alternative (List Alternative) (Maybe Else)]))
      (all ?:and
           ?:any_case
           (?:some ?:any_case)
           (?:maybe ?:when/else)))

(the' .private (?:switch ?:case)
      (type (for_any (_ it)
                     (-> (Projection it)
                         (Projection [(List [it Code]) Else]))))
      (?:and (?:many (?:and ?:case ?:any))
             ?:when/else))

(the' .private ?:when/simple_record
      (type (Projection [[[Name Code] (List [Name Code])] Code]))
      (let' [slot (?:and ?:global ?:any)]
            (?:and (?:tuple (?:and slot (?:some slot)))
                   ?:any)))

(the' .private ?:when/if_list
      (type (Projection [(List [(List Text) Code]) Else]))
      (let' [pattern (?:form (?:after (?:this_name [..prelude "list#"]) (?:some ?:member)))
             clause (?:and pattern
                           ?:any)]
            (?:and (?:many clause)
                   ?:when/else)))

(the' .private ?:when
      (type (Projection When))
      (all ?:or
           ?:when/complete_if
           ?:when/partial_if
           (?:switch ?:natural)
           (?:switch ?:integer)
           (?:switch ?:revolution)
           (?:switch ?:real)
           (?:switch ?:text)
           ?:when/complete_binary_of_case
           ?:when/partial_binary_of_case
           ?:when/complete_of_case
           ?:when/simple_record
           ?:when/if_list
           ?:when/let))

(with_template [,nullary ,form ,name ,comment]
               [(the' .public ,name
                      Macro
                      (comment ,comment
                               (macro (_ tokens)
                                      (meta:pure (list (if_case (|> (?:and ?:any ?:rest)
                                                                    (?:value (list:in_reverse tokens)))
                                                                [else
                                                                 (` ,nullary)]
                                                                [last,init
                                                                 (let' [[last init] last,init]
                                                                       (list:mix (is (-> Code (Change Code))
                                                                                     (function' (_ pre post) (` ,form)))
                                                                                 init
                                                                                 last))]))))))]

               [[0b (if (, pre) 1b (, post)) and/or
                 "https://en.wikipedia.org/wiki/And/or"]
                [1b (if (, pre) (, post) 0b) and
                 "https://en.wikipedia.org/wiki/Conjunction_(grammar)"]
                ])

(the' .private (redundancy?' = reference every_case)
      (type (for_any (_ it)
                     (-> (Equality it) it
                         (Predicate (Stack it)))))
      (if_case every_case
               [else
                false]
               [head,tail
                (let' [[head tail] head,tail]
                      (and/or (= reference head)
                              (redundancy?' = reference tail)))]))

(the' .private (redundancy? = every_case)
      (type (for_any (_ it)
                     (-> (Equality it)
                         (Predicate (Stack it)))))
      (if_case every_case
               [else
                false]
               [head,tail
                (let' [[head tail] head,tail]
                      (and/or (redundancy?' = head tail)
                              (redundancy? = tail)))]))

(with_template [,name ,type ,=]
               [(the' .private (,name reference it)
                      (type (Equality ,type))
                      (,= reference it))]

               [[natural:= Natural .i64_=#]
                [integer:= Integer .i64_=#]
                [revolution:= Revolution .i64_=#]
                [real:= Real .f64_=#]
                ])

(with_template [,name ,type ,= ,'= ,code]
               [(the' .private (,name '_ value every_then variable 'else)
                      (type (-> Code Code (List [,type Code]) Text Code
                                (Meta (List Code))))
                      (if (redundancy? ,= (list:as_stack (list:each pair:left every_then)))
                          (failure "Redundancy")
                          (meta:pure (list (` (.let# (..is ,type (, value))
                                                     (.function# (, '_) (, '_)
                                                                 (, (list:mix (function' (_ case,then 'else)
                                                                                         (let' [[case then] case,then]
                                                                                               ('if (` (,'= (, (,code case))
                                                                                                            (, '_)))
                                                                                                    then
                                                                                                    'else)))
                                                                              (list:in_reverse every_then)
                                                                              ('let (code:local variable) '_ 'else))))))))))]

               [[if_natural ..Natural natural:= .i64_=# code:natural]
                [if_integer ..Integer integer:= .i64_=# code:integer]
                [if_revolution ..Revolution revolution:= .i64_=# code:revolution]
                [if_real ..Real real:= .f64_=# code:real]
                [if_text ..Text text:= .text_=# code:text]
                ])

(the' .public (identical? expected actual)
      (for_any (_ it)
               (-> it
                   (Predicate it)))
      (.is?# expected actual))

(the' .private (text:interposed delimiter parts)
      (type (-> Text (List Text)
                Text))
      (let' [it ""]
            (list:mix (function' (_ right left)
                                 (if (text:= it left)
                                     right
                                     (text left delimiter right)))
                      parts
                      it)))

(the' .private (module name)
      (type (-> Text
                (Meta Module)))
      (function' (_ state)
                 (let' [[lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] state]
                       (if_case (property:value name lux:modules)
                                [else
                                 {:Left (text "Unknown module: " name)}]
                                [module
                                 {:Right state module}]))))

(with_template [,name ,type ,description]
               [(the' .private (,name name)
                      (type (-> Name
                                (Meta [Bit Label])))
                      (<| (monad:let meta:monad
                                     [name (name:normal name)
                                      .let' [[module name] name]
                                      =module (..module module)
                                      .let' [[module:module_hash module:module_aliases module:definitions module:imports module:module_state] =module]])
                          (if_case (property:value name module:definitions)
                                   [_
                                    (failure (text "Unknown " ,description ": " (name:as_text [module name])))]
                                   [exported,the_global
                                    (let' [[exported the_global] exported,the_global]
                                          (if_case the_global
                                                   [else
                                                    (failure (text "Unknown " ,description ": " (name:as_text [module name])))]
                                                   [definition
                                                    (let' [[type expression value] definition]
                                                          (if (type:= ,type type)
                                                              (meta:pure [exported (as (-> Any Label) value)])
                                                              (failure (text "Not a " ,description ": " (name:as_text [module name])))))]))])))]

               [[tag_as_label Tag "tag"]
                [slot_as_label Slot "slot"]
                ])

(the' .private (single_bundle it)
      (type (-> (List Bundle)
                (Maybe Bundle)))
      (if (natural:= 0 (.list_size# it))
          {:None}
          (let' [it (list:in_reverse it)]
                {:Some (list:mix (function' (_ left right)
                                            {:Right left right})
                                 (list:after 1 it)
                                 (.list_item# 0 it))})))

(the' .private (branch_of_case bundle 'value 'body)
      (type (-> (List Bundle) Code Code
                (Meta Code)))
      (.when# (single_bundle bundle)
              {:Some bundle}
              (if_case bundle
                       [bundle
                        (meta:pure (` (.function# (, (code:local bundle)) (, (code:local bundle))
                                                  (, 'body))))]
                       [else
                        (monad:let meta:monad
                                   ['body (let_pair bundle 'value 'body)]
                                   (pure (` (.function# (, 'value) (, 'value)
                                                        (, 'body)))))])
              
              {:None}
              (meta:pure (` (.function# (, 'value) (, 'value)
                                        (, 'body))))))

(the' .private (complete_of_case every_branch)
      (type (-> (Property_List [(List Bundle) Code])
                (-> Code Natural (Meta Code))))
      (function' (complete_of_case 'value case)
                 (if_case (property:value (natural:as_text case) every_branch)
                          [else
                           (failure (name:as_text [..prelude "complete_of_case"]))]
                          [bundle,'body
                           (let' [[bundle 'body] bundle,'body]
                                 (if (natural:= (.i64_+# 1 case)
                                                (.list_size# every_branch))
                                     (branch_of_case bundle 'value 'body)
                                     (monad:let meta:monad
                                                ['case (generated_name "'case")
                                                 'then (branch_of_case bundle 'case 'body)
                                                 'else (complete_of_case 'case (.i64_+# 1 case))
                                                 .let' ['if_case# (` (.if_case# (, 'value)
                                                                                (, 'then)
                                                                                (, 'else)))]]
                                                (pure (if (natural:= 0 case)
                                                          'if_case#
                                                          (` (.function# (, 'value) (, 'value)
                                                                         (, 'if_case#))))))))])))

(the' .private (partial_of_case every_case every_branch 'else 'full_value)
      (type (-> Natural (Property_List [(List Bundle) Code]) Code Code
                (-> Code Natural (Meta Code))))
      (function' (partial_of_case 'value case)
                 (if_case (property:value (natural:as_text case) every_branch)
                          [else
                           (let' ['then (` ((, 'else) (, 'full_value)))]
                                 (if (natural:= (.i64_+# 1 case)
                                                every_case)
                                     (meta:pure 'then)
                                     (monad:let meta:monad
                                                ['case (generated_name "'case")
                                                 'else (partial_of_case 'case (.i64_+# 1 case))]
                                                (pure ('if_case# 'value
                                                                 'case 'then
                                                                 'case 'else)))))]
                          [bundle,'body
                           (let' [[bundle 'body] bundle,'body]
                                 (if (natural:= (.i64_+# 1 case)
                                                every_case)
                                     (if_case (single_bundle bundle)
                                              [else
                                               (meta:pure 'body)]
                                              [bundle
                                               (let_pair bundle 'value 'body)])
                                     (monad:let meta:monad
                                                ['case (generated_name "'case")
                                                 'then (if_case (single_bundle bundle)
                                                                [else
                                                                 (pure 'body)]
                                                                [bundle
                                                                 (let_pair bundle 'case 'body)])
                                                 'else (partial_of_case 'case (.i64_+# 1 case))]
                                                (pure ('if_case# 'value
                                                                 'case 'then
                                                                 'case 'else)))))])))

(the' .private \n
      Text
      (.int_char# +10))

(the' .private (type_of_definition name state)
      (type (-> Name Lux
                (Maybe Type)))
      (let' [[expectation_for_module expectation_for_proper] name
             [lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] state]
            (if_case (property:value expectation_for_module lux:modules)
                     [else
                      {:None}]
                     [the_module
                      (let' [[module:module_hash module:module_aliases module:definitions module:imports module:module_state] the_module]
                            (if_case (property:value expectation_for_proper module:definitions)
                                     [else
                                      {:None}]
                                     [the_global
                                      (let' [[exported? definition] the_global]
                                            (if_case definition
                                                     [real_name
                                                      (type_of_definition real_name state)]
                                                     [definition
                                                      (let' [[def_type expression def_value] definition]
                                                            {:Some def_type})]))]))])))

(the' .private (type_variable expected context)
      (type (-> Natural (List (Maybe Type))
                (Maybe Type)))
      (let' [limit (.list_size# context)]
            (if (.int_<# (as (-> Natural Integer) limit)
                         (as (-> Natural Integer) expected))
                (.list_item# expected context)
                {:None})))

(the' .private (stack:each value it)
      (for_any (_ cause effect)
               (type (-> (-> cause effect)
                         (-> (Stack cause) (Stack effect)))))
      (stack:mix (function' (_ head tail)
                            {:Top (value head) tail})
                 {:Empty}
                 (stack:in_reverse it)))

(the' .private (clean_type variables it)
      (type (-> (List (Maybe Type))
                (Change Type)))
      (if_case it
               [name,parameters
                (let' [[name parameters] name,parameters]
                      {:Nominal name (list:each (function' (_ it)
                                                           (let' [[parammeter it] it]
                                                                 [parammeter (clean_type variables it)]))
                                                parameters)})]

               [_
                it]
               [general_or_special,id
                (let' [[general_or_special id] general_or_special,id]
                      (if general_or_special
                          (comment "special"
                                   it)
                          (comment "general"
                                   (if_case (type_variable id variables)
                                            [_
                                             it]
                                            [maybe_variable
                                             (.when# maybe_variable
                                                     {:Variable _}
                                                     it

                                                     it
                                                     (clean_type variables it))]))))]
               [quantification,environment,unquantified
                (let' [[quantification environment unquantified] quantification,environment,unquantified]
                      {:Quantification quantification
                                       (stack:each (function' (_ it)
                                                              (let' [[abstraction argument] it]
                                                                    [(clean_type variables abstraction)
                                                                     (clean_type variables argument)]))
                                                   environment)
                                       (clean_type variables unquantified)})]
               [left,right
                (let' [[left right] left,right]
                      {:Reification (clean_type variables left)
                                    (clean_type variables right)})]
               [name,anonymous
                (let' [[name anonymous] name,anonymous]
                      it)]))

(the' .private (type_of_reference full_name)
      (type (-> Name
                (Meta Type)))
      (monad:let meta:monad
                 [.let' [[module name] full_name]
                  current_module ..name_of_current_module]
                 (function' (_ compiler)
                            (let' [temp (is (Either Text [Lux Type])
                                            (if (.text_=# "" module)
                                                (if_case (in_env name compiler)
                                                         [else
                                                          (if_case (type_of_definition [current_module name] compiler)
                                                                   [else
                                                                    {:Left (text "Unknown var: " (name:as_text full_name))}]
                                                                   [implementation_type
                                                                    {:Right [compiler implementation_type]}])]
                                                         [implementation_type
                                                          {:Right [compiler implementation_type]}])
                                                (if_case (type_of_definition full_name compiler)
                                                         [else
                                                          {:Left (text "Unknown var: " (name:as_text full_name))}]
                                                         [implementation_type
                                                          {:Right [compiler implementation_type]}])))]
                                  (if_case temp
                                           [_
                                            temp]
                                           [compiler,temp
                                            (let' [[compiler temp] compiler,temp
                                                   [lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] compiler
                                                   [type_context:for_all type_context:there_exists] lux:type_context]
                                                  {:Right [compiler (clean_type type_context:for_all temp)]})])))))

(the' .private type:expectation
      (type (Meta Type))
      (<| (function' (_ state))
          (let' [[lux:info lux:source lux:provenance lux:current_module lux:modules lux:scopes lux:type_context lux:expected lux:seed lux:eval] state])
          (if_case lux:expected
                   [else
                    {:Left "Not expecting any type."}]
                   [type
                    {:Right [state type]}])))

(the' .private ('stack it)
      (type (-> (Stack Code)
                Code))
      (|> it
          stack:in_reverse
          (stack:mix ':Top ':Empty)))

(the' .private (type:as_code type)
      (-> Type
          Code)
      (if_case type
               [name,params
                (let' [[name params] name,params]
                      (` {..:Nominal (, (code:text name)) (, ('list (list:each (function' (_ it)
                                                                                          (let' [[polarity it] it]
                                                                                                (` [(, (code:bit polarity))
                                                                                                    (, (type:as_code it))])))
                                                                               params)))}))]
               [parameter,id
                (let' [[parameter id] parameter,id]
                      (` {..:Parameter (, (code:bit parameter))
                                       (, (code:natural id))}))]
               [quality,id
                (let' [[quality id] quality,id]
                      (` {..:Variable (, (code:bit quality)) (, (code:natural id))}))]
               [quantification,env,type
                (let' [[quantification env type] quantification,env,type]
                      (` {..:Quantification (, (code:bit quantification))
                                            (, ('stack (stack:each (function' (_ it)
                                                                              (let' [[abstraction argument] it]
                                                                                    (` [(, (type:as_code abstraction))
                                                                                        (, (type:as_code argument))])))
                                                                   env)))
                                            (, (type:as_code type))}))]
               [left,right
                (let' [[left right] left,right]
                      (` {..:Reification (, (type:as_code left)) (, (type:as_code right))}))]
               [full_name,anonymous
                (let' [[full_name anonymous] full_name,anonymous
                       [module name] full_name]
                      (comment "TODO: Generate the explicit type definition instead of using the `code:name` shortcut below."
                               (` {..:Named [(, (code:text module)) (, (code:text name))]
                                            (, (type:as_code anonymous))})
                               (code:name [module name])))]))

(the' .public (else it input)
      (for_any (_ input output)
               (-> (-> input output)
                   input
                   (-> input output)))
      it)

(the' .private (arity_of_label it)
      (-> Label
          Natural)
      (let' [[?label type] it]
            (if_case ?label
                     [else
                      1]
                     [label
                      (let' [[every_left right? cohort] label]
                            (.list_size# cohort))])))

(the' .private (index_of_label it)
      (-> Label
          Text)
      (let' [[?label type] it]
            (if_case ?label
                     [else
                      "0"]
                     [label
                      (let' [[every_left right? cohort] label]
                            (natural:as_text (if right?
                                                 (.i64_+# 1 every_left)
                                                 every_left)))])))

(the' .private list:enumeration
      (type (for_any (_ it)
                     (-> (List it)
                         (List [Natural it]))))
      (list:each' (function' (_ address it)
                             [address it])))

(the' .private Path
      Type
      {:Named (name ..Path)
              (type (for_any (Path _)
                             (Or (Either (Either Path Path)
                                         [Path Path])
                                 (List [Natural Path])
                                 (List [Integer Path])
                                 (List [Revolution Path])
                                 (List [Real Path])
                                 (List [Text Path])

                                 (List (Maybe Path))
                                 Path
                                 (List [Natural Path])
                                 [Natural Path]

                                 [Text Path]
                                 [Text Text Path]
                                 Path
                                 Code

                                 [Path Path])))})

(the' .private every_tag_of_path
      (type (List Name))
      (list [..prelude ":Path/Bit"]
            [..prelude ":Path/Natural"]
            [..prelude ":Path/Integer"]
            [..prelude ":Path/Revolution"]
            [..prelude ":Path/Real"]
            [..prelude ":Path/Text"]
            
            [..prelude ":Path/Alternative"]
            [..prelude ":Path/Pair"]
            [..prelude ":Path/List"]
            [..prelude ":Path/Item"]
            
            [..prelude ":Path/Let"]
            [..prelude ":Path/Alias"]
            [..prelude ":Path/Pop"]
            [..prelude ":Path/Body"]

            [..prelude ":Path/Or"]))
(the' .private :Path/Bit Tag (..tag [{:Some [00 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Natural Tag (..tag [{:Some [01 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Integer Tag (..tag [{:Some [02 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Revolution Tag (..tag [{:Some [03 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Real Tag (..tag [{:Some [04 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Text Tag (..tag [{:Some [05 0b ..every_tag_of_path]} Path]))

(the' .private :Path/Alternative Tag (..tag [{:Some [06 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Pair Tag (..tag [{:Some [07 0b ..every_tag_of_path]} Path]))
(the' .private :Path/List Tag (..tag [{:Some [08 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Item Tag (..tag [{:Some [09 0b ..every_tag_of_path]} Path]))

(the' .private :Path/Let Tag (..tag [{:Some [10 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Alias Tag (..tag [{:Some [11 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Pop Tag (..tag [{:Some [12 0b ..every_tag_of_path]} Path]))
(the' .private :Path/Body Tag (..tag [{:Some [13 0b ..every_tag_of_path]} Path]))

(the' .private :Path/Or Tag (..tag [{:Some [13 1b ..every_tag_of_path]} Path]))

(the' .private (switch:as_text as_text path:as_text it)
      (type (for_any (_ it)
                     (-> (-> it
                             Text)
                         (-> Path
                             Text)
                         (-> (List [it Path])
                             Text))))
      (text "{" (|> it
                    (list:each (<| (function' (_ expectation,then))
                                   (let' [[expectation then] expectation,then])
                                   (text (as_text expectation)
                                         " " (path:as_text then))))
                    (text:interposed " "))
            "}"))

(the' .private (path:as_text it)
      (-> Path
          Text)
      (if_case it
               [it
                (comment :Path/Bit
                         (if_case it
                                  [it
                                   (if_case it
                                            [then
                                             (text "{"
                                                   " " (bit:as_text 0b)
                                                   " " (path:as_text then)
                                                   "}")]
                                            [then
                                             (text "{"
                                                   " " (bit:as_text 1b)
                                                   " " (path:as_text then)
                                                   "}")])]
                                  [false_then,true_then
                                   (let' [[false_then true_then] false_then,true_then]
                                         (text "{"
                                               " " (bit:as_text 0b)
                                               " " (path:as_text false_then)
                                               " " (bit:as_text 1b)
                                               " " (path:as_text true_then)
                                               "}"))]))]
               [it
                (comment :Path/Natural
                         (switch:as_text natural:as_text path:as_text it))]
               [it
                (comment :Path/Integer
                         (switch:as_text integer:as_text path:as_text it))]
               [it
                (comment :Path/Revolution
                         "???")]
               [it
                (comment :Path/Real
                         "???")]
               [it
                (comment :Path/Text
                         (switch:as_text text:as_text path:as_text it))]
               [then
                (comment :Path/Alternative
                         (let' [cohort (.list_size# then)
                                last (.i64_-# 1 cohort)]
                               (text "{" (|> (list:enumeration then)
                                             (list:each (<| (function' (_ tag,then))
                                                            (let' [[tag then] tag,then
                                                                   right? (natural:= last tag)
                                                                   every_left (is Natural
                                                                                  (if right?
                                                                                      (.i64_-# 1 tag)
                                                                                      tag))])
                                                            (text "[" (natural:as_text every_left)
                                                                  " " (bit:as_text right?)
                                                                  "]"
                                                                  " " (if_case then
                                                                               [else
                                                                                "???"]
                                                                               [then
                                                                                (path:as_text then)]))))
                                             (text:interposed " "))
                                     "}")))]
               [then
                (comment :Path/Pair
                         (text "([]"
                               " " (path:as_text then)
                               ")"))]
               [it
                (comment :Path/List
                         (text "(LIST"
                               " " (switch:as_text natural:as_text path:as_text it)
                               ")"))]
               [item,then
                (comment :Path/Item
                         (let' [[item then] item,then]
                               (text "(ITEM"
                                     " " (natural:as_text item)
                                     " " (path:as_text then)
                                     ")")))]
               [local,then
                (comment :Path/Let
                         (let' [[local then] local,then]
                               (text "(LET"
                                     " " local
                                     " " (path:as_text then)
                                     ")")))]
               [old,new,then
                (comment :Path/Alias
                         (let' [[old new then] old,new,then]
                               (text "(Alias"
                                     " " old
                                     " " "->"
                                     " " new
                                     " " (path:as_text then)
                                     ")")))]
               [then
                (comment :Path/Pop
                         (text "(POP"
                               " " (path:as_text then)
                               ")"))]
               [then
                (comment :Path/Body
                         (text "(!"
                               " " (code:as_text then)
                               ")"))]
               [head,tail
                (comment :Path/Or
                         (let' [[head tail] head,tail]
                               (text "(|"
                                     " " (path:as_text head)
                                     " " (path:as_text tail)
                                     ")")))]))

(the' .private (path/failure it)
      (-> Code
          Meta)
      (function' (_ lux)
                 (meta:failure (text "Not a valid pattern: " (code:as_text it)))))

(the' .private (tuple_in_variant it)
      (type (-> (List Code)
                Code))
      (if_list it
               [[]
                (code:tuple (list))]
               [[one]
                one]
               (comment "more than one"
                        (code:tuple it))))

(the' .private (list:repeated amount it)
      (type (for_any (_ it)
                     (-> Natural it
                         (List it))))
      (if (natural:= 0 amount)
          (list)
          
          (natural:= 1 amount)
          (list it)

          (comment "else"
                   (.list_composite# (list it) (list:repeated (.i64_-# 1 amount) it)))))

(the' .private (path_variant cohort every_left right? it)
      (-> Natural Natural Bit Path
          Path)
      (let' [every_left (is Natural
                            (if right?
                                (.i64_+# 1 every_left)
                                every_left))]
            {:Path/Alternative (list:conjoint (list (list:repeated every_left {:None})
                                                    (list {:Some it})
                                                    (list:repeated (.i64_-# (.i64_+# 1 every_left) cohort) {:None})))}))

(the' .private (global? it)
      (type (-> Code
                (Maybe Name)))
      (if_name it
               (function' (_ @ name)
                          (let' [[module proper] name]
                                (if (.text_=# "" module)
                                    {:None}
                                    {:Some name})))
               (function' (_ _)
                          {:None})))

(the' .private (stack:as_list it)
      (type (for_any (_ it)
                     (-> (Stack it)
                         (List it))))
      (if_case it
               [empty
                (list)]
               [head,tail
                (let' [[head tail] head,tail]
                      (.list_composite# (list head)
                                        (stack:as_list tail)))]))

(the' .private (record:by_code it)
      (type (-> (List Code)
                (Maybe (List [Name Code]))))
      (monad:let maybe:monad
                 [record (pairs (list:as_stack it))]
                 (monad:each maybe:monad
                             (<| (function' (_ slot,value))
                                 (let' [[slot value] slot,value])
                                 (monad:let maybe:monad
                                            [slot (global? slot)])
                                 (pure [slot value]))
                             (stack:as_list record))))

(the' .private (record:by_slot it)
      (type (-> (List [Name Code])
                (Meta (List [Label Code]))))
      (monad:each meta:monad
                  (<| (function' (_ slot,value))
                      (let' [[slot value] slot,value])
                      (monad:let meta:monad
                                 [slot (slot_as_label slot)])
                      (let' [[exported? slot] slot])
                      (pure [slot value]))
                  it))

(the' .private (record:type_of_field <label,owner>,value)
      (type (-> [Label Code]
                Type))
      (let' [[label,owner value] <label,owner>,value
             [label it] label,owner]
            it))

(the' .private (record:in_order it)
      (type (-> (List [Label Code])
                (Property_List Code)))
      (list:each (<| (function' (_ slot,value))
                     (let' [[slot value] slot,value
                            [label reality] slot])
                     [(if_case label
                               [else
                                "???"]
                               [label
                                (let' [[every_left right? cohort] label]
                                      (natural:as_text (if right?
                                                           (.i64_+# 1 every_left)
                                                           every_left)))])
                      value])
                 it))

(the' .private (record:as_tuple it)
      (type (-> (Property_List Code)
                (Maybe (List Code))))
      (monad:each maybe:monad
                  (<| (function' (_ index))
                      (property:value (natural:as_text index) it))
                  (list:each pair:left (list:enumeration it))))

(the' .private (tuple_path path
                           pattern body)
      (type (-> (-> Code Path
                    (Meta Path))
                (-> (List Code) Path
                    (Meta Path))))
      (let' [pattern (list:in_reverse pattern)]
            (.if_list# pattern
                       (meta:pure {:Path/Pop body})
                       (function' (_ last before)
                                  (.if_list# before
                                             (path last body)
                                             (function' (_ _ _)
                                                        (monad:let meta:monad
                                                                   [body (path last body)]
                                                                   (monad:mix meta:monad
                                                                              (function' (_ left right)
                                                                                         (monad:let meta:monad
                                                                                                    [it (path left right)]
                                                                                                    (pure {:Path/Pair it})))
                                                                              before
                                                                              body))))))))

(the' .private (path pattern body)
      (type (-> Code Path
                (Meta Path)))
      (if_case pattern
               [@,it
                (comment :Bit
                         (let' [[@ it] @,it]
                               (meta:pure {:Path/Bit {:Left (if it
                                                                {:Right body}
                                                                {:Left body})}})))]
               [@,it
                (comment :Natural
                         (let' [[@ it] @,it]
                               (meta:pure {:Path/Natural (list [it body])})))]
               [@,it
                (comment :Integer
                         (let' [[@ it] @,it]
                               (meta:pure {:Path/Integer (list [it body])})))]
               [@,it
                (comment :Revolution
                         (let' [[@ it] @,it]
                               (meta:pure {:Path/Revolution (list [it body])})))]
               [@,it
                (comment :Real
                         (let' [[@ it] @,it]
                               (meta:pure {:Path/Real (list [it body])})))]
               [@,it
                (comment :Text
                         (let' [[@ it] @,it]
                               (meta:pure {:Path/Text (list [it body])})))]
               [@,local
                (comment :Name
                         (let' [[@ local] @,local
                                [the_module local] local]
                               (if (text:= "" the_module)
                                   (meta:pure {:Path/Let local body})
                                   (..path/failure pattern))))]
               [@,it
                (comment :Form
                         (let' [[@ it] @,it
                                [the_name every_term] (list:split 1 it)]
                               (if_list the_name
                                        [[@,the_name]
                                         (if_name @,the_name
                                                  (function' (_ @ the_name)
                                                             (let' [[the_module the_proper] the_name]
                                                                   (if (and (text:= "library/lux" the_module)
                                                                            (text:= "list#" the_proper))
                                                                       (monad:let meta:monad
                                                                                  [it (monad:mix meta:monad
                                                                                                 (function' (_ head tail)
                                                                                                            (monad:let meta:monad
                                                                                                                       [.let' [[item head] head]
                                                                                                                        it (path head tail)]
                                                                                                                       (pure {:Path/Item item it})))
                                                                                                 (list:in_reverse (list:enumeration every_term))
                                                                                                 {:Path/Pop body})]
                                                                                  (pure {:Path/List (list [(.list_size# every_term) it])}))
                                                                       (..path/failure pattern))))
                                                  (function' (_ _)
                                                             (..path/failure pattern)))]
                                        (..path/failure pattern))))]
               [@,it
                (comment :Variant
                         (let' [[@ it] @,it]
                               (.if_list# it
                                          (..path/failure pattern)
                                          (function' (_ head value)
                                                     (.when# head
                                                             {:Bit @,right?}
                                                             (let' [[@ right?] @,right?]
                                                                   (monad:let meta:monad
                                                                              [path (path (tuple_in_variant value) body)]
                                                                              (pure (path_variant 2 0 right? path))))

                                                             {:Name @,tag}
                                                             (let' [[@ tag] @,tag]
                                                                   (monad:let meta:monad
                                                                              [tag (tag_as_label tag)
                                                                               .let' [[exported? tag] tag]
                                                                               path (path (tuple_in_variant value) body)]
                                                                              (let' [[the_tag type] tag]
                                                                                    (if_case the_tag
                                                                                             [else
                                                                                              (..path/failure pattern)]
                                                                                             [the_tag
                                                                                              (let' [[every_left right? cohort] the_tag]
                                                                                                    (pure (path_variant (.list_size# cohort)
                                                                                                                        every_left
                                                                                                                        right?
                                                                                                                        path)))]))))

                                                             else
                                                             (..path/failure pattern))))))]
               [@,it
                (comment :Tuple
                         (let' [[@ it] @,it]
                               (if_list it
                                        [[]
                                         (tuple_path path it body)]
                                        (if_case (record:by_code it)
                                                 [else
                                                  (tuple_path path it body)]
                                                 [record
                                                  (monad:let meta:monad
                                                             [record (record:by_slot record)]
                                                             (if_case (list:as_stack record)
                                                                      [else
                                                                       (..path/failure pattern)]
                                                                      [head,tail
                                                                       (let' [[head tail] head,tail
                                                                              [label,expectation value] head
                                                                              [label expectation] label,expectation]
                                                                             (if (list:every? (<| (function' (_ field))
                                                                                                  (type:= expectation (record:type_of_field field)))
                                                                                              record)
                                                                                 (if_case label
                                                                                          [else
                                                                                           (..path/failure pattern)]
                                                                                          [label
                                                                                           (let' [[every_left right? cohort] label
                                                                                                  size_of_cohort (.list_size# cohort)
                                                                                                  record (record:in_order record)]
                                                                                                 (if (natural:= size_of_cohort (.list_size# record))
                                                                                                     (if_case (record:as_tuple record)
                                                                                                              [else
                                                                                                               (..path/failure pattern)]
                                                                                                              [in_order
                                                                                                               (tuple_path path in_order body)])
                                                                                                     (..path/failure pattern)))])
                                                                                 (..path/failure pattern)))]))]))))]))

(the' .private (maybe:each value it)
      (type (for_any (_ this that)
                     (-> (-> this
                             that)
                         (-> (Maybe this)
                             (Maybe that)))))
      (if_case it
               [else
                {:None}]
               [it
                {:Some (value it)}]))

(the' .private (path:or 'common head tail)
      (type (-> Text Path Path
                (Maybe Path)))
      (.when# [head tail]
              [{:Path/Pop head}
               {:Path/Pop tail}]
              (monad:let maybe:monad
                         [it (path:or 'common head tail)]
                         (pure {:Path/Pop it}))

              [{:Path/Pair head}
               {:Path/Pair tail}]
              (monad:let maybe:monad
                         [it (path:or 'common head tail)]
                         (pure {:Path/Pair it}))

              [{:Path/Pair head}
               {:Path/Or head' tail'}]
              (.when# (path:or 'common {:Path/Pair head} head')
                      {:Some {:Path/Pair head}}
                      {:Some {:Path/Or {:Path/Pair head}
                                       tail'}}

                      else
                      {:Some {:Path/Or {:Path/Pair head}
                                       {:Path/Or head' tail'}}})

              [{:Path/Bit head}
               {:Path/Bit tail}]
              (if_case head
                       [head
                        (if_case head
                                 [head_false
                                  (if_case tail
                                           [tail
                                            (if_case tail
                                                     [tail_false
                                                      (monad:let maybe:monad
                                                                 [it (path:or 'common head_false tail_false)]
                                                                 (pure {:Path/Bit {:Left {:Left it}}}))]
                                                     [tail_true
                                                      {:Some {:Path/Bit {:Right [head_false tail_true]}}}])]
                                           [tail_false,tail_true
                                            (let' [[tail_false tail_true] tail_false,tail_true]
                                                  (monad:let maybe:monad
                                                             [it (path:or 'common head_false tail_false)]
                                                             (pure {:Path/Bit {:Right [it tail_true]}})))])]
                                 [head_true
                                  (if_case tail
                                           [tail
                                            (if_case tail
                                                     [tail_false
                                                      {:Some {:Path/Bit {:Right [tail_false head_true]}}}]
                                                     [tail_true
                                                      (monad:let maybe:monad
                                                                 [it (path:or 'common head_true tail_true)]
                                                                 (pure {:Path/Bit {:Left {:Left it}}}))])]
                                           [tail_false,tail_true
                                            (let' [[tail_false tail_true] tail_false,tail_true]
                                                  (monad:let maybe:monad
                                                             [it (path:or 'common head_true tail_true)]
                                                             (pure {:Path/Bit {:Right [tail_false it]}})))])])]
                       [head_false,head_true
                        (let' [[head_false head_true] head_false,head_true]
                              (if_case tail
                                       [tail
                                        (if_case tail
                                                 [tail_false
                                                  (monad:let maybe:monad
                                                             [it (path:or 'common head_false tail_false)]
                                                             (pure {:Path/Bit {:Right [it head_true]}}))]
                                                 [tail_true
                                                  (monad:let maybe:monad
                                                             [it (path:or 'common head_true tail_true)]
                                                             (pure {:Path/Bit {:Right [head_false it]}}))])]
                                       [tail_false,tail_true
                                        (let' [[tail_false tail_true] tail_false,tail_true]
                                              (monad:let maybe:monad
                                                         [then_false (path:or 'common head_false tail_false)
                                                          then_true (path:or 'common head_true tail_true)]
                                                         (pure {:Path/Bit {:Right [then_false then_true]}})))]))])

              [{:Path/Item item_of_head head}
               {:Path/Item item_of_tail tail}]
              (if (natural:= item_of_head item_of_tail)
                  (monad:let maybe:monad
                             [it (path:or 'common head tail)]
                             (pure {:Path/Item item_of_head it}))
                  {:Some {:Path/Or {:Path/Item item_of_head head}
                                   {:Path/Item item_of_tail tail}}})

              [{:Path/Let local_of_head {:Path/Alternative head}}
               {:Path/Let local_of_tail {:Path/Alternative tail}}]
              (if (text:= local_of_head local_of_tail)
                  (monad:let maybe:monad
                             [it (path:or 'common {:Path/Alternative head} {:Path/Alternative tail})]
                             (pure {:Path/Let local_of_head it}))
                  (monad:let maybe:monad
                             [it (path:or 'common {:Path/Alternative (list:each (maybe:each (function' (_ it) {:Path/Alias 'common local_of_head it})) head)}
                                          {:Path/Alternative (list:each (maybe:each (function' (_ it) {:Path/Alias 'common local_of_tail it})) tail)})]
                             (pure {:Path/Let 'common it})))

              [{:Path/Let local_of_head head}
               {:Path/Let local_of_tail tail}]
              (if (text:= local_of_head local_of_tail)
                  (monad:let maybe:monad
                             [it (path:or 'common head tail)]
                             (pure {:Path/Let local_of_head it}))
                  {:Some {:Path/Or {:Path/Let local_of_head head}
                                   {:Path/Let local_of_tail tail}}})

              [{:Path/List head}
               {:Path/List tail}]
              (monad:let maybe:monad
                         [it (monad:mix maybe:monad
                                        (<| (function' (_ expectation,then fork))
                                            (let' [[expectation then] expectation,then])
                                            (if_case (property:value' natural:= expectation fork)
                                                     [else
                                                      (pure (property:with' natural:= expectation then fork))]
                                                     [old
                                                      (monad:let maybe:monad
                                                                 [then (path:or 'common then old)]
                                                                 (pure (property:with' natural:= expectation then fork)))]))
                                        head
                                        tail)]
                         (pure {:Path/List it}))

              [{:Path/List head}
               {:Path/Or head' tail'}]
              (.when# (path:or 'common {:Path/List head} head')
                      {:Some {:Path/List head}}
                      {:Some {:Path/Or {:Path/List head}
                                       tail'}}

                      else
                      {:Some {:Path/Or {:Path/List head}
                                       {:Path/Or head' tail'}}})
              
              [{:Path/Text head}
               {:Path/Text tail}]
              (monad:let maybe:monad
                         [it (monad:mix maybe:monad
                                        (<| (function' (_ expectation,then fork))
                                            (let' [[expectation then] expectation,then])
                                            (if_case (property:value expectation fork)
                                                     [else
                                                      (pure (property:with expectation then fork))]
                                                     [old
                                                      (monad:let maybe:monad
                                                                 [then (path:or 'common then old)]
                                                                 (pure (property:with expectation then fork)))]))
                                        head
                                        tail)]
                         (pure {:Path/Text it}))

              [{:Path/Text head}
               {:Path/Or head' tail'}]
              (.when# (path:or 'common {:Path/Text head} head')
                      {:Some {:Path/Text head}}
                      {:Some {:Path/Or {:Path/Text head}
                                       tail'}}

                      else
                      {:Some {:Path/Or {:Path/Text head}
                                       {:Path/Or head' tail'}}})
              
              [{:Path/Alternative head}
               {:Path/Alternative tail}]
              (if (natural:= (.list_size# head) (.list_size# tail))
                  (monad:let maybe:monad
                             [it (monad:each maybe:monad
                                             (function' (_ head,tail)
                                                        (let' [[head tail] head,tail]
                                                              (if_case head
                                                                       [else
                                                                        (if_case tail
                                                                                 [else
                                                                                  (pure {:None})]
                                                                                 [tail'
                                                                                  (pure tail)])]
                                                                       [head
                                                                        (if_case tail
                                                                                 [else
                                                                                  (pure {:Some head})]
                                                                                 [tail
                                                                                  (monad:let maybe:monad
                                                                                             [it (path:or 'common head tail)]
                                                                                             (pure {:Some it}))])])))
                                             (list:zipped_2 head tail))]
                             (pure {:Path/Alternative it}))
                  {:None})

              [{:Path/Alternative head}
               {:Path/Or head' tail'}]
              (.when# (path:or 'common {:Path/Alternative head} head')
                      {:Some {:Path/Alternative head}}
                      {:Some {:Path/Or {:Path/Alternative head}
                                       tail'}}

                      else
                      {:Some {:Path/Or {:Path/Alternative head}
                                       {:Path/Or head' tail'}}})
              
              else
              {:Some {:Path/Or head
                               tail}}))

(the' .private (top context)
      (type (-> (Stack Code)
                (Meta [Code (Stack Code)])))
      (if_case context
               [else
                (failure "!!! top")]
               [head,tail
                (let' [[head tail] head,tail]
                      (meta:pure [head tail]))]))

(the' .private (path:else it)
      (type (-> (Maybe Code)
                (Meta Code)))
      (if_case it
               [else
                (failure "!!! path:else")]
               [it
                (meta:pure it)]))

(the' .private (path/case:more? it)
      (type (Predicate (Stack (Maybe Path))))
      (if_case it
               [else
                false]
               [the_head,tail
                (let' [[the_head tail] the_head,tail]
                      (if_case the_head
                               [else
                                (path/case:more? tail)]
                               [then
                                true]))]))

(the' .private (path/case:as_code path:as_code context else it)
      (type (-> (-> (Stack Code) (Maybe Code) Path
                    (Meta Code))
                (-> (Stack Code) (Maybe Code) (Stack (Maybe Path))
                    (Meta Code))))
      (.when# it
              {:Top {:Some {:Path/Let @left,left}}
                    {:Top {:Some {:Path/Let @right,right}}
                          {:Empty}}}
              (let' [[@left left] @left,left
                     [@right right] @right,right]
                    (monad:let meta:monad
                               ['top,context (top context)
                                .let' [['top context] 'top,context]
                                'left (path:as_code context else left)
                                'right (path:as_code context else right)]
                               (pure ('if_case# 'top
                                                (code:local @left) 'left
                                                (code:local @right) 'right))))

              {:Top {:Some then}
                    {:Top {:Some {:Path/Let @tail,tail}}
                          {:Empty}}}
              (let' [[@tail tail] @tail,tail]
                    (monad:let meta:monad
                               ['top,context (top context)
                                .let' [['top context] 'top,context]
                                'else (path:as_code context else tail)
                                @case (generated_name "@case")
                                'then (path:as_code {:Top @case context} else then)]
                               (pure ('if_case# 'top
                                                @case 'then
                                                (code:local @tail) 'else))))

              {:Top the_head,tail}
              (let' [[the_head tail] the_head,tail]
                    (if_case the_head
                             [_
                              (comment :None
                                       (monad:let meta:monad
                                                  ['top,context (top context)
                                                   .let' [['top context] 'top,context]
                                                   @case (generated_name "@case")
                                                   'then (path/case:as_code path:as_code {:Top @case context} else tail)
                                                   'else (path:else else)]
                                                  (pure ('if_case# 'top
                                                                   @case 'else
                                                                   @case 'then))))]
                             [then
                              (comment :Some
                                       (if_case tail
                                                [_
                                                 (comment :Empty
                                                          (path:as_code context else then))]
                                                [_
                                                 (comment :Top
                                                          (.when# then
                                                                  {:Path/Let @then,then}
                                                                  (let' [[@then then] @then,then]
                                                                        (monad:let meta:monad
                                                                                   ['top,context (top context)
                                                                                    .let' [['top context] 'top,context]
                                                                                    'then (path:as_code context else then)
                                                                                    @case (generated_name "@case")
                                                                                    'else (if (path/case:more? tail)
                                                                                              (path/case:as_code path:as_code {:Top @case context} else tail)
                                                                                              (path:else else))]
                                                                                   (pure ('if_case# 'top
                                                                                                    (code:local @then) 'then
                                                                                                    @case 'else))))

                                                                  _
                                                                  (monad:let meta:monad
                                                                             ['top,context (top context)
                                                                              .let' [['top context] 'top,context]
                                                                              @case (generated_name "@case")
                                                                              'then (path:as_code {:Top @case context} else then)
                                                                              'else (if (path/case:more? tail)
                                                                                        (path/case:as_code path:as_code {:Top @case context} else tail)
                                                                                        (path:else else))]
                                                                             (pure ('if_case# 'top
                                                                                              @case 'then
                                                                                              @case 'else)))))]))]))

              else
              (failure "!!! path/case:as_code")))

(the' .private (switch:as_code as_code
                               path:as_code
                               context else it)
      (type (for_any (_ it)
                     (-> (-> it Code)
                         (-> (Stack Code) (Maybe Code) Path
                             (Meta Code))
                         (-> (Stack Code) (Maybe Code) (List [it Path])
                             (Meta Code)))))
      (monad:let meta:monad
                 ['top,context (top context)
                  .let' [['top context] 'top,context]
                  it (monad:each meta:monad
                                 (<| (function' (_ expectation,then))
                                     (let' [[expectation then] expectation,then])
                                     (monad:let meta:monad
                                                ['then (path:as_code context else then)]
                                                (pure (list (as_code expectation) 'then))))
                                 it)
                  'else (path:else else)
                  '_ (generated_name "'_")]
                 (pure (` (..when (, 'top)
                                  (,* (list:conjoint it))

                                  (, '_)
                                  (, 'else))))))

(the' .private (path:as_code context else it)
      (type (-> (Stack Code) (Maybe Code) Path
                (Meta Code)))
      (if_case it
               [it
                (comment :Path/Bit
                         (if_case it
                                  [it
                                   (monad:let meta:monad
                                              [.let' [[expectation then] (if_case it
                                                                                  [then
                                                                                   [false then]]
                                                                                  [then
                                                                                   [true then]])]
                                               'top,context (top context)
                                               .let' [['top context] 'top,context]
                                               'then (path:as_code context else then)
                                               'else (path:else else)]
                                              (pure (if expectation
                                                        ('if 'top
                                                             'then
                                                             'else)
                                                        ('if 'top
                                                             'else
                                                             'then))))]
                                  [false_then,true_then
                                   (let' [[false_then true_then] false_then,true_then]
                                         (monad:let meta:monad
                                                    ['top,context (top context)
                                                     .let' [['top context] 'top,context]
                                                     'false_then (path:as_code context else false_then)
                                                     'true_then (path:as_code context else true_then)]
                                                    (pure ('if 'top
                                                               'true_then
                                                               'false_then))))]))]
               [it
                (comment :Path/Natural
                         (switch:as_code code:natural
                                         path:as_code
                                         context else it))]
               [it
                (comment :Path/Integer
                         (switch:as_code code:integer
                                         path:as_code
                                         context else it))]
               [it
                (comment :Path/Revolution
                         (switch:as_code code:revolution
                                         path:as_code
                                         context else it))]
               [it
                (comment :Path/Real
                         (switch:as_code code:real
                                         path:as_code
                                         context else it))]
               [it
                (comment :Path/Text
                         (switch:as_code code:text
                                         path:as_code
                                         context else it))]
               [it
                (comment :Path/Alternative
                         (path/case:as_code path:as_code context else (list:as_stack it)))]
               [then
                (comment :Path/Pair
                         (.when# then
                                 {:Path/Let @left,then}
                                 (let' [[@left then] @left,then]
                                       (.when# then
                                               {:Path/Let @right,then}
                                               (let' [[@right then] @right,then]
                                                     (monad:let meta:monad
                                                                [.let' [@left (code:local @left)
                                                                        @right (code:local @right)]
                                                                 'top,context (top context)
                                                                 .let' [['top context] 'top,context]
                                                                 
                                                                 'then (path:as_code context else then)]
                                                                (pure ('let_pair [@left @right] 'top
                                                                                 'then))))
                                               
                                               _
                                               (monad:let meta:monad
                                                          [.let' [@left (code:local @left)]
                                                           @right (generated_name "@right")

                                                           'top,context (top context)
                                                           .let' [['top context] 'top,context]
                                                           
                                                           'then (path:as_code {:Top @right context} else then)]
                                                          (pure ('let_pair [@left @right] 'top
                                                                           'then)))))

                                 _
                                 (monad:let meta:monad
                                            [@left (generated_name "@left")
                                             @right (generated_name "@right")

                                             'top,context (top context)
                                             .let' [['top context] 'top,context]
                                             
                                             'then (path:as_code {:Top @left {:Top @right context}} else then)]
                                            (pure ('let_pair [@left @right] 'top
                                                             'then)))))]
               [it
                (comment :Path/List
                         (monad:let meta:monad
                                    [it (monad:each meta:monad
                                                    (<| (function' (_ size,then))
                                                        (let' [[size then] size,then])
                                                        (monad:let meta:monad
                                                                   ['then (path:as_code context else then)])
                                                        (pure (list (code:natural size) 'then)))
                                                    it)

                                     'top,context (top context)
                                     .let' [['top _] 'top,context]
                                     
                                     'else (path:else else)
                                     '_ (generated_name "'_")]
                                    (pure (` (..when (.list_size# (, 'top))
                                                     (,* (list:conjoint it))

                                                     (, '_)
                                                     (, 'else))))))]
               [item,then
                (comment :Path/Item
                         (let' [[item then] item,then]
                               (.when# then
                                       {:Path/Let local,then}
                                       (let' [[local then] local,then]
                                             (monad:let meta:monad
                                                        [.let' ['local (code:local local)]

                                                         'top,context (top context)
                                                         .let' [['top _] 'top,context]
                                                         
                                                         'then (path:as_code context else then)]
                                                        (pure ('let 'local (` (.list_item# (, (code:natural item)) (, 'top)))
                                                                    'then))))

                                       _
                                       (monad:let meta:monad
                                                  [@item (generated_name "@item")

                                                   'top,context (top context)
                                                   .let' [['top _] 'top,context]
                                                   
                                                   'then (path:as_code {:Top @item context} else then)]
                                                  (pure ('let @item (` (.list_item# (, (code:natural item)) (, 'top)))
                                                              'then))))))]
               [local,then
                (comment :Path/Let
                         (let' [[local then] local,then]
                               (monad:let meta:monad
                                          ['top,context (top context)
                                           .let' [['top context] 'top,context]
                                           then (path:as_code context else then)]
                                          (pure ('let (code:local local) 'top
                                                      then)))))]
               [old,new,then
                (comment :Path/Alias
                         (let' [[old new then] old,new,then]
                               (monad:let meta:monad
                                          [then (path:as_code context else then)]
                                          (pure ('let (code:local new) (code:local old)
                                                      then)))))]
               [then
                (comment :Path/Pop
                         (monad:let meta:monad
                                    ['top,context (top context)
                                     .let' [['top context] 'top,context]]
                                    (path:as_code context else then)))]
               [it
                (comment :Path/Body
                         (meta:pure it))]
               [left,right
                (comment :Path/Or
                         (let' [[left right] left,right]
                               (monad:let meta:monad
                                          ['else (path:as_code context else right)
                                           @else (generated_name "@else")
                                           'top,context (top context)
                                           .let' [['top _] 'top,context]
                                           'then (path:as_code context
                                                               {:Some (` ((, @else) []))}
                                                               left)]
                                          (pure ('let @else ('function {:None} (stack @else)
                                                                       'else)
                                                      'then)))))]
               ))

(<| (the' .public when
          Macro)
    (macro (_ tokens))
    (if_case (|> (?:and ?:any ?:rest)
                 (?:value tokens))
             [else
              (failure "")]
             ['term,branches
              (let' [['term branches] 'term,branches]
                    (monad:let meta:monad
                               [expansion (when_expansion branches)
                                '_ (generated_name "'_")]
                               (if_case (?:value expansion ?:when)
                                        [else
                                         (let' [by_default (monad:let meta:monad
                                                                      ['value (generated_name "'value")]
                                                                      (pure (list ('let 'value 'term
                                                                                        (` (..when (, 'value)
                                                                                                   (,* branches)))))))]
                                               (if_name 'term
                                                        (function' (_ @ @term)
                                                                   (let' [[the_module @term] @term]
                                                                         (if (text:= "" the_module)
                                                                             (if_case (|> (?:many (?:and ?:any ?:any))
                                                                                          (?:value expansion))
                                                                                      [else
                                                                                       (failure "")]
                                                                                      [every_branch
                                                                                       (monad:let meta:monad
                                                                                                  [every_path (monad:each meta:monad
                                                                                                                          (function' (_ pattern,body)
                                                                                                                                     (let' [[pattern body] pattern,body]
                                                                                                                                           (..path pattern {:Path/Body body})))
                                                                                                                          every_branch)
                                                                                                   'common (generated_name "'common")]
                                                                                                  (let' [[else every_then] (list:split 1 (list:in_reverse every_path))]
                                                                                                        (if_list else
                                                                                                                 [[else]
                                                                                                                  (if_case (is (Maybe Path)
                                                                                                                               (monad:mix maybe:monad
                                                                                                                                          (..path:or (code:as_text 'common))
                                                                                                                                          every_then
                                                                                                                                          else))
                                                                                                                           [else
                                                                                                                            (failure "")]
                                                                                                                           [path
                                                                                                                            (monad:let meta:monad
                                                                                                                                       ['path (path:as_code (stack (code:local @term))
                                                                                                                                                            {:None}
                                                                                                                                                            path)]
                                                                                                                                       (pure (list 'path)))])]
                                                                                                                 (failure ""))))])
                                                                             by_default)))
                                                        (function' (_ _)
                                                                   by_default)))]
                                        [the_scenario
                                         (if_case the_scenario
                                                  ['then,'else
                                                   (comment :When/Complete_If
                                                            (let' [['then 'else] 'then,'else]
                                                                  (pure (list ('if 'term 'then 'else)))))]
                                                  [case,'then,variable,'else
                                                   (comment :When/Partial_If
                                                            (let' [[case 'then variable,'else] case,'then,variable,'else
                                                                   [variable 'else] variable,'else]
                                                                  (pure (list (let' ['term (` (..is ..Bit
                                                                                                    (, 'term)))]
                                                                                    (.if# case
                                                                                          ('if 'term
                                                                                               'then
                                                                                               (` (.let# 0b
                                                                                                         (.function# (, (code:local variable)) (, (code:local variable))
                                                                                                                     (, 'else)))))
                                                                                          ('if 'term
                                                                                               (` (.let# 1b
                                                                                                         (.function# (, (code:local variable)) (, (code:local variable))
                                                                                                                     (, 'then))))
                                                                                               'else)))))))]
                                                  [every_then,variable,'else
                                                   (comment :When/If_Natural
                                                            (let' [[every_then variable 'else] every_then,variable,'else]
                                                                  (if_natural '_ 'term every_then variable 'else)))]
                                                  [every_then,variable,'else
                                                   (comment :When/If_Integer
                                                            (let' [[every_then variable 'else] every_then,variable,'else]
                                                                  (if_integer '_ 'term every_then variable 'else)))]
                                                  [every_then,variable,'else
                                                   (comment :When/If_Revolution
                                                            (let' [[every_then variable 'else] every_then,variable,'else]
                                                                  (if_revolution '_ 'term every_then variable 'else)))]
                                                  [every_then,variable,'else
                                                   (comment :When/If_Real
                                                            (let' [[every_then variable 'else] every_then,variable,'else]
                                                                  (if_real '_ 'term every_then variable 'else)))]
                                                  [every_then,variable,'else
                                                   (comment :When/If_Text
                                                            (let' [[every_then variable 'else] every_then,variable,'else]
                                                                  (if_text '_ 'term every_then variable 'else)))]
                                                  [condition_of_then,variable_of_then,'then,condition_of_else,variable_of_else,'body_of_else
                                                   (comment :When/Complete_Binary_Of_Alternative
                                                            (let' [[condition_of_then,variable_of_then,'then condition_of_else,variable_of_else,'body_of_else] condition_of_then,variable_of_then,'then,condition_of_else,variable_of_else,'body_of_else
                                                                   
                                                                   [condition_of_then,variable_of_then 'then] condition_of_then,variable_of_then,'then
                                                                   [condition_of_then variable_of_then] condition_of_then,variable_of_then

                                                                   [condition_of_else,variable_of_else 'body_of_else] condition_of_else,variable_of_else,'body_of_else
                                                                   [condition_of_else variable_of_else] condition_of_else,variable_of_else]
                                                                  (if (bit:= condition_of_then condition_of_else)
                                                                      (failure "Redundancy in case patterns.")
                                                                      (pure (list (if condition_of_then
                                                                                      ('if_case# 'term
                                                                                                 (code:local variable_of_else) 'body_of_else
                                                                                                 (code:local variable_of_then) 'then)
                                                                                      ('if_case# 'term
                                                                                                 (code:local variable_of_then) 'then
                                                                                                 (code:local variable_of_else) 'body_of_else)))))))]
                                                  [condition_of_then,variable_of_then,'then,variable_of_else,'body_of_else
                                                   (comment :When/Partial_Binary_Of_Alternative
                                                            (let' [[condition_of_then,variable_of_then,'then variable_of_else,'body_of_else] condition_of_then,variable_of_then,'then,variable_of_else,'body_of_else

                                                                   [condition_of_then,variable_of_then 'then] condition_of_then,variable_of_then,'then
                                                                   [condition_of_then variable_of_then] condition_of_then,variable_of_then
                                                                   
                                                                   [variable_of_else 'body_of_else] variable_of_else,'body_of_else]
                                                                  (monad:let meta:monad
                                                                             ['it (generated_name "'it")
                                                                              '_ (generated_name "'_")
                                                                              .let' ['else ('let (code:local variable_of_else) 'it
                                                                                                 'body_of_else)]]
                                                                             (pure (list ('let 'it 'term
                                                                                               (if condition_of_then
                                                                                                   ('if_case# 'it
                                                                                                              '_ 'else
                                                                                                              (code:local variable_of_then) 'then)
                                                                                                   ('if_case# 'it
                                                                                                              (code:local variable_of_then) 'then
                                                                                                              '_ 'else))))))))]
                                                  [head,tail,else
                                                   (comment :When/Complete_Of_Alternative
                                                            (let' [[head tail else] head,tail,else]
                                                                  (monad:let meta:monad
                                                                             [tag_of_head (|> head pair:left pair:left tag_as_label)
                                                                              every_tag (is (type (Meta (List [Label (List Bundle) Code])))
                                                                                            (monad:each meta:monad
                                                                                                        (function' (_ it)
                                                                                                                   (monad:let meta:monad
                                                                                                                              [.let' [[tag,content body] it
                                                                                                                                      [tag content] tag,content]
                                                                                                                               label (tag_as_label tag)
                                                                                                                               .let' [[exported? label] label]]
                                                                                                                              (pure [label content body])))
                                                                                                        (.list_composite# (list head) tail)))
                                                                              .let' [expectation_for_type (pair:right (pair:right tag_of_head))
                                                                                     expectation_for_arity (arity_of_label (pair:right tag_of_head))
                                                                                     in_order (is (type (Property_List [(List Bundle) Code]))
                                                                                                  (list:mix (function' (_ it)
                                                                                                                       (let' [[label content body] it]
                                                                                                                             (property:with (index_of_label label)
                                                                                                                                            [content body])))
                                                                                                            every_tag
                                                                                                            (list)))]]
                                                                             (if (and (not (natural:= 1 expectation_for_arity))
                                                                                      (list:every? (function' (_ tag)
                                                                                                              (type:= expectation_for_type
                                                                                                                      (pair:right (pair:left tag))))
                                                                                                   every_tag))
                                                                                 (if_case else
                                                                                          [else
                                                                                           (if (natural:= expectation_for_arity (.list_size# in_order))
                                                                                               (if_name 'term
                                                                                                        (function' (_ _ _)
                                                                                                                   (monad:let meta:monad
                                                                                                                              ['complete_of_case (complete_of_case in_order 'term 0)]
                                                                                                                              (pure (list 'complete_of_case))))
                                                                                                        (function' (_ _)
                                                                                                                   (monad:let meta:monad
                                                                                                                              ['local (generated_name "'local")
                                                                                                                               'complete_of_case (complete_of_case in_order 'local 0)]
                                                                                                                              (pure (list ('let 'local 'term
                                                                                                                                                'complete_of_case))))))
                                                                                               (failure ""))]
                                                                                          [local_of_else,body_of_else
                                                                                           (let' [[local_of_else body_of_else] local_of_else,body_of_else]
                                                                                                 (if (natural:= expectation_for_arity (.list_size# in_order))
                                                                                                     (failure "")
                                                                                                     (if_name 'term
                                                                                                              (function' (_ @ name_of_'term)
                                                                                                                         (monad:let meta:monad
                                                                                                                                    [type_of_input (type_of_reference name_of_'term)
                                                                                                                                     .let' ['local 'term]
                                                                                                                                     'else (generated_name "'else")
                                                                                                                                     type_of_output type:expectation
                                                                                                                                     'partial_of_case (partial_of_case expectation_for_arity in_order 'else 'term 'local 0)]
                                                                                                                                    (pure (list ('let 'else (` (..else (, (let' ['local_of_else (code:local local_of_else)]
                                                                                                                                                                                ('function {:None} (stack 'local_of_else)
                                                                                                                                                                                           body_of_else)))
                                                                                                                                                                       (, 'term)))
                                                                                                                                                      'partial_of_case)))))
                                                                                                              (function' (_ _)
                                                                                                                         (monad:let meta:monad
                                                                                                                                    ['local (generated_name "'local")]
                                                                                                                                    (pure (list ('let 'local 'term
                                                                                                                                                      (` (..when (, 'local)
                                                                                                                                                                 (,* branches)))))))))))])
                                                                                 (failure "")))))]
                                                  [slot_of_head,value_of_head,tail,'body
                                                   (comment :When/Simple_Record
