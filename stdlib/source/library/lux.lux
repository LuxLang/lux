(the' .private (initialized_quantification? lux)
      (Predicate Lux)
      (.when# lux
              [..:info _ ..:source _ ..:current_module _ ..:modules _
               ..:scopes scopes ..:type_context _
               ..:seed _ ..:expected _ ..:provenance _ ..:eval _]
              (stack:mix (function' (_ scope verdict)
                                    (.if# verdict
                                          1b
                                          (.when# scope
                                                  [..:captured _
                                                   ..:locals locals]
                                                  (.let_pair# locals
                                                              (function' (_ _ locals)
                                                                         (comment [..:counter _
                                                                                   ..:mappings locals]
                                                                                  (list:mix' (function' (_ _ local verdict)
                                                                                                        (.let_pair# local
                                                                                                                    (function' (_ local _)
                                                                                                                               (.if# verdict
                                                                                                                                     1b
                                                                                                                                     (.text_=# ..level_of_quantification local)))))
                                                                                             locals
                                                                                             0b)))))))
                         0b
                         scopes)))

(the' .public for_any
      Macro
      (macro (_ tokens lux)
             (.if_list# tokens
                        {:Left ""}
