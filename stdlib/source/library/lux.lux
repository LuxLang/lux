(the' .private (pairs xs)
      (for_any (_ it)
               (-> ($ Stack it)
                   ($ Maybe ($ Stack (Tuple it it)))))
      (.if_case# xs
                 (function' (_ _)
                            {:Some {:Empty}})
                 (function' (_ x,y,xs')
                            (.let_pair# x,y,xs'
                                        (function' (_ x y,xs')
                                                   (.if_case# y,xs'
                                                              (function' (_ _)
                                                                         {:None})
                                                              (function' (_ y,xs')
                                                                         (.let_pair# y,xs'
                                                                                     (function' (_ y xs')
                                                                                                (.if_case# (pairs xs')
                                                                                                           (function' (_ _)
                                                                                                                      {:None})
                                                                                                           (function' (_ tail)
                                                                                                                      {:Some {:Top [x y] tail}})))))))))))

