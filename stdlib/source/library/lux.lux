(comment "https://en.wikipedia.org/wiki/Operator_associativity"
         (the' .public left_associative
               Macro
               (macro (_ tokens)
                      (let' [size (.list_size# tokens)]
                            (.if# (.i64_=# 0 size)
                                  (failure "")
                                  (.if# (.i64_=# 1 size)
                                        (failure "")
                                        (.if# (.i64_=# 2 size)
                                              (meta:pure (list (.list_item# 2 tokens)))
                                              (comment "else"
