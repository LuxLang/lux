                                                      (, expression)))))))

          else
          (..failure "")))

(the ?:method
     (Projection [Code Text])
     (?:form (?:after (?:this_name [..prelude "is#"])
                      (?:and ?:any
                             ?:local))))

(<| (comment "[Scrap your type classes](https://www.haskellforall.com/2012/05/scrap-your-type-classes.html)")
    (the .public Interface)
    (macro (_ tokens))
    (monad:let meta:monad
               [methods' (monad:each meta:monad complete_expansion tokens)]
               (when (?:value (list:conjoint methods')
                              (?:some ?:method))
                     {:Some methods}
                     (pure (list (` (..Tuple (,* (list:each pair:left methods))))
                                 (code:tuple (list:each (|>> pair:right code:text) methods))))

                     {:None}
                     (failure ""))))

(<| (the .public Rec)
    (let [recursive_type (is (-> Code Code Text
                                 (Change Code))
                             (function (recursive_type 'self 'dummy name body)
                                       (` {..:Reification (..Nominal "")
                                                          (.for_any ((, 'self) (, 'dummy))
                                                                    (, ('let (code:local name) (` {..:Reification (..Nominal "") (, 'self)})
                                                                             body)))})))])
    (macro (_ tokens))
    (when tokens
          (list {:Name _ ["" name]} body)
          (monad:let meta:monad
                     [body' (complete_expansion body)
                      'self (generated_name "'self")
                      'dummy (generated_name "'dummy")]
                     (when body'
                           (list body' labels)
                           (pure (list (recursive_type 'self 'dummy name body')
                                       labels))

                           (list body')
                           (pure (list (recursive_type 'self 'dummy name body')))

                           _
                           (failure "")))

          else
          (failure "")))

(with_template [<type>]
               [(the .public <type>
                     Type
                     (let [[_ proper] (name <type>)]
