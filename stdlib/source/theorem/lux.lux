(.using
 [library
  [["/"] lux (.only)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]
   [logic
    [[0] bit (.only)
     [["//" 1] \\theorem]]]
   [macro
    [[0] expansion]]]])

(/.<| (/.secret [it])
      (expansion.let [it' (/.secret [it] it)])
      (_.the .public secret
             (?.= /.Bit
                  (/.let [it /.false
                          it' /.true]
                         (bit.= it it'))
                  /.false))
      (!.= (/.<| (by.let in.any)
                 (by.let in.any)
                 (/.all by.and
                        (in.of in.any (/.list in.any by.definition))
                        (by.= //bit.complementation_of_=)))
           in.any))
