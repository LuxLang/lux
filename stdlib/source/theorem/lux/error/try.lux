(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" functor
     ["//[1]" \\theorem]]]
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]]]
 [\\library
  ["[0]" / (.only)
   ["/[1]" //]]]
 ["[0]" //
  [//
   ["[1][0]" function]
   [logic
    ["[1][0]" bit]]
   [data
    ["[1][0]" case]]]])

(the axiom_of_identity
     (<| (//function.induction "it")
         (//case.induction "it"
                           ["it:L" (!.= (all by.and
                                             (by.of by.definition (list in.any in.any))
                                             (by.if_case in.any
                                                         by.left
                                                         in.any))
                                        (all by.and
                                             (by.of by.definition (list in.any))
                                             in.any))]
                           ["it:R" (!.= (all by.and
                                             (by.of by.definition (list in.any in.any))
                                             (by.if_case in.any
                                                         by.right
                                                         in.any)
                                             (in.case by.right (by.of by.definition (list in.any))))
                                        (all by.and
                                             (by.of by.definition (list in.any))
                                             in.any))])))

(the axiom_of_composition
     (<| (//function.induction "it")
         (//case.induction "it"
                           ["it:L" (!.= (all by.and
                                             (by.of by.definition (list in.any in.any in.any))
                                             (by.of by.definition (list in.any in.any))
                                             (by.if_case (all by.and
                                                              (by.of by.definition (list in.any in.any))
                                                              (by.if_case in.any
                                                                          by.left
                                                                          in.any))
                                                         by.left
                                                         in.any))
                                        (all by.and
                                             (by.of by.definition (list in.any in.any))
                                             (by.if_case in.any
                                                         by.left
                                                         in.any)))]
                           ["it:R" (!.= (all by.and
                                             (by.of by.definition (list in.any in.any in.any))
                                             (by.of by.definition (list in.any in.any))
                                             (by.if_case (all by.and
                                                              (by.of by.definition (list in.any in.any))
                                                              (by.if_case in.any
                                                                          by.right
                                                                          in.any))
                                                         by.right
                                                         in.any))
                                        (all by.and
                                             (by.of by.definition (list in.any in.any))
                                             (by.if_case in.any
                                                         by.right
                                                         in.any)
                                             (in.case by.right (by.of by.definition (list in.any in.any in.any)))))])))

(_.the .public functor
       (//functor.system /.functor)
       (!.and ..axiom_of_identity
              ..axiom_of_composition))

(_.the .public as_maybe|:Failure
       (?.let [any]
              [error Text]
              (?.= (Maybe any)
                   (/.as_maybe {/.:Failure error})
                   {.:None}))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (by.if_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public as_maybe|:Success
       (?.let [any]
              [it any]
              (?.= (Maybe any)
                   (/.as_maybe {/.:Success it})
                   {.:Some it}))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (by.if_case in.any
                             by.right
                             in.any))
            in.any))

(_.the .public of_maybe|:None
       (?.let [any]
              [error Text]
              (?.= (/.Try any)
                   (/.of_maybe error {.:None})
                   {/.:Failure error}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.if_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public of_maybe|:Some
       (?.let [any]
              [it any
               error Text]
              (?.= (Maybe any)
                   (/.of_maybe error {.:Some it})
                   {/.:Success it}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.if_case in.any
                             by.right
                             in.any))
            in.any))

(_.the .public else|:Failure
       (?.let [any]
              [it any
               error Text]
              (?.= (/.else it {/.:Failure error})
                   it))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public else|:Success
       (?.let [any]
              [it any
               else any]
              (?.= (/.else else {/.:Success it})
                   it))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.right
                                in.any))
            in.any))

(_.the .public whether|false
       (?.let [any]
              [it (/.Try any)]
              (?.= (/.Try any)
                   (/.whether false it)
                   {/.:Failure //.not_valid}))
       (!.= (by.if by.definition in.any)
            in.any))

(_.the .public whether|true
       (?.let [any]
              [it (/.Try any)]
              (?.= (/.Try any)
                   (/.whether .true it)
                   it))
       (!.= (by.= //bit.if_true)
            in.any))

(_.the .public and/or|:Failure
       (?.let [any]
              [error Text
               else (/.Try any)]
              (?.= (/.Try any)
                   (/.and/or {/.:Failure error} else)
                   else))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public and/or|:Success
       (?.let [any]
              [error Text
               it any
               else (/.Try any)]
              (?.= (/.Try any)
                   (/.and/or {/.:Success it} else)
                   {/.:Success it}))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.right
                                in.any))
            in.any))

(_.the .public idempotency_of_as
       (?.let [any]
              [error Text]
              (?.= (/.Try any)
                   (/.as error {/.:Failure error})
                   {/.:Failure error}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.if_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public as|:Failure
       (?.let [any]
              [it any
               old Text
               new Text]
              (?.= (/.Try any)
                   (/.as new {/.:Failure old})
                   {/.:Failure new}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.if_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public as|:Success
       (?.let [any]
              [it any
               error Text]
              (?.= (/.Try any)
                   (/.as error {/.:Success it})
                   {/.:Success it}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.if_case in.any
                             by.right
                             in.any))
            in.any))

(_.the .public as_either|:Failure
       (?.let [any_left any_right]
              [error Text
               left any_left]
              (?.= (.Either any_left any_right)
                   (/.as_either left {/.:Failure error})
                   {.:Left left}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.if_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public as_either|:Success
       (?.let [any_left any_right]
              [left any_left
               right any_right]
              (?.= (.Either any_left any_right)
                   (/.as_either left {/.:Success right})
                   {.:Right right}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.if_case in.any
                             by.right
                             in.any))
            in.any))

(_.the .public of_either|:Left
       (?.let [any_left any_right]
              [error Text
               left any_left]
              (?.= (/.Try any_right)
                   (/.of_either error {.:Left left})
                   {/.:Failure error}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.if_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public of_either|:Right
       (?.let [any]
              [error Text
               it any]
              (?.= (/.Try any)
                   (/.of_either error {.:Right it})
                   {/.:Success it}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.if_case in.any
                             by.right
                             in.any))
            in.any))

(_.the .public if|:Failure
       (?.let [any]
              [error Text
               then any
               else any]
              (?.= (/.if [it {/.:Failure error}]
                         then
                         else)
                   else))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public if|:Success
       (?.let [any any_premise]
              [some any_premise
               then (-> any_premise any)
               else any]
              (?.= (/.if [it {/.:Success some}]
                         (then it)
                         else)
                   (then some)))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.right
                                (in.of in.any (list in.any))))
            in.any))
