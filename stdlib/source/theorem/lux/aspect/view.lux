(.using
 [library
  [lux (.except as)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]
    [[0] term]
    [[0] axiom]]
   [[0] function
    [["//" 1] \\theorem]]
   [data
    [[0] text]
    [collection
     [[0] dictionary]]]
   [abstract
    [[0] monad]]
   [error
    [[0] try]
    [[0] exception]]
   [compiler
    [language
     [lux
      [[0] analysis]]]]
   [meta
    [[0] provenance]]]]
 [["/"] \\library])

(<| (the .public (induction $variable [$of $as]
                            if_property
                            context it)
         (-> induction.Variable [induction.Variable induction.Variable]
             (Change !.Proof)))
    (monad.let try.monad
               [.let [registry (induction.registry it)]
                @variable (dictionary.value $variable registry)
                .let [@of (induction.next_variable registry)
                      @as (++ @of)
                      registry (dictionary.lacks $variable registry)]])
    (if (dictionary.in_domain? registry $of)
        (exception.except induction.name_is_already_in_use [registry $of])

        (and/or (dictionary.in_domain? registry $as)
                (text.= $of $as))
        (exception.except induction.name_is_already_in_use [registry $as]))
    (comment "else")
    (|> it
        (induction.in_proposition (|> (analysis.reified [(analysis.constant provenance.dummy (name /.new))
                                                         (list (term.new provenance.dummy @of $of)
                                                               (term.new provenance.dummy @as $as))])
                                      (by.substitution_of_variable @variable)))
        (if_property context)))

(_.the .public in_reverse
       (?.let [context analogy]
              [of (/.Of context analogy)
               as (/.As context analogy)]
              (?.= (/.View analogy context)
                   (/.in_reverse (/.new of as))
                   (/.new as of)))
       (!.= (all by.and
                 (by.of by.definition (list (by.of by.definition (list in.any in.any))))
                 (<| (by.let_pair in.any)
                     in.any))
            in.any))

(_.the .public in_reverse_is_an_involution
       (?.let [context analogy]
              [of (/.Of context analogy)
               as (/.As context analogy)]
              (?.= (/.View context analogy)
                   (/.in_reverse (/.in_reverse (/.new of as)))
                   (/.new of as)))
       (!.= (all by.and
                 (in.of in.any (list (by.= ..in_reverse)))
                 (by.= ..in_reverse))
            in.any))

(<| (axiom.the .public (recuperation /:Context /:it))
    (?.let [it /:Context])
    (?.= /:Context
         (/.of /:it (/.as /:it it))
         it))

(<| (axiom.the .public (visitation /:Analogy /:it))
    (?.let [it /:Analogy])
    (?.= /:Analogy
         (/.as /:it (/.of /:it it))
         it))

(<| (axiom.the .public (system /:Context /:Analogy /:it))
    (all ?.and
         (..recuperation /:Context /:it)
         (..visitation /:Analogy /:it)))

(_.the of
       (?.let [context analogy]
              [of (/.Of context analogy)
               as (/.As context analogy)]
              (?.= (/.of (/.new of as))
                   of))
       (!.= (all by.and
                 (by.of by.definition (list (by.of by.definition (list in.any in.any))))
                 (<| (by.let_pair in.any)
                     in.any))
            in.any))

(_.the as
       (?.let [context analogy]
              [of (/.Of context analogy)
               as (/.As context analogy)]
              (?.= (/.as (/.new of as))
                   as))
       (_.proof ..of))

(_.the .public identity
       (?.let [It]
              []
              (..system It It /.identity))
       (let [proof (<| (function (_ inner outer))
                       (!.= (all by.and
                                 (in.of in.any (list by.definition
                                                     (in.of in.any (list by.definition in.any))))
                                 (in.of (by.= outer) (list (in.of (by.= inner) (list in.any))))
                                 (by.of by.definition (list (by.of by.definition (list in.any)))))
                            in.any))]
            (all !.and
                 (proof ..as ..of)
                 (proof ..of ..as)
                 )))

(<| (_.the .public left_identity
           (?.let [Context Analogy]
                  [it (/.View Context Analogy)]
                  (?.= (/.View Context Analogy)
                       (/.composite /.identity it)
                       it)))
    (..induction "it"
                 ["it:of" "it:as"])
    (!.= (all by.and
              (by.of by.definition (list by.definition in.any))
              (in.of in.any (list (all by.and
                                       (in.of in.any (list (by.= ..of)
                                                           (by.= ..of)))
                                       (by.= //function.left_identity))
                                  (all by.and
                                       (in.of in.any (list (by.= ..as)
                                                           (by.= ..as)))
                                       (by.= //function.right_identity)))))
         in.any))

(<| (_.the .public right_identity
           (?.let [Context Analogy]
                  [it (/.View Context Analogy)]
                  (?.= (/.View Context Analogy)
                       (/.composite it /.identity)
                       it)))
    (..induction "it"
                 ["it:of" "it:as"])
    (!.= (all by.and
              (by.of by.definition (list in.any by.definition))
              (in.of in.any (list (all by.and
                                       (in.of in.any (list (by.= ..of)
                                                           (by.= ..of)))
                                       (by.= //function.right_identity))
                                  (all by.and
                                       (in.of in.any (list (by.= ..as)
                                                           (by.= ..as)))
                                       (by.= //function.left_identity)))))
         in.any))

(_.the .public associativity
       (?.let [Context Context' Analogy' Analogy]
              [outer (/.View Context Context')
               middle (/.View Context' Analogy')
               inner (/.View Analogy' Analogy)]
              (?.= (/.View Context Analogy)
                   (/.composite (/.composite outer middle) inner)
                   (/.composite outer (/.composite middle inner))))
       (!.= (all by.and
                 (by.of by.definition (list (by.of by.definition (list in.any in.any))
                                            in.any))
                 (in.of in.any (list (all by.and
                                          (in.of in.any (list (by.= ..of)
                                                              in.any))
                                          (by.= //function.associativity_of_composite))
                                     (in.of in.any (list in.any
                                                         (by.= ..as))))))
            (all by.and
                 (by.of by.definition (list in.any
                                            (by.of by.definition (list in.any in.any))))
                 (in.of in.any (list (in.of in.any (list in.any
                                                         (by.= ..of)))
                                     (all by.and
                                          (in.of in.any (list (by.= ..as)
                                                              in.any))
                                          (by.= //function.associativity_of_composite)))))))

(_.the .public with_identity
       (?.let [It]
              [change (Change It)]
              (?.= (Change It)
                   (/.with /.identity change)
                   change))
       (<| (//function.induction "it")
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any in.any))
                     (in.of in.any (list by.definition (in.of in.any (list (in.of in.any (list by.definition in.any))))))
                     (in.of (by.= ..of) (list (in.of in.any (list (in.of (by.= ..as) (list in.any))))))
                     (by.of by.definition (list (in.of in.any (list (by.of by.definition (list in.any)))))))
                in.any)))
