(.using
 [library
  [lux (.except if)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]
    [["if"] hypothesis]
    [[0] term]
    [[0] axiom]]
   [data
    [[0] text]
    [collection
     [[0] dictionary]]]
   [abstract
    [[0] monad]]
   [error
    [[0] try]
    [[0] exception]]
   [compiler
    [language
     [lux
      [[0] analysis]]]]
   [meta
    [[0] provenance]]
   [[0] function (.only)
    [["//" 1] \\theorem]]]]
 [["/"] \\library])

(<| (the .public (induction $variable [$if $some]
                            if_property
                            context it)
         (-> induction.Variable [induction.Variable induction.Variable]
             (Change !.Proof)))
    (monad.let try.monad
               [.let [registry (induction.registry it)]
                @variable (dictionary.value $variable registry)
                .let [@if (induction.next_variable registry)
                      @some (++ @if)
                      registry (dictionary.lacks $variable registry)]])
    (.if (dictionary.in_domain? registry $if)
         (exception.except induction.name_is_already_in_use [registry $if])

         (and/or (dictionary.in_domain? registry $some)
                 (text.= $if $some))
         (exception.except induction.name_is_already_in_use [registry $some]))
    (comment "else")
    (|> it
        (induction.in_proposition (|> (analysis.reified [(analysis.constant provenance.dummy (name /.new))
                                                         (list (term.new provenance.dummy @if $if)
                                                               (term.new provenance.dummy @some $some))])
                                      (by.substitution_of_variable @variable)))
        (if_property context)))

(<| (axiom.the .public (injection /:Context /:Case /:it))
    (?.let [case /:Case])
    (?.= (Or /:Context /:Case)
         (/.if /:it (/.some /:it case))
         {.:Right case}))

(<| (axiom.the .public (system /:Context /:Case /:it))
    (all ?.and
         (..injection /:Context /:Case /:it)))

(_.the .public if_identity
       (?.let [It]
              [it It]
              (?.= (Or It It)
                   (/.if /.identity it)
                   {.:Right it}))
       (!.= (all by.and
                 (in.of (all by.and
                             (by.of by.definition (list by.definition))
                             (<| (by.let_pair (by.of by.definition (list in.any in.any)))
                                 in.any))
                        (list in.any))
                 (by.of in.any (list in.any)))
            in.any))

(_.the .public some_identity
       (?.let [It]
              [it It]
              (?.= It
                   (/.some /.identity it)
                   it))
       (!.= (all by.and
                 (in.of (all by.and
                             (by.of by.definition (list by.definition))
                             (<| (by.let_pair (by.of by.definition (list in.any in.any)))
                                 in.any))
                        (list in.any))
                 (by.of by.definition (list in.any)))
            in.any))

(_.the .public identity
       (?.let [It]
              []
              (..system It It /.identity))
       (!.= (all by.and
                 (in.of in.any (list in.any (by.= ..some_identity)))
                 (by.= ..if_identity))
            in.any))

(_.the :if
       (?.let [Context Case]
              [if (/.If Context Case)
               some (/.Some Context Case)]
              (?.= (/.If Context Case)
                   (/.if (/.new if some))
                   if))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.let_pair (by.of by.definition (list in.any in.any)))
                     in.any))
            in.any))

(_.the :some
       (?.let [Context Case]
              [if (/.If Context Case)
               some (/.Some Context Case)]
              (?.= (/.Some Context Case)
                   (/.some (/.new if some))
                   some))
       (_.proof ..:if))

(<| (axiom.the .public (if /:Context /:Case /:it))
    (?.let [it /:Context
            case /:Case])
    (?.or (?.= (Or /:Context /:Case)
               (/:it it)
               {.:Left it})
          (?.= (Or /:Context /:Case)
               (/:it it)
               {.:Right case})))

(_.the .public intermediation
       (<| (?.let [Context Case]
                  [context Context
                   if (/.If Context Case)])
           (?.if (..if Context Case if))
           (?.= (<| (function (_ it))
                    (when (if it)
                          {.:Left _}
                          {.:Left it}

                          {.:Right case}
                          {.:Right case}))
                if))
       (<| !.if (function (_ is_if))
           (//function.induction "it")
           (if.if is_if
                  (<| (function (_ is_context))
                      (!.= (by.of (<| in.function
                                      (by.let (by.=' is_context))
                                      (by.if_case in.any
                                                  by.left)
                                      in.any)
                                  (list in.any))
                           (by.=' is_context)))
                  (<| (function (_ is_case))
                      (!.= (by.of (<| in.function
                                      (by.let (by.=' is_case))
                                      (by.if_case in.any
                                                  by.right)
                                      in.any)
                                  (list in.any))
                           (by.=' is_case))))))

(comment (<| (_.the .public left_identity
                    (<| (?.let [Context Case]
                               [if (/.If Context Case)
                                some (/.Some Context Case)])
                        (?.if (..if Context Case if))
                        (?.= (/.Case Context Case)
                             (/.composite /.identity (/.new if some))
                             (/.new if some))))
             (<| !.if (function (_ is_if))
                 (!.= (all by.and
                           (by.of by.definition (list in.any in.any))
                           (in.of in.any (list (<| in.function
                                                   (by.let (by.= ..if_identity))
                                                   (by.if_case in.any
                                                               by.right)
                                                   (by.let in.any)
                                                   (in.if_case (in.of (by.= ..:if) (list in.any))
                                                               in.any
                                                               in.any))
                                               (all by.and
                                                    (in.of in.any (list (all by.and
                                                                             (in.of in.any (list by.definition))
                                                                             (by.= ..:some))
                                                                        (by.= ..:some)))
                                                    (by.= //function.left_identity)))))
                      in.any)))

         (the _ []))
