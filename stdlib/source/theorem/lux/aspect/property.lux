(.using
 [library
  [lux (.except its has revised)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]
    [["if"] hypothesis]
    [[0] term]
    [[0] axiom]]
   [data
    [[0] pair
     [["//" 1] \\theorem]]
    [[0] text]
    [collection
     [[0] dictionary]]]
   [[0] function (.only)
    [["//" 1] \\theorem]]
   [abstract
    [[0] monad]]
   [error
    [[0] try]
    [[0] exception]]
   [compiler
    [language
     [lux
      [[0] analysis]]]]
   [meta
    [[0] provenance]]]]
 [["/"] \\library])

(the .public (induction name_of_variable [name_of_its name_of_has]
                        if_property
                        context it)
     (-> induction.Variable [induction.Variable induction.Variable]
         (Change !.Proof))
     (monad.let try.monad
                [.let [registry (induction.registry it)]
                 register_of_variable (dictionary.value name_of_variable registry)
                 .let [register_of_its (induction.next_variable registry)
                       register_of_has (++ register_of_its)
                       registry (dictionary.lacks name_of_variable registry)]]
                (if (dictionary.in_domain? registry name_of_its)
                    (exception.except induction.name_is_already_in_use [registry name_of_its])

                    (and/or (dictionary.in_domain? registry name_of_has)
                            (text.= name_of_its name_of_has))
                    (exception.except induction.name_is_already_in_use [registry name_of_has])

                    (comment "else"
                             (|> it
                                 (induction.in_proposition (|> (analysis.reified [(analysis.constant provenance.dummy (name /.new))
                                                                                  (list (term.new provenance.dummy register_of_its name_of_its)
                                                                                        (term.new provenance.dummy register_of_has name_of_has))])
                                                               (by.substitution_of_variable register_of_variable)))
                                 (if_property context))))))

(_.the its
       (?.let [context analogy]
              [its (/.Its context analogy)
               has (/.Has context analogy)]
              (?.= (/.its (/.new its has))
                   its))
       (!.= (all by.and
                 (by.of by.definition (list (by.of by.definition (list in.any in.any))))
                 (<| (by.let_pair in.any)
                     in.any))
            in.any))

(<| (axiom.the .public (acquisition /:Context /:Focus /:it))
    (?.let [context /:Context
            focus /:Focus])
    (?.= /:Focus
         (/.its /:it (/.has /:it focus context))
         focus))

(<| (axiom.the .public (alteration /:Context /:Focus /:it))
    (?.let [context /:Context])
    (?.= /:Context
         (/.has /:it (/.its /:it context) context)
         context))

(<| (axiom.the .public (system /:Context /:Focus /:it))
    (all ?.and
         (..acquisition /:Context /:Focus /:it)
         (..alteration /:Context /:Focus /:it)))

(_.the .public its_identity
       (?.let [It]
              [it It]
              (?.= It
                   (/.its /.identity it)
                   it))
       (!.= (by.of (all by.and
                        (by.of by.definition (list by.definition))
                        (<| (by.let_pair (by.of by.definition (list in.any in.any)))
                            in.any)
                        by.definition)
                   (list in.any))
            in.any))

(_.the .public has_identity
       (?.let [Context]
              [context Context
               focus Context]
              (?.= Context
                   (/.has /.identity focus context)
                   focus))
       (!.= (all by.and
                 (by.of by.definition (list by.definition
                                            in.any
                                            in.any))
                 (in.of (<| (by.let_pair (by.of by.definition (list in.any in.any)))
                            in.any)
                        (list in.any))
                 (by.= //pair.left))
            in.any))

(_.the .public identity
       (?.let [It]
              []
              (..system It It /.identity))
       (all !.and
            (!.= (all by.and
                      (in.of in.any (list in.any
                                          (all by.and
                                               (by.of by.definition (list by.definition
                                                                          in.any
                                                                          in.any))
                                               (in.of (<| (by.let_pair (by.of by.definition (list in.any in.any)))
                                                          in.any)
                                                      (list in.any))
                                               (by.= //pair.left))))
                      (by.= ..its_identity))
                 in.any)
            (!.= (all by.and
                      (in.of in.any (list in.any
                                          (by.= ..its_identity)
                                          in.any))
                      (by.= ..has_identity))
                 in.any)
            ))

(_.the .public revised
       (<| (?.let [Context Focus]
                  [context Context
                   property (/.Property Context Focus)])
           (?.if (..system Context Focus property))
           (?.= Context
                (/.revised property function.identity context)
                context))
       (<| !.if (function (_ is_property))
           if.let [is_property
                   (if.and if.any if.any)]
           (function (_ [it:acquisition it:alteration]))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any in.any))
                     (in.of in.any (list in.any
                                         (by.= //function.identity)
                                         in.any))
                     (by.=' it:alteration))
                in.any)))

(_.the .public revised_identity
       (<| (?.let [Context]
                  [context Context
                   change (Change Context)])
           (?.= Context
                (/.revised /.identity change context)
                (change context)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (by.= ..has_identity)
                 (in.of in.any (list (by.= ..its_identity))))
            in.any))

(<| (_.the .public left_identity
           (?.let [Context Focus]
                  [property (/.Property Context Focus)]
                  (?.= (/.Property Context Focus)
                       (/.composite /.identity property)
                       property)))
    (..induction "property"
                 ["property:its" "property:has"])
    (!.= (all by.and
              (by.of by.definition (list in.any in.any))
              (in.pair (all by.and
                            (in.of in.any (list (by.= ..its)
                                                (all by.and
                                                     (in.of in.any (list by.definition))
                                                     (by.= ..its))))
                            (by.= //function.right_identity))
                       (all by.and
                            (<| in.function
                                (//pair.let' in.any)
                                (function (_ ==))
                                (all by.and
                                     (by.= ..revised_identity)
                                     (by.of by.definition (list in.any in.any in.any))
                                     (in.of (<| (by.let_pair (by.of by.definition (list in.any in.any)))
                                                in.any)
                                            (list (by.=' ==)))))
                            (by.= //function.intermediation))))
         (by.of by.definition (list in.any in.any))))

(<| (_.the .public right_identity
           (?.let [Context Focus]
                  [property (/.Property Context Focus)]
                  (?.= (/.Property Context Focus)
                       (/.composite property /.identity)
                       property)))
    (..induction "property"
                 ["property:its" "property:has"])
    (!.= (all by.and
              (by.of by.definition (list in.any in.any))
              (in.pair (all by.and
                            (in.of in.any (list (all by.and
                                                     (in.of in.any (list by.definition))
                                                     (by.= ..its))
                                                (by.= ..its)))
                            (by.= //function.left_identity))
                       (all by.and
                            (<| in.function
                                (//pair.let' in.any)
                                (function (_ ==))
                                (all by.and
                                     (by.of by.definition (list in.any in.any in.any))
                                     (by.of by.definition (list in.any
                                                                (by.= ..has_identity)
                                                                in.any))
                                     (in.of (<| (by.let_pair (by.of by.definition (list in.any in.any)))
                                                in.any)
                                            (list (by.=' ==)))))
                            (by.= //function.intermediation))))
         (by.of by.definition (list in.any in.any))))
