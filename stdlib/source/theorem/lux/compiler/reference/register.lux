(.using
 [library
  [lux (.except abstraction argument)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]]]
 [["/"] \\library])

(_.the .public abstraction
       (?.= /.abstraction
            0)
       (!.= by.definition
            in.any))

(_.the .public argument
       (?.= /.argument
            (++ /.abstraction))
       (!.= by.definition
            in.any))
