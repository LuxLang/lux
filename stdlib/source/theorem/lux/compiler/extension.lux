(.using
 [library
  [lux (.except name)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]]]
 [["/"] \\library])

(_.the .public name
       (?.let [it Text]
              (?.= (/.name it)
                   (text it /.suffix)))
       (!.= (all by.and
                 (in.of by.definition (list in.any))
                 (by.of by.definition (list in.any in.any)))
            in.any))

(_.the .public analysis
       (?.let [it /.Name]
              (?.= (/.analysis it)
                   (text it /.suffix_of_analysis)))
       (_.proof ..name))

(_.the .public synthesis
       (?.let [it /.Name]
              (?.= (/.synthesis it)
                   (text it /.suffix_of_synthesis)))
       (_.proof ..name))
