(.using
 [library
  [lux (.except)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof]
    [["in"] substitution]
    [["by"] rule]]
   [meta
    [[0] static]
    [[0] module]
    [[0] name]]
   [macro
    [[0] template]
    [[0] expansion]]]]
 [["/"] \\library])

(template.with [,name ,reference]
               [(<| (expansion.let [,constant (static.text (name.proper (name ,name)))
                                    ,literal (static.text (.constant_literal# ,constant))])
                    (_.the .public ,name
                           (?.= ,literal
                                ,reference)
                           (!.= in.any
                                by.definition)))]

               [[delimiter_for_module module.delimiter]
                [delimiter_for_name name.delimiter]
                ])
