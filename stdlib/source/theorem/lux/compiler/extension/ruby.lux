(.using
 [library
  [lux (.except)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof]
    [["in"] substitution]
    [["by"] rule]]
   [macro
    [[0] template]]
   [meta
    [[0] static]
    [[0] name]]]]
 [\\library
  [[0] / (.only)
   [["/" 1] //]]])

(template.with [,definition]
               [(`` (_.the .public (,, (template.name [,definition]))
                           (?.= ,definition
                                (//.name (,, (static.text (text "ruby_" (name.proper (name ,definition)))))))
                           (!.= by.definition
                                in.any)))]
               [[/.object_get]
                [/.object_do]
                [/.object_nil]
                [/.object_nil?]

                [/.constant]
                [/.of]
                [/.import]
                ])
