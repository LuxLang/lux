(.using
 [library
  [lux (.except function type_of)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof]
    [["in"] substitution]
    [["by"] rule]]
   [macro
    [[0] template]]
   [meta
    [[0] static]
    [[0] name]]]]
 [\\library
  [[0] / (.only)
   [["/" 1] //]]])

(template.with [,definition]
               [(`` (_.the .public (,, (template.name [,definition]))
                           (?.= ,definition
                                (//.name (,, (static.text (text "js_" (name.proper (name ,definition)))))))
                           (!.= by.definition
                                in.any)))]
               [[/.object_new]
                [/.object_get]
                [/.object_do]
                [/.object_null]
                [/.object_null?]
                [/.object_undefined]
                [/.object_undefined?]

                [/.constant]
                [/.of]
                [/.function]
                [/.import]
                [/.type_of]
                ])
