(.using
 [library
  [lux (.except)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]
   [abstract
    [[0] functor
     [["//" 1] \\theorem]]]
   [[0] function
    [["//" 1] \\theorem]]]]
 [["/"] \\library])

(_.the .public write
       (?.let [any]
              [it any]
              (?.= (/.write it)
                   [it []]))
       (!.= (by.of by.definition (list in.any))
            in.any))

(the identity_of_functor
     !.Proof
     (let [by_identity (by.of by.definition (list in.any))]
          (<| (//function.induction "")
              (!.= (all by.and
                        (by.of by.definition (list in.any in.any))
                        (by.let_pair' in.any
                                      (function (_ ==)
                                                (all by.and
                                                     (in.pair in.any by_identity)
                                                     (by.=' ==)))))
                   by_identity))))

(the composition_of_functor
     !.Proof
     (let [by_composite (by.of by.definition (list in.any in.any in.any))
           by_functor (by.of by.definition (list in.any in.any))]
          (<| (//function.induction "")
              (!.= (all by.and
                        by_composite
                        (all by.and
                             by_functor
                             (by.let_pair (all by.and
                                               by_functor
                                               (by.let_pair' in.any
                                                             (function (_ ==)
                                                                       in.any)))
                                          (in.pair in.any
                                                   (in.of in.any (list in.any))))))
                   (all by.and
                        by_functor
                        (by.let_pair' in.any
                                      (function (_ _)
                                                (in.pair in.any by_composite))))))))

(_.the .public functor
       (//functor.system /.functor)
       (!.and ..identity_of_functor
              ..composition_of_functor))
