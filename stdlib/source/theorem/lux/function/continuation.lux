(.using
 [library
  [lux (.except)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof]
    ["in" substitution]
    ["by" rule]]
   [abstract
    ["[0]" functor
     ["//[1]" \\theorem]]]
   ["[0]" function
    ["//[1]" \\theorem]]]]
 ["/" \\library])

(_.the .public empty
       (?.let [any]
              [it any]
              (?.= (/.empty it)
                   it))
       (!.= (by.of (all by.and
                        by.definition
                        by.definition)
                   (list in.any))
            in.any))

(_.the .public pending
       (?.let [any]
              [it any]
              (?.= (/.continued /.empty (/.pending it))
                   it))
       (!.= (all by.and
                 (by.of by.definition (list by.definition in.any))
                 (by.of in.any (list in.any))
                 (by.of by.definition (list in.any)))
            in.any))

(_.the .public continued
       (?.let [any answer]
              [context (/.Context any answer)
               it any]
              (?.= (/.continued context (/.pending it))
                   (context it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.of in.any (list in.any)))
            in.any))

(_.the .public value
       (?.let [any]
              [it any]
              (?.= (/.value (/.pending it))
                   it))
       (!.= (all by.and
                 (in.of by.definition (list in.any))
                 (by.= ..pending))
            in.any))

(_.the axiom_of_identity
       (//functor.axiom_of_identity /.functor)
       (<| (//function.induction "it")
           (//function.induction "next")
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any in.any))
                     (in.of in.any (list (by.= //function.right_identity))))
                (in.of (by.of by.definition (list in.any))
                       (list in.any)))))

(_.the axiom_of_composition
       (//functor.axiom_of_composition /.functor)
       (<| (//function.induction "it")
           (//function.induction "next")
           (!.= (all by.and
                     (by.of (all by.and
                                 (by.of by.definition (list in.any in.any in.any))
                                 (by.of by.definition (list in.any
                                                            (by.of by.definition (list in.any in.any)))))
                            (list in.any))
                     (by.of in.any (list in.any))
                     (in.of in.any (list (by.= //function.associativity_of_composite))))
                (all by.and
                     (by.of by.definition (list in.any in.any in.any))))))

(_.the .public functor
       (//functor.system /.functor)
       (all !.and
            (_.proof ..axiom_of_identity)
            (_.proof ..axiom_of_composition)))
