(.using
 [library
  [lux (.except all and not)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" contradiction]
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   [macro
    ["[0]" template]]
   [logic
    ["[0]" bit
     ["[1]" \\theorem]]]
   ["[0]" function
    ["//[1]" \\theorem]]]]
 ["/" \\library])

(_.the .public none
       (?.let [any]
              [it any]
              (?.= (/.none it)
                   .false))
       (!.= (.all by.and
                  (in.of by.definition (list in.any))
                  (by.of by.definition (list in.any in.any)))
            by.definition))

(the by_true
     (.all by.and
           by.definition
           (by.of by.definition (list by.definition))
           (by.if in.any in.any)))

(_.the .public all
       (?.let [any]
              [it any]
              (?.= (/.all it)
                   .true))
       (!.= (.all by.and
                  (in.of by.definition (list in.any))
                  (by.of by.definition (list in.any in.any)))
            ..by_true))

(_.the .public double_negation
       (?.let [any]
              [it (/.Predicate any)]
              (?.= (/.not (/.not it))
                   it))
       (<| (//function.induction "")
           (!.= (.all by.and
                      (by.of (by.of by.definition (list (by.of by.definition (list in.any))))
                             (list in.any))
                      (in.of in.any (list (by.of in.any (list in.any))))
                      (by.= bit.double_negation))
                in.any)))

(_.the .public not_none
       (?.let [any]
              [it (/.Predicate any)]
              (?.= (/.not /.none)
                   /.all))
       (<| (//function.induction "")
           (!.= (.all by.and
                      (by.of by.definition (list in.any in.any))
                      (in.of in.any (list (by.= ..none)))
                      (by.= bit.true))
                (by.= ..all))))

(_.the .public not_all
       (?.let [any]
              [it (/.Predicate any)]
              (?.= (/.not /.all)
                   /.none))
       (<| (//function.induction "")
           (!.= (.all by.and
                      (by.of by.definition (list in.any in.any))
                      (in.of in.any (list (by.= ..all)))
                      (by.= bit.false))
                (by.= ..none))))

(_.the .public and/or_none
       (?.let [any]
              [it (/.Predicate any)]
              (?.= (/.and/or /.none it)
                   it))
       (<| (//function.induction "")
           (!.= (.all by.and
                      (by.of (by.of by.definition (list in.any in.any))
                             (list in.any))
                      (bit.and/or (by.= ..none) in.any)
                      (by.= bit.identity_of_and/or))
                in.any)))

(_.the .public and_all
       (?.let [any]
              [it (/.Predicate any)]
              (?.= (/.and /.all it)
                   it))
       (<| (//function.induction "")
           (!.= (.all by.and
                      (by.of (by.of by.definition (list in.any in.any))
                             (list in.any))
                      (bit.and (by.= ..all) in.any)
                      (by.= bit.identity_of_and))
                in.any)))

(template.the .public (< ,super ,sub)
              [(?.let [it any]
                      (?.if (?.= (,sub it)
                                 .true)
                            (?.= (,super it)
                                 .true)))])

(_.the .public <_or_left
       (?.let [any]
              [left (/.Predicate any)
               right (/.Predicate any)]
              (..< (/.and/or left right) left))
       (<| !.if (function (_ =_true))
           (!.= (.all by.and
                      (by.of by.definition (list in.any in.any in.any))
                      (bit.and/or (by.=' =_true) in.any)
                      (by.= bit.annihilation_of_and/or))
                in.any)))

(_.the .public <_or_right
       (?.let [any]
              [left (/.Predicate any)
               right (/.Predicate any)]
              (..< (/.and/or left right) right))
       (<| !.if (function (_ =_true))
           (!.= (.all by.and
                      (by.of by.definition (list in.any in.any in.any))
                      (bit.and/or in.any (by.=' =_true))
                      (by.= bit.commutativity_of_and/or)
                      (by.= bit.annihilation_of_and/or))
                in.any)))

(_.the .public <_and_left
       (?.let [any]
              [left (/.Predicate any)
               right (/.Predicate any)]
              (..< left (/.and left right)))
       (<| !.if (function (_ =_left))
           ((!.let [=_left
                    (.all by.and
                          (in.= (by.of by.definition (list in.any in.any in.any))
                                ..by_true)
                          (contradiction.then (in.= in.any in.any)))])
            (function (_ [=_left =_right])
                      (!.= (by.=' =_left)
                           ..by_true)))))

(_.the .public <_and_right
       (?.let [any]
              [left (/.Predicate any)
               right (/.Predicate any)]
              (..< right (/.and left right)))
       (<| !.if (function (_ =_right))
           ((!.let [=_right
                    (.all by.and
                          (in.= (by.of by.definition (list in.any in.any in.any))
                                ..by_true)
                          (contradiction.then (in.= in.any in.any)))])
            (function (_ [=_left =_right])
                      (!.= (by.=' =_right)
                           ..by_true)))))

(_.the .public difference_of_none
       (?.let [any]
              [it (/.Predicate any)]
              (?.= (/.- /.none it)
                   it))
       (<| (//function.induction "")
           (!.= (.all by.and
                      (by.of by.definition (list in.any in.any in.any))
                      (bit.and in.any
                               (.all by.and
                                     (in.of in.any (list (by.= ..none)))
                                     (by.= bit.true)))
                      (by.= bit.commutativity_of_and)
                      (by.= bit.identity_of_and))
                in.any)))

(_.the .public difference_of_all
       (?.let [any]
              [it (/.Predicate any)]
              (?.= (/.- /.all it)
                   /.none))
       (<| (//function.induction "")
           (!.= (.all by.and
                      (by.of by.definition (list in.any in.any in.any))
                      (bit.and in.any
                               (.all by.and
                                     (in.of in.any (list (by.= ..all)))
                                     (by.= bit.false)))
                      (by.= bit.commutativity_of_and)
                      (by.= bit.annihilation_of_and))
                (by.= ..none))))

(_.the .public difference_of_self
       (?.let [any]
              [it (/.Predicate any)]
              (?.= (/.- it it)
                   /.none))
       (<| (//function.induction "")
           (!.= (.all by.and
                      (by.of by.definition (list in.any in.any in.any))
                      (by.= bit.complementation_of_and))
                (by.= ..none))))
