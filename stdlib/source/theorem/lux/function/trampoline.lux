(.using
 [library
  [lux (.except)
   [abstract
    [[0] functor
     [["//" 1] \\theorem]]]
   [[0] function (.only)
    [["//" 1] \\theorem]]
   [data
    [[0] case
     [["//" 1] \\theorem]]]
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]]]
 [["/"] \\library])

(_.the .public return
       (?.let [any]
              [it any]
              (?.= (/.value (/.return it))
                   it))
       (!.= (all by.and
                 (by.of by.definition (list (by.of by.definition (list in.any))))
                 (by.if_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public jump
       (?.let [any]
              [it (/.Trampoline any)]
              (?.= (/.value (/.jump it))
                   (/.value it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (by.if_case in.any
                             by.right
                             (in.of (by.name (name /.value)) (list (by.of in.any (list in.any))))))
            in.any))

(_.the .public identity_of_functor
       (//functor.identity /.functor)
       (<| (//function.induction "it")
           (//case.induction "it"
                             ["it:return"
                              (!.= (all by.and
                                        (by.of by.definition (list in.any in.any))
                                        (<| (by.if_case in.any
                                                        by.left)
                                            (in.case by.left)
                                            (by.= //function.identity)))
                                   (by.of by.definition (list in.any)))]
                             ["it:jump"
                              (!.= (all by.and
                                        (by.of by.definition (list in.any in.any))
                                        (<| (by.if_case in.any
                                                        by.right)
                                            (in.case by.right)
                                            (all by.and
                                                 (in.of in.any (list (all by.and
                                                                          (in.of (by.name (name /.functor))
                                                                                 (list in.any))
                                                                          (by.=' identity_of_functor))
                                                                     in.any))
                                                 (by.= //function.left_identity))))
                                   (by.of by.definition (list in.any)))])))
