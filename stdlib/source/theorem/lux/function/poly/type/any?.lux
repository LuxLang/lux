(.using
 [library
  [lux (.except)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]
   [[0] function
    [["//" 1] \\theorem]
    [predicate (.only Predicate)]]]]
 [["/"] \\library])

(_.the .public constant
       (?.let [it any]
              [condition (Predicate it)
               any_thing any]
              (?.= (/.constant condition any_thing)
                   .false))
       (!.= (by.of by.definition (list in.any in.any))
            in.any))

(_.the .public variable
       (?.let [it]
              [condition (Predicate it)
               it it]
              (?.= (/.variable condition it)
                   (condition it)))
       (!.= (by.of by.definition (list in.any in.any))
            in.any))

(_.the .public case_of_left
       (?.let [it left right]
              [condition (Predicate it)
               in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               it (left it)]
              (?.= (/.case in_left in_right condition {.:Left it})
                   (in_left condition it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.left)
                     in.any))
            in.any))

(_.the .public case_of_right
       (?.let [it left right]
              [condition (Predicate it)
               in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               it (right it)]
              (?.= (/.case in_left in_right condition {.:Right it})
                   (in_right condition it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.right)
                     in.any))
            in.any))

(_.the .public pair
       (?.let [it left right]
              [condition (Predicate it)
               in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               the_left (left it)
               the_right (right it)]
              (?.= (/.pair in_left in_right condition [the_left the_right])
                   (and/or (in_left condition the_left)
                           (in_right condition the_right))))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any))
                 (<| (by.let_pair in.any)
                     in.any))
            in.any))

(_.the .public recursion
       (?.let [it]
              [it (Change (/.Algorithm it))]
              (?.= (/.recursion it)
                   (it (/.recursion it))))
       (<| (//function.induction "rest")
           (!.= (by.of by.definition (list in.any in.any))
                (in.of in.any (list (by.of by.definition (list in.any))
                                    in.any)))))
