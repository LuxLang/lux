(.using
 [library
  [lux (.except)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]
   [[0] function
    [["//" 1] \\theorem]]
   [logic
    [[0] bit
     [["//" 1] \\theorem]]]
   [data
    [[0] maybe]]
   [math
    [number
     [/64
      [[0] natural
       [["//" 1] \\theorem]]]]]]]
 [["/"] \\library])

(_.the .public constant
       (?.let [any]
              [it any
               choice Natural]
              (?.= (Maybe any)
                   (/.constant choice it)
                   {.:None}))
       (!.= (by.of by.definition (list in.any in.any))
            in.any))

(_.the .public variable_if_choice
       (<| (?.let [any]
                  [it any])
           (?.= (Maybe any)
                (/.variable /.choice it)
                {.:Some it}))
       (!.= (all by.and
                 (by.of by.definition (list by.definition in.any))
                 (<| (by.let in.any)
                     (by.if (by.= //natural.reflexivity_of_=))
                     in.any))
            in.any))

(_.the .public variable_if_else
       (<| (?.let [any]
                  [it any
                   choice Natural])
           (?.if (?.= (.i64_=# 0 choice)
                      0b))
           (?.= (Maybe any)
                (/.variable choice it)
                {.:None}))
       (<| !.if (.function (_ is_false))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.let in.any)
                         (by.if (by.=' is_false))
                         (by.let in.any)
                         in.any))
                in.any)))

(_.the .public case_of_left
       (?.let [it left right]
              [choice Natural
               in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               it (left it)]
              (?.= (/.case in_left in_right choice {.:Left it})
                   (in_left choice it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.left)
                     in.any))
            in.any))

(_.the .public case_of_right
       (?.let [it left right]
              [choice Natural
               in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               it (right it)]
              (?.= (/.case in_left in_right choice {.:Right it})
                   (in_right choice it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.right)
                     in.any))
            in.any))

(_.the .public pair
       (?.let [it left right]
              [choice Natural
               in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               the_left (left it)
               the_right (right it)]
              (?.= (Maybe it)
                   (/.pair in_left in_right choice [the_left the_right])
                   (maybe.and/or (in_left choice the_left)
                                 (in_right (-- choice) the_right))))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any))
                 (<| (by.let_pair in.any)
                     in.any))
            in.any))

(_.the .public recursion
       (?.let [it]
              [it (Change (/.Algorithm it))]
              (?.= (/.recursion it)
                   (it (/.recursion it))))
       (<| (//function.induction "rest")
           (!.= (by.of by.definition (list in.any in.any))
                (in.of in.any (list (by.of by.definition (list in.any))
                                    in.any)))))
