(.using
 [library
  [lux (.except)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]
   [[0] function
    [["//" 1] \\theorem]
    [predicate (.only Predicate)]]
   [logic
    [[0] bit
     [["//" 1] \\theorem]]]
   [data
    [[0] maybe]]]]
 [["/"] \\library])

(_.the .public constant
       (?.let [any]
              [it any
               ? (Predicate any)]
              (?.= (Maybe any)
                   (/.constant ? it)
                   {.:None}))
       (!.= (by.of by.definition (list in.any in.any))
            in.any))

(_.the .public variable_if_false
       (<| (?.let [any]
                  [it any
                   ? (Predicate any)])
           (?.if (?.= (? it)
                      .false))
           (?.= (Maybe any)
                (/.variable ? it)
                {.:None}))
       (<| !.if (.function (_ is_false))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (by.if (all by.and
                                 (by.=' is_false)
                                 (by.=' (?.in_reverse (by.proposition //bit.value_of_false))))
                            in.any))
                in.any)))

(_.the .public variable_if_true
       (<| (?.let [any]
                  [it any
                   ? (Predicate any)])
           (?.if (?.= (? it)
                      .true))
           (?.= (Maybe any)
                (/.variable ? it)
                {.:Some it}))
       (<| !.if (.function (_ is_true))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (by.if (all by.and
                                 (by.=' is_true)
                                 (by.=' (?.in_reverse (by.proposition //bit.value_of_true))))
                            in.any))
                in.any)))

(_.the .public case_of_left
       (?.let [it left right]
              [condition (Predicate it)
               in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               it (left it)]
              (?.= (/.case in_left in_right condition {.:Left it})
                   (in_left condition it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.left)
                     in.any))
            in.any))

(_.the .public case_of_right
       (?.let [it left right]
              [condition (Predicate it)
               in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               it (right it)]
              (?.= (/.case in_left in_right condition {.:Right it})
                   (in_right condition it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.right)
                     in.any))
            in.any))

(_.the .public pair
       (?.let [it left right]
              [condition (Predicate it)
               in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               the_left (left it)
               the_right (right it)]
              (?.= (Maybe it)
                   (/.pair in_left in_right condition [the_left the_right])
                   (maybe.and/or (in_left condition the_left)
                                 (in_right condition the_right))))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any))
                 (<| (by.let_pair in.any)
                     in.any))
            in.any))

(_.the .public recursion
       (?.let [it]
              [it (Change (/.Algorithm it))]
              (?.= (/.recursion it)
                   (it (/.recursion it))))
       (<| (//function.induction "rest")
           (!.= (by.of by.definition (list in.any in.any))
                (in.of in.any (list (by.of by.definition (list in.any))
                                    in.any)))))
