(.using
 [library
  [lux (.except)
   [transduction (.only Reduction)]
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]
   [[0] function
    [["//" 1] \\theorem]]]]
 [["/"] \\library])

(_.the .public constant
       (?.let [Zero One]
              [zero Zero
               one One
               successor (Reduction Zero One)]
              (?.= Zero
                   (/.constant successor one zero)
                   zero))
       (!.= (by.of by.definition (list in.any in.any in.any))
            in.any))

(_.the .public variable
       (?.let [Zero One]
              [zero Zero
               one One
               successor (Reduction Zero One)]
              (?.= Zero
                   (/.variable successor one zero)
                   (successor one zero)))
       (!.= (by.of by.definition (list in.any in.any in.any))
            in.any))

(_.the .public case_of_left
       (?.let [Zero One Left Right]
              [in_left (/.Mix Left)
               in_right (/.Mix Right)
               zero Zero
               one (Left One)
               successor (Reduction Zero One)]
              (?.= Zero
                   (/.case in_left in_right
                           successor {.:Left one} zero)
                   (in_left successor one zero)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.left)
                     in.any))
            in.any))

(_.the .public case_of_right
       (?.let [Zero One Left Right]
              [in_left (/.Mix Left)
               in_right (/.Mix Right)
               zero Zero
               one (Right One)
               successor (Reduction Zero One)]
              (?.= Zero
                   (/.case in_left in_right
                           successor {.:Right one} zero)
                   (in_right successor one zero)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.right)
                     in.any))
            in.any))

(_.the .public pair
       (?.let [Zero One Left Right]
              [in_left (/.Mix Left)
               in_right (/.Mix Right)
               zero Zero
               left_one (Left One)
               right_one (Right One)
               successor (Reduction Zero One)]
              (?.= Zero
                   (/.pair in_left in_right
                           successor [left_one right_one] zero)
                   (|> zero
                       (in_left successor left_one)
                       (in_right successor right_one))))
       (!.= (by.of (all by.and
                        (by.of by.definition (list in.any in.any in.any in.any))
                        (<| (by.let_pair in.any)
                            in.any))
                   (list in.any))
            in.any))

(_.the .public recursion
       (?.let [It]
              [it (Change (/.Mix It))]
              (?.= (/.recursion it)
                   (it (/.recursion it))))
       (<| (//function.induction "zero")
           (//function.induction "one")
           (//function.induction "successor")
           (!.= (by.of by.definition (list in.any in.any in.any in.any))
                (in.of in.any (list (by.of by.definition (list in.any)) in.any in.any in.any)))))
