(.using
 [library
  [lux (.except)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   ["[0]" function
    ["//[1]" \\theorem]]]]
 ["/" \\library (.only)
  ["/[1]" //]])

(_.the .public constant
       (?.let [it any]
              [any_thing any]
              (?.= (/.constant any_thing)
                   .true))
       (!.= (by.of by.definition (list in.any))
            in.any))

(_.the .public variable
       (?.let [it]
              [it it]
              (?.= (/.variable it)
                   .false))
       (!.= (by.of by.definition (list in.any))
            in.any))

(_.the .public case_of_left
       (?.let [it left right]
              [in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               it (left it)]
              (?.= (/.case in_left in_right {.:Left it})
                   (in_left it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.left)
                     in.any))
            in.any))

(_.the .public case_of_right
       (?.let [it left right]
              [in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               it (right it)]
              (?.= (/.case in_left in_right {.:Right it})
                   (in_right it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (<| (by.if_case in.any
                                 by.right)
                     in.any))
            in.any))

(_.the .public pair
       (?.let [it left right]
              [in_left (/.Algorithm left)
               in_right (/.Algorithm right)
               the_left (left it)
               the_right (right it)]
              (?.= (/.pair in_left in_right [the_left the_right])
                   (and (in_left the_left)
                        (in_right the_right))))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (<| (by.let_pair in.any)
                     in.any))
            in.any))

(_.the .public recursion
       (?.let [it]
              [it (Change (/.Algorithm it))]
              (?.= (/.recursion it)
                   (it (/.recursion it))))
       (<| (//function.induction "rest")
           (!.= (by.of by.definition (list in.any in.any))
                (in.of in.any (list (by.of by.definition (list in.any))
                                    in.any)))))
