                                          (,composition r67 s67) (,composition r66 s66) (,composition r65 s65) (,composition r64 s64) (,composition r63 s63) (,composition r62 s62) (,composition r61 s61) (,composition r60 s60)
                                          (,composition r57 s57) (,composition r56 s56) (,composition r55 s55) (,composition r54 s54) (,composition r53 s53) (,composition r52 s52) (,composition r51 s51) (,composition r50 s50)
