                               that (I64 It)]
                              (?.= (I64 It)
                                   (/.<< 1 (,definition this that))
                                   (,definition (/.<< 1 this) (/.<< 1 that))))
                       (!.= (all by.and
                                 (in.b64_<< (by.of by.definition (list in.any in.any)))
                                 (by.= ,b64_<<))
                            (by.of by.definition (list in.any in.any))))

                (_.the .public ,b64_>>
                       (?.let [It]
