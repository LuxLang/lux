(the .public (digit carry reference subject)
     (-> Bit Bit Bit
         Bit)
     (bit.or carry
             (bit.or reference subject)))

(the (//bit:or this that)
     (-> term.Rule term.Rule
         term.Rule)
     (in.of in.any (list this that)))

(the and/or_false!
     (all by.and
          (//bit.and/or (by.= //bit.value_of_false)
                        in.any)
          (by.= //bit.identity_of_and/or)))

(the and/or_true!
     (all by.and
          (//bit.and/or (by.= //bit.value_of_true)
                        in.any)
          (by.= //bit.annihilation_of_and/or)))

(the and_false!
     (all by.and
          (//bit.and (by.= //bit.value_of_false)
                     in.any)
          (by.= //bit.annihilation_of_and)))

(the and_true!
     (all by.and
          (//bit.and (by.= //bit.value_of_true)
                     in.any)
          (by.= //bit.identity_of_and)))

(_.the digit_is_correct
       (?.let [carry Bit
               reference Bit
               subject Bit]
              (?.= (..digit carry reference subject)
                   (all bit.or
                        (.and carry (.not (bit.or reference subject)))
                        (.and reference (.not (bit.or carry subject)))
                        (.and subject (.not (bit.or carry reference))))))
       (//bit.induction "carry"
                        (//bit.induction "reference"
                                         (//bit.induction "subject"
                                                          (!.= (all by.and
                                                                    (by.of by.definition (list in.any in.any in.any))
                                                                    (//bit:or (by.= //bit.value_of_false)
                                                                              (//bit:or (by.= //bit.value_of_false)
                                                                                        (by.= //bit.value_of_false)))
                                                                    (by.= //bit.identity_of_or)
                                                                    (by.= //bit.non_idempotence_of_or))
                                                               (all by.and
                                                                    (//bit:or ..and_false!
                                                                              (//bit:or ..and_false!
                                                                                        ..and_false!))
                                                                    (by.= //bit.identity_of_or)
                                                                    (by.= //bit.non_idempotence_of_or)))
                                                          (!.= (all by.and
                                                                    (by.of by.definition (list in.any in.any in.any))
                                                                    (//bit:or (by.= //bit.value_of_false)
                                                                              (//bit:or (by.= //bit.value_of_false)
                                                                                        (all by.and
                                                                                             (by.= //bit.value_of_true)
                                                                                             by.definition)))
                                                                    (by.= //bit.identity_of_or)
                                                                    (by.= //bit.complementation_of_or)
                                                                    by.definition)
                                                               (all by.and
                                                                    (//bit:or ..and_false!
                                                                              (//bit:or ..and_false!
                                                                                        ..and_true!))
                                                                    (by.= //bit.identity_of_or)
                                                                    (by.= //bit.identity_of_or)
                                                                    (//bit.not (by.= //bit.non_idempotence_of_or)))))
                                         (//bit.induction "subject"
                                                          (!.= (all by.and
                                                                    (by.of by.definition (list in.any in.any in.any))
                                                                    (//bit:or (by.= //bit.value_of_false)
                                                                              (//bit:or (by.= //bit.value_of_true)
                                                                                        (by.= //bit.value_of_false)))
                                                                    (by.= //bit.identity_of_or)
                                                                    (by.= //bit.commutativity_of_or)
                                                                    (by.= //bit.identity_of_or)
                                                                    by.definition)
                                                               (all by.and
                                                                    (//bit:or ..and_false!
                                                                              (//bit:or ..and_true!
                                                                                        ..and_false!))
                                                                    (by.= //bit.identity_of_or)
                                                                    (by.= //bit.commutativity_of_or)
                                                                    (by.= //bit.identity_of_or)
                                                                    (//bit.not (by.= //bit.non_idempotence_of_or))))
                                                          (!.= (all by.and
                                                                    (by.of by.definition (list in.any in.any in.any))
                                                                    (//bit:or (by.= //bit.value_of_false)
                                                                              (//bit:or (by.= //bit.value_of_true)
                                                                                        (by.= //bit.value_of_true)))
                                                                    (by.= //bit.identity_of_or)
                                                                    (by.= //bit.non_idempotence_of_or))
                                                               (all by.and
                                                                    (//bit:or ..and_false!
                                                                              (//bit:or ..and_true!
                                                                                        ..and_true!))
                                                                    (by.= //bit.identity_of_or)
                                                                    (by.= //bit.non_idempotence_of_or)))))
                        (//bit.induction "reference"
                                         (//bit.induction "subject"
                                                          (!.= (all by.and
                                                                    (by.of by.definition (list in.any in.any in.any))
                                                                    (//bit:or (all by.and
                                                                                   (by.= //bit.value_of_true)
                                                                                   by.definition)
                                                                              (by.= //bit.non_idempotence_of_or)))
                                                               (all by.and
                                                                    (//bit:or (all by.and
                                                                                   ..and_true!
                                                                                   (//bit.not (by.= //bit.non_idempotence_of_or)))
                                                                              (by.= //bit.non_idempotence_of_or))))
                                                          (let [or_false_true (//bit:or (by.= //bit.value_of_false)
                                                                                        (by.= //bit.value_of_true))]
                                                               (!.= (all by.and
                                                                         (by.of by.definition (list in.any in.any in.any))
                                                                         (//bit:or (by.= //bit.value_of_true)
                                                                                   (all by.and
                                                                                        or_false_true
                                                                                        (by.= //bit.identity_of_or)))
                                                                         (by.= //bit.non_idempotence_of_or))
                                                                    (all by.and
                                                                         (//bit:or (all by.and
                                                                                        ..and_true!
                                                                                        (//bit.not (all by.and
                                                                                                        or_false_true
                                                                                                        (by.= //bit.identity_of_or)))
                                                                                        (by.= //bit.false))
                                                                                   (all by.and
                                                                                        (//bit:or ..and_false!
                                                                                                  (all by.and
                                                                                                       ..and_true!
                                                                                                       (//bit.not (all by.and
                                                                                                                       (//bit:or (by.= //bit.value_of_true)
                                                                                                                                 (by.= //bit.value_of_false))
                                                                                                                       (by.= //bit.commutativity_of_or)
                                                                                                                       (by.= //bit.identity_of_or)))
                                                                                                       (by.= //bit.false)))
                                                                                        (by.= //bit.non_idempotence_of_or)))
                                                                         (by.= //bit.non_idempotence_of_or)))))
                                         (//bit.induction "subject"
                                                          (!.= (all by.and
                                                                    (by.of by.definition (list in.any in.any in.any))
                                                                    (//bit:or (by.= //bit.value_of_true)
                                                                              (all by.and
                                                                                   (//bit:or (by.= //bit.value_of_true)
                                                                                             (by.= //bit.value_of_false))
                                                                                   (by.= //bit.commutativity_of_or)
                                                                                   (by.= //bit.identity_of_or)))
                                                                    (by.= //bit.non_idempotence_of_or))
                                                               (let [and_true!' (all by.and
                                                                                     ..and_true!
                                                                                     (//bit.not (all by.and
                                                                                                     (//bit:or (by.= //bit.value_of_true)
                                                                                                               (by.= //bit.value_of_false))
                                                                                                     (by.= //bit.commutativity_of_or)
                                                                                                     (by.= //bit.identity_of_or))))]
                                                                    (all by.and
                                                                         (//bit:or and_true!'
                                                                                   (all by.and
                                                                                        (//bit:or and_true!'
                                                                                                  ..and_false!)
                                                                                        (by.= //bit.commutativity_of_or)
                                                                                        (by.= //bit.identity_of_or)))
                                                                         (by.= //bit.non_idempotence_of_or))))
                                                          (!.= (all by.and
                                                                    (by.of by.definition (list in.any in.any in.any))
                                                                    (//bit:or (by.= //bit.value_of_true)
                                                                              (by.= //bit.non_idempotence_of_or))
                                                                    (by.= //bit.commutativity_of_or)
                                                                    (by.= //bit.identity_of_or)
                                                                    by.definition)
                                                               (all by.and
                                                                    (//bit:or (all by.and
                                                                                   ..and_true!
                                                                                   (//bit.not (by.= //bit.non_idempotence_of_or)))
                                                                              (all by.and
                                                                                   (//bit:or ..and_true!
                                                                                             ..and_true!)
                                                                                   (by.= //bit.non_idempotence_of_or)))
                                                                    (by.= //bit.commutativity_of_or)
                                                                    (by.= //bit.identity_of_or)))))))

(the .public (carry carry reference subject)
     (-> Bit Bit Bit
         Bit)
     (bit.or (.and reference subject)
             (.and carry
                   (bit.or reference subject))))

(<| (_.the carry_is_correct
           (?.let [carry Bit
                   reference Bit
                   subject Bit]
                  (?.= (..carry carry reference subject)
                       (.and/or (.and reference subject)
                                (.and carry reference)
                                (.and carry subject)))))
    (let [carry=false_&_reference=false
          (!.= (all by.and
                    (by.of by.definition (list in.any in.any in.any))
                    (//bit:or ..and_false!
                              ..and_false!)
                    (by.= //bit.non_idempotence_of_or))
               (all by.and
                    (//bit.and/or and_false!
                                  in.any)
                    (by.= //bit.identity_of_and/or)
                    (//bit.and/or and_false!
                                  in.any)
                    (by.= //bit.identity_of_and/or)
                    ..and_false!))

          carry=true_&_reference=true
          (!.= (all by.and
                    (by.of by.definition (list in.any in.any in.any))
                    (//bit:or ..and_true!
                              (all by.and
                                   ..and_true!
                                   (//bit:or (by.= //bit.value_of_true)
                                             in.any)
                                   (by.= //bit.negation_by_or)))
                    (by.= //bit.complementation_of_or))
               (all by.and
                    (//bit.and/or ..and_true!
                                  in.any)
                    (by.= //bit.commutativity_of_and/or)
                    (//bit.and/or (all by.and
                                       (//bit.and/or ..and_true!
                                                     in.any)
                                       ..and/or_true!)
                                  in.any)
                    (by.= //bit.annihilation_of_and/or)))])
    (//bit.induction "carry"
                     (//bit.induction "reference"
                                      carry=false_&_reference=false
                                      (//bit.induction "subject"
                                                       (!.= (all by.and
                                                                 (by.of by.definition (list in.any in.any in.any))
                                                                 (//bit:or (all by.and
                                                                                ..and_true!
                                                                                (by.= //bit.value_of_false))
                                                                           ..and_false!)
                                                                 (by.= //bit.non_idempotence_of_or))
                                                            (all by.and
                                                                 (//bit.and/or ..and_true!
                                                                               in.any)
                                                                 ..and/or_false!
                                                                 (//bit.and/or ..and_false!
                                                                               in.any)
                                                                 (by.= //bit.identity_of_and/or)
                                                                 ..and_false!))
                                                       (!.= (all by.and
                                                                 (by.of by.definition (list in.any in.any in.any))
                                                                 (//bit:or ..and/or_true!
                                                                           ..and_false!)
                                                                 (by.= //bit.commutativity_of_or)
                                                                 (by.= //bit.identity_of_or))
                                                            (all by.and
                                                                 (//bit.and/or ..and_true!
                                                                               in.any)
                                                                 ..and/or_true!))))
                     (//bit.induction "reference"
                                      (//bit.induction "subject"
                                                       (!.= (all by.and
                                                                 (by.of by.definition (list in.any in.any in.any))
                                                                 (//bit:or ..and_false!
                                                                           ..and_true!)
                                                                 (by.= //bit.identity_of_or)
                                                                 (by.= //bit.non_idempotence_of_or))
                                                            (all by.and
                                                                 (//bit.and/or ..and_false!
                                                                               in.any)
                                                                 (by.= //bit.identity_of_and/or)
                                                                 (//bit.and/or ..and_true!
                                                                               in.any)
                                                                 ..and/or_false!
                                                                 ..and_true!
                                                                 (by.= //bit.value_of_false)))
                                                       (!.= (all by.and
                                                                 (by.of by.definition (list in.any in.any in.any))
                                                                 (//bit:or ..and_false!
                                                                           ..and_true!)
                                                                 (by.= //bit.identity_of_or)
                                                                 (//bit:or (by.= //bit.value_of_false)
                                                                           (by.= //bit.value_of_true))
                                                                 (by.= //bit.identity_of_or))
                                                            (all by.and
                                                                 (//bit.and/or ..and_false!
                                                                               in.any)
                                                                 (by.= //bit.identity_of_and/or)
                                                                 (//bit.and/or ..and_true!
                                                                               in.any)
