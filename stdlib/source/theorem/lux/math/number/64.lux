(template.the (annihilation ,x ,0)
              [(?.let [it (|type|)]
                      (?.= (|type|)
                           (,x ,0 it)
                           ,0))])

(template.with [,theorem_of_extension ,extension ,theorem_of_definition ,definition
                ,axiom ,nil ,value ,in ,bit_in ,theorem]
               [(_.the .public ,theorem_of_extension
                       (annihilation ,extension ,nil)
                       (<| (..induction "it")
                           (!.= (all by.and
                                     (,in by.definition in.any)
                                     (by.= ,axiom)
                                     (let [== (all by.and
                                                   (,bit_in (by.= ,value)
                                                            in.any)
                                                   (by.= ,theorem)
                                                   (by.=' (?.in_reverse (by.proposition ,value))))]
                                          (in.b64 == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==)))
                                by.definition)))

                (_.the .public ,theorem_of_definition
                       (annihilation ,definition ,nil)
                       (!.= (all by.and
                                 (by.of by.definition (list in.any in.any))
                                 (by.= ,theorem_of_extension))
                            in.any))]

               [[annihilation_of_b64_and .b64_and# annihilation_of_and /.and
                 ..and /.false //bit.value_of_false in.b64_and //bit.and //bit.annihilation_of_and]
                [annihilation_of_b64_and/or .b64_and/or# annihilation_of_and/or /.and/or
                 ..and/or /.true //bit.value_of_true in.b64_and/or //bit.and/or //bit.annihilation_of_and/or]
                ])

(_.the .public non_idempotence_of_b64_or
       (?.let [it (|type|)]
              (?.= (|type|)
                   (.b64_or# it it)
                   /.false))
       (<| (..induction "it")
           (!.= (all by.and
                     (by.= ..or)
                     (let [== (all by.and
                                   (by.= //bit.non_idempotence_of_or)
                                   (by.=' (?.in_reverse (by.proposition //bit.value_of_false))))]
                          (in.b64 == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==)))
                by.definition)))

(_.the .public non_idempotence_of_or
       (?.let [it (|type|)]
              (?.= (|type|)
                   (/.or it it)
                   /.false))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.= ..non_idempotence_of_b64_or))
            in.any))

(_.the .public complementation_of_or
       (?.let [it (|type|)]
              (?.= (|type|)
                   (/.or it (/.not it))
                   /.true))
       (!.= (all by.and
                 (in.of in.any (list in.any (all by.and
                                                 (in.of by.definition (list in.any))
                                                 (by.= ..commutativity_of_or))))
                 (by.= ..associativity_of_or)
                 (in.of in.any (list (by.= ..non_idempotence_of_or) in.any))
                 (by.= ..identity_of_or))
            in.any))

