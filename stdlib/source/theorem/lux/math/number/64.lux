(template.the (identity ,x ,1)
              [(?.let [it (|type|)]
                      (?.= (|type|)
                           (,x ,1 it)
                           it))])

(_.the .public identity_of_b64_or
       (..identity .b64_or# /.false)
       (<| (..induction "it")
           (!.= (all by.and
                     (in.b64_or by.definition in.any)
                     (by.= ..or)
                     (let [== (all by.and
                                   (in.of in.any (list (by.= //bit.value_of_false)
                                                       in.any))
                                   (by.= //bit.identity_of_or))]
                          (in.b64 == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==
                                  == == == == == == == ==)))
                in.any)))

(template.with [,name ,extension ,axiom ,property ,identity ,value ,in ,in']
               [(_.the .public ,name
                       (..identity ,extension ,identity)
                       (<| (..induction "it")
                           (!.= (all by.and
                                     (,in by.definition in.any)
                                     (by.= ,axiom)
                                     (let [== (all by.and
                                                   (,in' (by.= ,value)
                                                         in.any)
                                                   (by.= ,property))]
                                          (in.b64 == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==)))
                                in.any)))]

               [[identity_of_b64_and .b64_and# ..and //bit.identity_of_and /.true //bit.value_of_true in.b64_and //bit.and]
                [identity_of_b64_and/or .b64_and/or# ..and/or //bit.identity_of_and/or /.false //bit.value_of_false in.b64_and/or //bit.and/or]
                ])

(template.with [,name ,theorem ,definition ,value]
               [(_.the .public ,name
                       (..identity ,definition ,value)
                       (!.= (all by.and
                                 (by.of by.definition (list in.any in.any))
                                 (by.= ,theorem))
                            in.any))]

               [[identity_of_or ..identity_of_b64_or /.or /.false]
                [identity_of_and ..identity_of_b64_and /.and /.true]
                [identity_of_and/or ..identity_of_b64_and/or /.and/or /.false]
                ])

(template.the (commutativity ,x)
              [(?.let [this (|type|)
                       that (|type|)]
                      (?.= (|type|)
                           (,x this that)
                           (,x that this)))])

(template.with [,theorem_on_extension ,theorem_on_definition ,definition ,extension ,axiom ,property]
               [(_.the .public ,theorem_on_extension
                       (..commutativity ,extension)
                       (<| (..induction "this")
                           (..induction "that")
                           (!.= (all by.and
                                     (by.= ,axiom)
                                     (let [== (by.= ,property)]
                                          (in.b64 == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==)))
                                (by.= ,axiom))))

                (_.the .public ,theorem_on_definition
                       (..commutativity ,definition)
                       (!.= (all by.and
                                 (by.of by.definition (list in.any in.any))
                                 (by.= ,theorem_on_extension))
                            (by.of by.definition (list in.any in.any))))]

               [[commutativity_of_b64_or commutativity_of_or /.or .b64_or# ..or //bit.commutativity_of_or]
                [commutativity_of_b64_and commutativity_of_and /.and .b64_and# ..and //bit.commutativity_of_and]
                [commutativity_of_b64_and/or commutativity_of_and/or /.and/or .b64_and/or# ..and/or //bit.commutativity_of_and/or]
                ])

(template.the (associativity ,x)
              [(?.let [this (|type|)
                       that (|type|)
                       else (|type|)]
                      (?.= (|type|)
                           (,x this (,x that else))
                           (,x (,x this that) else)))])

(template.with [,theorem_of_extension ,extension ,theorem_of_definition ,definition ,axiom ,in ,theorem]
               [(_.the .public ,theorem_of_extension
                       (associativity ,extension)
                       (<| (..induction "this")
                           (..induction "that")
                           (..induction "else")
                           (!.= (all by.and
                                     (,in in.any
                                          (by.= ,axiom))
                                     (by.= ,axiom)
                                     (let [== (by.= ,theorem)]
                                          (in.b64 == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==
                                                  == == == == == == == ==)))
                                (all by.and
                                     (,in (by.= ,axiom)
                                          in.any)
                                     (by.= ,axiom)))))

                (_.the .public ,theorem_of_definition
                       (associativity ,definition)
                       (!.= (all by.and
                                 (by.of by.definition (list in.any
                                                            (by.of by.definition (list in.any
                                                                                       in.any))))
                                 (by.= ,theorem_of_extension))
                            (by.of by.definition (list (by.of by.definition (list in.any
                                                                                  in.any))
                                                       in.any))))]

               [[associativity_of_b64_or .b64_or# associativity_of_or /.or ..or in.b64_or //bit.associativity_of_or]
                [associativity_of_b64_and .b64_and# associativity_of_and /.and ..and in.b64_and //bit.associativity_of_and]
                [associativity_of_b64_and/or .b64_and/or# associativity_of_and/or /.and/or ..and/or in.b64_and/or //bit.associativity_of_and/or]
                ])

