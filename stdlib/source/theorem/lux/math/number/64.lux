(.using
 [library
  [lux (.except false true not and and/or)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]
    [[0] term]]
   [macro
    [[0] template]
    [[0] expansion]]
   [logic
    [[0] bit (.only)
     [["//" 1] \\theorem]]]
   [abstract
    [[0] monad]]
   [error
    [[0] try]
    [[0] exception]]
   [data
    [[0] pair (.only)
     [["//" 1] \\theorem]]
    [collection
     [[0] list (.open monad)]
     [[0] dictionary]]]
   [math
    [number
     [/64
      [["n"] natural]]]]
   [meta
    [[0] provenance]]
   [[0] function]]]
 [["/"] \\library])

(<| (the .public (induction name_of_variable
                            proof
                            context it)
         (-> induction.Variable
             (Change !.Proof)))
    (let [registry (induction.registry it)])
    (monad.let try.monad
               [register_of_variable (dictionary.value name_of_variable registry)])
    (let [register_of_0 (induction.next_variable registry)
          every_bit (|> (list.domain 64)
                        (list:each (function (_ index)
                                             [(n.+ register_of_0 index)
                                              (text name_of_variable " " (let [it (by n.base_08 as index)]
                                                                              (if (n.< 8 index)
                                                                                  (text "0" it)
                                                                                  it)))]))
                        list.in_reverse)
          registry (dictionary.lacks name_of_variable registry)])
    (when (list.one (<| (function (_ [register name]))
                        (when (dictionary.value name registry)
                              {try.:Success _}
                              {.:Some name}
                              
                              {try.:Failure error}
                              {.:None}))
                    every_bit)
          {.:Some name_of_bit}
          (exception.except induction.name_is_already_in_use [registry name_of_bit])
          
          {.:None}
          (|> it
              (induction.in_proposition (|> every_bit
                                            (list:each (<| (function (_ [register name]))
                                                           (term.new provenance.dummy register name)))
                                            (term.b64 provenance.dummy)
                                            (by.substitution_of_variable register_of_variable)))
              (proof context))))

(template.the (|type|)
              [(.I64 .Any)])

