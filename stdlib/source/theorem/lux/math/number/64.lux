                                   that Number/02
                                   it Number/02]
                                  (?.= (+/02 this (+/02 that it))
                                       (+/02 (+/02 this that) it))))
                    (//pair.induction "this")
                    (//pair.induction "that")
                    (//pair.induction "it")
                    (let [by:simplification (in.pair (all by.and
                                                          (by.= //bit.identity_of_or)
                                                          (//bit.or in.any
                                                                    (by.= //bit.identity_of_or)))
                                                     (all by.and
                                                          (all //bit.or
                                                               (by.= ..majority_of_false)
                                                               in.any
                                                               (by.= ..majority_of_false)
                                                               in.any)
                                                          (//bit.or (//bit.and in.any
                                                                               (by.= //bit.identity_of_or))
                                                                    in.any)
                                                          (by.= //bit.commutativity_in_or)
                                                          (//bit.or in.any
                                                                    (all by.and
                                                                         (//bit.or in.any
                                                                                   (by.= //bit.commutativity_of_or))
                                                                         (by.= //bit.commutativity_in_or)
                                                                         (by.=' (?.in_reverse (by.proposition //bit.associativity_of_or)))
                                                                         (//bit.or in.any
                                                                                   (//bit.or in.any
                                                                                             (all by.and
                                                                                                  (//bit.or (by.=' (?.in_reverse (by.proposition //bit.distributivity_of_or)))
                                                                                                            in.any)
                                                                                                  (by.=' (?.in_reverse (by.proposition //bit.associativity_of_or))))))))))])
                    (!.= (all by.and
                              (by:+/02 in.any (by:+/02 in.any in.any))
                              by:simplification
                              (in.pair (all by.and
                                            (//bit.or in.any
                                                      (by.= //bit.commutativity_of_or))
                                            (by.= //bit.commutativity_in_or))
                                       (all by.and
                                            (//bit.or in.any
                                                      (all by.and
                                                           (//bit.or in.any
                                                                     (//bit.or in.any
                                                                               (all by.and
                                                                                    (by.= //bit.commutativity_in_or)
                                                                                    (//bit.or (by.= //bit.commutativity_of_and)
                                                                                              (all by.and
                                                                                                   (by.= //bit.commutativity_of_or)
                                                                                                   (//bit.or (by.= //bit.commutativity_of_and)
                                                                                                             in.any))))))
                                                           (by.= //bit.commutativity_in_or)))
                                            (by.= //bit.commutativity_in_or))))
                         (all by.and
                              (by.= ..commutativity_of_+/02)
                              (by:+/02 in.any (by:+/02 in.any in.any))
                              by:simplification)))
                ))
