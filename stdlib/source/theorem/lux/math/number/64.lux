                       (?.let [It]
                              [this (I64 It)
                               that (I64 It)]
                              (?.= (I64 It)
                                   (/.<< 1 (,extension this that))
                                   (,extension (/.<< 1 this) (/.<< 1 that))))
                       (<| (..induction "this")
