(template.the (reflexivity ,x ,true)
              [(?.let [it (|type|)]
                      (?.= .Bit
                           (,x it it)
                           ,true))])

(_.the .public reflexivity_of_b64_=
       (reflexivity .b64_=# .true)
       (<| (..induction "it")
           (!.= (let [bit (all by.and
                               (//bit.and (by.= //bit.reflexivity_of_=)
                                          in.any)
                               (by.= //bit.identity_of_and))
                      byte (all by.and bit bit bit bit bit bit bit bit)]
                     (all by.and
                          (by.= ..=)
                          byte byte byte byte byte byte byte

                          bit bit bit bit bit bit bit

                          (by.= //bit.reflexivity_of_=)))
                in.any)))

(_.the .public reflexivity_of_=
       (reflexivity /.= .true)
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.= ..reflexivity_of_b64_=))
            in.any))

(template.the (symmetry ,x)
              [(?.let [this (|type|)
                       that (|type|)]
                      (?.= .Bit
                           (,x this that)
                           (,x that this)))])

(_.the .public symmetry_of_b64_=
       (symmetry .b64_=#)
       (<| (..induction "this")
           (..induction "that")
           (!.= (let [bit (//bit.and (by.= //bit.symmetry_of_=))
                      byte (<<| bit bit bit bit bit bit bit bit)]
                     (all by.and
                          (by.= ..=)
                          (<| byte byte byte byte byte byte byte
                              bit bit bit bit bit bit bit
                              (by.= //bit.symmetry_of_=))))
                (all by.and
                     (by.= ..=)))))

(_.the .public symmetry_of_=
       (symmetry /.=)
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (by.= ..symmetry_of_b64_=))
            (by.of by.definition (list in.any in.any))))

(_.the .public false
       (?.= (|type|)
            (/.not /.true)
            /.false)
       (!.= (all by.and
                 (in.of by.definition (list in.any))
                 (by.= ..non_idempotence_of_or))
            in.any))

(_.the .public true
       (?.= (|type|)
            (/.not /.false)
            /.true)
       (!.= (all by.and
                 (in.of by.definition (list in.any))
                 (by.= ..commutativity_of_or)
                 (by.= ..identity_of_or))
            in.any))

(_.the .public double_negation
       (?.let [it (|type|)]
              (?.= (|type|)
                   (/.not (/.not it))
                   it))
       (!.= (all by.and
                 (in.of by.definition (list (in.of by.definition (list in.any))))
                 (by.= ..associativity_of_or)
                 (in.of in.any (list (by.= ..non_idempotence_of_or) in.any))
                 (by.= ..identity_of_or))
            in.any))

(_.the .public <<
       (?.let [It]
              ['77 Bit '76 Bit '75 Bit '74 Bit '73 Bit '72 Bit '71 Bit '70 Bit
