                                   (,extension (/.>> 1 this) (/.>> 1 that))))
                       (<| (..induction "this")
                           (..induction "that")
                           (!.= (all by.and
                                     (in.b64_>> (by.= ,by))
                                     (by.= ..>>))
                                (all by.and
                                     (,in (by.= ..>>) (by.= ..>>))
                                     (by.= ,by)
                                     (let [== in.any]
                                          (in.b64 ,end
                                                  == == == == == == ==
