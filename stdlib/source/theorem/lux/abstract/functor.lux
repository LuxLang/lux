(.using
 [library
  [lux (.except function)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]
    ["if" hypothesis]
    ["[0]" axiom]]
   ["[0]" function (.only)
    ["//[1]" \\theorem]]
   [data
    ["[0]" case (.only)
     ["//[1]" \\theorem]]
    ["[0]" pair (.only)
     ["//[1]" \\theorem]]]
   [error
    ["[0]" try]]]]
 ["/" \\library])

(<| (axiom.the .public (identity /:each))
    (?.= (/:each function.identity)
         function.identity))

(<| (axiom.the .public (composition /:each))
    (?.let [any_premise any_lemma any_conclusion]
           [before (-> any_premise any_lemma)
            after (-> any_lemma any_conclusion)])
    (?.= (function.composite (/:each after) (/:each before))
         (/:each (function.composite after before))))

(<| (comment "https://en.wikipedia.org/wiki/Functor_(functional_programming)")
    (axiom.the .public (system /:each))
    (?.and (..identity /:each)
           (..composition /:each)))

(these (_.the identity_of_constant
              (..identity /.constant)
              (<| (//function.induction "it")
                  (!.= (by.of by.definition (list in.any in.any))
                       (by.of by.definition (list in.any)))))

       (_.the composition_of_constant
              (..composition /.constant)
              (<| (//function.induction "it")
                  (!.= (all by.and
                            (by.of by.definition (list in.any in.any in.any))
                            (by.of by.definition (list in.any
                                                       (by.of by.definition (list in.any
                                                                                  in.any)))))
                       (by.of by.definition (list in.any in.any)))))

       (_.the .public constant
              (..system /.constant)
              (all !.and
                   (_.proof ..identity_of_constant)
                   (_.proof ..composition_of_constant))))

(these (_.the identity_of_variable
              (..identity /.variable)
              (<| (//function.induction "it")
                  (!.= (all by.and
                            (by.of by.definition (list in.any in.any))
                            (by.of by.definition (list in.any)))
                       (by.of by.definition (list in.any)))))

       (_.the composition_of_variable
              (..composition /.variable)
              (<| (//function.induction "it")
                  (!.= (all by.and
                            (by.of by.definition (list in.any in.any in.any))
                            (by.of by.definition (list in.any
                                                       (by.of by.definition (list in.any
                                                                                  in.any)))))
                       (all by.and
                            (by.of by.definition (list in.any in.any))
                            (by.of by.definition (list in.any in.any in.any))))))

       (_.the .public variable
              (..system /.variable)
              (all !.and
                   (_.proof ..identity_of_variable)
                   (_.proof ..composition_of_variable))))

(these (_.the identity_of_case
              (<| (?.let [Left Right]
                         [left (/.Functor Left)
                          right (/.Functor Right)])
                  (?.if (..system left))
                  (?.if (..system right))
                  (..identity (/.case left right)))
              (<| !.if (.function (_ left_is_functor))
                  !.if (.function (_ right_is_functor))
                  (//function.induction "it")
                  (let [proof (<| (.function (_ the_case the_functor))
                                  if.let [(if.and if.any if.any) the_functor]
                                  (.function (_ [identity' composition']))
                                  (!.= (all by.and
                                            (by.of by.definition (list in.any in.any in.any in.any))
                                            (<| (by.if_case in.any
                                                            the_case)
                                                (in.case the_case)
                                                (all by.and
                                                     (in.of (by.=' identity')
                                                            (list in.any))
                                                     (by.of by.definition (list in.any)))))
                                       (by.of by.definition (list in.any))))])
                  (//case.induction "it"
                                    ["it" (proof by.left left_is_functor)]
                                    ["it" (proof by.right right_is_functor)])))

       (_.the composition_of_case
              (<| (?.let [Left Right]
                         [left (/.Functor Left)
                          right (/.Functor Right)])
                  (?.if (..system left))
                  (?.if (..system right))
                  (..composition (/.case left right)))
              (<| !.if (.function (_ left_is_functor))
                  !.if (.function (_ right_is_functor))
                  (//function.induction "it")
                  (let [proof (<| (.function (_ the_case the_functor))
                                  if.let [(if.and if.any if.any) the_functor]
                                  (.function (_ [identity' composition']))
                                  (!.= (all by.and
                                            (by.of by.definition (list in.any in.any in.any))
                                            (by.of by.definition (list in.any in.any in.any
                                                                       (all by.and
                                                                            (by.of by.definition (list in.any in.any in.any in.any))
                                                                            (<| (by.if_case in.any
                                                                                            the_case)
                                                                                (in.case the_case)
                                                                                in.any))))
                                            (<| (by.if_case in.any
                                                            the_case)
                                                (in.case the_case)
                                                in.any))
                                       (all by.and
                                            (by.of by.definition (list in.any in.any in.any in.any))
                                            (<| (by.if_case in.any
                                                            the_case)
                                                (in.case the_case)
                                                (all by.and
                                                     (in.of (by.=' (?.in_reverse composition'))
                                                            (list in.any))
                                                     (by.of by.definition (list in.any in.any in.any)))))))])
                  (//case.induction "it"
                                    ["it" (proof by.left left_is_functor)]
                                    ["it" (proof by.right right_is_functor)])))

       (_.the .public case
              (<| (?.let [Left Right]
                         [left (/.Functor Left)
                          right (/.Functor Right)])
                  (?.if (..system left))
                  (?.if (..system right))
                  (..system (/.case left right)))
              (<| (!.with (<| ?.over_conjunction
                              ?.over_conjunction
                              ?.any))
                  (all !.and
                       (_.proof ..identity_of_case)
                       (_.proof ..composition_of_case)))))

(these (_.the identity_of_pair
              (<| (?.let [Left Right]
                         [left (/.Functor Left)
                          right (/.Functor Right)])
                  (?.if (..system left))
                  (?.if (..system right))
                  (..identity (/.pair left right)))
              (<| !.if (.function (_ left_is_functor))
                  !.if (.function (_ right_is_functor))
                  (//function.induction "it")
                  (//pair.induction "it"
                                    ["it:left" "it:right"])
                  if.let [(if.and if.any if.any) left_is_functor]
                  (.function (_ [left:identity left:composition]))
                  if.let [(if.and if.any if.any) right_is_functor]
                  (.function (_ [right:identity right:composition]))
                  (!.= (all by.and
                            (by.of by.definition (list in.any in.any in.any in.any))
                            (<| (by.let_pair in.any)
                                (in.pair (all by.and
                                              (in.of (by.=' left:identity) (list in.any))
                                              (by.of by.definition (list in.any)))
                                         (all by.and
                                              (in.of (by.=' right:identity) (list in.any))
                                              (by.of by.definition (list in.any))))))
                       (by.of by.definition (list in.any)))))

       (_.the composition_of_pair
              (<| (?.let [Left Right]
                         [left (/.Functor Left)
                          right (/.Functor Right)])
                  (?.if (..system left))
                  (?.if (..system right))
                  (..composition (/.pair left right)))
              (<| !.if (.function (_ left_is_functor))
                  !.if (.function (_ right_is_functor))
                  (//function.induction "it")
                  (//pair.induction "it"
                                    ["it:left" "it:right"])
                  if.let [(if.and if.any if.any) left_is_functor]
                  (.function (_ [left:identity left:composition]))
                  if.let [(if.and if.any if.any) right_is_functor]
                  (.function (_ [right:identity right:composition]))
                  (!.= (all by.and
                            (by.of by.definition (list in.any in.any in.any))
                            (by.of by.definition (list in.any in.any in.any
                                                       (all by.and
                                                            (by.of by.definition (list in.any in.any in.any in.any))
                                                            (<| (by.let_pair in.any)
                                                                (in.pair in.any
                                                                         in.any)))))
                            (<| (by.let_pair in.any)
                                (in.pair in.any
                                         in.any)))
                       (all by.and
                            (by.of by.definition (list in.any in.any in.any in.any))
                            (<| (by.let_pair in.any)
                                (in.pair (all by.and
                                              (in.of (by.=' (?.in_reverse left:composition)) (list in.any))
                                              (by.of by.definition (list in.any in.any in.any)))
                                         (all by.and
                                              (in.of (by.=' (?.in_reverse right:composition)) (list in.any))
                                              (by.of by.definition (list in.any in.any in.any)))))))))

       (_.the .public pair
              (<| (?.let [Left Right]
                         [left (/.Functor Left)
                          right (/.Functor Right)])
                  (?.if (..system left))
                  (?.if (..system right))
                  (..system (/.pair left right)))
              (<| (!.with (<| ?.over_conjunction
                              ?.over_conjunction
                              ?.any))
                  (all !.and
                       (_.proof ..identity_of_pair)
                       (_.proof ..composition_of_pair)))))

(these (_.the identity_of_function
              (<| (?.let [Output]
                         [output (/.Functor Output)])
                  (?.if (..system output))
                  (..identity (/.function output)))
              (<| !.if (.function (_ output_is_functor))
                  if.let [(if.and if.any if.any) output_is_functor]
                  (.function (_ [output:identity output:composition]))
                  (//function.induction "it")
                  (//function.induction "argument")
                  (!.= (all by.and
                            (by.of by.definition (list in.any in.any in.any in.any))
                            (in.of (by.=' output:identity) (list in.any))
                            (by.of by.definition (list in.any)))
                       (in.of (by.of by.definition (list in.any)) (list in.any)))))

       (_.the composition_of_function
              (<| (?.let [Output]
                         [output (/.Functor Output)])
                  (?.if (..system output))
                  (..composition (/.function output)))
              (<| !.if (.function (_ output_is_functor))
                  if.let [(if.and if.any if.any) output_is_functor]
                  (.function (_ [output:identity output:composition]))
                  (//function.induction "it")
                  (//function.induction "argument")
                  (!.= (all by.and
                            (in.of (by.of by.definition (list in.any in.any in.any)) (list in.any))
                            (by.of (by.of by.definition (list in.any
                                                              in.any
                                                              (by.of by.definition (list in.any
                                                                                         in.any
                                                                                         in.any))))
                                   (list in.any))
                            (in.of in.any (list in.any (by.of in.any (list in.any)))))
                       (all by.and
                            (by.of (by.of by.definition (list in.any)) (list in.any in.any in.any))
                            (in.of (by.=' (?.in_reverse output:composition)) (list in.any))
                            (by.of by.definition (list in.any in.any in.any))))))

       (_.the .public function
              (<| (?.let [Output]
                         [output (/.Functor Output)])
                  (?.if (..system output))
                  (..system (/.function output)))
              (<| (!.with (<| ?.over_conjunction
                              ?.any))
                  (all !.and
                       (_.proof ..identity_of_function)
                       (_.proof ..composition_of_function)))))

(these (_.the identity_of_composite
              (<| (?.let [Outer Inner]
                         [outer (/.Functor Outer)
                          inner (/.Functor Inner)])
                  (?.if (..system outer))
                  (?.if (..system inner))
                  (..identity (/.composite outer inner)))
              (<| !.if (.function (_ outer_is_functor))
                  if.let [(if.and if.any if.any) outer_is_functor]
                  (.function (_ [outer:identity outer:composition]))

                  !.if (.function (_ inner_is_functor))
                  if.let [(if.and if.any if.any) inner_is_functor]
                  (.function (_ [inner:identity inner:composition]))

                  (//function.induction "it")
                  (!.= (all by.and
                            (by.of by.definition (list in.any in.any in.any in.any))
                            (in.of in.any (list (by.=' inner:identity)
                                                in.any))
                            (by.of (all by.and
                                        (by.=' outer:identity)
                                        by.definition)
                                   (list in.any)))
                       (by.of by.definition (list in.any)))))

       (_.the composition_of_composite
              (<| (?.let [Outer Inner]
                         [outer (/.Functor Outer)
                          inner (/.Functor Inner)])
                  (?.if (..system outer))
                  (?.if (..system inner))
                  (..composition (/.composite outer inner)))
              (<| !.if (.function (_ outer_is_functor))
                  if.let [(if.and if.any if.any) outer_is_functor]
                  (.function (_ [outer:identity outer:composition]))

                  !.if (.function (_ inner_is_functor))
                  if.let [(if.and if.any if.any) inner_is_functor]
                  (.function (_ [inner:identity inner:composition]))

                  (//function.induction "it")
                  (!.= (all by.and
                            (by.of by.definition (list in.any in.any in.any))
                            (by.of by.definition (list in.any
                                                       in.any
                                                       in.any
                                                       (by.of by.definition (list in.any
                                                                                  in.any
                                                                                  in.any
                                                                                  in.any)))))
                       (all by.and
                            (by.of by.definition (list in.any in.any in.any in.any))
                            (in.of in.any (list (by.=' (?.in_reverse inner:composition))
                                                in.any))
                            (in.of (by.=' (?.in_reverse outer:composition))
                                   (list in.any))
                            (by.of by.definition (list in.any in.any in.any))))))

       (_.the .public composite
              (<| (?.let [Outer Inner]
                         [outer (/.Functor Outer)
                          inner (/.Functor Inner)])
                  (?.if (..system outer))
                  (?.if (..system inner))
                  (..system (/.composite outer inner)))
              (<| (!.with (<| ?.over_conjunction
                              ?.over_conjunction
                              ?.any))
                  (all !.and
                       (_.proof ..identity_of_composite)
                       (_.proof ..composition_of_composite)))))
