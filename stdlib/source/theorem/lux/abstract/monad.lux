(.using
 [library
  [lux (.except)
   ["[0]" function]
   [macro
    ["[0]" template]
    ["[0]" expansion]]
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]]]
 ["/" \\library])

(<| (expansion.let [/:conjoint (these (by /:it conjoint))
                    /:each (these (by /:it each))
                    /:pure (these (by /:it pure))])
    (these (<| (template.the .public (identity /:Type /:it))
               [(<| (?.let [any]
                           [it any])
                    (?.= (-> (/:Type any)
                             (/:Type any))
                         (function.composite /:conjoint
                                             (/:each /:pure))
                         (function.composite /:conjoint
                                             /:pure)))])

           (<| (template.the .public (associativity /:Type /:it))
               [(<| (?.let [any]
                           [it any])
                    (?.= (-> (/:Type (/:Type (/:Type any)))
                             (/:Type any))
                         (function.composite /:conjoint
                                             (/:each /:conjoint))
                         (function.composite /:conjoint
                                             /:conjoint)))])

           (<| (template.the .public (application /:Type /:it))
               [(<| (?.let [before after]
                           [change (-> before after)])
                    (?.= (-> (/:Type (/:Type before))
                             (/:Type after))
                         (function.composite /:conjoint
                                             (/:each (/:each change)))
                         (function.composite (/:each change)
                                             /:conjoint)))])))

(<| (comment "https://en.wikipedia.org/wiki/Monad_(functional_programming)#Derivation_from_functors")
    (template.the .public (system /:Type /:it))
    [(all ?.and
          (..identity /:Type /:it)
          (..associativity /:Type /:it)
          (..application /:Type /:it))])
