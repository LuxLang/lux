(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad
     ["//[1]" \\theorem]]
    ["[0]" functor (.only Functor)
     ["//[1]" \\theorem]]]
   ["[0]" function
    ["//[1]" \\theorem]]
   [data
    ["[0]" case
     ["//[1]" \\theorem]]]
   [error
    ["[0]" try (.open functor)]]
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]]]
 ["/" \\library])

(_.the .public identity_of_functor
       (?.let [!]
              [dsl (Functor !)]
              (?.if (//functor.system dsl)
                    (//functor.identity (/.functor dsl))))
       (<| !.if (function (_ dsl_is_functor))
           ((!.let [(try.else identity_of_functor
                              (comment (by.by identity_of_functor (list dsl_is_functor))
                                       (?.of identity_of_functor (stack dsl_is_functor))))
                    (in.= (in.of (by.of by.definition (list in.any)) (list in.any))
                          in.any)]))
           (function (_ identity_of_functor))
           (//function.induction "it")
           (//case.induction "it"
                             ["it:pure"
                              (!.= (all by.and
                                        (by.of by.definition (list in.any
                                                                   in.any
                                                                   in.any))
                                        (<| (by.if_case in.any
                                                        by.left)
                                            (in.case by.left)
                                            (by.= //function.identity)))
                                   (by.= //function.identity))]
                             ["it:impure"
                              (<| (!.let_pair {try.:Success dsl_is_functor})
                                  (function (_ [identity_of_functor' composition_of_functor']))
                                  (!.= (all by.and
                                            (by.of by.definition (list in.any
                                                                       in.any
                                                                       in.any))
                                            (<| (by.if_case in.any
                                                            by.right)
                                                (in.case by.right)
                                                (all by.and
                                                     (in.of (by.let in.any in.any)
                                                            (list (by.=' identity_of_functor)
                                                                  in.any))
                                                     (in.of (by.=' identity_of_functor')
                                                            (list in.any))
                                                     (by.= //function.identity))))
                                       (by.= //function.identity)))])))

(_.the .public composition_of_functor
       (?.let [!]
              [dsl (Functor !)]
              (?.if (//functor.system dsl)
                    (//functor.composition (/.functor dsl))))
       (<| !.if (function (_ dsl_is_functor))
           (let [the_functor (by.of by.definition
                                    (list in.any))
                 functor:each (in.of the_functor (list in.any))])
           ((!.let [(try.else composition_of_functor
                              (comment (by.by composition_of_functor (list dsl_is_functor))
                                       (?.of composition_of_functor (stack dsl_is_functor))))
                    (in.= (in.of in.any
                                 (list functor:each
                                       functor:each))
                          functor:each)]))
           (function (_ composition_of_functor))
           (//function.induction "it")
           (//case.induction "it"
                             ["it:pure"
                              (!.= (all by.and
                                        (by.of by.definition (list in.any in.any in.any))
                                        (by.of by.definition (list in.any
                                                                   in.any
                                                                   (all by.and
                                                                        (by.of by.definition (list in.any in.any in.any))
                                                                        (by.if_case in.any
                                                                                    by.left
                                                                                    in.any))))
                                        (by.if_case in.any
                                                    by.left
                                                    in.any))
                                   (all by.and
                                        (by.of by.definition (list in.any in.any in.any))
                                        (<| (by.if_case in.any
                                                        by.left)
                                            (in.case by.left)
                                            (by.of by.definition (list in.any in.any in.any)))))]
                             ["it:impure"
                              (<| (let [the_dsl (by.let in.any in.any)])
                                  (!.let_pair {try.:Success dsl_is_functor})
                                  (function (_ [identity_of_functor' composition_of_functor']))
                                  (!.= (all by.and
                                            (by.of by.definition (list in.any in.any in.any))
                                            (by.of by.definition (list in.any
                                                                       in.any
                                                                       (all by.and
                                                                            (by.of by.definition (list in.any in.any in.any))
                                                                            (<| (by.if_case in.any
                                                                                            by.right)
                                                                                (in.case by.right)
                                                                                (in.of the_dsl (list in.any in.any))))))
                                            (<| (by.if_case in.any
                                                            by.right)
                                                (in.case by.right)
                                                (all by.and
                                                     (in.of the_dsl (list in.any in.any))
                                                     (by.=' (?.in_reverse (by.proposition //function.composite)))
                                                     (in.of (by.=' composition_of_functor')
                                                            (list in.any))
                                                     (in.of in.any (list (by.=' composition_of_functor)
                                                                         in.any)))))
                                       (all by.and
                                            (by.of by.definition (list in.any in.any in.any))
                                            (<| (by.if_case in.any
                                                            by.right)
                                                (in.case by.right)
                                                (in.of the_dsl (list in.any in.any))))))])))

(_.the .public functor
       (?.let [!]
              [dsl (Functor !)]
              (?.if (//functor.system dsl)
                    (//functor.system (/.functor dsl))))
       (<| !.if_and
           (all !.and
                (_.proof ..identity_of_functor)
                (_.proof ..composition_of_functor))))

(the /:conjoint
     (<| (by.let (by.of by.definition (list in.any)))
         (by.let_pair in.any)
         (by.let_pair in.any)
         (by.let in.any)
         in.any))

(the /:each
     (<| (by.let (by.of by.definition (list in.any)))
         (by.let_pair in.any)
         (by.let_pair in.any)
         (by.let in.any)
         in.any))

(the /:pure
     (<| (by.let (by.of by.definition (list in.any)))
         (by.let_pair in.any)
         (by.let_pair in.any)
         (by.let in.any)
         in.any))

(comment (_.the .public identity_of_monad
                (?.let [!]
                       [dsl (Functor !)]
                       (//monad.identity (/.Free !) (/.monad dsl)))
                (!.= in.any
                     in.any))

         (_.the .public associativity_of_monad
                (?.let [!]
                       [dsl (Functor !)]
                       (//monad.associativity (/.Free !) (/.monad dsl)))
                (!.= in.any
                     in.any))

         (_.the .public application_of_monad
                (?.let [!]
                       [dsl (Functor !)]
                       (//monad.application (/.Free !) (/.monad dsl)))
                (!.= in.any
                     in.any))

         (_.the .public monad
                (//monad.system .Maybe /.monad)
                (all !.and
                     (_.proof ..identity_of_monad)
                     (_.proof ..associativity_of_monad)
                     (_.proof ..application_of_monad)))

         (the _ []))
