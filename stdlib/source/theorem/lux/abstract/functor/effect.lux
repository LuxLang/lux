(.using
 [library
  [lux (.except)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   [abstract
    ["[0]" functor
     ["//[1]" \\theorem]]]
   ["[0]" function (.only)
    ["//[1]" \\theorem]]
   [data
    ["[0]" pair
     ["//[1]" \\theorem]]]]]
 ["/" \\library])

(_.the .public identity
       (//functor.identity /.functor)
       (<| (//function.induction "it")
           (//pair.induction "it"
                             ["it:input" "it:output"])
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.let_pair in.any)
                         (in.pair in.any
                                  (by.= //function.left_identity))))
                (by.= //function.identity))))

(_.the .public composition
       (//functor.composition /.functor)
       (<| (//function.induction "it")
           (//pair.induction "it"
                             ["it:input" "it:output"])
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any in.any))
                     (by.of by.definition (list in.any
                                                (all by.and
                                                     (by.of by.definition (list in.any in.any))
                                                     (by.let_pair in.any
                                                                  in.any))))
                     (<| (by.let_pair in.any)
                         (in.pair in.any)
                         (by.=' (?.in_reverse (by.proposition //function.associativity_of_composite)))))
                (all by.and
                     (by.of by.definition (list in.any in.any))
                     (by.let_pair in.any
                                  in.any)))))

(_.the .public functor
       (//functor.system /.functor)
       (all !.and
            (_.proof ..identity)
            (_.proof ..composition)))
