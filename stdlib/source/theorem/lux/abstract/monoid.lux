(.using
 [library
  [lux (.except)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]
    [[0] axiom]]]]
 [["/"] \\library])

(<| (axiom.the .public (axiom_of_left_identity /:Type /:identity /:composite))
    (?.let [it /:Type])
    (?.= /:Type
         (/:composite /:identity it)
         it))

(<| (axiom.the .public (axiom_of_right_identity /:Type /:identity /:composite))
    (?.let [it /:Type])
    (?.= /:Type
         (/:composite it /:identity)
         it))

(<| (axiom.the .public (axiom_of_associativity /:Type /:composite))
    (?.let [this /:Type
            that /:Type
            else /:Type])
    (?.= /:Type
         (/:composite (/:composite this that) else)
         (/:composite this (/:composite that else))))

(<| (comment "https://en.wikipedia.org/wiki/Monoid")
    (axiom.the .public (system /:Type /:identity /:composite))
    (all ?.and
         (..axiom_of_left_identity /:Type /:identity /:composite)
         (..axiom_of_right_identity /:Type /:identity /:composite)
         (..axiom_of_associativity /:Type /:composite)))
