(.using
 [library
  [lux (.except by)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]
    ["[0]" term]]
   ["[0]" function]
   [data
    [collection
     ["[0]" dictionary]]]
   [meta
    ["[0]" provenance]]
   [compiler
    [language
     [lux
      ["[0]" analysis]]]]
   [error
    ["[0]" try]
    ["[0]" exception]]
   [abstract
    ["[0]" monad]]]]
 [\\library
  ["[0]" /]])

(the .public (induction name_of_variable [name_of_left if_left] [name_of_right if_right]
                        context it)
     (-> induction.Variable [induction.Variable !.Proof] [induction.Variable !.Proof]
         !.Proof)
     (monad.let try.monad
                [.let [registry (induction.registry it)
                       register_of_case (induction.next_variable registry)]
                 register_of_variable (dictionary.value name_of_variable registry)
                 .let [registry (dictionary.lacks name_of_variable registry)]
                 if_left! (if (dictionary.in_domain? registry name_of_left)
                              (exception.except induction.name_is_already_in_use [registry name_of_left])
                              (|> it
                                  (induction.in_proposition (|> (term.new provenance.dummy register_of_case name_of_left)
                                                                (term.case provenance.dummy by.left)
                                                                (by.substitution_of_variable register_of_variable)))
                                  (if_left context)))
                 if_right! (if (dictionary.in_domain? registry name_of_right)
                               (exception.except induction.name_is_already_in_use [registry name_of_right])
                               (|> it
                                   (induction.in_proposition (|> (term.new provenance.dummy register_of_case name_of_right)
                                                                 (term.case provenance.dummy by.right)
                                                                 (by.substitution_of_variable register_of_variable)))
                                   (if_right context)))]
                (pure (if (induction.valid? if_left!)
                          if_right!
                          if_left!))))

(the (any_by case)
     (-> by.Case
         !.Proof)
     (!.= (all by.and
               (by.of by.definition
                      (list in.any
                            in.any
                            (by.of by.definition (list in.any))))
               (by.if_case in.any
                           case
                           (in.case case
                                    (in.of in.any (list in.any)))))
          (by.of by.definition (list in.any))))

(_.the .public left_by
       (?.let [any_left any_right any]
              [left any_left
               right any_right
               on_left (-> any_left any)
               on_right (-> any_right any)]
              (?.= (/.by on_left on_right (/.left left))
                   (/.left (on_left left))))
       (any_by by.left))

(_.the .public right_by
       (?.let [any_left any_right any]
              [left any_left
               right any_right
               on_left (-> any_left any)
               on_right (-> any_right any)]
              (?.= (/.by on_left on_right (/.right right))
                   (/.right (on_right right))))
       (any_by by.right))

(_.the .public identity_by_by
       (?.let [any_left any_right]
              [it (Or any_left any_right)]
              (?.= (/.by function.identity function.identity it)
                   it))
       (let [proof (function (_ case)
                             (!.= (all by.and
                                       (by.of by.definition
                                              (list in.any
                                                    in.any
                                                    in.any))
                                       (by.if_case in.any
                                                   case
                                                   (in.case case
                                                            (by.of by.definition (list in.any)))))
                                  in.any))]
            (..induction "it"
                         ["it:L" (proof by.left)]
                         ["it:R" (proof by.right)])))
