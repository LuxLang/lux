(.using
 [library
  [lux (.except by)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   ["[0]" function]]]
 [\\library
  ["[0]" /]])

(the (any_by case)
     (-> by.Case
         !.Proof)
     (!.= (all by.and
               (by.of by.definition
                      (list in.any
                            in.any
                            (by.of by.definition (list in.any))))
               (by.of_case in.any
                           case
                           (in.case case
                                    (by.of' in.any (list in.any)))))
          (by.of by.definition (list in.any))))

(_.the .public left_by
       (?.let [any_left any_right any]
              [left any_left
               right any_right
               on_left (-> any_left any)
               on_right (-> any_right any)]
              (?.= (/.by on_left on_right (/.left left))
                   (/.left (on_left left))))
       (any_by by.left))

(_.the .public right_by
       (?.let [any_left any_right any]
              [left any_left
               right any_right
               on_left (-> any_left any)
               on_right (-> any_right any)]
              (?.= (/.by on_left on_right (/.right right))
                   (/.right (on_right right))))
       (any_by by.right))

(_.the .public identity_by_by
       (?.let [any_left any_right]
              [it (Or any_left any_right)]
              (?.= (/.by function.identity function.identity it)
                   it))
       (let [proof (function (_ case)
                             (!.= (all by.and
                                       (by.of by.definition
                                              (list in.any
                                                    in.any
                                                    in.any))
                                       (by.of_case in.any
                                                   case
                                                   (in.case case
                                                            (by.of by.definition (list in.any)))))
                                  in.any))]
            (induction.case (proof by.left)
                            (proof by.right))))
