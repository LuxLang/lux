(.using
 [library
  [lux (.except by)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   ["[0]" function]
   [data
    [collection
     ["[0]" dictionary]]]
   [meta
    ["[0]" provenance]]
   [compiler
    ["@[0]" type]
    [language
     [lux
      ["[0]" analysis]]]]
   [error
    ["[0]" try]
    ["[0]" exception]]
   [abstract
    ["[0]" monad]]]]
 [\\library
  ["[0]" /]])

(the .public (induction name_of_variable [name_of_left name_of_right]
                        if_pair
                        context it)
     (-> induction.Variable [induction.Variable induction.Variable]
         (Change !.Proof))
     (monad.let try.monad
                [.let [registry (induction.registry it)]
                 register_of_variable (dictionary.value name_of_variable registry)
                 .let [register_of_left (induction.next_variable registry)
                       register_of_right (++ register_of_left)]]
                (if (dictionary.in_domain? registry name_of_left)
                    (exception.except induction.name_is_already_in_use [registry name_of_left])

                    (dictionary.in_domain? registry name_of_right)
                    (exception.except induction.name_is_already_in_use [registry name_of_right])

                    (comment "else"
                             (|> it
                                 (induction.in_proposition (by.substitution_of_variable register_of_variable
                                                                                        (?.'pair provenance.dummy
                                                                                                 (?.term provenance.dummy register_of_left name_of_left)
                                                                                                 (?.term provenance.dummy register_of_right name_of_right))))
                                 (if_pair context))))))

(_.the .public left
       (?.let [any_left any_right]
              [left any_left
               right any_right]
              (?.= (/.left [left right])
                   left))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (by.of_pair in.any
                             in.any))
            in.any))

(_.the .public right
       (?.let [any_left any_right]
              [left any_left
               right any_right]
              (?.= (/.right [left right])
                   right))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (by.of_pair in.any
                             in.any))
            in.any))

(_.the .public in_reverse
       (?.let [any_left any_right]
              [left any_left
               right any_right]
              (?.= (/.in_reverse [left right])
                   [right left]))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (by.of_pair in.any
                             (in.pair in.any in.any)))
            in.any))

(_.the .public involution_of_in_reverse
       (?.let [any_left any_right]
              [left any_left
               right any_right]
              (?.= (/.in_reverse (/.in_reverse [left right]))
                   [left right]))
       (let [by_reversal (by.of_pair in.any
                                     (in.pair in.any in.any))]
            (!.= (all by.and
                      (by.of by.definition (list (all by.and
                                                      (by.of by.definition (list in.any))
                                                      by_reversal)))
                      by_reversal)
                 in.any)))

(_.the .public by
       (?.let [any_left any_right
               any_left' any_right']
              [left any_left
               right any_right
               by_left (-> any_left any_left')
               by_right (-> any_right any_right')]
              (?.= (/.by by_left by_right [left right])
                   [(by_left left) (by_right right)]))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (by.of_pair in.any
                             (in.pair (in.of in.any (list in.any))
                                      (in.of in.any (list in.any)))))
            in.any))

(_.the .public identity_by_by
       (?.let [any_left any_right]
              [left any_left
               right any_right]
              (?.= (/.by function.identity function.identity [left right])
                   [left right]))
       (let [by_identity (by.of by.definition (list in.any))]
            (!.= (all by.and
                      (by.= ..by)
                      (in.pair by_identity by_identity))
                 in.any)))
