(.using
 [library
  [lux (.except)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof]
    [["in"] substitution]
    [["by"] rule]
    [[0] term]]
   [[0] error (.only)
    [[0] try (.only Try)]]
   [math
    [number
     [/64
      [[0] natural
       [["//" 1] \\theorem]]]]]
   [data
    [[0] pair
     [["//" 1] \\theorem]]]]]
 [\\library
  [[0] /]]
 [[0] //
  [[1 0] stack]])

(_.the .public empty?_of_empty
       (?.= (/.empty? /.empty)
            true)
       (!.= (all by.and
                 (by.of by.definition (list by.definition))
                 (by.of by.definition (list (by.let_pair in.any in.any)))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(the its_:front
     (by.let_pair in.any in.any))

(the (by_end the_case)
     (-> by.Case
         term.Rule)
     (all by.and
          (by.of by.definition (list in.any in.any))
          (<| (by.let (by.let_pair in.any in.any))
              (by.if_case in.any
                          the_case)
              (by.let_pair in.any)
              in.any)))

(_.the .public empty?_of_end
       (?.let [any]
              [it any
               queue (/.Queue any)]
              (?.= (/.empty? (/.end it queue))
                   false))
       (<| (//pair.induction "queue"
                             ["queue:front" "queue:rear"])
           (//stack.induction "queue:front"
                              (!.= (all by.and
                                        (by.of by.definition (list (by_end by.left)))
                                        (by.of by.definition (list its_:front))
                                        (<| (by.if_case in.any
                                                        by.right)
                                            in.any))
                                   in.any)
                              [["queue:front:head" "queue:front:tail"]
                               (!.= (all by.and
                                         (by.of by.definition (list (by_end by.right)))
                                         (by.of by.definition (list its_:front))
                                         (<| (by.if_case in.any
                                                         by.right)
                                             in.any))
                                    in.any)])))

(_.the .public size_of_empty
       (?.= (/.size /.empty)
            0)
       (!.= (all by.and
                 (by.of by.definition (list by.definition))
                 (by.let_pair in.any in.any)
                 (by.of by.definition (list (by.= //stack.size_of_Empty)
                                            (by.= //stack.size_of_Empty)))
                 (by.= //natural.identity_of_i64_+))
            in.any))

(_.the .public size_of_end
       (?.let [any]
              [it any
               queue (/.Queue any)]
              (?.= (/.size (/.end it queue))
                   (++ (/.size queue))))
       (<| (//pair.induction "queue"
                             ["queue:front" "queue:rear"])
           (//stack.induction "queue:front"
                              (!.= (all by.and
                                        (by.of by.definition (list (by_end by.left)))
                                        (by.let_pair in.any
                                                     (in.of in.any (list (by.= //stack.size_of_Top)
                                                                         in.any)))
                                        (by.of by.definition (list (by.of by.definition (list in.any))
                                                                   in.any)))
                                   (all by.and
                                        (by.of by.definition (list (all by.and
                                                                        (by.of by.definition (list in.any))
                                                                        (<| (by.let_pair in.any)
                                                                            (by.of by.definition (list in.any in.any))))))
                                        (by.= //natural.associativity_of_i64_+)))
                              [["queue:front:head" "queue:front:tail"]
                               (!.= (all by.and
                                         (by.of by.definition (list (by_end by.right)))
                                         (by.let_pair in.any
                                                      (in.of in.any (list (by.= //stack.size_of_Top)
                                                                          in.any)))
                                         (in.of in.any (list in.any
                                                             (all by.and
                                                                  (in.of in.any (list (by.of by.definition (list in.any in.any))))
                                                                  (by.= //stack.size_of_Top)
                                                                  (by.= //natural.successor))))
                                         (by.= //natural.commutativity_in_associativity))
                                    (all by.and
                                         (in.of in.any (list (all by.and
                                                                  (by.of by.definition (list in.any))
                                                                  (<| (by.let_pair in.any)
                                                                      (in.of in.any (list (by.= //stack.size_of_Top)
                                                                                          in.any))))))
                                         (by.= //natural.successor)))])))

(_.the .public front_of_empty
       (?.let [any]
              []
              (?.= (Try any)
                   (/.front (is (/.Queue (?.type any))
                                /.empty))
                   {try.:Failure error.empty}))
       (!.= (all by.and
                 (by.of by.definition (list by.definition))
                 (by.of by.definition (list its_:front))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(_.the .public front_of_end_of_empty
       (?.let [any]
              [it any]
              (?.= (Try any)
                   (/.front (/.end it /.empty))
                   {try.:Success it}))
       (!.= (all by.and
                 (by.of by.definition (list (all by.and
                                                 (in.of in.any (list in.any by.definition))
                                                 (by_end by.left))))
                 (by.of by.definition (list its_:front))
                 (<| (by.if_case in.any by.right)
                     (by.let_pair in.any)
                     in.any))
            in.any))
