(.using
 [library
  [lux (.except only)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]
    [[0] term]]
   [macro
    [[0] template]]
   [documentation
    [[0] remember]]
   [math
    [number
     [/64
      [["n"] natural]]]]
   [[0] function (.only)
    [["//" 1] \\theorem]
    [predicate (.only Predicate)]
    [poly
     [type
      [mix (.only Mix)]]]]
   [transduction (.only Reduction)]
   [abstract
    [[0] monad]
    [[0] functor (.only Functor)
     [["//" 1] \\theorem]]]
   [logic
    [[0] bit
     [["//" 1] \\theorem]]]
   [error
    [[0] try]]
   [meta
    [[0] provenance]]
   [data
    [collection
     [[0] dictionary]]]]]
 [["/"] \\library])

(the .public (induction name_of_variable
                        if_empty
                        if_head
                        context it)
     (-> induction.Variable !.Proof !.Proof
         !.Proof)
     (monad.let try.monad
                [.let [registry (induction.registry it)

                       register_of_head (induction.next_variable registry)
                       name_of_head (text name_of_variable " " "head")

                       register_of_tail (++ register_of_head)
                       name_of_tail (text name_of_variable " " "tail")]
                 register_of_variable (dictionary.value name_of_variable registry)
                 if_empty! (|> it
                               (induction.in_proposition (|> (term.list_empty provenance.dummy)
                                                             (by.substitution_of_variable register_of_variable)))
                               (if_empty context))
                 if_head! (|> it
                              (induction.in_proposition (|> (term.list_head provenance.dummy
                                                                            (term.new provenance.dummy register_of_head name_of_head)
                                                                            (term.new provenance.dummy register_of_tail name_of_tail))
                                                            (by.substitution_of_variable register_of_variable)))
                              (if_head context))]
                (pure (if (induction.valid? if_empty!)
                          if_head!
                          if_empty!))))

(template.with [,destructor ,constructor ,empty ,non_empty]
               [(_.the .public ,empty
                       (?.let [It Return]
                              [when_empty Return
                               when_non_empty (-> It (List It)
                                                  Return)]
                              (?.= (,destructor (.list_empty#)
                                                when_empty
                                                when_non_empty)
                                   when_empty))
                       !.axiom)

                (_.the .public ,non_empty
                       (?.let [It Return]
                              [end It
                               it (List It)
                               when_empty Return
                               when_non_empty (-> It (List It)
                                                  Return)]
                              (?.= (,destructor (,constructor end it)
                                                when_empty
                                                when_non_empty)
                                   (when_non_empty end it)))
                       !.axiom)]

               [[.list_head_if# .list_head# list_head_if_of_empty list_head_if_of_head]
                [.list_tail_if# .list_tail# list_tail_if_of_empty list_tail_if_of_tail]
                ])

(_.the .public any_extension
       (?.let [It]
              [extension It]
              (?.= (.list_head# extension (.list_empty#))
                   (.list_tail# extension (.list_empty#))))
       !.axiom)

(_.the .public commutativity
       (?.let [It]
              [head It
               tail It
               middle (List It)]
              (?.= (|> middle
                       (.list_head# head)
                       (.list_tail# tail))
                   (|> middle
                       (.list_tail# tail)
                       (.list_head# head))))
       !.axiom)

(<| (remember.to_do "2027-01-01"
                    "Canonize the definitions below as the official definitions. Optimize using functional->imperative translation.")
    (these (these (the (size it)
                       (type_of /.size)
                       (.list_head_if# it
                                       0
                                       (<| (function (_ head tail))
                                           (n.+ 1 (size tail)))))

                  (_.the =_size
                         (?.= /.size
                              ..size)
                         !.axiom))

           (these (the (empty? it)
                       (type_of /.empty?)
                       (.list_head_if# it
                                       true
                                       (<| (function (_ head tail))
                                           false)))

                  (_.the =_empty?
                         (?.= /.empty?
                              ..empty?)
                         !.axiom))

           (these (the (mix successor it zero)
                       (type_of /.mix)
                       (.list_head_if# it
                                       zero
                                       (<| (function (_ head tail))
                                           (mix successor tail (successor head zero)))))

                  (_.the =_mix
                         (?.= /.mix
                              ..mix)
                         !.axiom))

           (these (the functor'
                       (type_of /.functor)
                       (is (Functor List)
                           (implementation
                            (the (each value it)
                                 (.list_head_if# it
                                                 (.list_empty#)
                                                 (<| (function (_ head tail))
                                                     (.list_head# (value head) (each value tail))))))))

                  (_.the =_functor
                         (?.= /.functor
                              ..functor')
                         !.axiom))

           (these (the (only ? it)
                       (type_of /.only)
                       (.list_head_if# it
                                       (.list_empty#)
                                       (<| (function (_ head tail))
                                           (if (? head)
                                               (.list_head# head (only ? tail))
                                               (only ? tail)))))

                  (_.the =_only
                         (?.= /.only
                              ..only)
                         !.axiom))

           (these (the (any? ? it)
                       (type_of /.any?)
                       (.list_head_if# it
                                       false
                                       (<| (function (_ head tail))
                                           (and/or (? head)
                                                   (any? ? tail)))))

                  (_.the =_any?
                         (?.= /.any?
                              ..any?)
                         !.axiom))

           (these (the (every? ? it)
                       (type_of /.every?)
                       (.list_head_if# it
                                       true
                                       (<| (function (_ head tail))
                                           (and (? head)
                                                (every? ? tail)))))

                  (_.the =_every?
                         (?.= /.every?
                              ..every?)
                         !.axiom))
           ))

(_.the .public size_of_empty
       (?.= (/.size (.list_empty#))
            0)
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_size)
                             by.definition)
                        (list in.any))
                 (by.= ..list_head_if_of_empty))
            in.any))

(the not_empty!
     (by.of in.any (list in.any in.any)))

(_.the .public size_of_head
       (?.let [It]
              [head It
               tail (List It)]
              (?.= (/.size (.list_head# head tail))
                   (n.+ 1 (/.size tail))))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_size)
                             by.definition)
                        (list in.any))
                 (by.= ..list_head_if_of_head)
                 ..not_empty!)
            (in.of in.any (list in.any (in.of (all by.and
                                                   (by.= ..=_size)
                                                   by.definition)
                                              (list in.any))))))

(_.the .public empty?_of_empty
       (?.= (/.empty? (.list_empty#))
            true)
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_empty?)
                             by.definition)
                        (list in.any))
                 (by.= ..list_head_if_of_empty))
            in.any))

(_.the .public empty?_of_head
       (?.let [It]
              [head It
               tail (List It)]
              (?.= (/.empty? (.list_head# head tail))
                   false))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_empty?)
                             by.definition)
                        (list in.any))
                 (by.= ..list_head_if_of_head)
                 ..not_empty!)
            in.any))

(_.the .public mix_of_empty
       (?.let [One Zero]
              [zero Zero
               successor (Reduction Zero One)]
              (?.= Zero
                   (/.mix successor (.list_empty#) zero)
                   zero))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_mix)
                             by.definition)
                        (list in.any in.any in.any))
                 (by.= ..list_head_if_of_empty))
            in.any))

(_.the .public mix_of_head
       (?.let [One Zero]
              [zero Zero
               successor (Reduction Zero One)
               head One
               tail (List One)]
              (?.= Zero
                   (/.mix successor (.list_head# head tail) zero)
                   (/.mix successor tail (successor head zero))))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_mix)
                             by.definition)
                        (list in.any in.any in.any))
                 (by.= ..list_head_if_of_head)
                 ..not_empty!)
            (in.of (all by.and
                        (by.= ..=_mix)
                        by.definition)
                   (list in.any in.any in.any))))

(_.the identity
       (//functor.identity /.functor)
       (<| (let [identity! (by.of by.definition (list in.any))])
           (//function.induction "it")
           (..induction "it"
                        (!.= (all by.and
                                  (by.of (all by.and
                                              (by.= ..=_functor)
                                              by.definition)
                                         (list in.any in.any))
                                  (by.= ..list_head_if_of_empty))
                             identity!)
                        (!.= (all by.and
                                  (by.of (all by.and
                                              (by.= ..=_functor)
                                              by.definition)
                                         (list in.any in.any))
                                  (by.= ..list_head_if_of_head)
                                  ..not_empty!
                                  (in.list_head identity!
                                                (all by.and
                                                     (in.of (all by.and
                                                                 (by.name (name ..functor'))
                                                                 (by.=' (?.in_reverse (by.proposition ..=_functor))))
                                                            (list in.any in.any))
                                                     (by.of (all by.and
                                                                 (by.=' identity)
                                                                 by.definition)
                                                            (list in.any)))))
                             identity!))))

(_.the composition
       (//functor.composition /.functor)
       (<| (//function.induction "it")
           (..induction "it"
                        (let [of_empty! (<| (function (_ term!))
                                            (all by.and
                                                 (by.of (all by.and
                                                             (by.= ..=_functor)
                                                             by.definition)
                                                        (list in.any term!))
                                                 (by.= ..list_head_if_of_empty)))]
                             (!.= (all by.and
                                       (by.of by.definition (list in.any in.any in.any))
                                       (of_empty! (of_empty! in.any)))
                                  (of_empty! in.any)))
                        (let [of_end! (<| (function (_ term!))
                                          (all by.and
                                               (by.of (all by.and
                                                           (by.= ..=_functor)
                                                           by.definition)
                                                      (list in.any term!))
                                               (by.= ..list_head_if_of_head)
                                               ..not_empty!
                                               (in.list_head in.any
                                                             (in.of (all by.and
                                                                         (by.name (name ..functor'))
                                                                         (by.=' (?.in_reverse (by.proposition ..=_functor))))
                                                                    (list in.any in.any)))))]
                             (!.= (all by.and
                                       (by.of by.definition (list in.any in.any in.any))
                                       (of_end! (of_end! in.any))
                                       (in.list_head in.any
                                                     (all by.and
                                                          (by.=' (?.in_reverse (by.proposition //function.composite)))
                                                          (in.of (by.=' composition)
                                                                 (list in.any)))))
                                  (all by.and
                                       (of_end! in.any)
                                       (in.list_head (by.of by.definition (list in.any in.any in.any))
                                                     in.any)))))))

(_.the .public functor
       (//functor.system /.functor)
       (!.and (_.proof ..identity)
              (_.proof ..composition)))

(_.the .public only_of_empty
       (?.let [It]
              [? (Predicate It)]
              (?.= (/.only ? (.list_empty#))
                   (.list_empty#)))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_only)
                             by.definition)
                        (list in.any in.any))
                 (by.= ..list_head_if_of_empty))
            in.any))

(_.the .public only_of_head_false
       (<| (?.let [It]
                  [? (Predicate It)
                   head It
                   tail (List It)])
           (?.if (?.= (? head)
                      false))
           (?.= (/.only ? (.list_head# head tail))
                (/.only ? tail)))
       (<| !.if (function (_ =_false))
           (!.= (all by.and
                     (by.of (all by.and
                                 (by.= ..=_only)
                                 by.definition)
                            (list in.any in.any))
                     (by.= ..list_head_if_of_head)
                     ..not_empty!
                     (in.if (by.=' =_false)
                            in.any
                            in.any)
                     (by.= //bit.if_false))
                (in.of (all by.and
                            (by.= ..=_only)
                            by.definition)
                       (list in.any in.any)))))

(_.the .public only_of_head_true
       (<| (?.let [It]
                  [? (Predicate It)
                   head It
                   tail (List It)])
           (?.if (?.= (? head)
                      true))
           (?.= (/.only ? (.list_head# head tail))
                (.list_head# head (/.only ? tail))))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of (all by.and
                                 (by.= ..=_only)
                                 by.definition)
                            (list in.any in.any))
                     (by.= ..list_head_if_of_head)
                     ..not_empty!
                     (in.if (by.=' =_true)
                            in.any
                            in.any)
                     (by.= //bit.if_true)
                     (in.list_head in.any
                                   (in.of (all by.and
                                               (by.name (name ..only))
                                               (by.=' (?.in_reverse (by.proposition ..=_only))))
                                          (list in.any in.any))))
                in.any)))

(_.the .public any?_of_empty
       (?.let [It]
              [? (Predicate It)]
              (?.= (/.any? ? (.list_empty#))
                   false))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_any?)
                             by.definition)
                        (list in.any in.any))
                 (by.= ..list_head_if_of_empty))
            in.any))

(_.the .public any?_of_head_false
       (<| (?.let [It]
                  [? (Predicate It)
                   head It
                   tail (List It)])
           (?.if (?.= (? head)
                      false))
           (?.= (/.any? ? (.list_head# head tail))
                (/.any? ? tail)))
       (<| !.if (function (_ =_false))
           (!.= (all by.and
                     (by.of (all by.and
                                 (by.= ..=_any?)
                                 by.definition)
                            (list in.any in.any))
                     (by.= ..list_head_if_of_head)
                     ..not_empty!
                     (in.if (by.=' =_false)
                            in.any
                            in.any)
                     (by.= //bit.if_false))
                (in.of (all by.and
                            (by.= ..=_any?)
                            by.definition)
                       (list in.any in.any)))))

(_.the .public any?_of_head_true
       (<| (?.let [It]
                  [? (Predicate It)
                   head It
                   tail (List It)])
           (?.if (?.= (? head)
                      true))
           (?.= (/.any? ? (.list_head# head tail))
                true))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of (all by.and
                                 (by.= ..=_any?)
                                 by.definition)
                            (list in.any in.any))
                     (by.= ..list_head_if_of_head)
                     ..not_empty!
                     (in.if (by.=' =_true)
                            in.any
                            in.any)
                     (by.= //bit.if_true)
                     (by.= //bit.value_of_true))
                in.any)))

(_.the .public every?_of_empty
       (?.let [It]
              [? (Predicate It)]
              (?.= (/.every? ? (.list_empty#))
                   true))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_every?)
                             by.definition)
                        (list in.any in.any))
                 (by.= ..list_head_if_of_empty))
            in.any))

(_.the .public every?_of_head_false
       (<| (?.let [It]
                  [? (Predicate It)
                   head It
                   tail (List It)])
           (?.if (?.= (? head)
                      false))
           (?.= (/.every? ? (.list_head# head tail))
                false))
       (<| !.if (function (_ =_false))
           (!.= (all by.and
                     (by.of (all by.and
                                 (by.= ..=_every?)
                                 by.definition)
                            (list in.any in.any))
                     (by.= ..list_head_if_of_head)
                     ..not_empty!
                     (in.if (by.=' =_false)
                            in.any
                            in.any)
                     (by.= //bit.if_false)
                     (by.= //bit.value_of_false))
                in.any)))

(_.the .public every?_of_head_true
       (<| (?.let [It]
                  [? (Predicate It)
                   head It
                   tail (List It)])
           (?.if (?.= (? head)
                      true))
           (?.= (/.every? ? (.list_head# head tail))
                (/.every? ? tail)))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of (all by.and
                                 (by.= ..=_every?)
                                 by.definition)
                            (list in.any in.any))
                     (by.= ..list_head_if_of_head)
                     ..not_empty!
                     (in.if (by.=' =_true)
                            in.any
                            in.any)
                     (by.= //bit.if_true))
                (in.of (all by.and
                            (by.= ..=_every?)
                            by.definition)
                       (list in.any in.any)))))

(_.the .public whether_false
       (<| (?.let [It]
                  [it (List It)])
           (?.= (/.whether false
                           it)
                (list)))
       (!.= (by.= //bit.if_false)
            in.any))

(_.the .public whether_true
       (<| (?.let [It]
                  [it (List It)])
           (?.= (/.whether true
                           it)
                it))
       (!.= (by.= //bit.if_true)
            in.any))
