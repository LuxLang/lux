(.using
 [library
  [lux (.except only)
   [["_"] theorem (.only)
    [["?"] proposition]
    [["!"] proof (.only)
     [[0] induction]]
    [["in"] substitution]
    [["by"] rule]]
   [macro
    [[0] template]]
   [documentation
    [[0] remember]]
   [math
    [number
     [/64
      [["n"] natural]]]]
   [function
    [predicate (.only Predicate)]
    [poly
     [type
      [mix (.only Mix)]]]]
   [transduction (.only Reduction)]
   [abstract
    [functor (.only Functor)]]
   [logic
    [[0] bit
     [["//" 1] \\theorem]]]]]
 [["/"] \\library])

(template.with [,destructor ,constructor ,empty ,non_empty]
               [(_.the .public ,empty
                       (?.let [It Return]
                              [when_empty Return
                               when_non_empty (-> It (List It)
                                                  Return)]
                              (?.= (,destructor (.list_empty#)
                                                when_empty
                                                when_non_empty)
                                   when_empty))
                       !.axiom)

                (_.the .public ,non_empty
                       (?.let [It Return]
                              [end It
                               it (List It)
                               when_empty Return
                               when_non_empty (-> It (List It)
                                                  Return)]
                              (?.= (,destructor (,constructor end it)
                                                when_empty
                                                when_non_empty)
                                   (when_non_empty end it)))
                       !.axiom)]

               [[.list_head_if# .list_head# if_head_empty if_head_non_empty]
                [.list_tail_if# .list_tail# if_tail_empty if_tail_non_empty]
                ])

(<| (remember.to_do "2027-01-01"
                    "Canonize the definitions below as the official definitions. Optimize using functional->imperative translation.")
    (these (these (the (size it)
                       (type_of /.size)
                       (.list_head_if# it
                                       0
                                       (<| (function (_ head tail))
                                           (n.+ 1 (size tail)))))

                  (_.the =_size
                         (?.= /.size
                              ..size)
                         !.axiom))

           (these (the (empty? it)
                       (type_of /.empty?)
                       (.list_head_if# it
                                       true
                                       (<| (function (_ head tail))
                                           false)))

                  (_.the =_empty?
                         (?.= /.empty?
                              ..empty?)
                         !.axiom))

           (these (the (mix successor it zero)
                       (type_of /.mix)
                       (.list_head_if# it
                                       zero
                                       (<| (function (_ head tail))
                                           (mix successor tail (successor head zero)))))

                  (_.the =_mix
                         (?.= /.mix
                              ..mix)
                         !.axiom))

           (these (the (any? ? it)
                       (type_of /.any?)
                       (.list_head_if# it
                                       false
                                       (<| (function (_ head tail))
                                           (and/or (? head)
                                                   (any? ? tail)))))

                  (_.the =_any?
                         (?.= /.any?
                              ..any?)
                         !.axiom))
           ))

(_.the .public size_of_empty
       (?.= (/.size (.list_empty#))
            0)
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_size)
                             by.definition)
                        (list in.any))
                 (by.= ..if_head_empty))
            in.any))

(the not_empty!
     (by.of in.any (list in.any in.any)))

(_.the .public size_of_head
       (?.let [It]
              [head It
               tail (List It)]
              (?.= (/.size (.list_head# head tail))
                   (n.+ 1 (/.size tail))))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_size)
                             by.definition)
                        (list in.any))
                 (by.= ..if_head_non_empty)
                 ..not_empty!)
            (in.of in.any (list in.any (in.of (all by.and
                                                   (by.= ..=_size)
                                                   by.definition)
                                              (list in.any))))))

(_.the .public empty?_of_empty
       (?.= (/.empty? (.list_empty#))
            true)
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_empty?)
                             by.definition)
                        (list in.any))
                 (by.= ..if_head_empty))
            in.any))

(_.the .public empty?_of_head
       (?.let [It]
              [head It
               tail (List It)]
              (?.= (/.empty? (.list_head# head tail))
                   false))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_empty?)
                             by.definition)
                        (list in.any))
                 (by.= ..if_head_non_empty)
                 ..not_empty!)
            in.any))

(_.the .public mix_of_empty
       (?.let [One Zero]
              [zero Zero
               successor (Reduction Zero One)]
              (?.= Zero
                   (/.mix successor (.list_empty#) zero)
                   zero))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_mix)
                             by.definition)
                        (list in.any in.any in.any))
                 (by.= ..if_head_empty))
            in.any))

(_.the .public mix_of_head
       (?.let [One Zero]
              [zero Zero
               successor (Reduction Zero One)
               head One
               tail (List One)]
              (?.= Zero
                   (/.mix successor (.list_head# head tail) zero)
                   (/.mix successor tail (successor head zero))))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_mix)
                             by.definition)
                        (list in.any in.any in.any))
                 (by.= ..if_head_non_empty)
                 ..not_empty!)
            (in.of (all by.and
                        (by.= ..=_mix)
                        by.definition)
                   (list in.any in.any in.any))))

(_.the .public any?_of_empty
       (?.let [It]
              [? (Predicate It)]
              (?.= (/.any? ? (.list_empty#))
                   false))
       (!.= (all by.and
                 (by.of (all by.and
                             (by.= ..=_any?)
                             by.definition)
                        (list in.any in.any))
                 (by.= ..if_head_empty))
            in.any))

(_.the .public any?_of_head_false
       (<| (?.let [It]
                  [? (Predicate It)
                   head It
                   tail (List It)])
           (?.if (?.= (? head)
                      false))
           (?.= (/.any? ? (.list_head# head tail))
                (/.any? ? tail)))
       (<| !.if (function (_ =_false))
           (!.= (all by.and
                     (by.of (all by.and
                                 (by.= ..=_any?)
                                 by.definition)
                            (list in.any in.any))
                     (by.= ..if_head_non_empty)
                     ..not_empty!
                     (in.if (by.=' =_false)
                            in.any
                            in.any)
                     (by.= //bit.if_false))
                (in.of (all by.and
                            (by.= ..=_any?)
                            by.definition)
                       (list in.any in.any)))))

(_.the .public any?_of_head_true
       (<| (?.let [It]
                  [? (Predicate It)
                   head It
                   tail (List It)])
           (?.if (?.= (? head)
                      true))
           (?.= (/.any? ? (.list_head# head tail))
                true))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of (all by.and
                                 (by.= ..=_any?)
                                 by.definition)
                            (list in.any in.any))
                     (by.= ..if_head_non_empty)
                     ..not_empty!
                     (in.if (by.=' =_true)
                            in.any
                            in.any)
                     (by.= //bit.if_true)
                     (by.= //bit.value_of_true))
                in.any)))
