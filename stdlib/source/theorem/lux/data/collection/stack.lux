(.using
 [library
  [lux (.except)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   [transduction (.only Reduction)]
   [function
    [predicate (.only Predicate)]]
   [logic
    ["[0]" bit
     ["//[1]" \\theorem]]]
   ["[0]" error (.only)
    ["[0]" try (.only Try)]
    ["[0]" exception]]
   [abstract
    ["[0]" monad]]
   [compiler
    [language
     [lux
      ["[0]" analysis]]]]
   [data
    [collection
     ["[0]" dictionary]]]
   [meta
    ["[0]" provenance]]]]
 [\\library
  ["[0]" /]])

(the .public (induction name_of_variable
                        if_empty
                        [[name_of_head name_of_tail]
                         if_top]
                        context it)
     (-> induction.Variable
         !.Proof
         [[induction.Variable induction.Variable]
          !.Proof]
         !.Proof)
     (monad.let try.monad
                [.let [registry (induction.registry it)
                       register_of_head (induction.next_variable registry)
                       register_of_tail (++ register_of_head)]
                 register_of_variable (dictionary.value name_of_variable registry)
                 .let [registry (dictionary.lacks name_of_variable registry)]
                 if_empty! (|> it
                               (induction.in_proposition (|> (analysis.unit provenance.dummy)
                                                             (?.'case provenance.dummy by.left)
                                                             (by.substitution_of_variable register_of_variable)))
                               (if_empty context))
                 if_top! (if (dictionary.in_domain? registry name_of_head)
                             (exception.except induction.name_is_already_in_use [registry name_of_head])

                             (dictionary.in_domain? registry name_of_tail)
                             (exception.except induction.name_is_already_in_use [registry name_of_tail])
                             
                             (|> it
                                 (induction.in_proposition (|> (?.'pair provenance.dummy
                                                                        (?.variable provenance.dummy register_of_head name_of_head)
                                                                        (?.variable provenance.dummy register_of_tail name_of_tail))
                                                               (?.'case provenance.dummy by.right)
                                                               (by.substitution_of_variable register_of_variable)))
                                 (if_top context)))]
                (pure (if (induction.valid? if_empty!)
                          if_top!
                          if_empty!))))

(_.the .public mix_of_Empty
       (?.let [any_part any_whole]
              [whole any_whole
               composition (Reduction any_whole any_part)]
              (?.= any_whole
                   (/.mix composition {.:Empty} whole)
                   whole))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (<| (by.of_case in.any by.left)
                     in.any))
            in.any))

(_.the .public mix_of_Top
       (?.let [any_part any_whole]
              [whole any_whole
               part any_part
               tail (Stack any_part)
               composition (Reduction any_whole any_part)]
              (?.= any_whole
                   (/.mix composition {.:Top part tail} whole)
                   (/.mix composition tail (composition part whole))))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (<| (by.of_case in.any by.right)
                     (by.of_pair in.any)
                     in.any))
            (by.of' by.definition (list in.any in.any in.any))))

(_.the .public only_of_Empty
       (?.let [any]
              [predicate (Predicate any)]
              (?.= (Stack any)
                   (/.only predicate {.:Empty})
                   {.:Empty}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.of_case in.any by.left)
                     in.any))
            in.any))

(_.the .public only_of_Top_keep
       (<| (?.let [any]
                  [head any
                   tail (Stack any)
                   predicate (Predicate any)])
           (?.if (?.= (predicate head)
                      true))
           (?.= (Stack any)
                (/.only predicate {.:Top head tail})
                {.:Top head (/.only predicate tail)}))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.of_case in.any by.right)
                         (by.of_pair in.any)
                         (all by.and
                              (in.if (by.= =_true) in.any in.any)
                              (by.= //bit.if_true))))
                (in.case by.right (in.pair in.any (by.of' by.definition (list in.any in.any)))))))

(_.the .public only_of_Top_skip
       (<| (?.let [any]
                  [head any
                   tail (Stack any)
                   predicate (Predicate any)])
           (?.if (?.= (predicate head)
                      false))
           (?.= (Stack any)
                (/.only predicate {.:Top head tail})
                (/.only predicate tail)))
       (<| !.if (function (_ =_false))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.of_case in.any by.right)
                         (by.of_pair in.any)
                         (all by.and
                              (in.if (by.= =_false) in.any in.any)
                              (by.= //bit.if_false))))
                (by.of' by.definition (list in.any in.any)))))

(_.the .public size_of_Empty
       (?.= (/.size {.:Empty})
            0)
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.of_case in.any by.left)
                     in.any))
            in.any))

(_.the .public size_of_Top
       (?.let [any]
              [head any
               tail (Stack any)]
              (?.= (/.size {.:Top head tail})
                   (++ (/.size tail))))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.of_case in.any by.right)
                     (by.of_pair in.any)
                     in.any))
            (by.of' in.any (list (by.of' by.definition (list in.any))))))

(_.the .public empty?_=_true
       (?.= (/.empty? {.:Empty})
            true)
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.of_case in.any by.left)
                     in.any))
            in.any))

(_.the .public empty?_=_false
       (?.let [any]
              [head any
               tail (Stack any)]
              (?.= (/.empty? {.:Top head tail})
                   false))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.of_case in.any by.right)
                     in.any))
            in.any))

(_.the .public empty
       (?.= (/.empty? /.empty)
            true)
       (!.= (all by.and
                 (by.of' in.any (list by.definition))
                 (by.= empty?_=_true))
            in.any))

(_.the .public any?_Empty
       (?.let [any]
              [predicate (Predicate any)]
              (?.= (/.any? predicate {.:Empty})
                   false))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.of_case in.any by.left)
                     in.any))
            in.any))

(_.the .public any?_Top_failure
       (<| (?.let [any]
                  [predicate (Predicate any)
                   head any
                   tail (Stack any)])
           (?.if (?.= (predicate head)
                      false))
           (?.= (/.any? predicate {.:Top head tail})
                (/.any? predicate tail)))
       (<| !.if (function (_ =_false))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.of_case in.any by.right)
                         (by.of_pair in.any)
                         (all by.and
                              (//bit.and/or (by.= =_false)
                                            in.any)
                              (by.= //bit.if_false))))
                (by.of' by.definition (list in.any in.any)))))

(_.the .public any?_Top_success
       (<| (?.let [any]
                  [predicate (Predicate any)
                   head any
                   tail (Stack any)])
           (?.if (?.= (predicate head)
                      true))
           (?.= (/.any? predicate {.:Top head tail})
                true))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.of_case in.any by.right)
                         (by.of_pair in.any)
                         (all by.and
                              (//bit.and/or (by.= =_true)
                                            in.any)
                              (by.= //bit.if_true)
                              (by.= //bit.value_of_true))))
                in.any)))

(_.the .public every?_Empty
       (?.let [any]
              [predicate (Predicate any)]
              (?.= (/.every? predicate {.:Empty})
                   true))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.of_case in.any by.left)
                     in.any))
            in.any))

(_.the .public every?_Top_failure
       (<| (?.let [any]
                  [predicate (Predicate any)
                   head any
                   tail (Stack any)])
           (?.if (?.= (predicate head)
                      false))
           (?.= (/.every? predicate {.:Top head tail})
                false))
       (<| !.if (function (_ =_false))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.of_case in.any by.right)
                         (by.of_pair in.any)
                         (all by.and
                              (//bit.and/or (by.= =_false)
                                            in.any)
                              (by.= //bit.if_false)
                              (by.= //bit.value_of_false))))
                in.any)))

(_.the .public every?_Top_success
       (<| (?.let [any]
                  [predicate (Predicate any)
                   head any
                   tail (Stack any)])
           (?.if (?.= (predicate head)
                      true))
           (?.= (/.every? predicate {.:Top head tail})
                (/.every? predicate tail)))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.of_case in.any by.right)
                         (by.of_pair in.any)
                         (all by.and
                              (//bit.and/or (by.= =_true)
                                            in.any)
                              (by.= //bit.if_true))))
                (by.of' by.definition (list in.any in.any)))))

(_.the .public composite_empty_start
       (?.let [any]
              [end (Stack any)]
              (?.= (Stack any)
                   (/.composite {.:Empty} end)
                   end))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.of_case in.any by.left)
                     in.any))
            in.any))

(_.the .public composite_some_start
       (?.let [any]
              [head any
               tail (Stack any)
               end (Stack any)]
              (?.= (Stack any)
                   (/.composite {.:Top head tail} end)
                   {.:Top head (/.composite tail end)}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.of_case in.any by.right)
                     (by.of_pair in.any)
                     in.any))
            (<| (in.case by.right)
                (in.pair in.any)
                (by.of' by.definition (list in.any in.any)))))

(_.the .public composite_empty_end
       (?.let [any]
              [start (Stack any)]
              (?.= (Stack any)
                   (/.composite start {.:Empty})
                   start))
       (..induction "start"
                    (!.= (all by.and
                              (by.of' in.any (list in.any in.any))
                              (by.= ..composite_empty_start))
                         in.any)
                    [["start:head" "start:tail"]
                     (!.= (all by.and
                               (by.= ..composite_some_start)
                               (in.case by.right (in.pair in.any (by.= composite_empty_end))))
                          in.any)]))
