(.using
 [library
  [lux (.except)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   [transduction (.only Reduction)]
   [function
    [predicate (.only Predicate)]]
   [logic
    ["[0]" bit
     ["//[1]" \\theorem]]]
   ["[0]" error (.only)
    ["[0]" try (.only Try)]
    ["[0]" exception]]
   [abstract
    ["[0]" monad]
    ["[0]" functor
     ["//[1]" \\theorem]]
    ["[0]" monoid
     ["//[1]" \\theorem]]]
   [compiler
    [language
     [lux
      ["[0]" analysis]]]]
   [data
    [collection
     ["[0]" dictionary]]]
   [meta
    ["[0]" provenance]]
   ["[0]" function (.only)
    ["//[1]" \\theorem]]]]
 [\\library
  ["[0]" /]])

(the .public (induction name_of_variable
                        if_empty
                        [[name_of_head name_of_tail]
                         if_top]
                        context it)
     (-> induction.Variable
         !.Proof
         [[induction.Variable induction.Variable]
          !.Proof]
         !.Proof)
     (monad.let try.monad
                [.let [registry (induction.registry it)
                       register_of_head (induction.next_variable registry)
                       register_of_tail (++ register_of_head)]
                 register_of_variable (dictionary.value name_of_variable registry)
                 .let [registry (dictionary.lacks name_of_variable registry)]
                 if_empty! (|> it
                               (induction.in_proposition (|> (analysis.unit provenance.dummy)
                                                             (?.'case provenance.dummy by.left)
                                                             (by.substitution_of_variable register_of_variable)))
                               (if_empty context))
                 if_top! (if (dictionary.in_domain? registry name_of_head)
                             (exception.except induction.name_is_already_in_use [registry name_of_head])

                             (dictionary.in_domain? registry name_of_tail)
                             (exception.except induction.name_is_already_in_use [registry name_of_tail])
                             
                             (|> it
                                 (induction.in_proposition (|> (?.'pair provenance.dummy
                                                                        (?.term provenance.dummy register_of_head name_of_head)
                                                                        (?.term provenance.dummy register_of_tail name_of_tail))
                                                               (?.'case provenance.dummy by.right)
                                                               (by.substitution_of_variable register_of_variable)))
                                 (if_top context)))]
                (pure (if (induction.valid? if_empty!)
                          if_top!
                          if_empty!))))

(_.the .public mix_of_Empty
       (?.let [any_part any_whole]
              [whole any_whole
               composition (Reduction any_whole any_part)]
              (?.= any_whole
                   (/.mix composition {.:Empty} whole)
                   whole))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(_.the .public mix_of_Top
       (?.let [any_part any_whole]
              [whole any_whole
               part any_part
               tail (Stack any_part)
               composition (Reduction any_whole any_part)]
              (?.= any_whole
                   (/.mix composition {.:Top part tail} whole)
                   (/.mix composition tail (composition part whole))))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (<| (by.if_case in.any by.right)
                     (by.let_pair in.any)
                     in.any))
            (in.of by.definition (list in.any in.any in.any))))

(_.the .public commutativity_in_mix
       (?.let [any]
              [whole any
               head any
               tail (Stack any)
               reduction (Reduction any any)]
              (<| (?.if (//function.commutativity any reduction))
                  (?.if (//monoid.axiom_of_associativity any reduction))
                  (?.= any
                       (/.mix reduction tail (reduction head whole))
                       (reduction head (/.mix reduction tail whole)))))
       (<| !.if
           (function (_ commutativity))
           !.if
           (function (_ associativity))
           (..induction "tail"
                        (!.= (by.= ..mix_of_Empty)
                             (in.of in.any (list in.any (by.= ..mix_of_Empty))))
                        [["tail:head" "tail:tail"]
                         (!.= (all by.and
                                   (by.= ..mix_of_Top)
                                   (by.entailment commutativity_in_mix (stack commutativity associativity))
                                   (in.of in.any (list in.any (by.entailment commutativity_in_mix (stack commutativity associativity))))
                                   (by.=' (?.in_reverse associativity))
                                   (in.of in.any (list (by.=' commutativity) in.any))
                                   (by.=' associativity))
                              (in.of in.any (list in.any (all by.and
                                                              (by.= ..mix_of_Top)
                                                              (by.entailment commutativity_in_mix (stack commutativity associativity))))))])))

(_.the .public mix_with_constant_function
       (?.let [any]
              [whole any
               head any
               tail (Stack any)
               change (Change any)]
              (?.= any
                   (/.mix (function.constant change) {.:Top head tail} whole)
                   (/.mix (function.constant change) tail (change whole))))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any in.any))
                 (<| (by.if_case in.any by.right)
                     (by.let_pair in.any)
                     (in.of (by.name (name /.mix)) (list in.any in.any
                                                         (in.of (by.of by.definition (list in.any in.any)) (list in.any))))))
            in.any))

(_.the .public only_of_Empty
       (?.let [any]
              [predicate (Predicate any)]
              (?.= (Stack any)
                   (/.only predicate {.:Empty})
                   {.:Empty}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(_.the .public only_of_Top_keep
       (<| (?.let [any]
                  [head any
                   tail (Stack any)
                   predicate (Predicate any)])
           (?.if (?.= (predicate head)
                      true))
           (?.= (Stack any)
                (/.only predicate {.:Top head tail})
                {.:Top head (/.only predicate tail)}))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.if_case in.any by.right)
                         (by.let_pair in.any)
                         (all by.and
                              (in.if (by.=' =_true) in.any in.any)
                              (by.= //bit.if_true))))
                (in.case by.right (in.pair in.any (in.of by.definition (list in.any in.any)))))))

(_.the .public only_of_Top_skip
       (<| (?.let [any]
                  [head any
                   tail (Stack any)
                   predicate (Predicate any)])
           (?.if (?.= (predicate head)
                      false))
           (?.= (Stack any)
                (/.only predicate {.:Top head tail})
                (/.only predicate tail)))
       (<| !.if (function (_ =_false))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.if_case in.any by.right)
                         (by.let_pair in.any)
                         (all by.and
                              (in.if (by.=' =_false) in.any in.any)
                              (by.= //bit.if_false))))
                (in.of by.definition (list in.any in.any)))))

(_.the .public size_of_Empty
       (?.= (/.size {.:Empty})
            0)
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(_.the .public size_of_Top
       (?.let [any]
              [head any
               tail (Stack any)]
              (?.= (/.size {.:Top head tail})
                   (++ (/.size tail))))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.if_case in.any by.right)
                     (by.let_pair in.any)
                     in.any))
            (in.of in.any (list (in.of by.definition (list in.any))))))

(_.the .public empty?_of_Empty_=_true
       (?.= (/.empty? {.:Empty})
            true)
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(_.the .public empty?_of_Top_=_false
       (?.let [any]
              [head any
               tail (Stack any)]
              (?.= (/.empty? {.:Top head tail})
                   false))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.if_case in.any by.right)
                     in.any))
            in.any))

(_.the .public empty
       (?.= (/.empty? /.empty)
            true)
       (!.= (all by.and
                 (in.of in.any (list by.definition))
                 (by.= ..empty?_of_Empty_=_true))
            in.any))

(_.the .public any?_of_Empty
       (?.let [any]
              [predicate (Predicate any)]
              (?.= (/.any? predicate {.:Empty})
                   false))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(_.the .public any?_of_Top_failure
       (<| (?.let [any]
                  [predicate (Predicate any)
                   head any
                   tail (Stack any)])
           (?.if (?.= (predicate head)
                      false))
           (?.= (/.any? predicate {.:Top head tail})
                (/.any? predicate tail)))
       (<| !.if (function (_ =_false))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.if_case in.any by.right)
                         (by.let_pair in.any)
                         (all by.and
                              (//bit.and/or (by.=' =_false)
                                            in.any)
                              (by.= //bit.if_false))))
                (in.of by.definition (list in.any in.any)))))

(_.the .public any?_of_Top_success
       (<| (?.let [any]
                  [predicate (Predicate any)
                   head any
                   tail (Stack any)])
           (?.if (?.= (predicate head)
                      true))
           (?.= (/.any? predicate {.:Top head tail})
                true))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.if_case in.any by.right)
                         (by.let_pair in.any)
                         (all by.and
                              (//bit.and/or (by.=' =_true)
                                            in.any)
                              (by.= //bit.if_true)
                              (by.= //bit.value_of_true))))
                in.any)))

(_.the .public every?_of_Empty
       (?.let [any]
              [predicate (Predicate any)]
              (?.= (/.every? predicate {.:Empty})
                   true))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

