                              (//bit.and/or (by.=' =_false)
                                            in.any)
                              (by.= //bit.if_false)
                              (by.= //bit.value_of_false))))
                in.any)))

(_.the .public every?_of_Top_success
       (<| (?.let [any]
                  [predicate (Predicate any)
                   head any
                   tail (Stack any)])
           (?.if (?.= (predicate head)
                      true))
           (?.= (/.every? predicate {.:Top head tail})
                (/.every? predicate tail)))
       (<| !.if (function (_ =_true))
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any))
                     (<| (by.if_case in.any by.right)
                         (by.let_pair in.any)
                         (all by.and
                              (//bit.and/or (by.=' =_true)
                                            in.any)
                              (by.= //bit.if_true))))
