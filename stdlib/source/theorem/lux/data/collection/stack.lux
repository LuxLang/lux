(_.the .public composite_of_Empty_start
       (?.let [any]
              [end (Stack any)]
              (?.= (Stack any)
                   (/.composite {.:Empty} end)
                   end))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(_.the .public composite_of_Top_start
       (?.let [any]
              [head any
               tail (Stack any)
               end (Stack any)]
              (?.= (Stack any)
                   (/.composite {.:Top head tail} end)
                   {.:Top head (/.composite tail end)}))
       (!.= (all by.and
                 (by.of by.definition (list in.any in.any))
                 (<| (by.if_case in.any by.right)
                     (by.let_pair in.any)
                     in.any))
            (<| (in.case by.right)
                (in.pair in.any)
                (in.of by.definition (list in.any in.any)))))

(_.the .public composite_of_Empty_end
       (?.let [any]
              [start (Stack any)]
              (?.= (Stack any)
                   (/.composite start {.:Empty})
                   start))
       (..induction "start"
                    (!.= (all by.and
                              (in.of in.any (list in.any in.any))
                              (by.= ..composite_of_Empty_start))
                         in.any)
                    [["start:head" "start:tail"]
                     (!.= (all by.and
                               (by.= ..composite_of_Top_start)
                               (in.case by.right (in.pair in.any (by.=' composite_of_Empty_end))))
                          in.any)]))

(_.the axiom_of_associativity
       (?.let [any]
              []
              (//monoid.axiom_of_associativity (Stack any) /.composite))
       (..induction "this"
                    (!.= (all by.and
                              (in.of in.any (list (by.= ..composite_of_Empty_start)
                                                  in.any)))
                         (by.= ..composite_of_Empty_start))
                    [["this:head" "this:tail"]
                     (!.= (all by.and
                               (in.of in.any (list (by.= ..composite_of_Top_start)
                                                   in.any))
                               (by.= ..composite_of_Top_start)
                               (<| (in.case by.right)
                                   (in.pair in.any (by.=' axiom_of_associativity))))
                          (by.= ..composite_of_Top_start))]))

(_.the .public monoid
       (?.let [any]
              []
              (//monoid.system (Stack any) /.empty /.composite))
       (all !.and
            (!.= (all by.and
                      (in.of in.any (list by.definition in.any))
                      (by.= ..composite_of_Empty_start))
                 in.any)
            (!.= (all by.and
                      (in.of in.any (list in.any by.definition))
                      (by.= ..composite_of_Empty_end))
                 in.any)
            (_.proof ..axiom_of_associativity)))

(_.the identity
       (//functor.identity /.functor)
       (<| (//function.induction "")
           (..induction ""
                        (!.= (all by.and
                                  (by.of by.definition (list in.any in.any))
                                  (<| (by.if_case in.any by.left)
                                      in.any))
                             (by.= //function.identity))
                        [["head" "tail"]
                         (!.= (all by.and
                                   (by.of by.definition (list in.any in.any))
                                   (<| (by.if_case in.any by.right)
                                       (by.let_pair in.any)
                                       (in.case by.right (in.pair (by.= //function.identity)
                                                                  (all by.and
                                                                       (in.of (all by.and
                                                                                   (in.of (by.name (name /.functor)) (list in.any))
                                                                                   (by.=' identity))
                                                                              (list in.any))
                                                                       (by.= //function.identity))))))
                              (by.= //function.identity))])))

(_.the composition
       (//functor.composition /.functor)
       (<| (//function.induction "")
           (let ['each (function (_ 'it)
                                 (by.of by.definition (list in.any 'it)))]
                (..induction ""
                             (let [is_empty! (<| (by.if_case in.any by.left)
                                                 in.any)]
                                  (!.= (all by.and
                                            (by.of by.definition (list in.any in.any in.any))
                                            ('each (all by.and
                                                        ('each in.any)
                                                        is_empty!))
                                            is_empty!)
                                       (all by.and
                                            ('each in.any)
                                            is_empty!)))
                             [["head" "tail"]
                              (let [is_top! (<| (by.if_case in.any by.right)
                                                (by.let_pair in.any)
                                                in.any)]
                                   (!.= (all by.and
                                             (by.of by.definition (list in.any in.any in.any))
                                             ('each (all by.and
                                                         ('each in.any)
                                                         is_top!))
                                             is_top!
                                             (<| (in.case by.right)
                                                 (in.pair in.any
                                                          (all by.and
                                                               (in.of (by.name (name /.functor))
                                                                      (list in.any
                                                                            (in.of (by.name (name /.functor))
                                                                                   (list in.any
                                                                                         in.any))))
                                                               (by.=' (?.in_reverse (by.proposition //function.composite)))
                                                               (in.of (by.=' composition)
                                                                      (list in.any))))))
                                        (all by.and
                                             ('each in.any)
                                             is_top!
                                             (<| (in.case by.right)
                                                 (in.pair (by.of by.definition (list in.any in.any in.any))
                                                          (in.of (by.name (name /.functor)) (list in.any in.any)))))))]))))

(_.the .public functor
       (//functor.system /.functor)
       (!.and (_.proof ..identity)
              (_.proof ..composition)))

(_.the .public top_of_Empty
       (?.let [any]
              []
              (?.= (Try any)
                   (/.top {.:Empty})
                   {try.:Failure error.empty}))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(_.the .public top_of_Top
       (?.let [any]
              [head any
               tail (Stack any)]
              (?.= (Try any)
                   (/.top {.:Top head tail})
                   {try.:Success head}))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.if_case in.any by.right)
                     (by.let_pair in.any)
                     in.any))
            in.any))

(_.the .public pop_of_Empty
       (?.let [any]
              []
              (?.= (Try (Stack any))
                   (/.pop {.:Empty})
                   {try.:Failure error.empty}))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.if_case in.any by.left)
                     in.any))
            in.any))

(_.the .public pop_of_Top
       (?.let [any]
              [head any
               tail (Stack any)]
              (?.= (Try (Stack any))
                   (/.pop {.:Top head tail})
                   {try.:Success tail}))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (<| (by.if_case in.any by.right)
                     (by.let_pair in.any)
                     in.any))
            in.any))
