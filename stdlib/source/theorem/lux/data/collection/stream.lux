(.using
 [library
  [lux (.except)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   [function
    ["[0]" continuation
     ["//[1]" \\theorem]]]]]
 ["/" \\library])

(_.the .public head_of_repeated
       (?.let [any]
              [it any]
              (?.= any
                   (/.head (/.repeated it))
                   it))
       (!.= (all by.and
                 (by.of by.definition (list (by.of by.definition (list in.any))))
                 (by.let_pair (by.= //continuation.value)
                              in.any))
            in.any))

(_.the .public tail_of_repeated
       (?.let [any]
              [it any]
              (?.= (/.Stream any)
                   (/.tail (/.repeated it))
                   (/.repeated it)))
       (!.= (all by.and
                 (by.of by.definition (list (by.of by.definition (list in.any))))
                 (by.let_pair (by.= //continuation.value)
                              in.any)
                 (by.of in.any (list in.any)))
            (by.of by.definition (list in.any))))
