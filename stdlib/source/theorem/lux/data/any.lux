(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad]
    ["[0]" equality
     ["[1]" \\theorem]]]
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   [error
    ["[0]" try]
    ["[0]" exception]]
   [compiler
    [language
     [lux
      ["[0]" analysis]]]]
   [data
    [collection
     ["[0]" dictionary]]]
   [meta
    ["[0]" provenance]]]]
 [\\library
  ["[0]" /]])

(the .public (induction name_of_variable
                        if_any
                        context it)
     (-> induction.Variable
         (Change !.Proof))
     (monad.let try.monad
                [.let [registry (induction.registry it)]
                 register_of_variable (dictionary.value name_of_variable registry)]
                (|> it
                    (induction.in_proposition (|> (analysis.unit provenance.dummy)
                                                  (by.substitution_of_variable register_of_variable)))
                    (if_any context))))

(<| (comment "https://en.wikipedia.org/wiki/Reflexive_relation")
    (the reflexivity_of_equality'
         (!.= (by.of by.definition (list in.any in.any))
              in.any)))

(_.the .public reflexivity_of_equality
       (equality.axiom_of_reflexivity .Any /.equality)
       ..reflexivity_of_equality')

(the symmetry_of_equality'
     (!.= (by.of by.definition (list in.any in.any))
          (by.of by.definition (list in.any in.any))))

(_.the .public symmetry_of_equality
       (equality.axiom_of_symmetry .Any /.equality)
       ..symmetry_of_equality')

(the transitivity_of_equality'
     (<| !.if (function (_ reference_=_this))
         !.if (function (_ reference_=_that))
         (!.= (by.of by.definition (list in.any in.any))
              in.any)))

(_.the .public transitivity_of_equality
       (equality.axiom_of_transitivity .Any /.equality)
       ..transitivity_of_equality')

(_.the .public equality
       (equality.system .Any /.equality)
       (all !.and
            ..reflexivity_of_equality'
            ..symmetry_of_equality'
            ..transitivity_of_equality'))
