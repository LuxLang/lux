(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" functor
     ["//[1]" \\theorem]]]
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]]]
 [\\library
  ["[0]" /]]
 [///
  [logic
   ["[0]" bit]]])

(the axiom_of_identity
     (induction.function
      (induction.case
       (function (_ @left)
                 (!.= (all by.and
                           (by.of by.definition (list in.any (by.= @left)))
                           (by.of_case in.any
                                       by.left
                                       in.any))
                      (all by.and
                           (by.of by.definition (list in.any))
                           (by.= @left))))
       (function (_ @right)
                 (!.= (all by.and
                           (by.of by.definition (list in.any (by.= @right)))
                           (by.of_case in.any
                                       by.right
                                       in.any)
                           (in.case by.right (by.of by.definition (list in.any))))
                      (all by.and
                           (by.of by.definition (list in.any))
                           (by.= @right)))))))

(the axiom_of_composition
     (induction.function
      (induction.case
       (function (_ @left)
                 (!.= (all by.and
                           (by.of by.definition (list in.any in.any (by.= @left)))
                           (by.of by.definition (list in.any in.any))
                           (by.of_case (all by.and
                                            (by.of by.definition (list in.any in.any))
                                            (by.of_case in.any
                                                        by.left
                                                        in.any))
                                       by.left
                                       in.any))
                      (all by.and
                           (by.of by.definition (list in.any (by.= @left)))
                           (by.of_case in.any
                                       by.left
                                       in.any))))
       (function (_ @right)
                 (!.= (all by.and
                           (by.of by.definition (list in.any in.any (by.= @right)))
                           (by.of by.definition (list in.any in.any))
                           (by.of_case (all by.and
                                            (by.of by.definition (list in.any in.any))
                                            (by.of_case in.any
                                                        by.right
                                                        in.any))
                                       by.right
                                       in.any))
                      (all by.and
                           (by.of by.definition (list in.any (by.= @right)))
                           (by.of_case in.any
                                       by.right
                                       in.any)
                           (in.case by.right (by.of by.definition (list in.any in.any in.any)))))))))

(_.the .public functor
       (//functor.system /.functor)
       (!.and ..axiom_of_identity
              ..axiom_of_composition))

(_.the .public else|:None
       (?.let [any]
              [it any]
              (?.= (/.else it {.:None})
                   it))
       (!.= (by.let (by.of_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public else|:Some
       (?.let [any]
              [it any
               else any]
              (?.= (/.else else {.:Some it})
                   it))
       (!.= (by.let (by.of_case in.any
                                by.right
                                in.any))
            in.any))

(_.the .public as_list|:None
       (?.= (/.as_list {.:None})
            (.list))
       (!.= (all by.and
                 (by.of (by.definition) (list in.any))
                 (by.of_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public as_list|:Some
       (?.let [any]
              [it any]
              (?.= (/.as_list {.:Some it})
                   (.list it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (by.of_case in.any
                             by.right
                             (in.list (list in.any))))
            in.any))

(_.the .public whether|false
       (?.let [any]
              [it (Maybe any)]
              (?.= (Maybe any)
                   (/.whether .false it)
                   {.:None}))
       (!.= (by.if by.definition in.any)
            in.any))

(_.the .public whether|true
       (?.let [any]
              [it (Maybe any)]
              (?.= (Maybe any)
                   (/.whether .true it)
                   it))
       (!.= (by.= bit.if_true)
            in.any))

(_.the .public or|:None
       (?.let [any]
              [it (Maybe any)]
              (?.= (Maybe any)
                   (/.or {.:None} it)
                   it))
       (!.= (by.let (by.of_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public or|:Some
       (?.let [any]
              [it any
               else (Maybe any)]
              (?.= (Maybe any)
                   (/.or {.:Some it} else)
                   {.:Some it}))
       (!.= (by.let (by.of_case in.any
                                by.right
                                in.any))
            in.any))

(_.the .public if|:None
       (?.let [any]
              [then any
               else any]
              (?.= (/.if [it {.:None}]
                         then
                         else)
                   else))
       (!.= (by.let (by.of_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public if|:Some
       (?.let [any any_premise]
              [some any_premise
               then (-> any_premise any)
               else any]
              (?.= (/.if [it {.:Some some}]
                         (then it)
                         else)
                   (then some)))
       (!.= (by.let (by.of_case in.any
                                by.right
                                (by.of' in.any (list in.any))))
            in.any))
