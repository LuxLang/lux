(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad]
    ["[0]" functor
     ["//[1]" \\theorem]]]
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]]
   [error
    ["[0]" try]
    ["[0]" exception]]
   [compiler
    [language
     [lux
      ["[0]" analysis]]]]
   [data
    [collection
     ["[0]" dictionary]]]
   [meta
    ["[0]" provenance]]
   ["[0]" function
    ["//[1]" \\theorem]]]]
 [\\library
  ["[0]" /]]
 [///
  [logic
   ["[0]" bit]]])

(the .public (induction name_of_variable
                        if_none
                        [name_of_some
                         if_some]
                        context it)
     (-> induction.Variable
         !.Proof
         [induction.Variable
          !.Proof]
         !.Proof)
     (monad.let try.monad
                [.let [registry (induction.registry it)
                       register_of_some (induction.next_variable registry)]
                 register_of_variable (dictionary.value name_of_variable registry)
                 .let [registry (dictionary.lacks name_of_variable registry)]
                 if_none! (|> it
                              (induction.in_proposition (|> (analysis.unit provenance.dummy)
                                                            (?.'case provenance.dummy by.left)
                                                            (by.substitution_of_variable register_of_variable)))
                              (if_none context))
                 if_some! (if (dictionary.in_domain? registry name_of_some)
                              (exception.except induction.name_is_already_in_use [registry name_of_some])
                              (|> it
                                  (induction.in_proposition (|> (?.term provenance.dummy register_of_some name_of_some)
                                                                (?.'case provenance.dummy by.right)
                                                                (by.substitution_of_variable register_of_variable)))
                                  (if_some context)))]
                (pure (if (induction.valid? if_none!)
                          if_some!
                          if_none!))))

(the axiom_of_identity
     (<| (//function.induction "it")
         (..induction "it"
                      (!.= (all by.and
                                (by.of by.definition (list in.any in.any))
                                (by.if_case in.any
                                            by.left
                                            in.any))
                           (all by.and
                                (by.of by.definition (list in.any))
                                in.any))
                      ["it" (!.= (all by.and
                                      (by.of by.definition (list in.any in.any))
                                      (by.if_case in.any
                                                  by.right
                                                  in.any)
                                      (in.case by.right (by.of by.definition (list in.any))))
                                 (all by.and
                                      (by.of by.definition (list in.any))
                                      in.any))])))

(the axiom_of_composition
     (<| (//function.induction "it")
         (..induction "it"
                      (!.= (all by.and
                                (by.of by.definition (list in.any in.any in.any))
                                (by.of by.definition (list in.any in.any))
                                (by.if_case (all by.and
                                                 (by.of by.definition (list in.any in.any))
                                                 (by.if_case in.any
                                                             by.left
                                                             in.any))
                                            by.left
                                            in.any))
                           (all by.and
                                (by.of by.definition (list in.any in.any))
                                (by.if_case in.any
                                            by.left
                                            in.any)))
                      ["it" (!.= (all by.and
                                      (by.of by.definition (list in.any in.any in.any))
                                      (by.of by.definition (list in.any in.any))
                                      (by.if_case (all by.and
                                                       (by.of by.definition (list in.any in.any))
                                                       (by.if_case in.any
                                                                   by.right
                                                                   in.any))
                                                  by.right
                                                  in.any))
                                 (all by.and
                                      (by.of by.definition (list in.any in.any))
                                      (by.if_case in.any
                                                  by.right
                                                  in.any)
                                      (in.case by.right (by.of by.definition (list in.any in.any in.any)))))])))

(_.the .public functor
       (//functor.system /.functor)
       (!.and ..axiom_of_identity
              ..axiom_of_composition))

(_.the .public else|:None
       (?.let [any]
              [it any]
              (?.= (/.else it {.:None})
                   it))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public else|:Some
       (?.let [any]
              [it any
               else any]
              (?.= (/.else else {.:Some it})
                   it))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.right
                                in.any))
            in.any))

(_.the .public as_list|:None
       (?.= (/.as_list {.:None})
            (.list))
       (!.= (all by.and
                 (by.of (by.definition) (list in.any))
                 (by.if_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public as_list|:Some
       (?.let [any]
              [it any]
              (?.= (/.as_list {.:Some it})
                   (.list it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (by.if_case in.any
                             by.right
                             (in.list (list in.any))))
            in.any))

(_.the .public whether|false
       (?.let [any]
              [it (Maybe any)]
              (?.= (Maybe any)
                   (/.whether .false it)
                   {.:None}))
       (!.= (by.if by.definition in.any)
            in.any))

(_.the .public whether|true
       (?.let [any]
              [it (Maybe any)]
              (?.= (Maybe any)
                   (/.whether .true it)
                   it))
       (!.= (by.= bit.if_true)
            in.any))

(_.the .public or|:None
       (?.let [any]
              [it (Maybe any)]
              (?.= (Maybe any)
                   (/.or {.:None} it)
                   it))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public or|:Some
       (?.let [any]
              [it any
               else (Maybe any)]
              (?.= (Maybe any)
                   (/.or {.:Some it} else)
                   {.:Some it}))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.right
                                in.any))
            in.any))

(_.the .public if|:None
       (?.let [any]
              [then any
               else any]
              (?.= (/.if [it {.:None}]
                         then
                         else)
                   else))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public if|:Some
       (?.let [any any_premise]
              [some any_premise
               then (-> any_premise any)
               else any]
              (?.= (/.if [it {.:Some some}]
                         (then it)
                         else)
                   (then some)))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.right
                                (in.of in.any (list in.any))))
            in.any))
