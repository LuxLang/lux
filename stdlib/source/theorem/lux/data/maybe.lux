(.using
 [library
  [lux (.except)
   [abstract
    ["[0]" monad (.only)
     ["//[1]" \\theorem]]
    ["[0]" functor
     ["//[1]" \\theorem]]]
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]
    ["[0]" term]]
   [error
    ["[0]" try]
    ["[0]" exception]]
   [compiler
    [language
     [lux
      ["[0]" analysis]]]]
   [data
    [collection
     ["[0]" dictionary]]]
   [meta
    ["[0]" provenance]]
   ["[0]" function
    ["//[1]" \\theorem]]]]
 [\\library
  ["[0]" /]]
 [///
  [logic
   ["[0]" bit]]])

(the .public (induction name_of_variable
                        if_none
                        [name_of_some
                         if_some]
                        context it)
     (-> induction.Variable
         !.Proof
         [induction.Variable
          !.Proof]
         !.Proof)
     (monad.let try.monad
                [.let [registry (induction.registry it)
                       register_of_some (induction.next_variable registry)]
                 register_of_variable (dictionary.value name_of_variable registry)
                 .let [registry (dictionary.lacks name_of_variable registry)]
                 if_none! (|> it
                              (induction.in_proposition (|> (analysis.unit provenance.dummy)
                                                            (term.case provenance.dummy by.left)
                                                            (by.substitution_of_variable register_of_variable)))
                              (if_none context))
                 if_some! (if (dictionary.in_domain? registry name_of_some)
                              (exception.except induction.name_is_already_in_use [registry name_of_some])
                              (|> it
                                  (induction.in_proposition (|> (term.new provenance.dummy register_of_some name_of_some)
                                                                (term.case provenance.dummy by.right)
                                                                (by.substitution_of_variable register_of_variable)))
                                  (if_some context)))]
                (pure (if (induction.valid? if_none!)
                          if_some!
                          if_none!))))

(the identity
     (<| (//function.induction "it")
         (..induction "it"
                      (!.= (all by.and
                                (by.of by.definition (list in.any in.any))
                                (by.if_case in.any
                                            by.left
                                            in.any))
                           (all by.and
                                (by.of by.definition (list in.any))
                                in.any))
                      ["it" (!.= (all by.and
                                      (by.of by.definition (list in.any in.any))
                                      (by.if_case in.any
                                                  by.right
                                                  in.any)
                                      (in.case by.right (by.of by.definition (list in.any))))
                                 (all by.and
                                      (by.of by.definition (list in.any))
                                      in.any))])))

(the composition
     (<| (//function.induction "it")
         (..induction "it"
                      (!.= (all by.and
                                (by.of by.definition (list in.any in.any in.any))
                                (by.of by.definition (list in.any in.any))
                                (by.if_case (all by.and
                                                 (by.of by.definition (list in.any in.any))
                                                 (by.if_case in.any
                                                             by.left
                                                             in.any))
                                            by.left
                                            in.any))
                           (all by.and
                                (by.of by.definition (list in.any in.any))
                                (by.if_case in.any
                                            by.left
                                            in.any)))
                      ["it" (!.= (all by.and
                                      (by.of by.definition (list in.any in.any in.any))
                                      (by.of by.definition (list in.any in.any))
                                      (by.if_case (all by.and
                                                       (by.of by.definition (list in.any in.any))
                                                       (by.if_case in.any
                                                                   by.right
                                                                   in.any))
                                                  by.right
                                                  in.any))
                                 (all by.and
                                      (by.of by.definition (list in.any in.any))
                                      (by.if_case in.any
                                                  by.right
                                                  in.any)
                                      (in.case by.right (by.of by.definition (list in.any in.any in.any)))))])))

(_.the .public functor
       (//functor.system /.functor)
       (!.and ..identity
              ..composition))

(_.the .public else|:None
       (?.let [any]
              [it any]
              (?.= (/.else it {.:None})
                   it))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public else|:Some
       (?.let [any]
              [it any
               else any]
              (?.= (/.else else {.:Some it})
                   it))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.right
                                in.any))
            in.any))

(_.the .public as_list|:None
       (?.= (/.as_list {.:None})
            (.list))
       (!.= (all by.and
                 (by.of (by.definition) (list in.any))
                 (by.if_case in.any
                             by.left
                             in.any))
            in.any))

(_.the .public as_list|:Some
       (?.let [any]
              [it any]
              (?.= (/.as_list {.:Some it})
                   (.list it)))
       (!.= (all by.and
                 (by.of by.definition (list in.any))
                 (by.if_case in.any
                             by.right
                             (in.list (list in.any))))
            in.any))

(_.the .public whether|false
       (?.let [any]
              [it (Maybe any)]
              (?.= (Maybe any)
                   (/.whether .false it)
                   {.:None}))
       (!.= (by.if by.definition in.any)
            in.any))

(_.the .public whether|true
       (?.let [any]
              [it (Maybe any)]
              (?.= (Maybe any)
                   (/.whether .true it)
                   it))
       (!.= (by.= bit.if_true)
            in.any))

(_.the .public or|:None
       (?.let [any]
              [it (Maybe any)]
              (?.= (Maybe any)
                   (/.or {.:None} it)
                   it))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public or|:Some
       (?.let [any]
              [it any
               else (Maybe any)]
              (?.= (Maybe any)
                   (/.or {.:Some it} else)
                   {.:Some it}))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.right
                                in.any))
            in.any))

(_.the .public if|:None
       (?.let [any]
              [then any
               else any]
              (?.= (/.if [it {.:None}]
                         then
                         else)
                   else))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.left
                                in.any))
            in.any))

(_.the .public if|:Some
       (?.let [any any_premise]
              [some any_premise
               then (-> any_premise any)
               else any]
              (?.= (/.if [it {.:Some some}]
                         (then it)
                         else)
                   (then some)))
       (!.= (by.let in.any
                    (by.if_case in.any
                                by.right
                                (in.of in.any (list in.any))))
            in.any))

(the /:conjoint
     (<| (by.let_pair by.definition)
         (by.let_pair in.any)
         (by.let in.any)
         in.any))

(the /:each
     (<| (by.let_pair by.definition)
         (by.let_pair in.any)
         (by.let in.any)
         by.definition))

(the /:pure
     (<| (by.let_pair by.definition)
         (by.let_pair in.any)
         (by.let in.any)
         in.any))

(the if_none
     (by.if_case in.any
                 by.left
                 in.any))

(the (if_some it)
     (by.if_case in.any
                 by.right
                 it))

(_.the .public identity_of_monad
       (//monad.identity .Maybe /.monad)
       (<| (//function.induction "it")
           (let [pure>>conjoint (all by.and
                                     (by.of by.definition (list /:conjoint
                                                                /:pure
                                                                in.any))
                                     (by.of in.any (list (by.of in.any (list in.any))))
                                     (..if_some in.any))])
           (..induction "it"
                        (!.= (all by.and
                                  (by.of by.definition (list /:conjoint
                                                             (in.of /:each (list /:pure))
                                                             in.any))
                                  (by.of in.any (list (all by.and
                                                           (by.of in.any (list in.any in.any))
                                                           ..if_none)))
                                  ..if_none)
                             pure>>conjoint)
                        ["it" (!.= (all by.and
                                        (by.of by.definition (list /:conjoint
                                                                   (in.of /:each (list /:pure))
                                                                   in.any))
                                        (by.of in.any (list (all by.and
                                                                 (by.of in.any (list in.any in.any))
                                                                 (<| ..if_some
                                                                     (in.case by.right)
                                                                     (by.of in.any (list in.any))))))
                                        (..if_some in.any))
                                   pure>>conjoint)])))

(_.the .public associativity_of_monad
       (//monad.associativity .Maybe /.monad)
       (<| (//function.induction "it")
           (..induction "it"
                        (!.= (all by.and
                                  (by.of by.definition (list /:conjoint
                                                             (in.of /:each (list /:conjoint))
                                                             in.any))
                                  (by.of in.any (list (all by.and
                                                           (by.of in.any (list in.any in.any))
                                                           ..if_none)))
                                  ..if_none)
                             (all by.and
                                  (by.of by.definition (list /:conjoint
                                                             /:conjoint
                                                             in.any))
                                  (by.of in.any (list (all by.and
                                                           (by.of in.any (list in.any))
                                                           ..if_none)))
                                  ..if_none))
                        ["it" (let [when_some (function (_ the_side)
                                                        (!.= (all by.and
                                                                  (by.of by.definition (list /:conjoint
                                                                                             (in.of /:each (list /:conjoint))
                                                                                             in.any))
                                                                  (by.of in.any (list (all by.and
                                                                                           (by.of in.any (list in.any in.any))
                                                                                           (<| ..if_some
                                                                                               (in.case by.right)
                                                                                               (all by.and
                                                                                                    (by.of in.any (list in.any))
                                                                                                    (by.if_case in.any
                                                                                                                the_side
                                                                                                                in.any))))))
                                                                  (..if_some in.any))
                                                             (all by.and
                                                                  (by.of by.definition (list /:conjoint
                                                                                             /:conjoint
                                                                                             in.any))
                                                                  (by.of in.any (list (all by.and
                                                                                           (by.of in.any (list in.any))
                                                                                           (..if_some in.any))))
                                                                  (by.if_case in.any
                                                                              the_side
                                                                              in.any))))]
                                   (..induction "it"
                                                (when_some by.left)
                                                ["it" (when_some by.right)]))])))

(_.the .public application_of_monad
       (//monad.application .Maybe /.monad)
       (<| (//function.induction "it")
           (..induction "it"
                        (!.= (all by.and
                                  (by.of by.definition (list /:conjoint
                                                             (in.of /:each (list (in.of /:each (list in.any))))
                                                             in.any))
                                  (by.of in.any (list (all by.and
                                                           (by.of in.any (list in.any
                                                                               in.any))
                                                           ..if_none)))
                                  ..if_none)
                             (all by.and
                                  (by.of by.definition (list (in.of /:each (list in.any))
                                                             /:conjoint
                                                             in.any))
                                  (by.of in.any (list in.any
                                                      (all by.and
                                                           (by.of in.any (list in.any))
                                                           ..if_none)))
                                  ..if_none))
                        ["it" (let [when_some (function (_ if_case)
                                                        (!.= (all by.and
                                                                  (by.of by.definition (list /:conjoint
                                                                                             (in.of /:each (list (in.of /:each (list in.any))))
                                                                                             in.any))
                                                                  (by.of in.any (list (all by.and
                                                                                           (by.of in.any (list in.any
                                                                                                               in.any))
                                                                                           (<| ..if_some
                                                                                               (in.case by.right)
                                                                                               (all by.and
                                                                                                    (by.of in.any (list in.any in.any))
                                                                                                    if_case)))))
                                                                  (..if_some in.any))
                                                             (all by.and
                                                                  (by.of by.definition (list (in.of /:each (list in.any))
                                                                                             /:conjoint
                                                                                             in.any))
                                                                  (by.of in.any (list in.any
                                                                                      (all by.and
                                                                                           (by.of in.any (list in.any))
                                                                                           (..if_some in.any))))
                                                                  if_case)))]
                                   (..induction "it"
                                                (when_some ..if_none)
                                                ["it" (when_some (..if_some in.any))]))])))

(_.the .public monad
       (//monad.system .Maybe /.monad)
       (all !.and
            (_.proof ..identity_of_monad)
            (_.proof ..associativity_of_monad)
            (_.proof ..application_of_monad)))
