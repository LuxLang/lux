(.using
 [library
  [lux (.except and and/or if not false true)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]
     ["[0]" inference]
     ["[0]" contradiction]]
    ["in" substitution]
    ["by" rule]]
   [error
    ["[0]" try]]
   [abstract
    ["[0]" monad]
    ["[0]" equality
     ["[1]" \\theorem]]
    [order
     ["[0]" total
      ["[1]" strong
       ["[1]" \\theorem]]]]
    ["[0]" monoid
     ["[1]" \\theorem]]]
   [meta
    ["[0]" provenance]]
   [compiler
    [language
     [lux
      ["[0]" analysis]]]]
   [macro
    ["[0]" template]]
   [data
    [collection
     ["[0]" dictionary]]]]]
 [\\library
  ["[0]" /]])

(the .public (induction name_of_variable if_false if_true
                        context it)
     (-> induction.Variable !.Proof !.Proof
         !.Proof)
     (monad.let try.monad
                [register_of_variable (dictionary.value name_of_variable (induction.registry it))
                 if_false! (|> it
                               (induction.in_proposition (by.substitution_of_variable register_of_variable (analysis.bit provenance.dummy 0b)))
                               (if_false context))
                 if_true! (|> it
                              (induction.in_proposition (by.substitution_of_variable register_of_variable (analysis.bit provenance.dummy 1b)))
                              (if_true context))]
                (pure (.if (induction.valid? if_false!)
                           if_true!
                           if_false!))))

(the .public (and/or this that)
     (-> in.Rule in.Rule
         in.Rule)
     (in.if this in.any that))

(the .public (and this that)
     (-> in.Rule in.Rule
         in.Rule)
     (in.if this that in.any))

(the (if cause effect)
     (-> in.Rule in.Rule
         in.Rule)
     (in.of in.any (list cause effect)))

(the (not it)
     (-> in.Rule
         in.Rule)
     (in.of in.any (list it)))

(<| (comment "https://en.wikipedia.org/wiki/Boolean_algebra#Laws")
    (the (|not| it)
         (Change in.Rule)
         (all by.and
              (by.of by.definition (list it))
              (by.if in.any in.any))))

(the by_true
     (all by.and
          by.definition
          (|not| by.definition)))

(_.the .public value_of_false
       (?.= 0b
            .false)
       (!.= in.any
            by.definition))

(_.the .public value_of_true
       (?.= 1b
            .true)
       (!.= in.any
            by_true))

(_.the .public if_true
       (?.let [it]
              [then it
               else it]
              (?.= (.if .true
                        then
                        else)
                   then))
       (!.= (by.if by_true in.any)
            in.any))

(_.the .public if_false
       (?.let [it]
              [then it
               else it]
              (?.= (.if .false
                        then
                        else)
                   else))
       (!.= (by.if by.definition in.any)
            in.any))

(_.the .public true
       (?.= (.not .false)
            .true)
       (!.= in.any
            by.definition))

(<| (comment "https://en.wikipedia.org/wiki/Double_negation")
    (_.the .public double_negation
           (?.let [it Bit]
                  (?.= (.not (.not it))
                       it))
           (let [either_way (!.= (|not| (|not| in.any))
                                 in.any)]
                (..induction "it"
                             either_way
                             either_way))))

(_.the .public false
       (?.= (.not .true)
            .false)
       (!.= (all by.and
                 (in.of in.any (list by.definition))
                 (by.= double_negation))
            in.any))

(<| (comment "https://en.wikipedia.org/wiki/Idempotence")
    (template.with [,theorem ,composition]
                   [(_.the .public ,theorem
                           (?.let [it Bit]
                                  (?.= (,composition it it)
                                       it))
                           (..induction "it"
                                        (!.= (by.if in.any in.any)
                                             in.any)
                                        (!.= (by.if in.any in.any)
                                             in.any)))]

                   [[idempotence_of_and/or .and/or]
                    [idempotence_of_and .and]
                    ]))

(template.with [,theorem ,composition ,identity ,value]
               [(_.the .public ,theorem
                       (?.let [it Bit]
                              (?.= (,composition ,identity it)
                                   it))
                       (!.= (by.if ,value in.any)
                            in.any))]

               [[identity_of_and/or .and/or .false by.definition]
                [identity_of_and .and .true by_true]
                ])

(template.with [,theorem ,composition ,identity ,value]
               [(_.the .public ,theorem
                       (?.let [it Bit]
                              (?.= (,composition ,identity it)
                                   ,identity))
                       (!.= (by.if ,value in.any)
                            ,value))]

               [[annihilation_of_and/or .and/or .true by_true]
                [annihilation_of_and .and .false by.definition]
                ])

(<| (comment "https://en.wikipedia.org/wiki/Commutative_property")
    (_.the .public commutativity_of_and/or
           (?.let [this Bit
                   that Bit]
                  (?.= (.and/or this that)
                       (.and/or that this)))
           (..induction "this"
                        (let [this_=_false (by.= value_of_false)]
                             (..induction "that" (let [that_=_false (by.= value_of_false)]
                                                      (!.= (all by.and
                                                                (in.if this_=_false in.any in.any)
                                                                (by.= ..identity_of_and/or)
                                                                that_=_false)
                                                           (all by.and
                                                                (in.if this_=_false in.any in.any)
                                                                (by.= ..identity_of_and/or)
                                                                this_=_false)))
                                          (let [that_=_true (by.= value_of_true)]
                                               (!.= (all by.and
                                                         (in.if this_=_false in.any in.any)
                                                         (by.= ..identity_of_and/or)
                                                         that_=_true)
                                                    (all by.and
                                                         (in.if that_=_true in.any in.any)
                                                         (by.= ..annihilation_of_and/or))))))
                        (let [this_=_true (by.= value_of_true)]
                             (..induction "that" (let [that_=_false (by.= value_of_false)]
                                                      (!.= (all by.and
                                                                (in.if this_=_true in.any in.any)
                                                                (by.= ..annihilation_of_and/or))
                                                           (all by.and
                                                                (in.if that_=_false in.any in.any)
                                                                (by.= ..identity_of_and/or)
                                                                this_=_true)))
                                          (let [that_=_true (by.= value_of_true)]
                                               (!.= (all by.and
                                                         (in.if this_=_true in.any in.any)
                                                         (by.= ..annihilation_of_and/or))
                                                    (all by.and
                                                         (in.if that_=_true in.any in.any)
                                                         (by.= ..annihilation_of_and/or)))))))))

(_.the .public commutativity_of_and
       (?.let [this Bit
               that Bit]
              (?.= (.and this that)
                   (.and that this)))
       (..induction "this" (let [=this (by.= value_of_false)]
                                (..induction "that"
                                             (let [=that (by.= value_of_false)]
                                                  (!.= (all by.and
                                                            (in.if =this in.any in.any)
                                                            (by.= ..annihilation_of_and))
                                                       (all by.and
                                                            (in.if =that in.any in.any)
                                                            (by.= ..annihilation_of_and))))
                                             (let [=that (by.= value_of_true)]
                                                  (!.= (all by.and
                                                            (in.if =this in.any in.any)
                                                            (by.= ..annihilation_of_and))
                                                       (all by.and
                                                            (in.if =that in.any in.any)
                                                            (by.= ..identity_of_and)
                                                            =this)))))
                    (let [=this (by.= value_of_true)]
                         (..induction "that"
                                      (let [=that (by.= value_of_false)]
                                           (!.= (all by.and
                                                     (in.if =this in.any in.any)
                                                     (by.= ..identity_of_and)
                                                     =that)
                                                (all by.and
                                                     (in.if =that in.any in.any)
                                                     (by.= ..annihilation_of_and))))
                                      (let [=that (by.= value_of_true)]
                                           (!.= (all by.and
                                                     (in.if =this in.any in.any)
                                                     (by.= ..identity_of_and)
                                                     =that)
                                                (all by.and
                                                     (in.if =that in.any in.any)
                                                     (by.= ..identity_of_and)
                                                     =this)))))))

(<| (comment "https://en.wikipedia.org/wiki/Complement_(set_theory)"
             "https://en.wikipedia.org/wiki/Law_of_excluded_middle")
    (_.the .public complementation_of_and/or
           (?.let [it Bit]
                  (?.= (.and/or it (.not it))
                       .true))
           (..induction "it"
                        (let [=_false (by.= value_of_false)]
                             (!.= (all by.and
                                       (in.if =_false in.any in.any)
                                       (by.= identity_of_and/or)
                                       (in.of in.any (list =_false)))
                                  by.definition))
                        (let [=_true (by.= value_of_true)]
                             (!.= (all by.and
                                       (in.if =_true in.any in.any)
                                       (by.= annihilation_of_and/or))
                                  in.any)))))

(<| (comment "https://en.wikipedia.org/wiki/Law_of_noncontradiction")
    (_.the .public complementation_of_and
           (?.let [it Bit]
                  (?.= (.and it (.not it))
                       .false))
           (..induction "it"
                        (let [=it (by.= value_of_false)]
                             (!.= (all by.and
                                       (in.if =it in.any in.any)
                                       (by.= annihilation_of_and))
                                  in.any))
                        (let [=it (by.= value_of_true)]
                             (!.= (all by.and
                                       (in.if =it in.any in.any)
                                       (by.= identity_of_and)
                                       (in.of in.any (list =it))
                                       (by.= ..false))
                                  in.any)))))

(<| (comment "https://en.wikipedia.org/wiki/Associative_property")
    (_.the .public associativity_of_and/or
           (?.let [$0 Bit
                   $1 Bit
                   $2 Bit]
                  (?.= (.and/or $0 (.and/or $1 $2))
                       (.and/or (.and/or $0 $1) $2)))
           (..induction "$0"
                        (let [$0_=_false (by.= value_of_false)]
                             (..induction "$1"
                                          (let [$1_=_false (by.= value_of_false)]
                                               (!.= (all by.and
                                                         (in.if $0_=_false in.any in.any)
                                                         (by.= identity_of_and/or)
                                                         (in.if $1_=_false in.any in.any)
                                                         (by.= identity_of_and/or))
                                                    (all by.and
                                                         (in.if (all by.and
                                                                     (in.if $0_=_false in.any in.any)
                                                                     (by.= identity_of_and/or)
                                                                     $1_=_false)
                                                                in.any in.any)
                                                         (by.= identity_of_and/or))))
                                          (let [$1_=_true (by.= value_of_true)]
                                               (!.= (all by.and
                                                         (in.if $0_=_false in.any in.any)
                                                         (by.= identity_of_and/or)
                                                         (in.if $1_=_true in.any in.any)
                                                         (by.= annihilation_of_and/or))
                                                    (all by.and
                                                         (in.if (all by.and
                                                                     (in.if $0_=_false in.any in.any)
                                                                     (by.= identity_of_and/or)
                                                                     $1_=_true)
                                                                in.any in.any)
                                                         (by.= annihilation_of_and/or))))))
                        (let [$0_=_true (by.= value_of_true)]
                             (!.= (all by.and
                                       (in.if $0_=_true in.any in.any)
                                       (by.= annihilation_of_and/or))
                                  (all by.and
                                       (in.if (all by.and
                                                   (in.if $0_=_true in.any in.any)
                                                   (by.= annihilation_of_and/or))
                                              in.any in.any)
                                       (by.= annihilation_of_and/or)))))))

(_.the .public associativity_of_and
       (?.let [$0 Bit
               $1 Bit
               $2 Bit]
              (?.= (.and $0 (.and $1 $2))
                   (.and (.and $0 $1) $2)))
       (..induction "$0"
                    (let [=0 (by.= value_of_false)]
                         (!.= (all by.and
                                   (in.if =0 in.any in.any)
                                   (by.= annihilation_of_and))
                              (all by.and
                                   (in.if (all by.and
                                               (in.if =0 in.any in.any)
                                               (by.= annihilation_of_and))
                                          in.any in.any)
                                   (by.= annihilation_of_and))))
                    (let [=0 (by.= value_of_true)]
                         (..induction "$1"
                                      (let [=1 (by.= value_of_false)]
                                           (!.= (all by.and
                                                     (in.if =0 in.any in.any)
                                                     (by.= identity_of_and)
                                                     (in.if =1 in.any in.any)
                                                     (by.= annihilation_of_and))
                                                (all by.and
                                                     (in.if (all by.and
                                                                 (in.if =0 in.any in.any)
                                                                 (by.= identity_of_and)
                                                                 =1)
                                                            in.any in.any)
                                                     (by.= annihilation_of_and))))
                                      (let [=1 (by.= value_of_true)]
                                           (!.= (all by.and
                                                     (in.if =0 in.any in.any)
                                                     (by.= identity_of_and)
                                                     (in.if =1 in.any in.any)
                                                     (by.= identity_of_and))
                                                (all by.and
                                                     (in.if (all by.and
                                                                 (in.if =0 in.any in.any)
                                                                 (by.= identity_of_and)
                                                                 =1)
                                                            in.any in.any)
                                                     (by.= identity_of_and))))))))

(<| (comment "https://en.wikipedia.org/wiki/Distributive_property")
    (_.the .public distributivity_of_and/or
           (?.let [$0 Bit
                   $1 Bit
                   $2 Bit]
                  (?.= (.and (.and/or $0 $1) (.and/or $0 $2))
                       (.and/or $0 (.and $1 $2))))
           (..induction "$0"
                        (let [=_false (by.= value_of_false)
                              $or_false (all by.and
                                             (in.if =_false in.any in.any)
                                             (by.= identity_of_and/or))]
                             (!.= (in.if $or_false $or_false in.any)
                                  $or_false))
                        (let [=_true (by.= value_of_true)
                              $or_true (all by.and
                                            (in.if =_true in.any in.any)
                                            (by.= annihilation_of_and/or))]
                             (!.= (all by.and
                                       (in.if $or_true $or_true in.any)
                                       (by.= identity_of_and))
                                  $or_true))
                        )))

(_.the .public distributivity_of_and
       (?.let [$0 Bit
               $1 Bit
               $2 Bit]
              (?.= (.and/or (.and $0 $1) (.and $0 $2))
                   (.and $0 (.and/or $1 $2))))
       (..induction "$0"
                    (let [=0 (by.= value_of_false)
                          annihilation (all by.and
                                            (in.if =0 in.any in.any)
                                            (by.= annihilation_of_and))]
                         (!.= (all by.and
                                   (in.if annihilation in.any annihilation)
                                   (by.= identity_of_and/or))
                              annihilation))
                    (let [=0 (by.= value_of_true)
                          identity (all by.and
                                        (in.if =0 in.any in.any)
                                        (by.= identity_of_and))]
                         (!.= (in.if identity in.any identity)
                              identity))
                    ))

(<| (comment "https://en.wikipedia.org/wiki/De_Morgan%27s_laws")
    (_.the .public negation_of_and/or
           (?.let [this Bit
                   that Bit]
                  (?.= (.and (.not this) (.not that))
                       (.not (.and/or this that))))
           (..induction "this"
                        (let [=this (by.= value_of_false)]
                             (!.= (all by.and
                                       (in.if (all by.and
                                                   (in.of in.any (list =this))
                                                   (by.= ..true))
                                              in.any in.any)
                                       (by.= identity_of_and))
                                  (in.of in.any
                                         (list (all by.and
                                                    (in.if =this in.any in.any)
                                                    (by.= identity_of_and/or))))))
                        (let [=this (by.= value_of_true)]
                             (!.= (all by.and
                                       (in.if (all by.and
                                                   (in.of in.any (list =this))
                                                   (by.= ..false))
                                              in.any in.any)
                                       (by.= annihilation_of_and))
                                  (all by.and
                                       (in.of in.any
                                              (list (all by.and
                                                         (in.if =this in.any in.any)
                                                         (by.= annihilation_of_and/or))))
                                       (by.= ..false)))))))

(_.the .public negation_of_and
       (?.let [this Bit
               that Bit]
              (?.= (.and/or (.not this) (.not that))
                   (.not (.and this that))))
       (..induction "this"
                    (let [=this (by.= value_of_false)]
                         (!.= (all by.and
                                   (in.if (all by.and
                                               (in.of in.any (list =this))
                                               (by.= ..true))
                                          in.any in.any)
                                   (by.= annihilation_of_and/or))
                              (all by.and
                                   (in.of in.any
                                          (list (all by.and
                                                     (in.if =this in.any in.any)
                                                     (by.= annihilation_of_and))))
                                   (by.= ..true))))
                    (let [=this (by.= value_of_true)]
                         (!.= (all by.and
                                   (in.if (all by.and
                                               (in.of in.any (list =this))
                                               (by.= ..false))
                                          in.any in.any)
                                   (by.= identity_of_and/or))
                              (in.of in.any
                                     (list (all by.and
                                                (in.if =this in.any in.any)
                                                (by.= identity_of_and))))))))

(_.the .public absorption_of_and/or
       (?.let [this Bit
               that Bit]
              (?.= (.and/or this (.and this that))
                   this))
       (..induction "this"
                    (let [=this (by.= value_of_false)]
                         (!.= (all by.and
                                   (in.if =this in.any in.any)
                                   (by.= identity_of_and/or)
                                   (in.if =this in.any in.any)
                                   (by.= annihilation_of_and))
                              =this))
                    (let [=this (by.= value_of_true)]
                         (!.= (all by.and
                                   (in.if =this in.any in.any)
                                   (by.= annihilation_of_and/or))
                              =this))))

(_.the .public absorption_of_and
       (?.let [this Bit
               that Bit]
              (?.= (.and this (.and/or this that))
                   this))
       (..induction "this"
                    (let [=this (by.= value_of_false)]
                         (!.= (all by.and
                                   (in.if =this in.any in.any)
                                   (by.= annihilation_of_and))
                              =this))
                    (let [=this (by.= value_of_true)]
                         (!.= (all by.and
                                   (in.if =this in.any in.any)
                                   (by.= identity_of_and)
                                   (in.if =this in.any in.any)
                                   (by.= annihilation_of_and/or))
                              =this))))

(_.the .public if_not
       (?.let [it]
              [test Bit
               then it
               else it]
              (?.= (.if (.not test)
                        then
                        else)
                   (.if test
                        else
                        then)))
       (..induction "test"
                    (let [=this (by.= value_of_false)]
                         (!.= (all by.and
                                   (in.if (all by.and
                                               (in.of in.any (list =this))
                                               (by.= ..true))
                                          in.any in.any)
                                   (by.= if_true))
                              (all by.and
                                   (in.if =this in.any in.any)
                                   (by.= if_false))))
                    (let [=this (by.= value_of_true)]
                         (!.= (all by.and
                                   (in.if (all by.and
                                               (in.of in.any (list =this))
                                               (by.= ..false))
                                          in.any in.any)
                                   (by.= if_false))
                              (all by.and
                                   (in.if =this in.any in.any)
                                   (by.= if_true))))))

(<| (comment "https://en.wikipedia.org/wiki/Exclusive_or#Properties")
    (_.the .public identity_of_or
           (?.let [it Bit]
                  (?.= (/.or .false it)
                       it))
           (!.= (all by.and
                     (by.of by.definition (list by.definition in.any))
                     (by.if in.any in.any))
                in.any)))

(_.the .public negation_by_or
       (?.let [it Bit]
              (?.= (/.or .true it)
                   (.not it)))
       (!.= (all by.and
                 (by.of by.definition (list by_true in.any))
                 (by.if in.any in.any))
            in.any))

(_.the .public non_idempotence_of_or
       (?.let [it Bit]
              (?.= (/.or it it)
                   .false))
       (..induction "it"
                    (!.= (all by.and
                              (by.of by.definition (list in.any in.any))
                              (by.if in.any in.any))
                         by.definition)
                    (let [=it (by.= value_of_true)]
                         (!.= (all by.and
                                   (by.of by.definition (list in.any =it))
                                   (by.if in.any in.any)
                                   (by.= ..false))
                              in.any))))

(<| (comment "https://en.wikipedia.org/wiki/Complement_(set_theory)")
    (_.the .public complementation_of_or
           (?.let [it Bit]
                  (?.= (/.or it (.not it))
                       .true))
           (..induction "it"
                        (let [=it (by.= value_of_false)]
                             (!.= (all by.and
                                       (by.of by.definition (list in.any (in.of in.any (list =it))))
                                       (by.if in.any in.any)
                                       (by.= ..true))
                                  in.any))
                        (let [=it (by.= value_of_true)]
                             (!.= (all by.and
                                       (by.of by.definition (list in.any (in.of in.any (list =it))))
                                       (by.if in.any in.any)
                                       (by.= double_negation))
                                  in.any)))))

(<| (comment "https://en.wikipedia.org/wiki/Commutative_property")
    (_.the .public commutativity_of_or
           (?.let [this Bit
                   that Bit]
                  (?.= (/.or this that)
                       (/.or that this)))
           (..induction "this"
                        (let [=this (by.= value_of_false)]
                             (..induction "that"
                                          (let [=that (by.= value_of_false)]
                                               (!.= (in.of in.any (list =this =that))
                                                    (in.of in.any (list =that =this))))
                                          (let [=that (by.= value_of_true)]
                                               (!.= (all by.and
                                                         (by.of by.definition (list in.any =that))
                                                         (by.if in.any in.any))
                                                    (all by.and
                                                         (by.of by.definition (list in.any =this))
                                                         (by.if in.any in.any)
                                                         (by.= ..true))))))
                        (let [=this (by.= value_of_true)]
                             (..induction "that"
                                          (let [=that (by.= value_of_false)]
                                               (!.= (all by.and
                                                         (by.of by.definition (list in.any =that))
                                                         (by.if in.any in.any)
                                                         (by.= ..true))
                                                    (all by.and
                                                         (by.of by.definition (list in.any =this))
                                                         (by.if in.any in.any))))
                                          (let [=that (by.= value_of_true)]
                                               (!.= (in.of in.any (list =this =that))
                                                    (in.of in.any (list =that =this)))))))))

(_.the .public negation_in_or
       (?.let [this Bit
               that Bit]
              (?.= (/.or (.not this) that)
                   (.not (/.or this that))))
       (..induction "this"
                    (let [=this (by.= value_of_false)]
                         (!.= (all by.and
                                   (in.of in.any (list (all by.and
                                                            (in.of in.any (list =this))
                                                            (by.= ..true))
                                                       in.any))
                                   (by.= negation_by_or))
