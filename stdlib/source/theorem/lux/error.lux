(.using
 [library
  [lux (.except)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof]
    ["in" substitution]
    ["by" rule]]
   [macro
    ["[0]" template]]
   [meta
    ["[0]" static]
    ["[0]" name]]]]
 [\\library
  ["[0]" /]])

(template.with [,definition]
               [(`` (_.the .public (,, (template.name [,definition]))
                           (?.= ,definition
                                (,, (static.text (name.proper (name ,definition)))))
                           (!.= by.definition
                                in.any)))]
               [[/.not_valid]
                [/.not_known]
                [/.empty]
                [/.no_instance]
                [/.not_available]
                ])
