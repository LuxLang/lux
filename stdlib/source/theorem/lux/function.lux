(.using
 [library
  [lux (.except and)
   ["_" theorem (.only)
    ["?" proposition]
    ["!" proof (.only)
     ["[0]" induction]]
    ["in" substitution]
    ["by" rule]
    ["[0]" axiom]]
   [data
    ["[0]" case]
    ["[0]" pair]
    [collection
     ["[0]" dictionary]]]
   [meta
    ["[0]" provenance]]
   [compiler
    ["@[0]" type]
    [language
     [lux
      ["[0]" analysis]]]]
   [error
    ["[0]" try]
    ["[0]" exception]]
   [abstract
    ["[0]" monad]
    ["[0]" monoid
     ["//[1]" \\theorem]]]]]
 [\\library
  ["[0]" /]]
 ["[0]" //
  [data
   ["[1][0]" pair]
   ["[1][0]" case]]])

(the .public (induction name_of_variable by_application
                        context it)
     (-> induction.Variable
         (Change !.Proof))
     (monad.let try.monad
                [[expectation reality] (?.identity it)
                 .let [registry (induction.registry it)
                       register_of_variable (induction.next_variable registry)
                       argument (?.term provenance.dummy register_of_variable name_of_variable)]]
                (if (dictionary.in_domain? registry name_of_variable)
                    (exception.except induction.name_is_already_in_use [registry name_of_variable])
                    (by_application context
                                    {?.:Identity [?.:slow {@type.:Application provenance.dummy argument expectation}
                                                  ?.:fast {@type.:Application provenance.dummy argument reality}]}))))

(_.the .public identity
       (?.let [any]
              [it any]
              (?.= (/.identity it)
                   it))
       (!.= (by.of by.definition (list in.any))
            in.any))

(_.the .public constant
       (?.let [any_constant any]
              [constant any_constant
               it any]
              (?.= (/.constant constant it)
                   constant))
       (!.= (by.of by.definition (list in.any in.any))
            in.any))

(_.the .public of
       (?.let [any_premise any_conclusion]
              [premise any_premise
               it (-> any_premise any_conclusion)]
              (?.= (/.of premise it)
                   (it premise)))
       (!.= (by.of by.definition (list in.any in.any))
            in.any))

(_.the .public composite
       (?.let [any_premise any_lemma any_conclusion]
              [before (-> any_premise any_lemma)
               after (-> any_lemma any_conclusion)
               it any_premise]
              (?.= ((/.composite after before) it)
                   (after (before it))))
       (!.= (by.of (by.of by.definition (list in.any in.any))
                   (list in.any))
            in.any))

(_.the .public associativity_of_composite
       (?.let [type_0 type_1 type_2 type_3]
              [after (-> type_2 type_3)
               middle (-> type_1 type_2)
               before (-> type_0 type_1)]
              (?.= (-> type_0 type_3)
                   (/.composite (/.composite after middle) before)
                   (/.composite after (/.composite middle before))))
       (<| (..induction "")
           (!.= (all by.and
                     (by.of by.definition (list in.any in.any in.any))
                     (by.of by.definition (list in.any in.any in.any)))
                (all by.and
                     (by.of by.definition (list in.any in.any in.any))
                     (in.of in.any (list (by.of by.definition (list in.any in.any in.any))))))))

(_.the .public left_identity
       (?.let [any_premise any_conclusion]
              [it (-> any_premise any_conclusion)]
              (?.= (/.composite /.identity it)
                   it))
       (<| (..induction "")
           (!.= (all by.and
                     (by.= ..composite)
                     (by.= ..identity))
                in.any)))

(_.the .public right_identity
       (?.let [any_premise any_conclusion]
              [it (-> any_premise any_conclusion)]
              (?.= (/.composite it /.identity)
                   it))
       (<| (..induction "")
           (!.= (all by.and
                     (by.= ..composite)
                     (in.of in.any (list (by.= ..identity))))
                in.any)))

(_.the .public in_reverse
       (?.let [any_this any_that any_conclusion]
              [this any_this
               that any_that
               it (-> any_this any_that any_conclusion)]
              (?.= ((/.in_reverse it) that this)
                   (it this that)))
       (!.= (by.of (by.of by.definition (list in.any))
                   (list in.any in.any))
            in.any))

(_.the .public double_reversal
       (?.let [any_this any_that any_conclusion]
              [it (-> any_this any_that any_conclusion)]
              (?.= (/.in_reverse (/.in_reverse it))
                   it))
       (<| (..induction "0")
           (..induction "1")
           (!.= (all by.and
                     (by.= ..in_reverse)
                     (by.= ..in_reverse))
                in.any)))

(_.the .public intermediation
       (?.let [premise conclusion]
              [_ premise
               of (-> premise conclusion)]
              (?.= (function (_ it) (of it))
                   of))
       (<| (..induction "")
           (!.= (by.of in.any (list in.any))
                in.any)))

(_.the .public uncurried_is_inverse_of_curried
       (?.let [any_left any_right any]
              [it (-> [any_left any_right] any)]
              (?.= (/.uncurried (/.curried it))
                   it))
       (!.= (all by.and
                 (by.of by.definition (list (by.of by.definition (list in.any))))
                 (in.function (in.it in.any)
                              (function (_ @0)
                                        (by.let_pair' in.any
                                                      (function (_ ==)
                                                                (all by.and
                                                                     (by.of (by.=' @0) (list in.any in.any))
                                                                     (in.of in.any (list (by.=' ==))))))))
                 (by.= ..intermediation))
            in.any))

(_.the .public curried_is_inverse_of_uncurried
       (?.let [any_left any_right any]
              [it (-> any_left any_right any)]
              (?.= (/.curried (/.uncurried it))
                   it))
       (!.= (all by.and
                 (by.of by.definition (list (by.of by.definition (list in.any))))
                 ((in.function (in.it in.any))
                  (function (_ @0)
                            (all by.and
                                 ((in.function (in.and (in.it (by.=' @0))
                                                       (in.it in.any)))
                                  (function (_ [@0 @1])
                                            (all by.and
                                                 (by.of (by.=' @0) (list (in.pair in.any in.any)))
                                                 (by.let_pair in.any
                                                              (in.of in.any (list (by.=' @1)
                                                                                  in.any))))))
                                 (by.= ..intermediation))))
                 (by.= ..intermediation))
            in.any))

(the (or case by_choice)
     (-> by.Case
         (Change in.Rule))
     (all by.and
          (by.of by.definition (list in.any in.any by_choice))
          (by.if_case in.any
                      case
                      (in.of in.any (list in.any)))))

(the (any_or case)
     (!.= (or case (by.of by.definition (list in.any)))
          in.any))

(_.the .public left_or
       (?.let [any_left any_right any]
              [left any_left
               right any_right
               on_left (-> any_left any)
               on_right (-> any_right any)]
              (?.= (/.or on_left on_right (case.left left))
                   (on_left left)))
       (..any_or by.left))

(_.the .public right_or
       (?.let [any_left any_right any]
              [left any_left
               right any_right
               on_left (-> any_left any)
               on_right (-> any_right any)]
              (?.= (/.or on_left on_right (case.right right))
                   (on_right right)))
       (..any_or by.right))

(_.the .public identity_by_or
       (?.let [any_left any_right]
              [it (Or any_left any_right)]
              (?.= (/.or case.left case.right it)
                   it))
       (let [proof (function (_ case)
                             (!.= (all by.and
                                       (or case in.any)
                                       (by.of by.definition (list in.any)))
                                  in.any))]
            (//case.induction "it"
                              ["it:L" (proof by.left)]
                              ["it:R" (proof by.right)])))

(_.the .public double_reversal_of_or
       (?.let [any_left any_right]
              [it (Or any_left any_right)]
              (?.= (/.or case.right case.left (/.or case.right case.left it))
                   it))
       (let [proof (function (_ case)
                             (!.= (all by.and
                                       (or (not case) (all by.and
                                                           (or case in.any)
                                                           (by.of by.definition (list in.any))))
                                       (by.of by.definition (list in.any)))
                                  in.any))]
            (//case.induction "it"
                              ["it:L" (proof by.left)]
                              ["it:R" (proof by.right)])))

(_.the .public and
       (?.let [any any_left any_right]
              [it any
               by_left (-> any any_left)
               by_right (-> any any_right)]
              (?.= [(by_left it) (by_right it)]
                   (/.and by_left by_right it)))
       (!.= in.any
            (by.of by.definition (list in.any in.any in.any))))

(_.the .public identity_by_and
       (?.let [any_left any_right]
              [it [any_left any_right]]
              (?.= (/.and pair.left pair.right it)
                   it))
       (<| (//pair.induction "it" ["it:L" "it:R"])
           (!.= (all by.and
                     (in.of in.any (list in.any in.any in.any))
                     (by.=' (?.in_reverse (by.proposition ..and)))
                     (in.pair (by.= //pair.left) (by.= //pair.right)))
                in.any)))

(<| (comment "https://en.wikipedia.org/wiki/Commutative_property")
    (axiom.the .public (commutativity /:type /:+))
    (?.let [this /:type
            that /:type])
    (?.= (/:+ this that)
         (/:+ that this)))
