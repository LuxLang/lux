(.using
 [library
  [lux (.except type name)
   [abstract
    [["?"] projection (.open functor)]
    [[0] monad]]
   [error
    [[0] try (.open functor)]]
   [data
    [[0] text]
    [collection
     [[0] set (.only Set)]
     [[0] dictionary (.only Dictionary)]
     [[0] list (.only)
      [["?" 1] \\projection]
      [[0] property]]]]
   [meta
    [[0] code (.only)
     [["?" 1] \\projection]]]
   [compiler
    [meta
     [cli
      [compiler (.only Compiler)]]]]
   [world
    [net (.only URL)]
    [[0] file]]]]
 [[0] //
  [["/"] profile]
  [[0] android]
  [[1 0] runtime (.only Runtime)]
  [[1 0] project (.only Project)]
  [[1 0] dependency]
  [[1 0] injection]
  [[1 0] repository
   [[1] remote]]
  [[1 0] artifact (.only Artifact)
   [[1 "/" 0] type]]])

(the (singular input tag projection)
     (for_any (_ a)
              (-> (Dictionary Text Code) Text (?code.Projection a)
                  (?code.Projection a)))
     (?code.locally (|> input
                        (dictionary.value tag)
                        (try:each (|>> (list)))
                        (try.else (list)))
                    projection))

(the (plural input tag projection)
     (for_any (_ a)
              (-> (Dictionary Text Code) Text (?code.Projection a)
                  (?code.Projection (List a))))
     (?code.locally (|> input
                        (dictionary.value tag)
                        (try:each (|>> (list)))
                        (try.else (list)))
                    (?code.tuple (?.some projection))))

(the group
     (?code.Projection //artifact.Group)
     ?code.text)

(the name
     (?code.Projection //artifact.Name)
     ?code.text)

(the version
     (?code.Projection //artifact.Version)
     ?code.text)

(the artifact'
     (?code.Projection //artifact.Artifact)
     (all ?.and ..group ..name ..version))

(the artifact
     (?code.Projection //artifact.Artifact)
     (?code.tuple ..artifact'))

(the url
     (?code.Projection URL)
     ?code.text)

(the scm
     (?code.Projection /.SCM)
     ..url)

(the description
     (?code.Projection Text)
     ?code.text)

(the license
     (?code.Projection /.License)
     (monad.let [! ?.monad]
                [input (by ! each
                           (dictionary.of_list text.hash)
                           (?code.tuple (?.some (?.and ?code.text
                                                       ?list.any))))]
                (all ?.and
                     (..singular input "name" ..name)
                     (..singular input "url" ..url)
                     (?.else {/.:Repo}
                             (..singular input "type"
                                         (?.or (?code.this (' "repo"))
                                               (?code.this (' "manual"))))))))

(the organization
     (?code.Projection /.Organization)
     (monad.let [! ?.monad]
                [input (by ! each
                           (dictionary.of_list text.hash)
                           (?code.tuple (?.some (?.and ?code.text
                                                       ?list.any))))]
                (all ?.and
                     (..singular input "name" ..name)
                     (..singular input "url" ..url))))

(the developer
     (?code.Projection /.Developer)
     (monad.let [! ?.monad]
                [input (by ! each
                           (dictionary.of_list text.hash)
                           (?code.tuple (?.some (?.and ?code.text
                                                       ?list.any))))]
                (all ?.and
                     (..singular input "name" ..name)
                     (..singular input "url" ..url)
                     (?.maybe (..singular input "organization" ..organization))
                     )))

(the contributor
     (?code.Projection /.Contributor)
     ..developer)

(the info
     (?code.Projection /.Info)
     (monad.let [! ?.monad]
                [input (by ! each
                           (dictionary.of_list text.hash)
                           (?code.tuple (?.some (?.and ?code.text
                                                       ?list.any))))]
                (all ?.and
                     (?.maybe (..singular input "url" ..url))
                     (?.maybe (..singular input "scm" ..scm))
                     (?.maybe (..singular input "description" ..description))
                     (?.else (list) (..plural input "licenses" ..license))
                     (?.maybe (..singular input "organization" ..organization))
                     (?.else (list) (..plural input "developers" ..developer))
                     (?.else (list) (..plural input "contributors" ..contributor))
                     )))

(the repository
     (?code.Projection //repository.Address)
     ..url)

(the type
     (?code.Projection //artifact/type.Type)
     ?code.text)

(the dependency
     (?code.Projection //dependency.Dependency)
     (?code.tuple
      (all ?.and
           ..artifact'
           (?.else //artifact/type.lux_library ..type)
           )))

(the compiler
     (?code.Projection Compiler)
     (?code.tuple
      (all ?.and
           ?code.global
           (?.some ?code.text)
           )))

(the source
     (?code.Projection /.Source)
     ?code.text)

(the target
     (?code.Projection /.Target)
     ?code.text)

(the module_or_program
     (?code.Projection Name)
     ?code.name)

(the program
     (?code.Projection Name)
     ?code.global)

(the deploy_repository
     (?code.Projection [Text //repository.Address])
     (?.and ?code.text
            ..repository))

(the configuration/1
     (?code.Projection [Text Text])
     (?.and ?code.text
            ?code.text))

(the runtime
     (?code.Projection Runtime)
     (let [environment (?:each (dictionary.of_list text.hash)
                               (?.some (?code.tuple (?.and ?code.text ?code.text))))]
          (?code.tuple
           (all ?.and
                environment
                ?code.text
                (?.some ?code.text)))))

(the android
     (?code.Projection android.Profile)
     (monad.let [! ?.monad]
                [input (by ! each
                           (dictionary.of_list text.hash)
                           (?code.tuple (?.some (?.and ?code.text
                                                       ?list.any))))]
                (all ?.and
                     (..singular input "root" ?code.text)
                     (..singular input "platform" ?code.text)
                     (..singular input "tools" ?code.text)
                     (..singular input "manifest" ?code.text)
                     (..singular input "bundletool" ?code.text))))

(the profile
     (?code.Projection /.Profile)
     (monad.let [! ?.monad]
                [input (by ! each
                           (dictionary.of_list text.hash)
                           (?code.tuple (?.some (?.and ?code.text
                                                       ?list.any))))
                 .let [^parents (is (?code.Projection (List /.Name))
                                    (?.else (list)
                                            (..plural input "parents" ?code.text)))
                       ^identity (is (?code.Projection (Maybe Artifact))
                                     (?.maybe
                                      (..singular input "identity" ..artifact)))
                       ^info (is (?code.Projection (Maybe /.Info))
                                 (?.maybe
                                  (..singular input "info" ..info)))
                       ^repositories (is (?code.Projection (Set //repository.Address))
                                         (|> (..plural input "repositories" ..repository)
                                             (by ! each (set.of_list text.hash))
                                             (?.else (set.empty text.hash))
                                             (by ! each (set.has /.default_repository))))
                       ^dependencies (is (?code.Projection (Set //dependency.Dependency))
                                         (|> (..plural input "dependencies" ..dependency)
                                             (by ! each (set.of_list //dependency.hash))
                                             (?.else (set.empty //dependency.hash))))
                       ^lux (|> ..dependency
                                (..singular input //injection.lux_compiler_label)
                                (?.else /.default_lux))
                       ^compilers (|> ..compiler
                                      (..plural input "compilers")
                                      (?.else (list)))
                       ^sources (is (?code.Projection (Set /.Source))
                                    (|> (..plural input "sources" ..source)
                                        (by ! each (set.of_list text.hash))
                                        (?.else (set.of_list text.hash (list /.default_source)))))
                       ^resources (is (?code.Projection (Maybe file.Path))
                                      (?.maybe
                                       (..singular input "resources" ?code.text)))
                       ^target (is (?code.Projection /.Target)
                                   (|> ..target
                                       (..singular input "target")
                                       (?.else /.default_target)))
                       ^program (is (?code.Projection (Maybe Name))
                                    (?.maybe
                                     (..singular input "program" ..module_or_program)))
                       ^test (is (?code.Projection (Maybe Name))
                                 (?.maybe
                                  (..singular input "test" ..program)))
                       ^deploy_repositories (is (?code.Projection (Dictionary Text //repository.Address))
                                                (<| (by ! each (dictionary.of_list text.hash))
                                                    (?.else (list))
                                                    (..plural input "deploy_repositories" ..deploy_repository)))
                       ^configuration (is (?code.Projection (property.List Text))
                                          (<| (?.else (list))
                                              (..plural input "configuration" ..configuration/1)))
                       ^java (|> ..runtime
                                 (..singular input "java")
                                 (?.else //runtime.default_java))
                       ^js (|> ..runtime
                               (..singular input "js")
                               (?.else //runtime.default_js))
                       ^python (|> ..runtime
                                   (..singular input "python")
                                   (?.else //runtime.default_python))
                       ^lua (|> ..runtime
                                (..singular input "lua")
                                (?.else //runtime.default_lua))
                       ^ruby (|> ..runtime
                                 (..singular input "ruby")
                                 (?.else //runtime.default_ruby))
                       ^android (is (?code.Projection (Maybe android.Profile))
                                    (?.maybe (..singular input "android" ..android)))
                       ^comment (is (?code.Projection (List Code))
                                    (<| (?.else (list))
                                        (..plural input "comment" ?list.any)))]]
                (all ?.and
                     ^parents
                     ^identity
                     ^info
                     ^repositories
                     ^dependencies
                     ^lux
                     ^compilers
                     ^sources
                     ^resources
                     ^target
                     ^program
                     ^test
                     ^deploy_repositories
                     ^configuration
                     ^java
                     ^js
                     ^python
                     ^lua
                     ^ruby
                     ^android
                     ^comment
                     )))

(the .public project
     (?code.Projection Project)
     (by ?.monad each
         (dictionary.of_list text.hash)
         (?code.tuple (?.some (?.and ?code.text
                                     ..profile)))))
