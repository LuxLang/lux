(.using
 [library
  [lux (.except)
   [abstract
    [[0] monad]
    [[0] equality
     [[1 "T"] \\test]]]
   [error
    [[0] try (.open functor)]]
   [data
    [[0] text
     [["<" 1 ">"] \\projection]]]
   [math
    [[0] random (.only Random)]]
   [test
    [["_"] property (.only Test)]]]]
 [\\program
  [[0] /]]
 [["$" 0] ///
  [[1 0] time]])

(the .public random
     (Random /.Time)
     $///time.random)

(the .public test
     Test
     (<| (_.covering /._)
         (_.for [/.Time])
         (all _.and
              (_.for [/.equality]
                     (equalityT.spec /.equality ..random))

              (monad.let random.monad
                         [expected ..random]
                         (all _.and
                              (_.coverage [/.as_text /.of_text]
                                          (|> expected
                                              /.as_text
                                              (<text>.value /.of_text)
                                              (try:each (by /.equality = expected))
                                              (try.else false)))
                              ))
              )))
